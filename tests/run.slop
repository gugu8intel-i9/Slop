# The Slop test suite, written in Slop. Run it from the repository root with
# the compiler for your system, for example:
#   bin/slop run tests/run.slop                (Linux x86-64)
#   bin/slop-macos-arm64 run tests/run.slop    (Apple Silicon Mac)
#   bin\slop.exe run tests/run.slop            (Windows)
#   bin\slop-windows-arm64.exe run tests/run.slop   (Windows on ARM)

os = os_name()
arch = arch_name()
exe_suffix = ""
compiler = "bin/slop"
if os == "linux" and arch == "arm64" {
    compiler = "bin/slop-linux-arm64"
}
if os == "macos" {
    compiler = "bin/slop-macos"
    if arch == "arm64" {
        compiler = "bin/slop-macos-arm64"
    }
}
if os == "windows" {
    compiler = "bin/slop.exe"
    if arch == "arm64" {
        compiler = "bin/slop-windows-arm64.exe"
    }
    exe_suffix = ".exe"
}
stage = compiler
failures = 0
passed = 0

fn fail(msg: string) {
    print("FAIL " + msg)
    failures += 1
}

fn ok(msg: string) {
    print("ok   " + msg)
    passed += 1
}

fn build(src: string, out: string) -> bool {
    log = run(stage, [stage, src, out])
    if run_status() != 0 {
        fail(src + " did not compile:\n" + log)
        return false
    }
    return true
}

fn run_program(exe: string) -> string {
    return run(exe, [exe])
}

# a scratch file name in the current directory
fn tmp(name: string) -> string {
    return "slop-test-" + name + exe_suffix
}

print("testing on " + os + " " + arch)

# 1. the compiler builds itself, and the shipped compilers match compiler.slop
stage1 = tmp("stage1")
stage2 = tmp("stage2")
log = run(compiler, [compiler, "compiler.slop", stage1])
if run_status() != 0 {
    fail("bin/slop could not compile compiler.slop:\n" + log)
    exit(1)
}
log = run(stage1, [stage1, "compiler.slop", stage2])
if run_status() != 0 {
    fail("stage 1 could not compile compiler.slop:\n" + log)
    exit(1)
}
if read_file(stage1) != read_file(stage2) {
    fail("the compiler does not reproduce itself (stage 1 != stage 2)")
} else {
    ok("compiler builds itself (stage 1 == stage 2)")
}
if read_file(compiler) != read_file(stage1) {
    fail(compiler + " is out of date. Rebuild it: " + compiler + " compiler.slop " + compiler)
} else {
    ok(compiler + " matches compiler.slop")
}
stage = stage2

# every shipped compiler must match what the source builds for its system
struct Shipped {
    target: string,
    path: string
}

shipped = [
    Shipped("linux", "bin/slop"),
    Shipped("linux-arm64", "bin/slop-linux-arm64"),
    Shipped("macos", "bin/slop-macos"),
    Shipped("macos-arm64", "bin/slop-macos-arm64"),
    Shipped("windows", "bin/slop.exe"),
    Shipped("windows-arm64", "bin/slop-windows-arm64.exe")
]
for s in shipped {
    out = tmp("cross-" + s.target)
    log = run(stage, [stage, "--target", s.target, "compiler.slop", out])
    if run_status() != 0 {
        fail("could not build the " + s.target + " compiler:\n" + log)
    } else {
        if read_file(out) != read_file(s.path) {
            fail(s.path + " is out of date. Rebuild it: " + compiler + " --target " + s.target + " compiler.slop " + s.path)
        } else {
            ok(s.path + " matches compiler.slop")
        }
    }
}

# 2. test programs: output must match tests/expected/<name>.txt exactly
tests = ["array", "array_struct_string", "core", "features", "fib", "float", "function", "function_args", "hello_native", "method", "print", "struct", "sum_loop", "std", "thread", "use", "web", "crypto", "https", "websocket", "udp", "parallel", "gpu", "async", "npu", "matrix"]
for name in tests {
    exe = tmp(name)
    if build("tests/" + name + ".slop", exe) {
        got = run_program(exe)
        want = read_file("tests/expected/" + name + ".txt")
        if got == want {
            ok("tests/" + name + ".slop")
        } else {
            fail("tests/" + name + ".slop printed:\n" + got + "\nexpected:\n" + want)
        }
    }
}

# 3. examples: each must build; most are run and spot-checked
struct Check {
    name: string,
    expect: string
}

checks = [
    Check("hello", "Hello, World!"),
    Check("easy_start", "Hello Gugu"),
    Check("easy_syntax", "count: 3"),
    Check("structs_and_match", "Matched 5: Medium"),
    Check("real_world_db", "First restored transaction entry"),
    Check("storage_savings", "Completed Successfully"),
    Check("secure_guards_test", "Array index out of bounds"),
    Check("low_level_demo", "1337"),
    Check("slopfetch", "Kernel:"),
    Check("web_server", ""),
    Check("chat", ""),
    Check("benchmark", ""),
    Check("fetch", ""),
    Check("gpu", "ran on"),
    Check("npu", "1 xor 1 = 0"),
    Check("matmul", "same answers")
]
for c in checks {
    exe = tmp(c.name)
    if build("examples/" + c.name + ".slop", exe) {
        if c.expect == "" {
            ok("examples/" + c.name + ".slop builds")
        } else {
            got = run_program(exe)
            if contains(got, c.expect) {
                ok("examples/" + c.name + ".slop")
            } else {
                fail("examples/" + c.name + ".slop printed:\n" + got)
            }
        }
    }
}

# 4. mistakes give clear errors
struct BadCase {
    code: string,
    expect: string
}

bad = [
    BadCase("print(nope)", "line 1: unknown name 'nope'"),
    BadCase("x = 1\nx = \"text\"", "line 2: cannot assign string to x (int)"),
    BadCase("fn f(a: int) -> int {\n    return a\n}\nprint(f(1, 2))", "line 4: f takes 1 arguments"),
    BadCase("print(1 + \"a\")", "'+' needs numbers"),
    BadCase("if 1 < 2 {\n    print(1)", "missing '}'"),
    BadCase("print(7.5 % 2)", "'%' needs whole numbers"),
    BadCase("n = 1\nn = 2.5", "cannot assign float"),
    BadCase("names = [\"a\"]\ngpu for i in 0..1 {\n    print(names[i])\n}", "line 3: gpu for: 'names' has type array[string]"),
    BadCase("n = 0\nxs = [1]\ngpu for i in 0..1 {\n    n = xs[i]\n}", "line 4: gpu for: the loop cannot change 'n'"),
    BadCase("fn f(x: int) -> int {\n    return x\n}\nxs = [1]\ngpu for i in 0..1 {\n    xs[i] = f(i)\n}", "'f()' cannot run on the GPU")
]
for b in bad {
    write_file("slop-test-bad.slop", b.code)
    log = run(stage, [stage, "slop-test-bad.slop", tmp("bad")])
    if run_status() != 0 and contains(log, b.expect) {
        ok("error: " + b.expect)
    } else {
        fail("expected an error containing '" + b.expect + "', got:\n" + log)
    }
}

# 5. the slop command
struct CliCase {
    args: array[string],
    expect: string,
    status: int
}

cli = [
    CliCase(["version"], "Slop ", 0),
    CliCase(["help"], "slop run app.slop", 0),
    CliCase(["check", "tests/fib.slop"], "ok: no mistakes", 0),
    CliCase(["frobnicate"], "unknown command 'frobnicate'", 2),
    CliCase(["run"], "which file?", 2),
    CliCase(["std"], "random", 0),
    CliCase(["std", "math"], "gcd(a: int, b: int) -> int", 0)
]
for c in cli {
    all = [stage]
    for a in c.args {
        push(all, a)
    }
    log = run(stage, all)
    if run_status() == c.status and contains(log, c.expect) {
        ok("slop " + join(c.args, " "))
    } else {
        fail("slop " + join(c.args, " ") + " printed:\n" + log)
    }
}
log = run(stage, [stage, "new", "slop-test-made"])
if contains(read_file("slop-test-made.slop"), "print(") {
    ok("slop new")
} else {
    fail("slop new printed:\n" + log)
}
remove_file("slop-test-made.slop")

# 6. packages, with a package from this repository (no network needed)
log = run(stage, [stage, "add", "packages/stats/stats.slop"])
if run_status() == 0 and contains(read_file("slop.pkg"), "stats packages/stats/stats.slop") {
    ok("slop add")
} else {
    fail("slop add printed:\n" + log)
}
write_file("slop-test-pkg.slop", "use \"stats\"\nprint(median([3.0, 1.0, 2.0]))\n")
exe = tmp("pkg")
if build("slop-test-pkg.slop", exe) {
    got = run_program(exe)
    if got == "2.0\n" {
        ok("use \"stats\"")
    } else {
        fail("use \"stats\" printed:\n" + got)
    }
}
log = run(stage, [stage, "list"])
if contains(log, "stats") {
    ok("slop list")
} else {
    fail("slop list printed:\n" + log)
}
log = run(stage, [stage, "remove", "stats"])
if run_status() == 0 and not contains(read_file("slop.pkg"), "stats") {
    ok("slop remove")
} else {
    fail("slop remove printed:\n" + log)
}
remove_file("slop.pkg")
remove_file("slop-test-pkg.slop")

# 7. slop convert: programs in other languages become Slop that prints the same
converted = ["hello.rs", "demo.rs", "match.rs", "demo.c", "switch.c", "demo.cpp", "Demo.java", "Demo.cs", "demo.js", "demo.go", "demo.py", "classes.py", "demo.kt", "demo.swift"]
for f in converted {
    src = "tests/convert/" + f
    out = "slop-test-conv.slop"
    log = run(stage, [stage, "convert", src, "-o", out])
    exe = tmp("conv")
    if run_status() != 0 or not file_exists(out) {
        fail("slop convert " + f + ":\n" + log)
    } else {
        if build(out, exe) {
            got = run_program(exe)
            want = read_file(src + ".expected")
            if got == want {
                ok("slop convert " + f)
            } else {
                fail("converted " + f + " printed:\n" + got + "\nexpected:\n" + want)
            }
        }
    }
}
remove_file("slop-test-conv.slop")

print("")
print(int_to_string(passed) + " passed, " + int_to_string(failures) + " failed")
if failures > 0 {
    exit(1)
}
