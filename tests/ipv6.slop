# IPv6 (run by CI, where the computer has IPv6): one server answers both
# IPv6 and IPv4, over http, https, plain sockets and UDP
use "web"
use "time"

fn handle(req: Request) -> Response {
    return text("hello " + req.path)
}

fn udp_echo(port: int) -> int {
    fd = udp_open(port)
    socket_timeout(fd, 10000)
    for i in 0..2 {
        msg = udp_receive(fd)
        udp_reply(fd, msg + " from " + udp_sender(fd))
    }
    socket_close(fd)
    return 2
}

quiet()
port = 26000 + clock_ns() / 1000 % 2000
server = spawn serve_count(port, 4)
got = ""
tries = 0
while http_status() == 0 and tries < 300 {
    got = http_get("http://[::1]:" + str(port) + "/six")
    if http_status() == 0 {
        sleep(20)
    }
    tries += 1
}
print(http_status(), got, http_error())
if http_status() == 0 {
    print("this computer has no IPv6")
    exit(1)
}
print(http_get("http://127.0.0.1:" + str(port) + "/four"), http_status())
c = socket_connect("::1", port)
socket_write(c, "GET /raw HTTP/1.0\r\n\r\n")
print("raw", contains(socket_read(c), "hello /raw"))
socket_close(c)
print(http_get("http://localhost:" + str(port) + "/name"))
join(server)

# https over IPv6 (the test certificate for localhost also names ::1)
make_cert("localhost", "slop-test-v6-cert.pem", "slop-test-v6-key.pem")
trust_cert("slop-test-v6-cert.pem")
server2 = spawn serve_https_count(port + 1, "slop-test-v6-cert.pem", "slop-test-v6-key.pem", 1)
tries = 0
got = http_get("https://[::1]:" + str(port + 1) + "/secure")
while contains(http_error(), "cannot connect") and tries < 300 {
    sleep(20)
    got = http_get("https://[::1]:" + str(port + 1) + "/secure")
    tries += 1
}
print(http_status(), got, http_error())
join(server2)
remove_file("slop-test-v6-cert.pem")
remove_file("slop-test-v6-key.pem")

# UDP over IPv6 and IPv4 on one socket
u = spawn udp_echo(port + 2)
c6 = udp_open(0)
socket_timeout(c6, 200)
got = ""
tries = 0
while got == "" and tries < 100 {
    udp_send(c6, "::1", port + 2, "six")
    got = udp_receive(c6)
    tries += 1
}
print(got, udp_sender(c6))
udp_send(c6, "127.0.0.1", port + 2, "four")
socket_timeout(c6, 5000)
print(udp_receive(c6), udp_sender(c6))
join(u)
socket_close(c6)
