# random: random numbers (not for passwords or keys)
#   use "random"
#   print(random_int(1, 6))   # a dice roll

__random_state = clock_ns()

# the same seed gives the same numbers every run
fn seed(n: int) {
    __random_state = n
}

# the next 64 random bits (splitmix64)
fn random_bits() -> int {
    __random_state += -7046029254386353131
    z = __random_state
    z = (z ^ ((z >> 30) & 17179869183)) * -4658895280553007687
    z = (z ^ ((z >> 27) & 137438953471)) * -7723592293110705685
    return z ^ ((z >> 31) & 8589934591)
}

# a whole number from lo to hi, both included
fn random_int(lo: int, hi: int) -> int {
    span = hi - lo + 1
    r = random_bits() & 9223372036854775807
    return lo + r % span
}

# a float from 0.0 up to (not including) 1.0
fn random_float() -> float {
    return float((random_bits() >> 11) & 9007199254740991) / 9007199254740992.0
}

fn random_between(lo: float, hi: float) -> float {
    return lo + (hi - lo) * random_float()
}

fn coin_flip() -> bool {
    return (random_bits() & 1) == 1
}

fn pick_int(a: array[int]) -> int {
    return a[random_int(0, len(a) - 1)]
}

fn pick_string(a: array[string]) -> string {
    return a[random_int(0, len(a) - 1)]
}

# shuffles the list in place
fn shuffle_ints(a: array[int]) {
    i = len(a) - 1
    while i > 0 {
        j = random_int(0, i)
        t = a[i]
        a[i] = a[j]
        a[j] = t
        i -= 1
    }
}

fn shuffle_strings(a: array[string]) {
    i = len(a) - 1
    while i > 0 {
        j = random_int(0, i)
        t = a[i]
        a[i] = a[j]
        a[j] = t
        i -= 1
    }
}
