# tls: TLS 1.3, the encryption behind https, written in Slop
#   Used by the web module (serve_https, http_get with https://). It speaks
#   TLS 1.3 with X25519 and ChaCha20-Poly1305, signs with ECDSA (P-256 or
#   P-384 keys), and checks certificates (ECDSA and RSA) against the system's
#   trusted list.
use "crypto.slop"

# ---------- base64 and PEM ----------
__b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn base64_encode(b: array[int]) -> string {
    out = ""
    i = 0
    while i < len(b) {
        n = b[i] << 16
        if i + 1 < len(b) {
            n = n | (b[i + 1] << 8)
        }
        if i + 2 < len(b) {
            n = n | b[i + 2]
        }
        out = out + char_at(__b64, (n >> 18) & 63) + char_at(__b64, (n >> 12) & 63)
        if i + 1 < len(b) {
            out = out + char_at(__b64, (n >> 6) & 63)
        } else {
            out = out + "="
        }
        if i + 2 < len(b) {
            out = out + char_at(__b64, n & 63)
        } else {
            out = out + "="
        }
        i += 3
    }
    return out
}

fn base64_decode(s: string) -> array[int] {
    out: array[int] = []
    acc = 0
    bits = 0
    for i in 0..len(s) {
        c = byte_at(s, i)
        v = -1
        if c >= 65 and c <= 90 {
            v = c - 65
        }
        if c >= 97 and c <= 122 {
            v = c - 71
        }
        if c >= 48 and c <= 57 {
            v = c + 4
        }
        if c == 43 {
            v = 62
        }
        if c == 47 {
            v = 63
        }
        if v >= 0 {
            acc = ((acc << 6) | v) & 16777215
            bits += 6
            if bits >= 8 {
                bits -= 8
                push(out, (acc >> bits) & 255)
            }
        }
    }
    return out
}

# the DER bytes of every "-----BEGIN label-----" block
fn pem_blocks(pem: string, label: string) -> array[array[int]] {
    out: array[array[int]] = []
    begin = "-----BEGIN " + label + "-----"
    stop = "-----END " + label + "-----"
    rest = pem
    while true {
        a = find(rest, begin)
        if a < 0 {
            break
        }
        rest = slice(rest, a + len(begin), len(rest))
        e = find(rest, stop)
        if e < 0 {
            break
        }
        push(out, base64_decode(slice(rest, 0, e)))
        rest = slice(rest, e + len(stop), len(rest))
    }
    return out
}

fn pem_encode(label: string, der: array[int]) -> string {
    b = base64_encode(der)
    out = "-----BEGIN " + label + "-----\n"
    i = 0
    while i < len(b) {
        e = i + 64
        if e > len(b) {
            e = len(b)
        }
        out = out + slice(b, i, e) + "\n"
        i = e
    }
    return out + "-----END " + label + "-----\n"
}

# ---------- DER (the binary format of certificates and keys) ----------
# [tag, content start, content length, end] of the element at i
fn der_at(b: array[int], i: int) -> array[int] {
    if i + 1 >= len(b) {
        return [-1, i, 0, i]
    }
    tag = b[i]
    l = b[i + 1]
    start = i + 2
    if l >= 128 {
        nb = l & 127
        l = 0
        for k in 0..nb {
            if start < len(b) {
                l = (l << 8) | b[start]
            }
            start += 1
        }
    }
    if start + l > len(b) {
        return [-1, i, 0, i]
    }
    return [tag, start, l, start + l]
}

# positions of the elements inside a SEQUENCE/SET whose content is start..end
fn der_items(b: array[int], start: int, end: int) -> array[int] {
    out: array[int] = []
    i = start
    while i < end {
        e = der_at(b, i)
        if e[0] < 0 {
            break
        }
        push(out, i)
        i = e[3]
    }
    return out
}

fn der_content(b: array[int], i: int) -> array[int] {
    e = der_at(b, i)
    return sub_bytes(b, e[1], e[3])
}

fn der_whole(b: array[int], i: int) -> array[int] {
    e = der_at(b, i)
    return sub_bytes(b, i, e[3])
}

fn der(tag: int, content: array[int]) -> array[int] {
    n = len(content)
    head = [tag]
    if n < 128 {
        push(head, n)
    } else {
        if n < 256 {
            push(head, 129)
            push(head, n)
        } else {
            if n < 65536 {
                push(head, 130)
                push(head, n >> 8)
                push(head, n & 255)
            } else {
                push(head, 131)
                push(head, n >> 16)
                push(head, (n >> 8) & 255)
                push(head, n & 255)
            }
        }
    }
    return join_bytes(head, content)
}

fn der_seq(items: array[array[int]]) -> array[int] {
    body: array[int] = []
    for it in items {
        body = join_bytes(body, it)
    }
    return der(48, body)
}

# a positive INTEGER from big-endian bytes
fn der_uint(b: array[int]) -> array[int] {
    i = 0
    while i < len(b) - 1 and b[i] == 0 {
        i += 1
    }
    v = sub_bytes(b, i, len(b))
    if v[0] >= 128 {
        v = join_bytes([0], v)
    }
    return der(2, v)
}

fn der_oid(hexs: string) -> array[int] {
    return der(6, from_hex(hexs))
}

# ECDSA r||s -> DER SEQUENCE { r, s }, and back
fn ecdsa_sig_der(rs: array[int]) -> array[int] {
    h = len(rs) / 2
    return der_seq([der_uint(sub_bytes(rs, 0, h)), der_uint(sub_bytes(rs, h, len(rs)))])
}

fn ecdsa_sig_raw(sig: array[int], size: int) -> array[int] {
    empty: array[int] = []
    top = der_at(sig, 0)
    if top[0] != 48 {
        return empty
    }
    items = der_items(sig, top[1], top[3])
    if len(items) != 2 {
        return empty
    }
    r = __fit(der_content(sig, items[0]), size / 2)
    s = __fit(der_content(sig, items[1]), size / 2)
    if len(r) == 0 or len(s) == 0 {
        return empty
    }
    return join_bytes(r, s)
}

# a big-endian number as exactly n bytes (empty if it does not fit)
fn __fit(b: array[int], n: int) -> array[int] {
    i = 0
    while i < len(b) and b[i] == 0 {
        i += 1
    }
    v = sub_bytes(b, i, len(b))
    if len(v) > n {
        empty: array[int] = []
        return empty
    }
    out: array[int] = []
    for k in 0..n - len(v) {
        push(out, 0)
    }
    return join_bytes(out, v)
}

# ---------- time ----------
# days since 1970-01-01 for a calendar date
fn days_from_civil(y0: int, m: int, d: int) -> int {
    y = y0
    if m <= 2 {
        y -= 1
    }
    era = y / 400
    if y < 0 and y % 400 != 0 {
        era -= 1
    }
    yoe = y - era * 400
    mp = (m + 9) % 12
    doy = (153 * mp + 2) / 5 + d - 1
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

# [year, month, day] for days since 1970-01-01
fn civil_from_days(z0: int) -> array[int] {
    z = z0 + 719468
    era = z / 146097
    doe = z - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp = (5 * doy + 2) / 153
    d = doy - (153 * mp + 2) / 5 + 1
    m = mp + 3
    if m > 12 {
        m -= 12
    }
    if m <= 2 {
        y += 1
    }
    return [y, m, d]
}

fn __digits_at(b: array[int], i: int, n: int) -> int {
    v = 0
    for k in 0..n {
        v = v * 10 + b[i + k] - 48
    }
    return v
}

# UTCTime (tag 23) or GeneralizedTime (tag 24) -> seconds since 1970
fn der_time(b: array[int], i: int) -> int {
    e = der_at(b, i)
    s = e[1]
    y = 0
    if e[0] == 23 {
        y = __digits_at(b, s, 2)
        if y < 50 {
            y += 2000
        } else {
            y += 1900
        }
        s += 2
    } else {
        y = __digits_at(b, s, 4)
        s += 4
    }
    mo = __digits_at(b, s, 2)
    d = __digits_at(b, s + 2, 2)
    hh = __digits_at(b, s + 4, 2)
    mi = __digits_at(b, s + 6, 2)
    ss = __digits_at(b, s + 8, 2)
    return days_from_civil(y, mo, d) * 86400 + hh * 3600 + mi * 60 + ss
}

fn __two(n: int) -> string {
    if n < 10 {
        return "0" + str(n)
    }
    return str(n)
}

fn der_utctime(t: int) -> array[int] {
    c = civil_from_days(t / 86400)
    r = t % 86400
    s = __two(c[0] % 100) + __two(c[1]) + __two(c[2]) + __two(r / 3600) + __two(r % 3600 / 60) + __two(r % 60) + "Z"
    return der(23, to_bytes(s))
}

# ---------- certificates (X.509) ----------
struct X509Cert {
    ok: bool,
    der: array[int],
    tbs: array[int],
    sig_alg: string,
    sig: array[int],
    issuer: array[int],
    subject: array[int],
    not_before: int,
    not_after: int,
    key_type: string,
    curve: string,
    pub: array[int],
    rsa_e: array[int],
    names: array[string],
    ips: array[string]
}

fn __bad_cert() -> X509Cert {
    e: array[int] = []
    n: array[string] = []
    return X509Cert(false, e, e, "", e, e, e, 0, 0, "", "", e, e, n, n)
}

fn parse_cert(d: array[int]) -> X509Cert {
    top = der_at(d, 0)
    if top[0] != 48 {
        return __bad_cert()
    }
    parts = der_items(d, top[1], top[3])
    if len(parts) != 3 {
        return __bad_cert()
    }
    tbs = der_whole(d, parts[0])
    alg_seq = der_at(d, parts[1])
    sig_alg = to_hex(der_content(d, der_items(d, alg_seq[1], alg_seq[3])[0]))
    sigbits = der_content(d, parts[2])
    sig = sub_bytes(sigbits, 1, len(sigbits))
    t = der_at(d, parts[0])
    f = der_items(d, t[1], t[3])
    k = 0
    if der_at(d, f[0])[0] == 160 {
        k = 1
    }
    # serial, signature, issuer, validity, subject, key
    issuer = der_whole(d, f[k + 2])
    validity = der_at(d, f[k + 3])
    vt = der_items(d, validity[1], validity[3])
    nb = der_time(d, vt[0])
    na = der_time(d, vt[1])
    subject = der_whole(d, f[k + 4])
    spki = der_at(d, f[k + 5])
    sp = der_items(d, spki[1], spki[3])
    alg = der_at(d, sp[0])
    ai = der_items(d, alg[1], alg[3])
    key_oid = to_hex(der_content(d, ai[0]))
    keybits = der_content(d, sp[1])
    key = sub_bytes(keybits, 1, len(keybits))
    key_type = ""
    curve = ""
    pub = key
    rsa_e: array[int] = []
    if key_oid == "2a8648ce3d0201" {
        key_type = "ec"
        c = to_hex(der_content(d, ai[1]))
        if c == "2a8648ce3d030107" {
            curve = "P-256"
        }
        if c == "2b81040022" {
            curve = "P-384"
        }
    }
    if key_oid == "2a864886f70d010101" {
        key_type = "rsa"
        rk = der_at(key, 0)
        ri = der_items(key, rk[1], rk[3])
        pub = der_content(key, ri[0])
        rsa_e = der_content(key, ri[1])
    }
    names: array[string] = []
    ips: array[string] = []
    for idx in f {
        e = der_at(d, idx)
        if e[0] == 163 {
            exts = der_at(d, e[1])
            for x in der_items(d, exts[1], exts[3]) {
                xe = der_at(d, x)
                xi = der_items(d, xe[1], xe[3])
                oid = to_hex(der_content(d, xi[0]))
                if oid == "551d11" {
                    val = der_content(d, xi[len(xi) - 1])
                    gs = der_at(val, 0)
                    for g in der_items(val, gs[1], gs[3]) {
                        ge = der_at(val, g)
                        if ge[0] == 130 {
                            push(names, lower(from_bytes(sub_bytes(val, ge[1], ge[3]))))
                        }
                        if ge[0] == 135 and ge[2] == 4 {
                            push(ips, str(val[ge[1]]) + "." + str(val[ge[1] + 1]) + "." + str(val[ge[1] + 2]) + "." + str(val[ge[1] + 3]))
                        }
                    }
                }
            }
        }
    }
    return X509Cert(true, d, tbs, sig_alg, sig, issuer, subject, nb, na, key_type, curve, pub, rsa_e, names, ips)
}

# does `signer` vouch for `c`? (checks the signature on c)
fn cert_signed_by(c: X509Cert, signer: X509Cert) -> bool {
    alg = ""
    kind = ""
    if c.sig_alg == "2a8648ce3d040302" {
        alg = "sha256"
        kind = "ec"
    }
    if c.sig_alg == "2a8648ce3d040303" {
        alg = "sha384"
        kind = "ec"
    }
    if c.sig_alg == "2a8648ce3d040304" {
        alg = "sha512"
        kind = "ec"
    }
    if c.sig_alg == "2a864886f70d01010b" {
        alg = "sha256"
        kind = "rsa"
    }
    if c.sig_alg == "2a864886f70d01010c" {
        alg = "sha384"
        kind = "rsa"
    }
    if c.sig_alg == "2a864886f70d01010d" {
        alg = "sha512"
        kind = "rsa"
    }
    if kind == "" or kind != signer.key_type {
        return false
    }
    h = hash_with(alg, c.tbs)
    if kind == "ec" {
        if signer.curve == "" {
            return false
        }
        C = curve_named(signer.curve)
        rs = ecdsa_sig_raw(c.sig, C.size * 2)
        if len(rs) == 0 {
            return false
        }
        return ecdsa_verify(C, signer.pub, h, sub_bytes(rs, 0, C.size), sub_bytes(rs, C.size, len(rs)))
    }
    return rsa_verify_pkcs1(signer.pub, signer.rsa_e, alg, h, c.sig)
}

fn cert_matches_host(c: X509Cert, host: string) -> bool {
    h = lower(host)
    for ip in c.ips {
        if ip == h {
            return true
        }
    }
    for n in c.names {
        if n == h {
            return true
        }
        if starts_with(n, "*.") {
            dot = find(h, ".")
            if dot > 0 and slice(h, dot, len(h)) == slice(n, 1, len(n)) {
                return true
            }
        }
    }
    return false
}

# ---------- trusted certificates ----------
__tls_roots: array[X509Cert] = []
__tls_roots_loaded = false
__tls_extra: array[array[int]] = []

# trusts one more certificate (a PEM file), for example your own self-signed one
fn tls_trust(path: string) {
    for d in pem_blocks(read_file(path), "CERTIFICATE") {
        push(__tls_extra, d)
    }
}

fn __tls_load_roots() {
    if __tls_roots_loaded {
        return
    }
    __tls_roots_loaded = true
    ders: array[array[int]] = []
    if os_name() == "windows" {
        for s in __windows_roots() {
            push(ders, to_bytes(s))
        }
    } else {
        for path in ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/ca-bundle.pem", "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem", "/etc/ssl/cert.pem", "/usr/local/etc/openssl/cert.pem", "/opt/homebrew/etc/openssl@3/cert.pem"] {
            if len(ders) == 0 and file_exists(path) {
                ders = pem_blocks(read_file(path), "CERTIFICATE")
            }
        }
    }
    roots: array[X509Cert] = []
    for d in ders {
        c = parse_cert(d)
        if c.ok {
            push(roots, c)
        }
    }
    __tls_roots = roots
}

# checks the server's chain: each certificate signed by the next, ending at a
# trusted one, all within their dates, the first one naming the host
fn tls_check_chain(chain: array[X509Cert], host: string) -> string {
    if len(chain) == 0 {
        return "the server sent no certificate"
    }
    now = __time_unix()
    for c in chain {
        if not c.ok {
            return "a certificate could not be read"
        }
    }
    if not cert_matches_host(chain[0], host) {
        return "the certificate is not for " + host
    }
    trusted: array[X509Cert] = []
    for d in __tls_extra {
        c = parse_cert(d)
        if c.ok {
            push(trusted, c)
        }
    }
    __tls_load_roots()
    for r in __tls_roots {
        push(trusted, r)
    }
    i = 0
    while i < len(chain) {
        c = chain[i]
        if now < c.not_before or now > c.not_after {
            return "a certificate has expired or is not valid yet"
        }
        # is c itself trusted?
        for t in trusted {
            if same_bytes(t.der, c.der) {
                return ""
            }
        }
        # signed by a trusted certificate?
        for t in trusted {
            if same_bytes(t.subject, c.issuer) and cert_signed_by(c, t) {
                return ""
            }
        }
        # else the next one in the chain must have signed it
        if i + 1 >= len(chain) or not same_bytes(chain[i + 1].subject, c.issuer) or not cert_signed_by(c, chain[i + 1]) {
            return "the certificate is not signed by anyone this computer trusts"
        }
        i += 1
    }
    return "the certificate is not signed by anyone this computer trusts"
}

# ---------- keys ----------
# a server's certificate chain and private key: ECDSA (curve, d) or RSA (rsa)
struct TlsKey {
    ok: bool,
    curve: string,
    d: array[int],
    chain: array[array[int]],
    kind: string,
    rsa: RsaKey
}

# the numbers of a PKCS#1 RSAPrivateKey { version, n, e, d, p, q, dp, dq, qinv }
fn __rsa_key(b: array[int]) -> RsaKey {
    top = der_at(b, 0)
    it = der_items(b, top[1], top[3])
    if len(it) < 9 {
        e: array[int] = []
        return RsaKey(e, e, e, e, e, e, e, e)
    }
    return RsaKey(der_content(b, it[1]), der_content(b, it[2]), der_content(b, it[3]), der_content(b, it[4]), der_content(b, it[5]), der_content(b, it[6]), der_content(b, it[7]), der_content(b, it[8]))
}

# reads a certificate file (the chain, PEM) and its private key (PEM: EC or PKCS#8)
fn tls_load_key(cert_path: string, key_path: string) -> TlsKey {
    chain = pem_blocks(read_file(cert_path), "CERTIFICATE")
    kt = read_file(key_path)
    e: array[int] = []
    curve = ""
    d = e
    kind = ""
    rsa = RsaKey(e, e, e, e, e, e, e, e)
    for blk in pem_blocks(kt, "PRIVATE KEY") {
        # PKCS#8: { version, { algorithm, parameters }, OCTET STRING { the key } }
        top = der_at(blk, 0)
        it = der_items(blk, top[1], top[3])
        alg = der_at(blk, it[1])
        ai = der_items(blk, alg[1], alg[3])
        inner = der_content(blk, it[2])
        oid = to_hex(der_content(blk, ai[0]))
        if oid == "2a864886f70d010101" {
            kind = "rsa"
            rsa = __rsa_key(inner)
        }
        if oid == "2a8648ce3d0201" and len(ai) > 1 {
            kind = "ec"
            c = to_hex(der_content(blk, ai[1]))
            if c == "2a8648ce3d030107" {
                curve = "P-256"
            }
            if c == "2b81040022" {
                curve = "P-384"
            }
            ie = der_at(inner, 0)
            ii = der_items(inner, ie[1], ie[3])
            d = der_content(inner, ii[1])
        }
    }
    for blk in pem_blocks(kt, "RSA PRIVATE KEY") {
        kind = "rsa"
        rsa = __rsa_key(blk)
    }
    for blk in pem_blocks(kt, "EC PRIVATE KEY") {
        kind = "ec"
        top = der_at(blk, 0)
        it = der_items(blk, top[1], top[3])
        d = der_content(blk, it[1])
        for idx in it {
            x = der_at(blk, idx)
            if x[0] == 160 {
                c = to_hex(der_content(blk, x[1]))
                if c == "2a8648ce3d030107" {
                    curve = "P-256"
                }
                if c == "2b81040022" {
                    curve = "P-384"
                }
            }
        }
    }
    ok = len(chain) > 0 and ((kind == "ec" and len(d) > 0 and curve != "") or (kind == "rsa" and len(rsa.n) > 0))
    return TlsKey(ok, curve, d, chain, kind, rsa)
}

# the signature scheme to use with this key, from those the client offers (0 if none fits)
fn __pick_scheme(key: TlsKey, offered: array[int], v13: bool) -> int {
    want: array[int] = []
    if key.kind == "ec" {
        if key.curve == "P-384" {
            want = [1283]
        } else {
            want = [1027]
        }
    } else {
        # RSA-PSS first; TLS 1.2 may also use the older PKCS#1 v1.5
        want = [2052, 2053, 2054]
        if not v13 {
            want = [2052, 2053, 2054, 1025, 1281, 1537]
        }
    }
    for w in want {
        for o in offered {
            if o == w {
                return w
            }
        }
    }
    return 0
}

# signs content with the server's key using scheme (ECDSA signatures in DER form)
fn __server_sign(key: TlsKey, scheme: int, content: array[int]) -> array[int] {
    if key.kind == "ec" {
        C = curve_named(key.curve)
        return ecdsa_sig_der(ecdsa_sign(C, key.d, hash_with(__curve_hash(key.curve), content)))
    }
    alg = "sha256"
    if scheme == 2053 or scheme == 1281 {
        alg = "sha384"
    }
    if scheme == 2054 or scheme == 1537 {
        alg = "sha512"
    }
    if scheme >= 2052 and scheme <= 2054 {
        return rsa_sign_pss(key.rsa, alg, hash_with(alg, content))
    }
    return rsa_sign_pkcs1(key.rsa, alg, hash_with(alg, content))
}

# a self-signed certificate and key for trying https on your own computer
fn tls_make_cert(host: string, cert_path: string, key_path: string) {
    C = p256()
    d = ecdsa_new_key(C)
    pub = ecdsa_public(C, d)
    name = der_seq([der(49, der_seq([der_oid("550403"), der(12, to_bytes(host))]))])
    now = __time_unix()
    alt = der(130, to_bytes(host))
    if host == "localhost" {
        alt = join_bytes(alt, der(135, [127, 0, 0, 1]))
    }
    if __is_ipv4(host) {
        p = split(host, ".")
        alt = der(135, [to_int(p[0]), to_int(p[1]), to_int(p[2]), to_int(p[3])])
    }
    san = der_seq([der_oid("551d11"), der(4, der(48, alt))])
    tbs = der_seq([der(160, der(2, [2])), der_uint(join_bytes([1], random_bytes(8))), der_seq([der_oid("2a8648ce3d040302")]), name, der_seq([der_utctime(now - 86400), der_utctime(now + 365 * 86400)]), name, der_seq([der_seq([der_oid("2a8648ce3d0201"), der_oid("2a8648ce3d030107")]), der(3, join_bytes([0], pub))]), der(163, der_seq([san]))])
    sig = ecdsa_sig_der(ecdsa_sign(C, d, sha256(tbs)))
    cert = der_seq([tbs, der_seq([der_oid("2a8648ce3d040302")]), der(3, join_bytes([0], sig))])
    ec = der_seq([der(2, [1]), der(4, d), der(160, der_oid("2a8648ce3d030107")), der(161, der(3, join_bytes([0], pub)))])
    write_file(cert_path, pem_encode("CERTIFICATE", cert))
    write_file(key_path, pem_encode("EC PRIVATE KEY", ec))
}

# ---------- TLS connections (1.3, and 1.2 for older software) ----------
# Ciphers: ChaCha20-Poly1305 (preferred) and AES-128-GCM.
# Key exchange: X25519 (preferred) and P-256.
struct Tls {
    fd: int,
    ok: bool,
    err: string,
    raw: string,
    rkey: array[int],
    riv: array[int],
    rseq: int,
    wkey: array[int],
    wiv: array[int],
    wseq: int,
    rtype: int,
    rbody: string,
    hsbuf: string,
    mtype: int,
    msg: string,
    data: string,
    closed: bool,
    ver: int,
    aes: bool,
    renc: bool,
    wenc: bool
}

fn __is_ipv4(host: string) -> bool {
    parts = split(host, ".")
    if len(parts) != 4 {
        return false
    }
    for p in parts {
        if len(p) == 0 or len(p) > 3 {
            return false
        }
        for i in 0..len(p) {
            if byte_at(p, i) < 48 or byte_at(p, i) > 57 {
                return false
            }
        }
    }
    return true
}

fn __tls_new(fd: int) -> Tls {
    e: array[int] = []
    return Tls(fd, true, "", "", e, e, 0, e, e, 0, 0, "", "", 0, "", "", false, 13, false, false, false)
}

fn __tls_fail(c: Tls, why: string) -> Tls {
    c.ok = false
    if c.err == "" {
        c.err = why
    }
    return c
}

fn __u16(v: int) -> string {
    return chr((v >> 8) & 255) + chr(v & 255)
}

fn __u24(v: int) -> string {
    return chr((v >> 16) & 255) + chr((v >> 8) & 255) + chr(v & 255)
}

fn __num(s: string, i: int, n: int) -> int {
    v = 0
    for k in 0..n {
        v = (v << 8) | byte_at(s, i + k)
    }
    return v
}

fn __tls_seal(c: Tls, nonce: array[int], plain: array[int], aad: array[int]) -> array[int] {
    if c.aes {
        return aes128_gcm_seal(c.wkey, nonce, plain, aad)
    }
    return chacha20_poly1305_seal(c.wkey, nonce, plain, aad)
}

fn __tls_open(c: Tls, nonce: array[int], sealed: array[int], aad: array[int]) -> array[int] {
    if c.aes {
        return aes128_gcm_open(c.rkey, nonce, sealed, aad)
    }
    return chacha20_poly1305_open(c.rkey, nonce, sealed, aad)
}

# TLS 1.2 additional data: sequence number, type, version, length
fn __aad12(seq: int, rtype: int, n: int) -> array[int] {
    return join_bytes(join_bytes(__be64(seq), [rtype, 3, 3]), [(n >> 8) & 255, n & 255])
}

# reads one record (header + body) into c.rtype and c.rbody
fn __tls_read_record(c: Tls) -> Tls {
    while len(c.raw) < 5 {
        more = socket_read(c.fd)
        if more == "" {
            return __tls_fail(c, "the connection closed")
        }
        c.raw = c.raw + more
    }
    n = __num(c.raw, 3, 2)
    if n > 18432 {
        return __tls_fail(c, "a record was too long")
    }
    while len(c.raw) < 5 + n {
        more = socket_read(c.fd)
        if more == "" {
            return __tls_fail(c, "the connection closed")
        }
        c.raw = c.raw + more
    }
    c.rtype = byte_at(c.raw, 0)
    c.rbody = slice(c.raw, 5, 5 + n)
    head = slice(c.raw, 0, 5)
    c.raw = slice(c.raw, 5 + n, len(c.raw))
    if c.rtype == 20 {
        # ChangeCipherSpec: in TLS 1.2 what follows is encrypted
        if c.ver == 12 and len(c.rkey) > 0 {
            c.renc = true
            c.rseq = 0
        }
        return c
    }
    if c.renc and c.ver == 13 and c.rtype == 23 {
        plain = __tls_open(c, __tls_nonce(c.riv, c.rseq), to_bytes(c.rbody), to_bytes(head))
        if not open_ok() {
            return __tls_fail(c, "a record failed its integrity check")
        }
        c.rseq += 1
        k = len(plain) - 1
        while k >= 0 and plain[k] == 0 {
            k -= 1
        }
        if k < 0 {
            return __tls_fail(c, "an empty record")
        }
        c.rtype = plain[k]
        c.rbody = from_bytes(sub_bytes(plain, 0, k))
    } else {
        if c.renc and c.ver == 12 {
            body = to_bytes(c.rbody)
            nonce: array[int] = []
            if not c.aes {
                nonce = __tls_nonce(c.riv, c.rseq)
            }
            if c.aes {
                if len(body) < 24 {
                    return __tls_fail(c, "a record was too short")
                }
                nonce = join_bytes(c.riv, sub_bytes(body, 0, 8))
                body = sub_bytes(body, 8, len(body))
            }
            if len(body) < 16 {
                return __tls_fail(c, "a record was too short")
            }
            plain = __tls_open(c, nonce, body, __aad12(c.rseq, c.rtype, len(body) - 16))
            if not open_ok() {
                return __tls_fail(c, "a record failed its integrity check")
            }
            c.rseq += 1
            c.rbody = from_bytes(plain)
        }
    }
    if c.rtype == 21 {
        if len(c.rbody) >= 2 and byte_at(c.rbody, 1) == 0 {
            c.closed = true
            return __tls_fail(c, "closed")
        }
        code = 0
        if len(c.rbody) >= 2 {
            code = byte_at(c.rbody, 1)
        }
        return __tls_fail(c, "the other side refused (alert " + str(code) + ")")
    }
    return c
}

fn __tls_nonce(iv: array[int], seq: int) -> array[int] {
    out: array[int] = []
    for i in 0..12 {
        v = iv[i]
        if i >= 4 {
            v = v ^ ((seq >> ((11 - i) * 8)) & 255)
        }
        push(out, v)
    }
    return out
}

# the next whole handshake message, into c.mtype and c.msg (with its header)
fn __tls_next_msg(c: Tls) -> Tls {
    while len(c.hsbuf) < 4 or len(c.hsbuf) < 4 + __num(c.hsbuf, 1, 3) {
        c = __tls_read_record(c)
        if not c.ok {
            return c
        }
        if c.rtype == 20 {
            continue
        }
        if c.rtype != 22 {
            return __tls_fail(c, "expected a handshake message")
        }
        c.hsbuf = c.hsbuf + c.rbody
    }
    n = __num(c.hsbuf, 1, 3)
    c.mtype = byte_at(c.hsbuf, 0)
    c.msg = slice(c.hsbuf, 0, 4 + n)
    c.hsbuf = slice(c.hsbuf, 4 + n, len(c.hsbuf))
    return c
}

fn __tls_write_plain(c: Tls, rtype: int, body: string) {
    i = 0
    while i < len(body) or i == 0 {
        e = i + 16000
        if e > len(body) {
            e = len(body)
        }
        socket_write(c.fd, chr(rtype) + "\x03\x03" + __u16(e - i) + slice(body, i, e))
        i = e
        if len(body) == 0 {
            break
        }
    }
}

# encrypts and sends body (split into records), as content type rtype
fn __tls_write(c: Tls, rtype: int, body: string) -> Tls {
    i = 0
    while i < len(body) or i == 0 {
        e = i + 16000
        if e > len(body) {
            e = len(body)
        }
        piece = slice(body, i, e)
        if c.ver == 13 {
            inner = to_bytes(piece + chr(rtype))
            head = "\x17\x03\x03" + __u16(len(inner) + 16)
            sealed = __tls_seal(c, __tls_nonce(c.wiv, c.wseq), inner, to_bytes(head))
            socket_write(c.fd, head + from_bytes(sealed))
        } else {
            plain = to_bytes(piece)
            aad = __aad12(c.wseq, rtype, len(plain))
            out = ""
            if c.aes {
                explicit = __be64(c.wseq)
                out = from_bytes(explicit) + from_bytes(__tls_seal(c, join_bytes(c.wiv, explicit), plain, aad))
            } else {
                out = from_bytes(__tls_seal(c, __tls_nonce(c.wiv, c.wseq), plain, aad))
            }
            socket_write(c.fd, chr(rtype) + "\x03\x03" + __u16(len(out)) + out)
        }
        c.wseq += 1
        i = e
        if len(body) == 0 {
            break
        }
    }
    return c
}

fn __tls_label(secret: array[int], label: string, ctx: array[int], n: int) -> array[int] {
    full = to_bytes("tls13 " + label)
    info = join_bytes(join_bytes([(n >> 8) & 255, n & 255, len(full)], full), join_bytes([len(ctx)], ctx))
    return hkdf_expand("sha256", secret, info, n)
}

fn __tls_hash(transcript: string) -> array[int] {
    return sha256(to_bytes(transcript))
}

# TLS 1.3 traffic keys from the two secrets
fn __tls_keys(c: Tls, read_secret: array[int], write_secret: array[int]) -> Tls {
    e: array[int] = []
    klen = 32
    if c.aes {
        klen = 16
    }
    c.rkey = __tls_label(read_secret, "key", e, klen)
    c.riv = __tls_label(read_secret, "iv", e, 12)
    c.wkey = __tls_label(write_secret, "key", e, klen)
    c.wiv = __tls_label(write_secret, "iv", e, 12)
    c.rseq = 0
    c.wseq = 0
    c.renc = true
    c.wenc = true
    return c
}

# the TLS 1.2 pseudo-random function (with SHA-256)
fn __prf(secret: array[int], label: string, seed: array[int], n: int) -> array[int] {
    s = join_bytes(to_bytes(label), seed)
    out: array[int] = []
    a = hmac("sha256", secret, s)
    while len(out) < n {
        for x in hmac("sha256", secret, join_bytes(a, s)) {
            if len(out) < n {
                push(out, x)
            }
        }
        a = hmac("sha256", secret, a)
    }
    return out
}

# TLS 1.2 keys: is_client says which half is ours to write with
fn __tls12_keys(c: Tls, master: array[int], cr: array[int], sr: array[int], is_client: bool) -> Tls {
    klen = 32
    ivlen = 12
    if c.aes {
        klen = 16
        ivlen = 4
    }
    kb = __prf(master, "key expansion", join_bytes(sr, cr), 2 * klen + 2 * ivlen)
    ck = sub_bytes(kb, 0, klen)
    sk = sub_bytes(kb, klen, 2 * klen)
    civ = sub_bytes(kb, 2 * klen, 2 * klen + ivlen)
    siv = sub_bytes(kb, 2 * klen + ivlen, 2 * klen + 2 * ivlen)
    if is_client {
        c.wkey = ck
        c.wiv = civ
        c.rkey = sk
        c.riv = siv
    } else {
        c.wkey = sk
        c.wiv = siv
        c.rkey = ck
        c.riv = civ
    }
    c.rseq = 0
    c.wseq = 0
    return c
}

fn __tls12_master(pre: array[int], ems: bool, transcript: string, cr: array[int], sr: array[int]) -> array[int] {
    if ems {
        return __prf(pre, "extended master secret", __tls_hash(transcript), 48)
    }
    return __prf(pre, "master secret", join_bytes(cr, sr), 48)
}

# the extensions of a ClientHello/ServerHello: [type, start, length, ...]
fn __tls_exts(s: string, start: int, end: int) -> array[int] {
    out: array[int] = []
    i = start
    while i + 4 <= end {
        t = __num(s, i, 2)
        n = __num(s, i + 2, 2)
        push(out, t)
        push(out, i + 4)
        push(out, n)
        i += 4 + n
    }
    return out
}

fn __zeros(n: int) -> array[int] {
    out: array[int] = []
    for i in 0..n {
        push(out, 0)
    }
    return out
}

fn __curve_hash(curve: string) -> string {
    if curve == "P-384" {
        return "sha384"
    }
    return "sha256"
}

# a key pair for the key exchange: [private bytes..., then public]; group 29 X25519, 23 P-256
fn __kx_private(group: int) -> array[int] {
    if group == 23 {
        return ecdsa_new_key(p256())
    }
    return random_bytes(32)
}

fn __kx_public(group: int, priv: array[int]) -> array[int] {
    if group == 23 {
        return ecdsa_public(p256(), priv)
    }
    return x25519_public(priv)
}

fn __kx_shared(group: int, priv: array[int], theirs: array[int]) -> array[int] {
    if group == 23 {
        return p256_shared(priv, theirs)
    }
    if len(theirs) != 32 {
        empty: array[int] = []
        return empty
    }
    out = x25519(priv, theirs)
    if bn_zero(out) {
        empty: array[int] = []
        return empty
    }
    return out
}

# checks a signature from the server's certificate key (TLS 1.2 key exchange or 1.3 CertificateVerify)
fn __check_sig(leaf: X509Cert, scheme: int, content: array[int], sig: array[int]) -> bool {
    if (scheme == 1027 or scheme == 1283 or scheme == 1539) and leaf.key_type == "ec" and leaf.curve != "" {
        C = curve_named(leaf.curve)
        alg = "sha256"
        if scheme == 1283 {
            alg = "sha384"
        }
        if scheme == 1539 {
            alg = "sha512"
        }
        rs = ecdsa_sig_raw(sig, C.size * 2)
        return len(rs) > 0 and ecdsa_verify(C, leaf.pub, hash_with(alg, content), sub_bytes(rs, 0, C.size), sub_bytes(rs, C.size, len(rs)))
    }
    if leaf.key_type != "rsa" {
        return false
    }
    alg = ""
    pss = false
    if scheme == 2052 {
        alg = "sha256"
        pss = true
    }
    if scheme == 2053 {
        alg = "sha384"
        pss = true
    }
    if scheme == 2054 {
        alg = "sha512"
        pss = true
    }
    if scheme == 1025 {
        alg = "sha256"
    }
    if scheme == 1281 {
        alg = "sha384"
    }
    if scheme == 1537 {
        alg = "sha512"
    }
    if alg == "" {
        return false
    }
    if pss {
        return rsa_verify_pss(leaf.pub, leaf.rsa_e, alg, hash_with(alg, content), sig)
    }
    return rsa_verify_pkcs1(leaf.pub, leaf.rsa_e, alg, hash_with(alg, content), sig)
}

# reads a Certificate message's list of certificates (TLS 1.3 has a context and per-certificate extensions)
fn __cert_list(m: string, v13: bool) -> array[X509Cert] {
    chain: array[X509Cert] = []
    q = 4
    if v13 {
        q = 4 + 1 + byte_at(m, 4)
    }
    end = q + 3 + __num(m, q, 3)
    q += 3
    while q < end {
        n = __num(m, q, 3)
        push(chain, parse_cert(to_bytes(slice(m, q + 3, q + 3 + n))))
        q += 3 + n
        if v13 {
            q += 2 + __num(m, q, 2)
        }
    }
    return chain
}

# ---------- server side ----------
# the handshake on a new connection: TLS 1.3, or 1.2 for older software
fn tls_accept(fd: int, key: TlsKey) -> Tls {
    c = __tls_new(fd)
    c = __tls_next_msg(c)
    if not c.ok {
        return c
    }
    if c.mtype != 1 {
        return __tls_fail(c, "expected a ClientHello")
    }
    ch = c.msg
    cr = to_bytes(slice(ch, 6, 38))
    p = 4 + 2 + 32
    sid_len = byte_at(ch, p)
    sid = slice(ch, p + 1, p + 1 + sid_len)
    p += 1 + sid_len
    ncs = __num(ch, p, 2)
    suites: array[int] = []
    k = 0
    while k < ncs {
        push(suites, __num(ch, p + 2 + k, 2))
        k += 2
    }
    p += 2 + ncs
    p += 1 + byte_at(ch, p)
    ext_end = p + 2 + __num(ch, p, 2)
    exts: array[int] = []
    if p + 2 <= len(ch) {
        exts = __tls_exts(ch, p + 2, ext_end)
    }
    tls13 = false
    tls12 = __num(ch, 4, 2) >= 771
    share: array[int] = []
    groups: array[int] = []
    offered: array[int] = []
    alpn = false
    ems = false
    reneg = false
    for su in suites {
        if su == 255 {
            reneg = true
        }
    }
    k = 0
    while k < len(exts) {
        t = exts[k]
        a = exts[k + 1]
        n = exts[k + 2]
        if t == 43 {
            tls12 = false
            j = a + 1
            while j < a + n {
                if __num(ch, j, 2) == 772 {
                    tls13 = true
                }
                if __num(ch, j, 2) == 771 {
                    tls12 = true
                }
                j += 2
            }
        }
        if t == 51 {
            j = a + 2
            while j + 4 <= a + n {
                g = __num(ch, j, 2)
                l = __num(ch, j + 2, 2)
                if g == 29 and l == 32 {
                    share = to_bytes(slice(ch, j + 4, j + 4 + 32))
                }
                j += 4 + l
            }
        }
        if t == 10 {
            j = a + 2
            while j < a + n {
                push(groups, __num(ch, j, 2))
                j += 2
            }
        }
        if t == 13 {
            j = a + 2
            while j < a + n {
                push(offered, __num(ch, j, 2))
                j += 2
            }
        }
        if t == 16 and contains(slice(ch, a, a + n), "http/1.1") {
            alpn = true
        }
        if t == 23 {
            ems = true
        }
        if t == 65281 {
            reneg = true
        }
        k += 3
    }
    # TLS 1.3 if the client can, ChaCha20 first
    suite13 = 0
    for su in suites {
        if su == 4867 {
            suite13 = 4867
        }
    }
    if suite13 == 0 {
        for su in suites {
            if su == 4865 {
                suite13 = 4865
            }
        }
    }
    scheme = __pick_scheme(key, offered, true)
    if tls13 and suite13 != 0 and len(share) == 32 and scheme != 0 {
        c.aes = suite13 == 4865
        return __accept13(c, key, ch, sid, share, suite13, scheme, alpn)
    }
    # else TLS 1.2 with ECDHE, signed with the certificate's key
    scheme = __pick_scheme(key, offered, false)
    chacha12 = 52393
    aes12 = 49195
    if key.kind == "rsa" {
        chacha12 = 52392
        aes12 = 49199
    }
    suite12 = 0
    for su in suites {
        if su == chacha12 {
            suite12 = chacha12
        }
    }
    if suite12 == 0 {
        for su in suites {
            if su == aes12 {
                suite12 = aes12
            }
        }
    }
    group = 0
    if len(groups) == 0 {
        group = 23
    }
    for g in groups {
        if g == 29 {
            group = 29
        }
    }
    if group == 0 {
        for g in groups {
            if g == 23 {
                group = 23
            }
        }
    }
    # in TLS 1.2 the client's curve list also covers the certificate's curve
    cert_group = 23
    if key.curve == "P-384" {
        cert_group = 24
    }
    cert_ok = len(groups) == 0 or key.kind == "rsa"
    for g in groups {
        if g == cert_group {
            cert_ok = true
        }
    }
    if not tls12 or suite12 == 0 or group == 0 or scheme == 0 or not cert_ok {
        # handshake_failure
        __tls_write_plain(c, 21, "\x02\x28")
        return __tls_fail(c, "the browser and server have no TLS settings in common")
    }
    c.ver = 12
    c.aes = suite12 == 49195 or suite12 == 49199
    # the last 8 bytes of our random say we could have done TLS 1.3
    sr = join_bytes(random_bytes(24), to_bytes("DOWNGRD\x01"))
    sh_ext = "\x00\x0b\x00\x02\x01\x00"
    if reneg {
        sh_ext = sh_ext + "\xff\x01\x00\x01\x00"
    }
    if ems {
        sh_ext = sh_ext + "\x00\x17\x00\x00"
    }
    if alpn {
        sh_ext = sh_ext + "\x00\x10\x00\x0b\x00\x09\x08http/1.1"
    }
    sh_body = "\x03\x03" + from_bytes(sr) + "\x00" + __u16(suite12) + "\x00" + __u16(len(sh_ext)) + sh_ext
    sh = "\x02" + __u24(len(sh_body)) + sh_body
    certs = ""
    for d in key.chain {
        certs = certs + __u24(len(d)) + from_bytes(d)
    }
    cm = "\x0b" + __u24(len(certs) + 3) + __u24(len(certs)) + certs
    priv = __kx_private(group)
    pub = __kx_public(group, priv)
    params = "\x03" + __u16(group) + chr(len(pub)) + from_bytes(pub)
    signed = join_bytes(join_bytes(cr, sr), to_bytes(params))
    sig = __server_sign(key, scheme, signed)
    if len(sig) == 0 {
        return __tls_fail(c, "signing failed")
    }
    ske_body = params + __u16(scheme) + __u16(len(sig)) + from_bytes(sig)
    ske = "\x0c" + __u24(len(ske_body)) + ske_body
    shd = "\x0e\x00\x00\x00"
    __tls_write_plain(c, 22, sh + cm + ske + shd)
    th = ch + sh + cm + ske + shd
    c = __tls_next_msg(c)
    if not c.ok {
        return c
    }
    if c.mtype != 16 {
        return __tls_fail(c, "expected the browser's key")
    }
    cke = c.msg
    shared = __kx_shared(group, priv, to_bytes(slice(cke, 5, 5 + byte_at(cke, 4))))
    if len(shared) == 0 {
        return __tls_fail(c, "the browser's key was not valid")
    }
    th = th + cke
    master = __tls12_master(shared, ems, th, cr, sr)
    c = __tls12_keys(c, master, cr, sr, false)
    c = __tls_next_msg(c)
    if not c.ok {
        return c
    }
    if not c.renc or c.mtype != 20 or not same_bytes(to_bytes(slice(c.msg, 4, len(c.msg))), __prf(master, "client finished", __tls_hash(th), 12)) {
        return __tls_fail(c, "the browser's Finished message was wrong")
    }
    th = th + c.msg
    __tls_write_plain(c, 20, "\x01")
    c.wenc = true
    c = __tls_write(c, 22, "\x14\x00\x00\x0c" + from_bytes(__prf(master, "server finished", __tls_hash(th), 12)))
    return c
}

fn __accept13(c0: Tls, key: TlsKey, ch: string, sid: string, share: array[int], suite: int, scheme: int, alpn: bool) -> Tls {
    c = c0
    priv = random_bytes(32)
    pub = x25519_public(priv)
    shared = x25519(priv, share)
    sh_body = "\x03\x03" + from_bytes(random_bytes(32)) + chr(len(sid)) + sid + __u16(suite) + "\x00"
    sh_ext = "\x00\x2b\x00\x02\x03\x04" + "\x00\x33\x00\x24\x00\x1d\x00\x20" + from_bytes(pub)
    sh_body = sh_body + __u16(len(sh_ext)) + sh_ext
    sh = "\x02" + __u24(len(sh_body)) + sh_body
    __tls_write_plain(c, 22, sh)
    __tls_write_plain(c, 20, "\x01")
    th = ch + sh
    e: array[int] = []
    zero = __zeros(32)
    early = hkdf_extract("sha256", zero, zero)
    hs = hkdf_extract("sha256", __tls_label(early, "derived", sha256(e), 32), shared)
    chs = __tls_label(hs, "c hs traffic", __tls_hash(th), 32)
    shs = __tls_label(hs, "s hs traffic", __tls_hash(th), 32)
    c = __tls_keys(c, chs, shs)
    ee_ext = ""
    if alpn {
        ee_ext = "\x00\x10\x00\x0b\x00\x09\x08http/1.1"
    }
    ee = "\x08" + __u24(len(ee_ext) + 2) + __u16(len(ee_ext)) + ee_ext
    certs = ""
    for d in key.chain {
        certs = certs + __u24(len(d)) + from_bytes(d) + "\x00\x00"
    }
    cert_body = "\x00" + __u24(len(certs)) + certs
    cm = "\x0b" + __u24(len(cert_body)) + cert_body
    th = th + ee + cm
    content = repeat(" ", 64) + "TLS 1.3, server CertificateVerify\x00" + from_bytes(__tls_hash(th))
    sig = __server_sign(key, scheme, to_bytes(content))
    if len(sig) == 0 {
        return __tls_fail(c, "signing failed")
    }
    cv_body = __u16(scheme) + __u16(len(sig)) + from_bytes(sig)
    cv = "\x0f" + __u24(len(cv_body)) + cv_body
    th = th + cv
    sfk = __tls_label(shs, "finished", e, 32)
    sfin = "\x14\x00\x00\x20" + from_bytes(hmac("sha256", sfk, __tls_hash(th)))
    th = th + sfin
    c = __tls_write(c, 22, ee + cm + cv + sfin)
    master = hkdf_extract("sha256", __tls_label(hs, "derived", sha256(e), 32), zero)
    cap = __tls_label(master, "c ap traffic", __tls_hash(th), 32)
    sap = __tls_label(master, "s ap traffic", __tls_hash(th), 32)
    cfk = __tls_label(chs, "finished", e, 32)
    want = hmac("sha256", cfk, __tls_hash(th))
    c = __tls_next_msg(c)
    if not c.ok {
        return c
    }
    if c.mtype != 20 or not same_bytes(to_bytes(slice(c.msg, 4, len(c.msg))), want) {
        return __tls_fail(c, "the browser's Finished message was wrong")
    }
    return __tls_keys(c, cap, sap)
}

# ---------- client side ----------
__tls_max = 13
__tls_aes_only = false

# for testing: the newest TLS version the client offers (12 or 13), and
# whether it offers only AES-128-GCM
fn tls_client_options(max_version: int, aes_only: bool) {
    __tls_max = max_version
    __tls_aes_only = aes_only
}

# the handshake with a server (TLS 1.3, or 1.2 if that is all it speaks);
# checks its certificate unless insecure
fn tls_connect(fd: int, host: string, insecure: bool) -> Tls {
    c = __tls_new(fd)
    priv = random_bytes(32)
    pub = x25519_public(priv)
    cr = random_bytes(32)
    sni = "\x00" + __u16(len(host)) + host
    ext = "\x00\x00" + __u16(len(sni) + 2) + __u16(len(sni)) + sni
    ext = ext + "\x00\x0a\x00\x06\x00\x04\x00\x1d\x00\x17"
    ext = ext + "\x00\x0b\x00\x02\x01\x00"
    schemes = "\x04\x03\x05\x03\x08\x04\x08\x05\x08\x06\x04\x01\x05\x01\x06\x01"
    ext = ext + "\x00\x0d" + __u16(len(schemes) + 2) + __u16(len(schemes)) + schemes
    ext = ext + "\x00\x17\x00\x00" + "\xff\x01\x00\x01\x00"
    suites = "\x13\x03\x13\x01\xcc\xa9\xcc\xa8\xc0\x2b\xc0\x2f"
    if __tls_aes_only {
        suites = "\x13\x01\xc0\x2b\xc0\x2f"
    }
    if __tls_max >= 13 {
        ext = ext + "\x00\x2b\x00\x05\x04\x03\x04\x03\x03"
        ext = ext + "\x00\x33\x00\x26\x00\x24\x00\x1d\x00\x20" + from_bytes(pub)
    } else {
        suites = slice(suites, 4, len(suites))
        if __tls_aes_only {
            suites = "\xc0\x2b\xc0\x2f"
        }
    }
    body = "\x03\x03" + from_bytes(cr) + "\x20" + from_bytes(random_bytes(32)) + __u16(len(suites)) + suites + "\x01\x00" + __u16(len(ext)) + ext
    ch = "\x01" + __u24(len(body)) + body
    __tls_write_plain(c, 22, ch)
    c = __tls_next_msg(c)
    if not c.ok {
        return c
    }
    if c.mtype != 2 {
        return __tls_fail(c, "expected a ServerHello")
    }
    sh = c.msg
    sr = to_bytes(slice(sh, 6, 38))
    if to_hex(sr) == "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c" {
        return __tls_fail(c, "the server wants a key exchange Slop does not offer")
    }
    p = 4 + 2 + 32
    p += 1 + byte_at(sh, p)
    suite = __num(sh, p, 2)
    p += 3
    exts: array[int] = []
    if p + 2 <= len(sh) {
        exts = __tls_exts(sh, p + 2, p + 2 + __num(sh, p, 2))
    }
    share: array[int] = []
    tls13 = false
    ems = false
    k = 0
    while k < len(exts) {
        if exts[k] == 43 and __num(sh, exts[k + 1], 2) == 772 {
            tls13 = true
        }
        if exts[k] == 51 and __num(sh, exts[k + 1], 2) == 29 {
            share = to_bytes(slice(sh, exts[k + 1] + 4, exts[k + 1] + 4 + 32))
        }
        if exts[k] == 23 {
            ems = true
        }
        k += 3
    }
    if not tls13 {
        if __num(sh, 4, 2) != 771 {
            return __tls_fail(c, "the server only speaks TLS older than 1.2")
        }
        if from_bytes(sub_bytes(sr, 24, 32)) == "DOWNGRD\x01" and __tls_max >= 13 {
            return __tls_fail(c, "the connection was pushed down from TLS 1.3 (someone may be in the middle)")
        }
        return __connect12(c, host, insecure, ch + sh, cr, sr, suite, ems)
    }
    if (suite != 4867 and suite != 4865) or len(share) != 32 {
        return __tls_fail(c, "the server picked settings Slop does not offer")
    }
    c.aes = suite == 4865
    shared = x25519(priv, share)
    th = ch + sh
    e: array[int] = []
    zero = __zeros(32)
    early = hkdf_extract("sha256", zero, zero)
    hs = hkdf_extract("sha256", __tls_label(early, "derived", sha256(e), 32), shared)
    chs = __tls_label(hs, "c hs traffic", __tls_hash(th), 32)
    shs = __tls_label(hs, "s hs traffic", __tls_hash(th), 32)
    c = __tls_keys(c, shs, chs)
    chain: array[X509Cert] = []
    while true {
        c = __tls_next_msg(c)
        if not c.ok {
            return c
        }
        m = c.msg
        if c.mtype == 8 {
            th = th + m
            continue
        }
        if c.mtype == 13 {
            return __tls_fail(c, "the server asks for a client certificate (not supported)")
        }
        if c.mtype == 11 {
            chain = __cert_list(m, true)
            th = th + m
            continue
        }
        if c.mtype == 15 {
            if len(chain) == 0 {
                return __tls_fail(c, "the server sent no certificate")
            }
            content = repeat(" ", 64) + "TLS 1.3, server CertificateVerify\x00" + from_bytes(__tls_hash(th))
            sch = __num(m, 4, 2)
            sig = to_bytes(slice(m, 8, 8 + __num(m, 6, 2)))
            if sch == 1025 or sch == 1281 or sch == 1537 or not __check_sig(chain[0], sch, to_bytes(content), sig) {
                return __tls_fail(c, "the server's signature did not check out")
            }
            th = th + m
            continue
        }
        if c.mtype == 20 {
            sfk = __tls_label(shs, "finished", e, 32)
            if not same_bytes(to_bytes(slice(m, 4, len(m))), hmac("sha256", sfk, __tls_hash(th))) {
                return __tls_fail(c, "the server's Finished message was wrong")
            }
            th = th + m
            break
        }
        return __tls_fail(c, "an unexpected handshake message")
    }
    if not insecure {
        why = tls_check_chain(chain, host)
        if why != "" {
            # bad_certificate
            __tls_write_plain(c, 21, "\x02\x2a")
            return __tls_fail(c, why)
        }
    }
    master = hkdf_extract("sha256", __tls_label(hs, "derived", sha256(e), 32), zero)
    cap = __tls_label(master, "c ap traffic", __tls_hash(th), 32)
    sap = __tls_label(master, "s ap traffic", __tls_hash(th), 32)
    __tls_write_plain(c, 20, "\x01")
    cfk = __tls_label(chs, "finished", e, 32)
    c = __tls_write(c, 22, "\x14\x00\x00\x20" + from_bytes(hmac("sha256", cfk, __tls_hash(th))))
    return __tls_keys(c, sap, cap)
}

# the rest of a TLS 1.2 handshake, after the ServerHello
fn __connect12(c0: Tls, host: string, insecure: bool, th0: string, cr: array[int], sr: array[int], suite: int, ems: bool) -> Tls {
    c = c0
    th = th0
    if suite != 52393 and suite != 52392 and suite != 49195 and suite != 49199 {
        return __tls_fail(c, "the server picked settings Slop does not offer")
    }
    c.ver = 12
    c.aes = suite == 49195 or suite == 49199
    chain: array[X509Cert] = []
    group = 0
    theirs: array[int] = []
    while true {
        c = __tls_next_msg(c)
        if not c.ok {
            return c
        }
        m = c.msg
        if c.mtype == 11 {
            chain = __cert_list(m, false)
            th = th + m
            continue
        }
        if c.mtype == 12 {
            if len(chain) == 0 or byte_at(m, 4) != 3 {
                return __tls_fail(c, "the server's key exchange was not readable")
            }
            group = __num(m, 5, 2)
            pl = byte_at(m, 7)
            theirs = to_bytes(slice(m, 8, 8 + pl))
            params = to_bytes(slice(m, 4, 8 + pl))
            q = 8 + pl
            sch = __num(m, q, 2)
            sig = to_bytes(slice(m, q + 4, q + 4 + __num(m, q + 2, 2)))
            if group != 29 and group != 23 {
                return __tls_fail(c, "the server picked a key exchange Slop does not offer")
            }
            if not __check_sig(chain[0], sch, join_bytes(join_bytes(cr, sr), params), sig) {
                return __tls_fail(c, "the server's signature did not check out")
            }
            th = th + m
            continue
        }
        if c.mtype == 13 {
            return __tls_fail(c, "the server asks for a client certificate (not supported)")
        }
        if c.mtype == 14 {
            th = th + m
            break
        }
        return __tls_fail(c, "an unexpected handshake message")
    }
    if group == 0 {
        return __tls_fail(c, "the server sent no key exchange")
    }
    if not insecure {
        why = tls_check_chain(chain, host)
        if why != "" {
            __tls_write_plain(c, 21, "\x02\x2a")
            return __tls_fail(c, why)
        }
    }
    priv = __kx_private(group)
    pub = __kx_public(group, priv)
    shared = __kx_shared(group, priv, theirs)
    if len(shared) == 0 {
        return __tls_fail(c, "the server's key was not valid")
    }
    cke = "\x10" + __u24(len(pub) + 1) + chr(len(pub)) + from_bytes(pub)
    th = th + cke
    master = __tls12_master(shared, ems, th, cr, sr)
    c = __tls12_keys(c, master, cr, sr, true)
    __tls_write_plain(c, 22, cke)
    __tls_write_plain(c, 20, "\x01")
    c.wenc = true
    fin = "\x14\x00\x00\x0c" + from_bytes(__prf(master, "client finished", __tls_hash(th), 12))
    c = __tls_write(c, 22, fin)
    th = th + fin
    c = __tls_next_msg(c)
    if not c.ok {
        return c
    }
    if c.mtype == 4 {
        # a session ticket (not used): the Finished comes next
        c = __tls_next_msg(c)
        if not c.ok {
            return c
        }
    }
    if not c.renc or c.mtype != 20 or not same_bytes(to_bytes(slice(c.msg, 4, len(c.msg))), __prf(master, "server finished", __tls_hash(th), 12)) {
        return __tls_fail(c, "the server's Finished message was wrong")
    }
    return c
}

# sends text over the connection
fn tls_send(c: Tls, s: string) -> Tls {
    return __tls_write(c, 23, s)
}

# the next piece of text into c.data ("" once the other side is done)
fn tls_recv(c: Tls) -> Tls {
    c.data = ""
    while c.ok {
        c = __tls_read_record(c)
        if not c.ok {
            return c
        }
        if c.rtype == 23 {
            c.data = c.rbody
            return c
        }
        # session tickets and other handshake messages after the start: skip
    }
    return c
}

# which TLS version the connection uses: "1.3" or "1.2"
fn tls_version(c: Tls) -> string {
    if c.ver == 12 {
        return "1.2"
    }
    return "1.3"
}

fn tls_close(c: Tls) {
    if c.ok and c.wenc {
        __tls_write(c, 21, "\x01\x00")
    }
    socket_close(c.fd)
}
