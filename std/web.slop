# web: websites and web services
#   use "web"
#
#   fn handle(req: Request) -> Response {
#       if route(req, "GET", "/") {
#           return html(page("Home", "<h1>Hello!</h1>"))
#       }
#       if route(req, "GET", "/hello/:name") {
#           return text("Hi " + param("name"))
#       }
#       return not_found()
#   }
#
#   serve(8080)    # then open http://localhost:8080
#   serve_https(8443, "cert.pem", "key.pem")   # https (make_cert makes a test pair)
use "tls.slop"
use "http2.slop"

struct Request {
    method: string,
    path: string,
    query: string,
    headers: string,
    body: string
}

struct Response {
    status: int,
    content_type: string,
    headers: string,
    body: string
}

# the parts route() matched, for param(): "name\x01value\x02..." in a
# byte buffer (see __rb_new), so setting them for each request takes no
# lasting memory (a list assigned to a global would be kept for good)
__web_params = 0
__web_quiet = false
__web_status = 0
__web_error = ""
__web_version = ""
__web_insecure = false
# HTTP/2 for https, as server and client (use_http2(false) turns it off)
__web_h2 = true
__web_word = 0
__web_pool_word = 0
# open connections kept for the next request to the same server
_web_pool_keys: array[string] = []
_web_pool_conns: array[Tls] = []

# ---------- answers ----------
fn html(body: string) -> Response {
    return Response(200, "text/html; charset=utf-8", "", body)
}

fn text(body: string) -> Response {
    return Response(200, "text/plain; charset=utf-8", "", body)
}

fn json(body: string) -> Response {
    return Response(200, "application/json", "", body)
}

# sends the visitor to another address
fn redirect(url: string) -> Response {
    return Response(303, "text/plain", "Location: " + url + "\r\n", "")
}

fn not_found() -> Response {
    return Response(404, "text/html; charset=utf-8", "", page("Not found", "<h1>Not found</h1><p>There is no page here.</p>"))
}

fn bad_request(why: string) -> Response {
    return Response(400, "text/plain; charset=utf-8", "", why)
}

# the same answer with another status code (201, 403, 500, ...)
fn with_status(r: Response, code: int) -> Response {
    return Response(code, r.content_type, r.headers, r.body)
}

fn with_header(r: Response, name: string, value: string) -> Response {
    return Response(r.status, r.content_type, r.headers + name + ": " + value + "\r\n", r.body)
}

fn set_cookie(r: Response, name: string, value: string) -> Response {
    return with_header(r, "Set-Cookie", name + "=" + url_encode(value) + "; Path=/; HttpOnly; SameSite=Lax")
}

# a file from disk, with the right type for its extension (404 if missing)
fn send_file(path: string) -> Response {
    if not file_exists(path) or contains(path, "..") {
        return not_found()
    }
    return Response(200, content_type_for(path), "", read_file(path))
}

# answers /prefix/... from the files in dir: send_dir(req, "/static/", "public")
fn send_dir(req: Request, prefix: string, dir: string) -> Response {
    rest = slice(req.path, len(prefix), len(req.path))
    if rest == "" or ends_with(rest, "/") {
        rest = rest + "index.html"
    }
    return send_file(dir + "/" + rest)
}

fn content_type_for(path: string) -> string {
    p = lower(path)
    types = [".html", "text/html; charset=utf-8", ".htm", "text/html; charset=utf-8", ".css", "text/css", ".js", "text/javascript", ".json", "application/json", ".txt", "text/plain; charset=utf-8", ".svg", "image/svg+xml", ".png", "image/png", ".jpg", "image/jpeg", ".jpeg", "image/jpeg", ".gif", "image/gif", ".webp", "image/webp", ".ico", "image/x-icon", ".pdf", "application/pdf", ".wasm", "application/wasm", ".woff2", "font/woff2", ".mp4", "video/mp4", ".xml", "application/xml"]
    k = 0
    while k < len(types) {
        if ends_with(p, types[k]) {
            return types[k + 1]
        }
        k += 2
    }
    return "application/octet-stream"
}

# ---------- reading the request ----------
# true when the request matches: route(req, "GET", "/users/:id"). "*" as the
# method matches any; a last "*" segment matches the rest of the path.
fn route(req: Request, method: string, pattern: string) -> bool {
    if method != "*" and method != req.method and not (method == "GET" and req.method == "HEAD") {
        return false
    }
    want = split(pattern, "/")
    got = split(req.path, "/")
    names: array[string] = []
    values: array[string] = []
    for i in 0..len(want) {
        w = want[i]
        if w == "*" and i == len(want) - 1 {
            rest: array[string] = []
            for k in i..len(got) {
                push(rest, got[k])
            }
            push(names, "*")
            push(values, join(rest, "/"))
            _web_params_set(names, values)
            return true
        }
        if i >= len(got) {
            return false
        }
        if starts_with(w, ":") {
            if got[i] == "" {
                return false
            }
            push(names, slice(w, 1, len(w)))
            push(values, got[i])
        } else {
            if w != got[i] {
                return false
            }
        }
    }
    if len(got) != len(want) {
        return false
    }
    _web_params_set(names, values)
    return true
}

fn _web_params_set(names: array[string], values: array[string]) {
    if __web_params == 0 {
        __web_params = __rb_new()
    }
    __rb_clear(__web_params)
    for i in 0..len(names) {
        __rb_add(__web_params, names[i] + "\x01" + values[i] + "\x02")
    }
}

# a :name part of the path that route() matched
fn param(name: string) -> string {
    if __web_params == 0 {
        return ""
    }
    for item in split(__rb_peek(__web_params, __rb_len(__web_params)), "\x02") {
        eq = find(item, "\x01")
        if eq >= 0 and slice(item, 0, eq) == name {
            return slice(item, eq + 1, len(item))
        }
    }
    return ""
}

# a value from "a=1&b=2" text
fn __web_field(data: string, key: string) -> string {
    for pair in split(data, "&") {
        eq = find(pair, "=")
        if eq >= 0 {
            if url_decode(slice(pair, 0, eq)) == key {
                return url_decode(slice(pair, eq + 1, len(pair)))
            }
        } else {
            if url_decode(pair) == key {
                return ""
            }
        }
    }
    return ""
}

# ?key=value in the address
fn query(req: Request, key: string) -> string {
    return __web_field(req.query, key)
}

# a field of a submitted form (<form method="post">)
fn form(req: Request, key: string) -> string {
    return __web_field(req.body, key)
}

# a request header, any capitalization: header(req, "User-Agent")
fn header(req: Request, name: string) -> string {
    want = lower(name)
    for line in split(req.headers, "\n") {
        c = find(line, ":")
        if c > 0 and lower(trim(slice(line, 0, c))) == want {
            return trim(slice(line, c + 1, len(line)))
        }
    }
    return ""
}

fn cookie(req: Request, name: string) -> string {
    for part in split(header(req, "Cookie"), ";") {
        p = trim(part)
        eq = find(p, "=")
        if eq > 0 and slice(p, 0, eq) == name {
            return url_decode(slice(p, eq + 1, len(p)))
        }
    }
    return ""
}

# ---------- text for the web ----------
fn url_decode(s: string) -> string {
    out = ""
    i = 0
    while i < len(s) {
        c = byte_at(s, i)
        if c == 43 {
            out = out + " "
            i += 1
            continue
        }
        if c == 37 and i + 2 < len(s) {
            hi = __web_hex(byte_at(s, i + 1))
            lo = __web_hex(byte_at(s, i + 2))
            if hi >= 0 and lo >= 0 {
                out = out + chr(hi * 16 + lo)
                i += 3
                continue
            }
        }
        out = out + char_at(s, i)
        i += 1
    }
    return out
}

fn __web_hex(c: int) -> int {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return -1
}

fn url_encode(s: string) -> string {
    digits = "0123456789ABCDEF"
    out = ""
    for i in 0..len(s) {
        c = byte_at(s, i)
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 46 or c == 95 or c == 126 {
            out = out + char_at(s, i)
        } else {
            out = out + "%" + char_at(digits, c / 16) + char_at(digits, c % 16)
        }
    }
    return out
}

# makes text safe to put inside HTML
fn escape_html(s: string) -> string {
    out = replace(s, "&", "&amp;")
    out = replace(out, "<", "&lt;")
    out = replace(out, ">", "&gt;")
    out = replace(out, "\"", "&quot;")
    return replace(out, "'", "&#39;")
}

# fills {{name}} in a template with values (made safe for HTML);
# {{{name}}} puts the value in as it is. pairs: ["name", "Ada", "age", "36"]
fn render(template: string, pairs: array[string]) -> string {
    out = template
    k = 0
    while k + 1 < len(pairs) {
        out = replace(out, "{{{" + pairs[k] + "}}}", pairs[k + 1])
        out = replace(out, "{{" + pairs[k] + "}}", escape_html(pairs[k + 1]))
        k += 2
    }
    return out
}

fn render_file(path: string, pairs: array[string]) -> string {
    return render(read_file(path), pairs)
}

# a whole HTML page with a clean, readable look
fn page(title: string, body: string) -> string {
    style = "body{font-family:system-ui,sans-serif;max-width:46rem;margin:2rem auto;padding:0 1rem;line-height:1.6;color:#222;background:#fff}a{color:#0b5fff}input,textarea,button{font:inherit;padding:.4rem .6rem;margin:.2rem 0}button{cursor:pointer}pre,code{background:#f4f4f4;padding:.1rem .3rem}@media(prefers-color-scheme:dark){body{background:#151515;color:#e8e8e8}a{color:#6ea8ff}pre,code{background:#262626}}"
    return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>" + escape_html(title) + "</title>\n<style>" + style + "</style>\n</head>\n<body>\n" + body + "\n</body>\n</html>\n"
}

# ---------- JSON ----------
# a JSON string, quoted and escaped
fn json_string(s: string) -> string {
    out = replace(s, "\\", "\\\\")
    out = replace(out, "\"", "\\\"")
    out = replace(out, "\n", "\\n")
    out = replace(out, "\r", "\\r")
    out = replace(out, "\t", "\\t")
    return "\"" + out + "\""
}

# {"key": value, ...} from pairs of key and JSON text:
# json_object(["name", json_string("Ada"), "age", "36"])
fn json_object(pairs: array[string]) -> string {
    parts: array[string] = []
    k = 0
    while k + 1 < len(pairs) {
        push(parts, json_string(pairs[k]) + ": " + pairs[k + 1])
        k += 2
    }
    return "{" + join(parts, ", ") + "}"
}

# [a, b, ...] from JSON texts
fn json_list(items: array[string]) -> string {
    return "[" + join(items, ", ") + "]"
}

# ---------- the server ----------
fn reason(code: int) -> string {
    if code == 200 {
        return "OK"
    }
    if code == 404 {
        return "Not Found"
    }
    if code < 300 {
        if code == 201 {
            return "Created"
        }
        if code == 204 {
            return "No Content"
        }
        if code == 101 {
            return "Switching Protocols"
        }
        return "OK"
    }
    if code < 400 {
        if code == 301 {
            return "Moved Permanently"
        }
        if code == 302 {
            return "Found"
        }
        if code == 303 {
            return "See Other"
        }
        if code == 304 {
            return "Not Modified"
        }
        return "Redirect"
    }
    if code < 500 {
        if code == 400 {
            return "Bad Request"
        }
        if code == 401 {
            return "Unauthorized"
        }
        if code == 403 {
            return "Forbidden"
        }
        if code == 405 {
            return "Method Not Allowed"
        }
        if code == 413 {
            return "Payload Too Large"
        }
        return "Error"
    }
    if code == 503 {
        return "Service Unavailable"
    }
    return "Internal Server Error"
}

# stops serve() from printing a line for every request
fn quiet() {
    __web_quiet = true
}

# answers visitors on this port with your handle(req) function, forever
fn serve(port: int) {
    serve_count(port, -1)
}

# like serve, but stops after count requests (handy for tests)
fn serve_count(port: int, count: int) {
    fd = socket_listen(port)
    if fd < 0 {
        eprint("web: cannot use port " + str(port) + " (is another program using it?)")
        exit(1)
    }
    if not __web_quiet {
        print("Serving on http://localhost:" + str(port) + "  (stop with Ctrl+C)")
    }
    s = _web_server(port, count)
    p = __poller_new()
    if p < 0 {
        _web_serve_tasks(fd, s)
    } else {
        _web_serve_events(fd, p, s)
    }
    socket_close(fd)
}

# each server's own state (kept for the whole run): +0 requests answered,
# +8 the limit (-1: none), +16 its port, +24 a lock, +32 its poller,
# +40 its table of connections, +48 the table's lock, +56 the connections
# answered by tasks (4096 places, each 0 or the socket + 1)
fn _web_server(port: int, count: int) -> int {
    # on a multiple of 8 bytes: the locks in it need that on ARM
    s = (__alloc_bytes_in(2, 72) + 7) & -8
    __memzero(s, 64)
    __store64(s + 8, count)
    __store64(s + 16, port)
    __store64(s + 32, -1)
    held = (__alloc_bytes_in(2, 4096 * 8 + 8) + 7) & -8
    __memzero(held, 4096 * 8)
    __store64(s + 56, held)
    return s
}

# notes that a task answers c (its place, or -1 when all are taken)
fn __web_hold(s: int, c: int) -> int {
    held = __load64(s + 56)
    at = -1
    __spin_lock(s + 48)
    for i in 0..4096 {
        if at < 0 and __load64(held + i * 8) == 0 {
            __store64(held + i * 8, c + 1)
            at = i
        }
    }
    __spin_unlock(s + 48)
    return at
}

# the task is about to close its connection
fn __web_let_go(s: int, at: int) {
    if at >= 0 {
        __spin_lock(s + 48)
        __store64(__load64(s + 56) + at * 8, 0)
        __spin_unlock(s + 48)
    }
}

# the server is done: connections kept open for more requests stop waiting
fn _web_wake_all(s: int) {
    held = __load64(s + 56)
    __spin_lock(s + 48)
    for i in 0..4096 {
        v = __load64(held + i * 8)
        if v != 0 {
            __socket_shutdown(v - 1)
        }
    }
    __spin_unlock(s + 48)
    _ws_wake(s)
}

fn __web_more(s: int) -> bool {
    limit = __load64(s + 8)
    return limit < 0 or __load64(s) < limit
}

# one task per connection, which answers its requests one after another
# (where there is no poller: Windows)
fn _web_serve_tasks(fd: int, s: int) {
    live: array[task[void]] = []
    while __web_more(s) {
        c = socket_accept(fd)
        if c >= 0 and not __web_more(s) {
            socket_close(c)
        } else if c >= 0 {
            # each visitor gets its own task, so slow ones don't hold up the rest
            push(live, async _web_answer(c, s, __web_hold(s, c)))
            if len(live) >= 64 {
                # finished tasks are collected now and then (each
                # collection makes a new list)
                live = _web_reap(live)
            }
        }
    }
    _web_wake_all(s)
    for t in live {
        await t
    }
}

# an event loop: a few worker threads (two per core) wait on one poller that
# watches every open connection. A worker takes a connection only when a
# request comes in, answers it, and gives it back. Idle connections (kept
# open between requests) cost no thread; ones idle for a minute are closed.
fn _web_serve_events(fd: int, p: int, s: int) {
    __store64(s + 32, p)
    # for each socket number: 0 not ours, 1 waiting, 2 being answered; then the time
    st = __os_alloc(65536 * 16)
    __store64(s + 40, st)
    _web_poll_watch(p, fd, true)
    workers = __cpu_count() * 2
    if workers < 8 {
        workers = 8
    }
    if workers > 64 {
        workers = 64
    }
    others: array[task[void]] = []
    for w in 1..workers {
        push(others, async _web_worker(fd, s, w))
    }
    _web_worker(fd, s, 0)
    for t in others {
        await t
    }
    # close what is still open
    for c in 0..65536 {
        if __load64(st + c * 16) != 0 {
            socket_close(c)
        }
    }
    socket_close(p)
    __os_release(st, 65536 * 16)
}

# the poller calls, as ordinary functions: the small buffer each one uses
# is freed when it returns (the loops that call them run for good)
fn _web_poll_wait(p: int, out: int, max: int, ms: int) -> int {
    return __poller_wait(p, out, max, ms)
}

fn _web_poll_watch(p: int, fd: int, once: bool) -> bool {
    return __poller_watch(p, fd, once)
}

# a new visitor on the listening socket fd: set up and watched by poller p
# (its own function, so what the setup allocates is freed at once)
fn _web_take_visitor(fd: int, p: int, st: int) {
    c = socket_accept(fd)
    # let the next visitor in (another worker may take it)
    __poller_watch(p, fd, true)
    if c >= 0 and c < 65536 {
        __socket_nodelay(c)
        # a request that starts must arrive within 10 seconds
        __socket_timeout(c, 10000)
        __store64(st + c * 16 + 8, clock_ns())
        __store64(st + c * 16, 1)
        __poller_watch(p, c, true)
    } else if c >= 0 {
        socket_close(c)
    }
}

fn _web_worker(fd: int, s: int, me: int) {
    p = __load64(s + 32)
    st = __load64(s + 40)
    ready = __alloc_bytes(8 * 16)
    last_sweep = clock_ns()
    sockets: array[task[void]] = []
    while __web_more(s) {
        n = _web_poll_wait(p, ready, 16, 100)
        for i in 0..n {
            f = __load64(ready + i * 8)
            if f == fd {
                _web_take_visitor(fd, p, st)
            } else if f >= 0 and f < 65536 {
                mine = false
                __spin_lock(s + 48)
                if __load64(st + f * 16) == 1 {
                    __store64(st + f * 16, 2)
                    mine = true
                }
                __spin_unlock(s + 48)
                if mine {
                    id = _web_conn(f, s)
                    if id >= 0 {
                        push(sockets, async _ws_run_plain(id, s))
                    }
                }
            }
        }
        # worker 0 closes connections idle for a minute
        now = clock_ns()
        if me == 0 and now - last_sweep > 1000000000 {
            last_sweep = now
            __spin_lock(s + 48)
            for c in 0..65536 {
                if __load64(st + c * 16) == 1 and now - __load64(st + c * 16 + 8) > 60000000000 {
                    __store64(st + c * 16, 0)
                    socket_close(c)
                }
            }
            __spin_unlock(s + 48)
        }
        if len(sockets) > 0 {
            sockets = _web_reap_done(sockets)
        }
    }
    # the server is done: end its WebSockets
    _ws_wake(s)
    for t in sockets {
        await t
    }
}

# the tasks still running (never waits)
fn _web_reap_done(live: array[task[void]]) -> array[task[void]] {
    keep: array[task[void]] = []
    for t in live {
        if done(t) {
            await t
        } else {
            push(keep, t)
        }
    }
    return keep
}

# answers the requests that came in on c, then gives it back to the event
# loop; or, when it became a WebSocket, its id (else -1)
fn _web_conn(c: int, s: int) -> int {
    st = __load64(s + 40)
    raw = ""
    while true {
        need = __web_need(raw)
        while need < 0 {
            piece = socket_read(c)
            if piece == "" or len(raw) > 16777216 {
                __store64(st + c * 16, 0)
                socket_close(c)
                return -1
            }
            raw = raw + piece
            need = __web_need(raw)
        }
        req = slice(raw, 0, need)
        raw = slice(raw, need, len(raw))
        keep = __web_keep(req)
        out = __web_reply(req, "http", keep)
        if out != "" {
            socket_write(c, out)
        }
        __web_count(s)
        if starts_with(out, "HTTP/1.1 101 ") {
            # the WebSocket's own task takes the connection from here
            id = _ws_take(__tls_new(c), false, s, _ws_path_of(req))
            __spin_lock(s + 48)
            __store64(st + c * 16, 0)
            __spin_unlock(s + 48)
            if id < 0 {
                socket_close(c)
            }
            return id
        }
        if not keep or out == "" {
            __store64(st + c * 16, 0)
            socket_close(c)
            return -1
        }
        if raw == "" {
            # nothing more for now: back to waiting
            __store64(st + c * 16 + 8, clock_ns())
            __store64(st + c * 16, 1)
            _web_poll_watch(__load64(s + 32), c, true)
            return -1
        }
    }
    return -1
}

fn __web_count(s: int) {
    __spin_lock(s + 24)
    __store64(s, __load64(s) + 1)
    last = __load64(s + 8) >= 0 and __load64(s) == __load64(s + 8)
    __spin_unlock(s + 24)
    if last {
        # the last request: wake the loop that may be waiting for a visitor
        w = socket_connect("127.0.0.1", __load64(s + 16))
        if w >= 0 {
            socket_close(w)
        }
    }
}

# the tasks still running (waits for the oldest when there are too many)
fn _web_reap(live: array[task[void]]) -> array[task[void]] {
    keep: array[task[void]] = []
    for t in live {
        if done(t) {
            await t
        } else {
            push(keep, t)
        }
    }
    if len(keep) >= 512 {
        await keep[0]
        rest: array[task[void]] = []
        for i in 1..len(keep) {
            push(rest, keep[i])
        }
        return rest
    }
    return keep
}

# the length of the first whole request in raw (head and body), or -1 if it
# has not all arrived yet
fn __web_need(raw: string) -> int {
    he = find(raw, "\r\n\r\n")
    if he < 0 {
        return -1
    }
    want = 0
    cl = __web_head_value(raw, he, "content-length")
    if cl != "" {
        want = to_int(cl)
    }
    if len(raw) - he - 4 < want {
        return -1
    }
    return he + 4 + want
}

# the value of the header `name` (given in lower case) in the head that
# ends at he, "" if there is none; reads the head where it is (no copies)
fn __web_head_value(head: string, he: int, name: string) -> string {
    low = lower(slice(head, 0, he))
    at = find(low, "\r\n" + name + ":")
    if at < 0 {
        return ""
    }
    start = at + 3 + len(name)
    rest = slice(low, start, len(low))
    e = find(rest, "\r\n")
    if e < 0 {
        e = len(rest)
    }
    # the value as written (not lowered)
    return trim(slice(head, start, start + e))
}

# does the visitor want the connection kept open after this request?
# (HTTP/1.1 does unless it says close; HTTP/1.0 only if it asks)
fn __web_keep(req: string) -> bool {
    he = find(req, "\r\n\r\n")
    if he < 0 {
        return false
    }
    fe = find(req, "\r\n")
    keep = fe >= 8 and slice(req, fe - 8, fe) == "HTTP/1.1"
    v = lower(__web_head_value(req, he, "connection"))
    if contains(v, "close") {
        keep = false
    }
    if contains(v, "keep-alive") {
        keep = true
    }
    return keep
}

# the answer (as bytes to send) for a whole raw request, from handle()
# handle() runs for one visitor at a time, so it can use globals freely;
# reading and sending (the slow parts) happen for many visitors at once
fn __web_reply(raw: string, scheme: string, keep: bool) -> string {
    __spin_lock(addr_of(__web_word))
    out = __web_reply_one(raw, scheme, keep)
    __spin_unlock(addr_of(__web_word))
    return out
}

fn __web_reply_one(raw: string, scheme: string, keep: bool) -> string {
    he = find(raw, "\r\n\r\n")
    if he < 0 {
        return ""
    }
    body = slice(raw, he + 4, len(raw))
    fe = find(raw, "\r\n")
    first = split(slice(raw, 0, fe), " ")
    if len(first) < 2 {
        return ""
    }
    # the header lines, one per line (as handle() sees them)
    headers = ""
    if fe < he {
        headers = replace(slice(raw, fe + 2, he), "\r\n", "\n") + "\n"
    }
    target = first[1]
    q = find(target, "?")
    path = target
    qs = ""
    if q >= 0 {
        path = slice(target, 0, q)
        qs = slice(target, q + 1, len(target))
    }
    req = Request(first[0], url_decode(path), qs, headers, body)
    if __web_params != 0 {
        __rb_clear(__web_params)
    }
    resp = handle(req)
    if resp.status == 101 {
        # a WebSocket: the connection changes to messages after this
        if not __web_quiet {
            print(req.method + " " + req.path + " 101")
        }
        return "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" + resp.headers + "\r\n"
    }
    extra = ""
    if scheme == "https" {
        # browsers remember to use https for this site
        extra = "Strict-Transport-Security: max-age=31536000\r\n"
    }
    conn = "close"
    if keep {
        conn = "keep-alive"
    }
    # one join: each + would copy everything before it again
    body_out = resp.body
    if req.method == "HEAD" {
        body_out = ""
    }
    out = join(["HTTP/1.1 ", str(resp.status), " ", reason(resp.status), "\r\nContent-Type: ", resp.content_type, "\r\nContent-Length: ", str(len(resp.body)), "\r\nConnection: ", conn, "\r\n", extra, resp.headers, "\r\n", body_out], "")
    if not __web_quiet {
        print(req.method + " " + req.path + " " + str(resp.status))
    }
    return out
}

# answers the requests on one connection until the visitor is done (or
# idle for 30 seconds), then closes it
fn _web_answer(c: int, s: int, at: int) {
    __socket_nodelay(c)
    __socket_timeout(c, 30000)
    raw = ""
    # requests come in batches (_web_answer_batch), so the memory each batch
    # uses is freed when it ends, however long the connection stays open
    while true {
        r = _web_answer_batch(c, s, at, raw)
        if starts_with(r, "\x01") {
            return
        }
        raw = slice(r, 1, len(r))
    }
}

# answers up to 64 requests on c: "\x00" and what came in beyond them, or
# "\x01" once the connection is closed (or became a WebSocket)
fn _web_answer_batch(c: int, s: int, at: int, raw0: string) -> string {
    raw = raw0
    for n in 0..64 {
        if not __web_more(s) {
            __web_let_go(s, at)
            socket_close(c)
            return "\x01"
        }
        need = __web_need(raw)
        while need < 0 {
            if raw == "" and not _web_wait(c, s) {
                __web_let_go(s, at)
                socket_close(c)
                return "\x01"
            }
            piece = socket_read(c)
            if piece == "" or len(raw) > 16777216 {
                __web_let_go(s, at)
                socket_close(c)
                return "\x01"
            }
            raw = raw + piece
            need = __web_need(raw)
        }
        req = slice(raw, 0, need)
        raw = slice(raw, need, len(raw))
        keep = __web_keep(req)
        out = __web_reply(req, "http", keep)
        if out != "" {
            socket_write(c, out)
        }
        __web_count(s)
        if starts_with(out, "HTTP/1.1 101 ") {
            t = __tls_new(c)
            id = _ws_take(t, false, s, _ws_path_of(req))
            __web_let_go(s, at)
            if id >= 0 {
                _ws_run(t, false, id, s)
            } else {
                socket_close(c)
            }
            return "\x01"
        }
        if not keep or out == "" {
            __web_let_go(s, at)
            socket_close(c)
            return "\x01"
        }
    }
    return "\x00" + raw
}

# waits for the next request on c, a quarter second at a time: false if
# the server is done or nothing came for 30 seconds (on every system,
# without needing another thread to wake the wait)
fn _web_wait(c: int, s: int) -> bool {
    waited = 0
    while waited < 30000 {
        if __socket_ready(c, 250) {
            return true
        }
        if not __web_more(s) {
            return false
        }
        waited += 250
    }
    return false
}

# the same over TLS
fn _web_answer_tls(c: int, key: TlsKey, s: int, at: int) {
    __socket_nodelay(c)
    __socket_timeout(c, 30000)
    t = tls_accept_alpn(c, key, __web_h2)
    if not t.ok {
        if not __web_quiet and t.err != "the connection closed" {
            print("https handshake failed: " + t.err)
        }
        __web_let_go(s, at)
        socket_close(c)
        # a failed handshake counts as one visit (for serve_https_count)
        __web_count(s)
        return
    }
    if t.alpn == "h2" {
        _web_h2_serve(t, c, s, at)
        return
    }
    t.h2buf = ""
    while true {
        t = _web_answer_tls_batch(t, c, s, at)
        if t.data == "done" {
            return
        }
    }
}

# up to 64 requests over TLS (what came in beyond them waits in t.h2buf);
# t.data is "done" once the connection is closed (or became a WebSocket)
fn _web_answer_tls_batch(t0: Tls, c: int, s: int, at: int) -> Tls {
    t = t0
    raw = t.h2buf
    for n in 0..64 {
        if not __web_more(s) {
            __web_let_go(s, at)
            tls_close(t)
            t.data = "done"
            return t
        }
        need = __web_need(raw)
        while need < 0 {
            if raw == "" and t.raw == "" and not _web_wait(c, s) {
                __web_let_go(s, at)
                tls_close(t)
                t.data = "done"
                return t
            }
            t = tls_recv(t)
            if t.data == "" or len(raw) > 16777216 {
                __web_let_go(s, at)
                tls_close(t)
                t.data = "done"
                return t
            }
            raw = raw + t.data
            need = __web_need(raw)
        }
        req = slice(raw, 0, need)
        raw = slice(raw, need, len(raw))
        keep = __web_keep(req)
        out = __web_reply(req, "https", keep)
        if out != "" {
            t = tls_send(t, out)
        }
        __web_count(s)
        if starts_with(out, "HTTP/1.1 101 ") {
            id = _ws_take(t, true, s, _ws_path_of(req))
            __web_let_go(s, at)
            if id >= 0 {
                _ws_run(t, true, id, s)
            } else {
                tls_close(t)
            }
            t.data = "done"
            return t
        }
        if not keep or out == "" {
            __web_let_go(s, at)
            tls_close(t)
            t.data = "done"
            return t
        }
    }
    t.h2buf = raw
    t.data = ""
    return t
}

# answers visitors over https on this port, forever; cert_file holds the
# certificate (and any chain), key_file its private key (RSA, or ECDSA P-256 or P-384)
fn serve_https(port: int, cert_file: string, key_file: string) {
    serve_https_count(port, cert_file, key_file, -1)
}

fn serve_https_count(port: int, cert_file: string, key_file: string, count: int) {
    key = tls_load_key(cert_file, key_file)
    if not key.ok {
        eprint("web: cannot use " + cert_file + " and " + key_file + " (they should be PEM files: a certificate, and an RSA or ECDSA P-256/P-384 key; make_cert() makes a test pair)")
        exit(1)
    }
    fd = socket_listen(port)
    if fd < 0 {
        eprint("web: cannot use port " + str(port) + " (is another program using it?)")
        exit(1)
    }
    if not __web_quiet {
        print("Serving on https://localhost:" + str(port) + "  (stop with Ctrl+C)")
    }
    s = _web_server(port, count)
    live: array[task[void]] = []
    while __web_more(s) {
        c = socket_accept(fd)
        if c >= 0 {
            if not __web_more(s) {
                socket_close(c)
            } else {
                push(live, async _web_answer_tls(c, key, s, __web_hold(s, c)))
                if len(live) >= 64 {
                    # finished tasks are collected now and then (each
                    # collection makes a new list)
                    live = _web_reap(live)
                }
            }
        }
    }
    # no more visitors: stop taking them, and end the connections kept open
    socket_close(fd)
    _web_wake_all(s)
    for t in live {
        await t
    }
}

# makes a self-signed certificate and key for trying https on your computer
# (browsers will warn; http_get accepts it after trust_cert(cert_file))
fn make_cert(host: string, cert_file: string, key_file: string) {
    tls_make_cert(host, cert_file, key_file)
}

# trusts one more certificate for https (for example your own self-signed one)
fn trust_cert(cert_file: string) {
    tls_trust(cert_file)
    _web_pool_clear()
}

# ---------- asking other servers ----------
# http_get("https://example.com/") gives the page's text; http_status() then
# gives its status code (0 if it failed, with the reason in http_error()).
fn http_get(url: string) -> string {
    return http_request("GET", url, "")
}

fn http_post(url: string, form_data: string) -> string {
    return http_request("POST", url, form_data)
}

fn http_status() -> int {
    return __web_status
}

# the HTTP version the last http_get / http_post used: "2" or "1.1"
fn http_version() -> string {
    return __web_version
}

fn http_error() -> string {
    return __web_error
}

# for testing: the newest TLS version to offer (12 or 13) and AES only
fn https_client_options(max_version: int, aes_only: bool) {
    tls_client_options(max_version, aes_only)
    _web_pool_clear()
}

# for testing only: accept any https certificate
fn https_insecure() {
    __web_insecure = true
    _web_pool_clear()
}

# a kept connection to key ("https://host:port"), or one with ok false
fn _web_pool_take(key: string) -> Tls {
    __spin_lock(addr_of(__web_pool_word))
    let found = -1
    for i in 0..len(_web_pool_keys) {
        if _web_pool_keys[i] == key {
            found = i
        }
    }
    let t = __tls_new(-1)
    t.ok = false
    if found >= 0 {
        t = _web_pool_conns[found]
        let keys: array[string] = []
        let conns: array[Tls] = []
        for i in 0..len(_web_pool_keys) {
            if i != found {
                push(keys, _web_pool_keys[i])
                push(conns, _web_pool_conns[i])
            }
        }
        _web_pool_keys = keys
        _web_pool_conns = conns
    }
    __spin_unlock(addr_of(__web_pool_word))
    return t
}

# keeps a connection for later (at most 16; the oldest goes)
fn _web_pool_put(key: string, t: Tls) {
    __spin_lock(addr_of(__web_pool_word))
    if len(_web_pool_keys) >= 16 {
        tls_close(_web_pool_conns[0])
        let keys: array[string] = []
        let conns: array[Tls] = []
        for i in 1..len(_web_pool_keys) {
            push(keys, _web_pool_keys[i])
            push(conns, _web_pool_conns[i])
        }
        _web_pool_keys = keys
        _web_pool_conns = conns
    }
    push(_web_pool_keys, key)
    push(_web_pool_conns, t)
    __spin_unlock(addr_of(__web_pool_word))
}

fn _web_pool_clear() {
    __spin_lock(addr_of(__web_pool_word))
    for t in _web_pool_conns {
        tls_close(t)
    }
    let keys: array[string] = []
    let conns: array[Tls] = []
    _web_pool_keys = keys
    _web_pool_conns = conns
    __spin_unlock(addr_of(__web_pool_word))
}

fn __web_fail(why: string) -> string {
    __web_status = 0
    __web_error = why
    return ""
}

# the next piece from a connection (TLS or plain) into t.data; "" when closed
fn _web_recv(t: Tls, secure: bool) -> Tls {
    if secure {
        return tls_recv(t)
    }
    t.data = socket_read(t.fd)
    return t
}

# the host in "host:port", "host", "[::1]:8080" or "[::1]" (an IPv6 address
# is written in brackets in web addresses)
fn _web_host(hostport: string) -> string {
    if starts_with(hostport, "[") {
        end = find(hostport, "]")
        if end > 0 {
            return slice(hostport, 1, end)
        }
    }
    colon = find(hostport, ":")
    if colon >= 0 {
        return slice(hostport, 0, colon)
    }
    return hostport
}

# the port in the same (the default if there is none)
fn _web_port(hostport: string, fallback: int) -> int {
    rest = hostport
    if starts_with(hostport, "[") {
        end = find(hostport, "]")
        if end < 0 {
            return fallback
        }
        rest = slice(hostport, end + 1, len(hostport))
    }
    colon = find(rest, ":")
    if colon >= 0 {
        return to_int(slice(rest, colon + 1, len(rest)))
    }
    return fallback
}

# a new connection to host:port (TLS for https), or one with ok false
fn _web_open(host: string, port: int, secure: bool) -> Tls {
    return _web_open_alpn(host, port, secure, false)
}

# the same; with h2, an https server may pick HTTP/2 (then t.alpn is "h2")
fn _web_open_alpn(host: string, port: int, secure: bool, h2: bool) -> Tls {
    let t = __tls_new(-1)
    t.ok = false
    let ip = host
    if host == "localhost" {
        ip = "127.0.0.1"
    }
    if not __is_ip(ip) {
        ip = __resolve(host)
        if ip == "" {
            t.err = "cannot find the address of " + host
            return t
        }
    }
    let fd = socket_connect(ip, port)
    if fd < 0 {
        t.err = "cannot connect to " + host + ":" + str(port)
        return t
    }
    __socket_nodelay(fd)
    # a server that stops answering gives up after a minute
    __socket_timeout(fd, 60000)
    if secure {
        protos: array[string] = ["http/1.1"]
        if h2 {
            protos = ["h2", "http/1.1"]
        }
        t = tls_connect_alpn(fd, host, __web_insecure, protos)
        if not t.ok {
            socket_close(fd)
            t.err = "https: " + t.err
        }
        return t
    }
    t = __tls_new(fd)
    return t
}

# is the whole answer here? -1: not yet, else its length (head and body);
# -2: its end is when the server closes (no length given)
fn _web_answer_end(raw: string, method: string) -> int {
    let he = find(raw, "\r\n\r\n")
    if he < 0 {
        return -1
    }
    let lines = split(slice(raw, 0, he), "\r\n")
    let parts = split(lines[0], " ")
    let status = 0
    if len(parts) > 1 {
        status = to_int(parts[1])
    }
    if method == "HEAD" or status == 204 or status == 304 or (status >= 100 and status < 200) {
        return he + 4
    }
    let length = -1
    let chunked = false
    for line in lines {
        let c = find(line, ":")
        if c > 0 {
            let name = lower(trim(slice(line, 0, c)))
            if name == "content-length" {
                length = to_int(trim(slice(line, c + 1, len(line))))
            }
            if name == "transfer-encoding" and contains(lower(line), "chunked") {
                chunked = true
            }
        }
    }
    if chunked {
        let body = slice(raw, he + 4, len(raw))
        if starts_with(body, "0\r\n\r\n") {
            return he + 9
        }
        let e = find(body, "\r\n0\r\n\r\n")
        if e < 0 {
            return -1
        }
        return he + 4 + e + 7
    }
    if length >= 0 {
        if len(raw) - he - 4 < length {
            return -1
        }
        return he + 4 + length
    }
    return -2
}

# may the connection be used again after this answer?
fn _web_reusable(head: string) -> bool {
    let lines = split(head, "\r\n")
    let keep = contains(lines[0], "HTTP/1.1")
    for line in lines {
        let c = find(line, ":")
        if c > 0 and lower(trim(slice(line, 0, c))) == "connection" {
            let v = lower(line)
            if contains(v, "close") {
                keep = false
            }
            if contains(v, "keep-alive") {
                keep = true
            }
        }
    }
    return keep
}

# asks a server; connections are kept and used again for the next request to
# the same server (so https skips its handshake), unless the server says no
fn http_request(method: string, url: string, body: string) -> string {
    __web_status = 0
    __web_error = ""
    __web_version = ""
    let secure = starts_with(url, "https://")
    if not secure and not starts_with(url, "http://") {
        return __web_fail("the address should start with http:// or https://")
    }
    let rest = slice(url, 7, len(url))
    let port = 80
    if secure {
        rest = slice(url, 8, len(url))
        port = 443
    }
    let slash = find(rest, "/")
    let hostport = rest
    let path = "/"
    if slash >= 0 {
        hostport = slice(rest, 0, slash)
        path = slice(rest, slash, len(rest))
    }
    let host = _web_host(hostport)
    port = _web_port(hostport, port)
    let key = "http://"
    if secure {
        key = "https://"
    }
    key = key + lower(host) + ":" + str(port)
    let msg = method + " " + path + " HTTP/1.1\r\nHost: " + hostport + "\r\nConnection: keep-alive\r\nUser-Agent: slop\r\nAccept: */*\r\n"
    if body != "" or method == "POST" {
        msg = msg + "Content-Type: application/x-www-form-urlencoded\r\nContent-Length: " + str(len(body)) + "\r\n"
    }
    msg = msg + "\r\n" + body
    let raw = ""
    let t = __tls_new(-1)
    let end = -1
    # a kept connection first; if the server had closed it, a new one
    for attempt in 0..2 {
        let reused = false
        if attempt == 0 {
            t = _web_pool_take(key)
            reused = t.ok
        }
        if not reused {
            t = _web_open_alpn(host, port, secure, __web_h2)
            if not t.ok {
                return __web_fail(t.err)
            }
        }
        __web_version = "1.1"
        if t.alpn == "h2" {
            __web_version = "2"
            # HTTP/2: the answer comes back written the HTTP/1.1 way
            t = _web_h2_fetch(t, method, path, hostport, body)
            raw = t.data
            end = len(raw)
            if raw != "" or not reused {
                break
            }
            tls_close(t)
            continue
        }
        if secure {
            t = tls_send(t, msg)
        } else {
            socket_write(t.fd, msg)
        }
        raw = ""
        end = _web_answer_end(raw, method)
        while end < 0 and t.ok {
            t = _web_recv(t, secure)
            if t.data == "" {
                break
            }
            raw = raw + t.data
            end = _web_answer_end(raw, method)
        }
        if raw != "" or not reused {
            break
        }
        # a kept connection the server had closed: try once more, fresh
        tls_close(t)
    }
    let he = find(raw, "\r\n\r\n")
    if he < 0 {
        tls_close(t)
        return __web_fail("no answer from " + host)
    }
    let head = slice(raw, 0, he)
    if end >= 0 and len(raw) == end and t.ok and t.h2 >= 0 and _web_reusable(head) {
        _web_pool_put(key, t)
    } else {
        tls_close(t)
    }
    let out = slice(raw, he + 4, len(raw))
    if end >= 0 {
        out = slice(raw, he + 4, end)
    }
    let lines = split(head, "\r\n")
    let parts = split(lines[0], " ")
    if len(parts) > 1 {
        __web_status = to_int(parts[1])
    }
    for line in lines {
        let c = find(line, ":")
        if c > 0 and lower(trim(slice(line, 0, c))) == "transfer-encoding" and contains(lower(line), "chunked") {
            out = __web_unchunk(out)
        }
    }
    return out
}

# "Transfer-Encoding: chunked" bodies: size lines in hex, then the pieces
fn __web_unchunk(s: string) -> string {
    out = ""
    i = 0
    while i < len(s) {
        e = find(slice(s, i, len(s)), "\r\n")
        if e < 0 {
            break
        }
        line = slice(s, i, i + e)
        semi = find(line, ";")
        if semi >= 0 {
            line = slice(line, 0, semi)
        }
        n = 0
        for k in 0..len(trim(line)) {
            n = n * 16 + __web_hex(byte_at(trim(line), k))
        }
        if n <= 0 {
            break
        }
        i = i + e + 2
        out = out + slice(s, i, i + n)
        i = i + n + 2
    }
    return out
}

# ---------- WebSockets ----------
# A connection that stays open: both sides send messages whenever they like.
#   server: in handle(), return websocket(req) for the address; then your
#           on_websocket(ws) runs for each visitor that connects:
#             fn on_websocket(ws: WebSocket) {
#                 ws = ws_receive(ws)
#                 while ws.ok {
#                     ws_send(ws, "you said " + ws.message)
#                     ws = ws_receive(ws)
#                 }
#             }
#   client: ws = ws_connect("ws://localhost:8080/chat")   (wss:// for TLS)
struct WebSocket {
    ok: bool,
    id: int,
    path: string,
    message: string,
    binary: bool,
    err: string,
    conn: Tls,
    secure: bool,
    buf: string,
    frag: string,
    fragging: bool,
    fragbin: bool
}

# runs for each WebSocket a visitor opens (write your own to use them)
fn on_websocket(ws: WebSocket) {
}

# the open connections, so any task can send on any of them. Each place
# (160 bytes): +0 socket + 1 (0: free), +8 a lock, +16 the TLS sequence
# number, +24 TLS version, +32 AES, +40 TLS, +48 the server it belongs to
# (0: a client), +56 its number (id / 4096), +64 key length, +72 iv length,
# +80 the path (for the server), +96 key (32 bytes), +128 iv (12 bytes),
# +144 1 once its server is done
__ws_slots = 0
__ws_word = 0
__ws_gen = 0
__ws_guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

fn _ws_place(id: int) -> int {
    if id < 0 or __ws_slots == 0 {
        return 0
    }
    return __ws_slots + id % 4096 * 160
}

# a place for a new connection: its id, or -1 when all 4096 are taken
fn _ws_take(t: Tls, secure: bool, owner: int, path: string) -> int {
    __spin_lock(addr_of(__ws_word))
    if __ws_slots == 0 {
        __ws_slots = __os_alloc(4096 * 160)
        __memzero(__ws_slots, 4096 * 160)
    }
    at = -1
    i = 0
    while at < 0 and i < 4096 {
        if __load64(__ws_slots + i * 160) == 0 {
            at = i
        }
        i += 1
    }
    gen = 0
    if at >= 0 {
        __ws_gen += 1
        gen = __ws_gen
        p = __ws_slots + at * 160
        __store64(p, t.fd + 1)
        __store64(p + 8, 0)
        __store64(p + 16, t.wseq)
        __store64(p + 24, t.ver)
        __store64(p + 32, 0)
        if t.aes {
            __store64(p + 32, 1)
        }
        __store64(p + 40, 0)
        if secure {
            __store64(p + 40, 1)
        }
        __store64(p + 48, owner)
        __store64(p + 56, gen)
        __store64(p + 144, 0)
        __store64(p + 64, len(t.wkey))
        __store64(p + 72, len(t.wiv))
        for k in 0..len(t.wkey) {
            __store8(p + 96 + k, t.wkey[k])
        }
        for k in 0..len(t.wiv) {
            __store8(p + 128 + k, t.wiv[k])
        }
        __store64(p + 80, 0)
        if owner != 0 {
            buf = __os_alloc(len(path) + 8)
            __store64(buf, len(path))
            __memcpy(buf + 8, __str_ptr(path), len(path))
            __store64(p + 80, buf)
        }
    }
    __spin_unlock(addr_of(__ws_word))
    if at < 0 {
        return -1
    }
    return gen * 4096 + at
}

# one frame: FIN, the kind, the length, and (from clients) a mask
fn _ws_frame(op: int, data: string, masked: bool) -> string {
    n = len(data)
    m = 0
    if masked {
        m = 128
    }
    head = chr(128 | op)
    if n < 126 {
        head = head + chr(m | n)
    } else if n < 65536 {
        head = head + chr(m | 126) + chr((n >> 8) & 255) + chr(n & 255)
    } else {
        head = head + chr(m | 127)
        for i in 0..8 {
            head = head + chr((n >> ((7 - i) * 8)) & 255)
        }
    }
    if not masked {
        return head + data
    }
    r = __random_text(4)
    key = byte_at(r, 0) | (byte_at(r, 1) << 8) | (byte_at(r, 2) << 16) | (byte_at(r, 3) << 24)
    return head + r + _ws_mask(data, key)
}

# data XOR the 4-byte mask (byte i uses mask byte i % 4)
fn _ws_mask(s: string, key: int) -> string {
    n = len(s)
    p = __alloc_bytes(n + 8)
    src = __str_ptr(s)
    i = 0
    while i < n {
        __store8(p + i, __load8(src + i) ^ ((key >> ((i & 3) * 8)) & 255))
        i += 1
    }
    return __str(p, n)
}

# sends one frame on connection id (from any task); false if it is closed
fn _ws_write(id: int, op: int, data: string) -> bool {
    p = _ws_place(id)
    if p == 0 {
        return false
    }
    __spin_lock(p + 8)
    if __load64(p) == 0 or __load64(p + 56) != id / 4096 {
        __spin_unlock(p + 8)
        return false
    }
    frame = _ws_frame(op, data, __load64(p + 48) == 0)
    fd = __load64(p) - 1
    if __load64(p + 40) != 0 {
        t = __tls_new(fd)
        t.ver = __load64(p + 24)
        t.aes = __load64(p + 32) != 0
        t.wseq = __load64(p + 16)
        key: array[int] = []
        for k in 0..__load64(p + 64) {
            push(key, __load8(p + 96 + k))
        }
        iv: array[int] = []
        for k in 0..__load64(p + 72) {
            push(iv, __load8(p + 128 + k))
        }
        t.wkey = key
        t.wiv = iv
        t.wenc = true
        t = __tls_write(t, 23, frame)
        __store64(p + 16, t.wseq)
    } else {
        socket_write(fd, frame)
    }
    __spin_unlock(p + 8)
    return true
}

# closes connection id's socket and frees its place
fn _ws_release(id: int) {
    p = _ws_place(id)
    if p == 0 {
        return
    }
    __spin_lock(p + 8)
    if __load64(p) == 0 or __load64(p + 56) != id / 4096 {
        __spin_unlock(p + 8)
        return
    }
    fd = __load64(p) - 1
    __store64(p, 0)
    if __load64(p + 80) != 0 {
        buf = __load64(p + 80)
        __os_release(buf, __load64(buf) + 8)
        __store64(p + 80, 0)
    }
    __spin_unlock(p + 8)
    socket_close(fd)
}

# the server s is done: its WebSockets stop waiting
fn _ws_wake(s: int) {
    if __ws_slots == 0 {
        return
    }
    for i in 0..4096 {
        p = __ws_slots + i * 160
        if __load64(p) != 0 and __load64(p + 48) == s {
            __spin_lock(p + 8)
            if __load64(p) != 0 and __load64(p + 48) == s {
                # +144: the server is done (its reads see this within a
                # quarter second, on every system)
                __store64(p + 144, 1)
                __socket_shutdown(__load64(p) - 1)
            }
            __spin_unlock(p + 8)
        }
    }
}

# answers an address with a WebSocket: return websocket(req) from handle(),
# and on_websocket(ws) then runs for the connection
fn websocket(req: Request) -> Response {
    key = header(req, "Sec-WebSocket-Key")
    if key == "" or not contains(lower(header(req, "Upgrade")), "websocket") {
        return bad_request("this address is for WebSockets")
    }
    accept = base64_encode(sha1(to_bytes(key + __ws_guid)))
    return Response(101, "", "Sec-WebSocket-Accept: " + accept + "\r\n", "")
}

# the path in a raw request ("GET /chat?x=1 HTTP/1.1" -> "/chat?x=1")
fn _ws_path_of(raw: string) -> string {
    first = split(slice(raw, 0, find(raw, "\r\n")), " ")
    if len(first) < 2 {
        return "/"
    }
    return first[1]
}

# runs on_websocket for a connection the server accepted
fn _ws_run(t: Tls, secure: bool, id: int, s: int) {
    p = _ws_place(id)
    path = "/"
    if p != 0 and __load64(p + 80) != 0 {
        buf = __load64(p + 80)
        path = __str(buf + 8, __load64(buf))
    }
    __socket_timeout(t.fd, 0)
    ws = WebSocket(true, id, path, "", false, "", t, secure, "", "", false, false)
    if __web_more(s) {
        on_websocket(ws)
    }
    _ws_release(id)
}

# the same, from the event loop (which hands over only numbers)
fn _ws_run_plain(id: int, s: int) {
    p = _ws_place(id)
    _ws_run(__tls_new(__load64(p) - 1), false, id, s)
}

# reads more from the connection into ws.buf
fn _ws_more(ws: WebSocket) -> WebSocket {
    piece = ""
    p = _ws_place(ws.id)
    if p != 0 and __load64(p + 48) != 0 and ws.conn.raw == "" {
        # a server's connection: wait a quarter second at a time, so a
        # server that is done can end it
        while not __socket_ready(ws.conn.fd, 250) {
            if __load64(p + 144) != 0 or __load64(p + 56) != ws.id / 4096 {
                ws.ok = false
                ws.err = "the server stopped"
                _ws_release(ws.id)
                return ws
            }
        }
    }
    if ws.secure {
        ws.conn = tls_recv(ws.conn)
        piece = ws.conn.data
    } else {
        piece = socket_read(ws.conn.fd)
    }
    if piece == "" {
        ws.ok = false
        if ws.err == "" {
            ws.err = "the connection closed"
        }
        _ws_release(ws.id)
        return ws
    }
    ws.buf = ws.buf + piece
    return ws
}

# the length of the first whole frame in b, -1 if it has not all arrived,
# -2 if it is too big (over 16 MB)
fn _ws_need(b: string) -> int {
    if len(b) < 2 {
        return -1
    }
    n = byte_at(b, 1) & 127
    h = 2
    if n == 126 {
        if len(b) < 4 {
            return -1
        }
        n = (byte_at(b, 2) << 8) | byte_at(b, 3)
        h = 4
    } else if n == 127 {
        if len(b) < 10 {
            return -1
        }
        n = 0
        for i in 2..10 {
            n = (n << 8) | byte_at(b, i)
        }
        h = 10
    }
    if (byte_at(b, 1) & 128) != 0 {
        h += 4
    }
    if n < 0 or n > 16777216 {
        return -2
    }
    if len(b) < h + n {
        return -1
    }
    return h + n
}

# the data in one whole frame (unmasked)
fn _ws_payload(f: string) -> string {
    n = byte_at(f, 1) & 127
    h = 2
    if n == 126 {
        h = 4
    } else if n == 127 {
        h = 10
    }
    if (byte_at(f, 1) & 128) == 0 {
        return slice(f, h, len(f))
    }
    key = byte_at(f, h) | (byte_at(f, h + 1) << 8) | (byte_at(f, h + 2) << 16) | (byte_at(f, h + 3) << 24)
    return _ws_mask(slice(f, h + 4, len(f)), key)
}

# waits for the next message: ws.message (ws.binary if it was bytes);
# ws.ok is false once the connection has closed
fn ws_receive(ws: WebSocket) -> WebSocket {
    ws.message = ""
    ws.binary = false
    while ws.ok {
        need = _ws_need(ws.buf)
        if need == -2 or len(ws.frag) > 16777216 {
            _ws_write(ws.id, 8, "\x03\xf1")
            _ws_release(ws.id)
            ws.ok = false
            ws.err = "a message was too big"
            return ws
        }
        if need < 0 {
            ws = _ws_more(ws)
            continue
        }
        f = slice(ws.buf, 0, need)
        ws.buf = slice(ws.buf, need, len(ws.buf))
        op = byte_at(f, 0) & 15
        fin = (byte_at(f, 0) & 128) != 0
        data = _ws_payload(f)
        if op == 9 {
            # a ping: answer it
            _ws_write(ws.id, 10, data)
        } else if op == 10 {
            # a pong: nothing to do
        } else if op == 8 {
            # the other side is done: answer, then close
            code = "\x03\xe8"
            if len(data) >= 2 {
                code = slice(data, 0, 2)
            }
            _ws_write(ws.id, 8, code)
            _ws_release(ws.id)
            ws.ok = false
            return ws
        } else if op == 0 and ws.fragging {
            ws.frag = ws.frag + data
            if fin {
                ws.message = ws.frag
                ws.binary = ws.fragbin
                ws.frag = ""
                ws.fragging = false
                return ws
            }
        } else if op == 1 or op == 2 {
            if fin {
                ws.message = data
                ws.binary = op == 2
                return ws
            }
            ws.frag = data
            ws.fragging = true
            ws.fragbin = op == 2
        } else {
            _ws_write(ws.id, 8, "\x03\xea")
            _ws_release(ws.id)
            ws.ok = false
            ws.err = "the other side broke the WebSocket rules"
            return ws
        }
    }
    return ws
}

# sends a text message (false if the connection is closed)
fn ws_send(ws: WebSocket, text: string) -> bool {
    return _ws_write(ws.id, 1, text)
}

# sends bytes as a binary message
fn ws_send_binary(ws: WebSocket, data: string) -> bool {
    return _ws_write(ws.id, 2, data)
}

# sends a text message to the connection with this id (ws.id), from anywhere
fn ws_send_to(id: int, text: string) -> bool {
    return _ws_write(id, 1, text)
}

# sends a text message to every WebSocket visitor; how many got it
fn ws_broadcast(text: string) -> int {
    if __ws_slots == 0 {
        return 0
    }
    sent = 0
    for i in 0..4096 {
        p = __ws_slots + i * 160
        if __load64(p) != 0 and __load64(p + 48) != 0 {
            if _ws_write(__load64(p + 56) * 4096 + i, 1, text) {
                sent += 1
            }
        }
    }
    return sent
}

# how many WebSocket visitors are connected
fn ws_count() -> int {
    if __ws_slots == 0 {
        return 0
    }
    n = 0
    for i in 0..4096 {
        p = __ws_slots + i * 160
        if __load64(p) != 0 and __load64(p + 48) != 0 {
            n += 1
        }
    }
    return n
}

# closes the connection (telling the other side)
fn ws_close(ws: WebSocket) {
    _ws_write(ws.id, 8, "\x03\xe8")
    _ws_release(ws.id)
}

# opens a WebSocket to a server: ws://host:port/path, or wss:// (TLS);
# ws.ok is false (and ws.err says why) if it could not
fn ws_connect(url: string) -> WebSocket {
    e = __tls_new(-1)
    ws = WebSocket(false, -1, "", "", false, "", e, false, "", "", false, false)
    secure = starts_with(url, "wss://")
    rest = ""
    port = 80
    if secure {
        rest = slice(url, 6, len(url))
        port = 443
    } else if starts_with(url, "ws://") {
        rest = slice(url, 5, len(url))
    } else {
        ws.err = "the address should start with ws:// or wss://"
        return ws
    }
    slash = find(rest, "/")
    hostport = rest
    path = "/"
    if slash >= 0 {
        hostport = slice(rest, 0, slash)
        path = slice(rest, slash, len(rest))
    }
    host = _web_host(hostport)
    port = _web_port(hostport, port)
    t = _web_open(host, port, secure)
    if not t.ok {
        ws.err = t.err
        return ws
    }
    key = base64_encode(random_bytes(16))
    msg = "GET " + path + " HTTP/1.1\r\nHost: " + hostport + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\nUser-Agent: slop\r\n\r\n"
    if secure {
        t = tls_send(t, msg)
    } else {
        socket_write(t.fd, msg)
    }
    raw = ""
    while find(raw, "\r\n\r\n") < 0 {
        t = _web_recv(t, secure)
        if t.data == "" or len(raw) > 65536 {
            socket_close(t.fd)
            ws.err = "the server closed the connection"
            return ws
        }
        raw = raw + t.data
    }
    he = find(raw, "\r\n\r\n")
    lines = split(slice(raw, 0, he), "\r\n")
    if not starts_with(lines[0], "HTTP/1.1 101") {
        socket_close(t.fd)
        ws.err = "the server did not take the WebSocket (" + lines[0] + ")"
        return ws
    }
    want = base64_encode(sha1(to_bytes(key + __ws_guid)))
    got = ""
    for i in 1..len(lines) {
        c = find(lines[i], ":")
        if c > 0 and lower(trim(slice(lines[i], 0, c))) == "sec-websocket-accept" {
            got = trim(slice(lines[i], c + 1, len(lines[i])))
        }
    }
    if got != want {
        socket_close(t.fd)
        ws.err = "the server's WebSocket answer was wrong"
        return ws
    }
    # messages may come at any time: no time limit
    __socket_timeout(t.fd, 0)
    id = _ws_take(t, secure, 0, "")
    if id < 0 {
        socket_close(t.fd)
        ws.err = "too many WebSockets open"
        return ws
    }
    ws.ok = true
    ws.id = id
    ws.path = path
    ws.conn = t
    ws.secure = secure
    ws.buf = slice(raw, he + 4, len(raw))
    return ws
}

# ---------- HTTP/2 (over https) ----------
# turns HTTP/2 on or off (on by default) for serve_https and for http_get
# and http_post to https sites
fn use_http2(on: bool) {
    __web_h2 = on
    _web_pool_clear()
}

# a header block as HEADERS and CONTINUATION frames
fn _web_h2_headers(stream: int, block: string, end_stream: bool, max: int) -> string {
    flags = 0
    if end_stream {
        flags = 1
    }
    if len(block) <= max {
        return h2_frame(1, flags | 4, stream, block)
    }
    out = h2_frame(1, flags, stream, slice(block, 0, max))
    at = max
    while at < len(block) {
        e = at + max
        if e > len(block) {
            e = len(block)
        }
        last = 0
        if e == len(block) {
            last = 4
        }
        out = out + h2_frame(9, last, stream, slice(block, at, e))
        at = e
    }
    return out
}

# an HTTP/1.1 answer (status line, headers, body) -> HTTP/2 header pairs;
# the body goes in [0] of the result, the pairs after it
fn _web_h2_answer(raw: string) -> array[string] {
    he = find(raw, "\r\n\r\n")
    out: array[string] = [slice(raw, he + 4, len(raw))]
    lines = split(slice(raw, 0, he), "\r\n")
    parts = split(lines[0], " ")
    push(out, ":status")
    push(out, parts[1])
    for i in 1..len(lines) {
        c = find(lines[i], ":")
        if c > 0 {
            name = lower(trim(slice(lines[i], 0, c)))
            # these belong to HTTP/1.1 connections, not HTTP/2
            if name != "connection" and name != "keep-alive" and name != "transfer-encoding" and name != "upgrade" and name != "proxy-connection" {
                push(out, name)
                push(out, trim(slice(lines[i], c + 1, len(lines[i]))))
            }
        }
    }
    return out
}

# HTTP/2 request headers -> the same request written the HTTP/1.1 way, for handle()
fn _web_h2_request_text(pairs: array[string], body: string) -> string {
    method = "GET"
    path = "/"
    authority = ""
    rest = ""
    cookies: array[string] = []
    has_length = false
    i = 0
    while i + 1 < len(pairs) {
        n = pairs[i]
        v = pairs[i + 1]
        if n == ":method" {
            method = v
        } else if n == ":path" {
            path = v
        } else if n == ":authority" {
            authority = v
        } else if n == "cookie" {
            push(cookies, v)
        } else if not starts_with(n, ":") {
            if n == "content-length" {
                has_length = true
            }
            rest = rest + n + ": " + v + "\r\n"
        }
        i += 2
    }
    head = method + " " + path + " HTTP/1.1\r\n"
    if authority != "" {
        head = head + "Host: " + authority + "\r\n"
    }
    if len(cookies) > 0 {
        head = head + "Cookie: " + join(cookies, "; ") + "\r\n"
    }
    if not has_length and body != "" {
        rest = rest + "Content-Length: " + str(len(body)) + "\r\n"
    }
    return head + rest + "\r\n" + body
}

# the state of one HTTP/2 connection the server is answering. The streams
# are parallel lists: id, send window, request ended, answer started,
# header block so far, request head (HTTP/1.1 form), and buffers (see
# __rb_new) for the request body and the answer body still to send.
struct H2Server {
    t: Tls,
    inb: int,
    dec: Hpack,
    conn_win: int,
    init_win: int,
    max_frame: int,
    ids: array[int],
    wins: array[int],
    ended: array[int],
    started: array[int],
    blocks: array[string],
    heads: array[string],
    bodies: array[int],
    outs: array[int],
    got: int,
    closing: bool,
    done: bool
}

# answers HTTP/2 on a TLS connection whose handshake picked "h2". Requests
# on several streams can arrive at once; each is answered with handle() when
# it is complete, and answers go out as fast as the other side's windows
# (flow control) allow. The work happens in rounds (_web_h2_round), so the
# memory each round uses is freed when it ends.
fn _web_h2_serve(t: Tls, c: int, s: int, at: int) {
    inb = __rb_new()
    ok = true
    while ok and __rb_len(inb) < 24 {
        if __rb_len(inb) == 0 and t.raw == "" and not _web_wait(c, s) {
            ok = false
        } else {
            t = _web_h2_pull(t, inb)
            ok = t.data != ""
            t.data = ""
        }
    }
    if not ok or __rb_take(inb, 24) != h2_preface() {
        __rb_free(inb)
        __web_let_go(s, at)
        tls_close(t)
        return
    }
    # our settings: up to 100 streams at once, 1 MB per stream for request
    # bodies; and 16 MB more for the whole connection
    t = tls_send(t, h2_frame(4, 0, 0, "\x00\x03" + h2_be32(100) + "\x00\x04" + h2_be32(1048576)) + h2_frame(8, 0, 0, h2_be32(16711680)))
    ei: array[int] = []
    es: array[string] = []
    st = H2Server(t, inb, hpack_new(4096), 65535, 65535, 16384, ei, ei, ei, ei, es, es, ei, ei, 0, false, false)
    while not st.done {
        st = _web_h2_round(st, c, s)
    }
    for k in 0..len(st.ids) {
        __rb_free(st.bodies[k])
        __rb_free(st.outs[k])
    }
    __rb_free(st.inb)
    __web_let_go(s, at)
    tls_close(st.t)
}

# reads more from the connection into buffer inb; t.data is "x" if
# something came, "" if the connection closed
fn _web_h2_pull(t0: Tls, inb: int) -> Tls {
    t = tls_recv(t0)
    if t.data == "" {
        return t
    }
    __rb_add(inb, t.data)
    t.data = "x"
    return t
}

# one round: send what the windows allow, then handle up to 32 frames
# (the state is copied once per round, not once per frame)
fn _web_h2_round(st0: H2Server, c: int, s: int) -> H2Server {
    st = st0
    for round in 0..32 {
        # send what the windows allow
        out = ""
        finished = 0
        k = 0
        while k < len(st.ids) {
            if st.started[k] == 1 {
                left = __rb_len(st.outs[k])
                n = left
                if n > st.conn_win {
                    n = st.conn_win
                }
                if n > st.wins[k] {
                    n = st.wins[k]
                }
                if n > st.max_frame {
                    n = st.max_frame
                }
                if n > 0 or left == 0 {
                    flags = 0
                    if n == left {
                        flags = 1
                    }
                    out = out + h2_frame(0, flags, st.ids[k], __rb_take(st.outs[k], n))
                    st.conn_win -= n
                    st.wins[k] = st.wins[k] - n
                    if len(out) > 65536 {
                        st.t = tls_send(st.t, out)
                        out = ""
                    }
                    if n == left {
                        # this stream is done: its answer has gone out (its
                        # place in the lists is free for a new stream)
                        __rb_clear(st.bodies[k])
                        __rb_clear(st.outs[k])
                        st.ids[k] = 0
                        st.started[k] = 0
                        finished += 1
                        k += 1
                    }
                    continue
                }
            }
            k += 1
        }
        if out != "" {
            st.t = tls_send(st.t, out)
        }
        # answers count once they are sent (the last one may stop the server)
        for q in 0..finished {
            __web_count(s)
        }
        if finished > 0 and not __web_more(s) {
            st.closing = true
        }
        if st.closing {
            pending = false
            for x in st.started {
                if x == 1 {
                    pending = true
                }
            }
            if not pending {
                # done: say so (GOAWAY) and close
                st.t = tls_send(st.t, h2_frame(7, 0, 0, h2_be32(st.got) + h2_be32(0)))
                st.done = true
                return st
            }
        }
        # the next frame
        need = __h2_rb_need(st.inb)
        if need < 0 {
            if __rb_len(st.inb) == 0 and st.t.raw == "" and not st.closing and not _web_wait(c, s) {
                st.closing = true
                continue
            }
            st.t = _web_h2_pull(st.t, st.inb)
            if st.t.data == "" {
                st.done = true
                return st
            }
            st.t.data = ""
            continue
        }
        f = __rb_take(st.inb, need)
        # handle the frame
            kind = h2_frame_type(f)
            flags = h2_frame_flags(f)
            sid = h2_frame_stream(f)
            if kind == 4 {
                if (flags & 1) == 0 {
                    p = 9
                    while p + 6 <= len(f) {
                        id = (byte_at(f, p) << 8) | byte_at(f, p + 1)
                        v = h2_u32(f, p + 2)
                        if id == 4 {
                            for q in 0..len(st.wins) {
                                st.wins[q] = st.wins[q] + v - st.init_win
                            }
                            st.init_win = v
                        }
                        if id == 5 and v >= 16384 and v <= 16777215 {
                            st.max_frame = v
                        }
                        p += 6
                    }
                    st.t = tls_send(st.t, h2_frame(4, 1, 0, ""))
                }
                continue
            }
            if kind == 6 {
                if (flags & 1) == 0 {
                    st.t = tls_send(st.t, h2_frame(6, 1, 0, slice(f, 9, len(f))))
                }
                continue
            }
            if kind == 8 {
                inc = h2_u32(f, 9) & 2147483647
                if sid == 0 {
                    st.conn_win += inc
                } else {
                    for q in 0..len(st.ids) {
                        if st.ids[q] == sid {
                            st.wins[q] = st.wins[q] + inc
                        }
                    }
                }
                continue
            }
            if kind == 7 {
                st.closing = true
                continue
            }
            if sid == 0 {
                # stream frames must name a stream
                continue
            }
            k = -1
            for q in 0..len(st.ids) {
                if st.ids[q] == sid {
                    k = q
                }
            }
            if kind == 3 {
                if k >= 0 {
                    __rb_clear(st.bodies[k])
                    __rb_clear(st.outs[k])
                    st.ids[k] = 0
                    st.started[k] = 0
                }
                continue
            }
            if kind == 1 and k < 0 and sid > 0 and not st.closing {
                # a free place in the lists, or a new one
                for q in 0..len(st.ids) {
                    if k < 0 and st.ids[q] == 0 {
                        k = q
                    }
                }
                if k < 0 {
                    push(st.ids, 0)
                    push(st.wins, 0)
                    push(st.ended, 0)
                    push(st.started, 0)
                    push(st.blocks, "")
                    push(st.heads, "")
                    push(st.bodies, __rb_new())
                    push(st.outs, __rb_new())
                    k = len(st.ids) - 1
                }
                st.ids[k] = sid
                st.wins[k] = st.init_win
                st.ended[k] = 0
                st.started[k] = 0
                st.blocks[k] = ""
                st.heads[k] = ""
            }
            if k < 0 {
                continue
            }
            complete = false
            if kind == 1 or kind == 9 {
                st.blocks[k] = st.blocks[k] + h2_frame_body(f)
                if kind == 1 and (flags & 1) != 0 {
                    st.ended[k] = 1
                }
                if (flags & 4) != 0 {
                    st.dec = hpack_decode(st.dec, st.blocks[k])
                    st.blocks[k] = ""
                    if not st.dec.ok {
                        # COMPRESSION_ERROR: the connection cannot go on
                        st.t = tls_send(st.t, h2_frame(7, 0, 0, h2_be32(st.got) + h2_be32(9)))
                        st.done = true
                        return st
                    }
                    # the first block is the request's headers (a later one: trailers)
                    if st.heads[k] == "" {
                        st.heads[k] = _web_h2_request_text(st.dec.headers, "")
                    }
                    complete = st.ended[k] == 1
                }
            } else if kind == 0 {
                n = len(f) - 9
                __rb_add(st.bodies[k], h2_frame_body(f))
                if n > 0 {
                    # give the window back at once
                    st.t = tls_send(st.t, h2_frame(8, 0, 0, h2_be32(n)) + h2_frame(8, 0, sid, h2_be32(n)))
                }
                if (flags & 1) != 0 {
                    st.ended[k] = 1
                    complete = true
                }
            }
            if complete and st.started[k] == 0 {
                # the request is here: answer it with handle()
                st.got = sid
                raw = __web_reply(st.heads[k] + __rb_take(st.bodies[k], __rb_len(st.bodies[k])), "https", true)
                if raw == "" {
                    raw = "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n"
                }
                a = _web_h2_answer(raw)
                pairs: array[string] = []
                for q in 1..len(a) {
                    push(pairs, a[q])
                }
                st.started[k] = 1
                if a[0] == "" {
                    st.t = tls_send(st.t, _web_h2_headers(sid, hpack_encode(pairs), true, st.max_frame))
                    __rb_clear(st.bodies[k])
                    __rb_clear(st.outs[k])
                    st.ids[k] = 0
                    st.started[k] = 0
                    __web_count(s)
                } else {
                    __rb_add(st.outs[k], a[0])
                    st.t = tls_send(st.t, _web_h2_headers(sid, hpack_encode(pairs), false, st.max_frame))
                }
                if not __web_more(s) {
                    st.closing = true
                }
            }
    }
    return st
}

# one request over an HTTP/2 connection (made by _web_open_alpn). t.data
# gets the answer written the HTTP/1.1 way (status line, headers,
# Content-Length, body), or "" if the connection failed; t.h2 is the next
# stream number (-1: do not use the connection again)
fn _web_h2_fetch(t0: Tls, method: string, path: string, authority: string, body: string) -> Tls {
    t = t0
    out = ""
    if t.h2 == 0 {
        # a new connection: the preface and our settings (no header table, so
        # nothing to remember between requests; no pushes; 16 MB windows)
        out = h2_preface() + h2_frame(4, 0, 0, "\x00\x01" + h2_be32(0) + "\x00\x02" + h2_be32(0) + "\x00\x04" + h2_be32(16777216)) + h2_frame(8, 0, 0, h2_be32(16711680))
        t.h2 = 1
        t.h2win = 65535
        t.h2init = 65535
    }
    sid = t.h2
    t.h2 += 2
    pairs: array[string] = [":method", method, ":scheme", "https", ":authority", authority, ":path", path, "user-agent", "slop", "accept", "*/*"]
    if body != "" or method == "POST" {
        push(pairs, "content-type")
        push(pairs, "application/x-www-form-urlencoded")
        push(pairs, "content-length")
        push(pairs, str(len(body)))
    }
    out = out + _web_h2_headers(sid, hpack_encode(pairs), body == "", 16384)
    t = tls_send(t, out)
    swin = t.h2init
    sent = 0
    # what came in (beyond a frame not read yet) and the answer body, kept
    # outside Slop's memory so a big answer is not copied again and again
    inb = __rb_new()
    __rb_add(inb, t.h2buf)
    t.h2buf = ""
    got = __rb_new()
    dec = hpack_new(4096)
    block = ""
    status = ""
    head = ""
    unacked = 0
    done = false
    while not done {
        # the body, as the windows allow
        if sent < len(body) {
            n = len(body) - sent
            if n > t.h2win {
                n = t.h2win
            }
            if n > swin {
                n = swin
            }
            if n > 16384 {
                n = 16384
            }
            if n > 0 {
                flags = 0
                if sent + n == len(body) {
                    flags = 1
                }
                t = tls_send(t, h2_frame(0, flags, sid, slice(body, sent, sent + n)))
                sent += n
                t.h2win -= n
                swin -= n
                continue
            }
        }
        need = __h2_rb_need(inb)
        while need < 0 {
            t = _web_h2_pull(t, inb)
            if t.data == "" {
                __rb_free(inb)
                __rb_free(got)
                t.ok = false
                return t
            }
            t.data = ""
            need = __h2_rb_need(inb)
        }
        f = __rb_take(inb, need)
        kind = h2_frame_type(f)
        flags = h2_frame_flags(f)
        fs = h2_frame_stream(f)
        if kind == 4 {
            if (flags & 1) == 0 {
                p = 9
                while p + 6 <= len(f) {
                    id = (byte_at(f, p) << 8) | byte_at(f, p + 1)
                    v = h2_u32(f, p + 2)
                    if id == 4 {
                        swin += v - t.h2init
                        t.h2init = v
                    }
                    p += 6
                }
                t = tls_send(t, h2_frame(4, 1, 0, ""))
            }
        } else if kind == 6 {
            if (flags & 1) == 0 {
                t = tls_send(t, h2_frame(6, 1, 0, slice(f, 9, len(f))))
            }
        } else if kind == 8 {
            inc = h2_u32(f, 9) & 2147483647
            if fs == 0 {
                t.h2win += inc
            } else if fs == sid {
                swin += inc
            }
        } else if kind == 7 {
            # the server is closing: answers up to its last stream still come
            last = h2_u32(f, 9) & 2147483647
            t.h2 = -1
            if sid > last {
                __rb_free(inb)
                __rb_free(got)
                t.data = ""
                return t
            }
        } else if fs == sid {
            if kind == 1 or kind == 9 {
                block = block + h2_frame_body(f)
                if (flags & 4) != 0 {
                    dec = hpack_decode(dec, block)
                    block = ""
                    if not dec.ok {
                        __rb_free(inb)
                        __rb_free(got)
                        t.ok = false
                        t.data = ""
                        return t
                    }
                    if status == "" {
                        i = 0
                        while i + 1 < len(dec.headers) {
                            n = dec.headers[i]
                            if n == ":status" {
                                status = dec.headers[i + 1]
                            } else if not starts_with(n, ":") and n != "content-length" and n != "transfer-encoding" {
                                head = head + n + ": " + dec.headers[i + 1] + "\r\n"
                            }
                            i += 2
                        }
                    }
                }
                if (flags & 1) != 0 {
                    done = true
                }
            } else if kind == 0 {
                __rb_add(got, h2_frame_body(f))
                unacked += len(f) - 9
                if unacked > 8388608 {
                    # more room for the rest of a big answer
                    t = tls_send(t, h2_frame(8, 0, 0, h2_be32(unacked)) + h2_frame(8, 0, sid, h2_be32(unacked)))
                    unacked = 0
                }
                if (flags & 1) != 0 {
                    done = true
                }
            } else if kind == 3 {
                # the server refused this request (as REFUSED_STREAM, say)
                __rb_free(inb)
                __rb_free(got)
                t.data = ""
                return t
            }
        }
    }
    if unacked > 0 {
        # give the connection's window back for the next request
        t = tls_send(t, h2_frame(8, 0, 0, h2_be32(unacked)))
    }
    t.h2buf = __rb_take(inb, __rb_len(inb))
    __rb_free(inb)
    if status == "" {
        status = "200"
    }
    n = __rb_len(got)
    t.data = "HTTP/1.1 " + status + " " + reason(to_int(status)) + "\r\n" + head + "content-length: " + str(n) + "\r\n\r\n" + __rb_take(got, n)
    __rb_free(got)
    return t
}
