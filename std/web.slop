# web: websites and web services
#   use "web"
#
#   fn handle(req: Request) -> Response {
#       if route(req, "GET", "/") {
#           return html(page("Home", "<h1>Hello!</h1>"))
#       }
#       if route(req, "GET", "/hello/:name") {
#           return text("Hi " + param("name"))
#       }
#       return not_found()
#   }
#
#   serve(8080)    # then open http://localhost:8080
#   serve_https(8443, "cert.pem", "key.pem")   # https (make_cert makes a test pair)
use "tls.slop"

struct Request {
    method: string,
    path: string,
    query: string,
    headers: string,
    body: string
}

struct Response {
    status: int,
    content_type: string,
    headers: string,
    body: string
}

__web_param_names: array[string] = []
__web_param_values: array[string] = []
__web_quiet = false
__web_status = 0
__web_error = ""
__web_insecure = false
__web_word = 0
__web_pool_word = 0
# open connections kept for the next request to the same server
_web_pool_keys: array[string] = []
_web_pool_conns: array[Tls] = []

# ---------- answers ----------
fn html(body: string) -> Response {
    return Response(200, "text/html; charset=utf-8", "", body)
}

fn text(body: string) -> Response {
    return Response(200, "text/plain; charset=utf-8", "", body)
}

fn json(body: string) -> Response {
    return Response(200, "application/json", "", body)
}

# sends the visitor to another address
fn redirect(url: string) -> Response {
    return Response(303, "text/plain", "Location: " + url + "\r\n", "")
}

fn not_found() -> Response {
    return Response(404, "text/html; charset=utf-8", "", page("Not found", "<h1>Not found</h1><p>There is no page here.</p>"))
}

fn bad_request(why: string) -> Response {
    return Response(400, "text/plain; charset=utf-8", "", why)
}

# the same answer with another status code (201, 403, 500, ...)
fn with_status(r: Response, code: int) -> Response {
    return Response(code, r.content_type, r.headers, r.body)
}

fn with_header(r: Response, name: string, value: string) -> Response {
    return Response(r.status, r.content_type, r.headers + name + ": " + value + "\r\n", r.body)
}

fn set_cookie(r: Response, name: string, value: string) -> Response {
    return with_header(r, "Set-Cookie", name + "=" + url_encode(value) + "; Path=/; HttpOnly; SameSite=Lax")
}

# a file from disk, with the right type for its extension (404 if missing)
fn send_file(path: string) -> Response {
    if not file_exists(path) or contains(path, "..") {
        return not_found()
    }
    return Response(200, content_type_for(path), "", read_file(path))
}

# answers /prefix/... from the files in dir: send_dir(req, "/static/", "public")
fn send_dir(req: Request, prefix: string, dir: string) -> Response {
    rest = slice(req.path, len(prefix), len(req.path))
    if rest == "" or ends_with(rest, "/") {
        rest = rest + "index.html"
    }
    return send_file(dir + "/" + rest)
}

fn content_type_for(path: string) -> string {
    p = lower(path)
    types = [".html", "text/html; charset=utf-8", ".htm", "text/html; charset=utf-8", ".css", "text/css", ".js", "text/javascript", ".json", "application/json", ".txt", "text/plain; charset=utf-8", ".svg", "image/svg+xml", ".png", "image/png", ".jpg", "image/jpeg", ".jpeg", "image/jpeg", ".gif", "image/gif", ".webp", "image/webp", ".ico", "image/x-icon", ".pdf", "application/pdf", ".wasm", "application/wasm", ".woff2", "font/woff2", ".mp4", "video/mp4", ".xml", "application/xml"]
    k = 0
    while k < len(types) {
        if ends_with(p, types[k]) {
            return types[k + 1]
        }
        k += 2
    }
    return "application/octet-stream"
}

# ---------- reading the request ----------
# true when the request matches: route(req, "GET", "/users/:id"). "*" as the
# method matches any; a last "*" segment matches the rest of the path.
fn route(req: Request, method: string, pattern: string) -> bool {
    if method != "*" and method != req.method and not (method == "GET" and req.method == "HEAD") {
        return false
    }
    want = split(pattern, "/")
    got = split(req.path, "/")
    names: array[string] = []
    values: array[string] = []
    for i in 0..len(want) {
        w = want[i]
        if w == "*" and i == len(want) - 1 {
            rest: array[string] = []
            for k in i..len(got) {
                push(rest, got[k])
            }
            push(names, "*")
            push(values, join(rest, "/"))
            __web_param_names = names
            __web_param_values = values
            return true
        }
        if i >= len(got) {
            return false
        }
        if starts_with(w, ":") {
            if got[i] == "" {
                return false
            }
            push(names, slice(w, 1, len(w)))
            push(values, got[i])
        } else {
            if w != got[i] {
                return false
            }
        }
    }
    if len(got) != len(want) {
        return false
    }
    __web_param_names = names
    __web_param_values = values
    return true
}

# a :name part of the path that route() matched
fn param(name: string) -> string {
    for i in 0..len(__web_param_names) {
        if __web_param_names[i] == name {
            return __web_param_values[i]
        }
    }
    return ""
}

# a value from "a=1&b=2" text
fn __web_field(data: string, key: string) -> string {
    for pair in split(data, "&") {
        eq = find(pair, "=")
        if eq >= 0 {
            if url_decode(slice(pair, 0, eq)) == key {
                return url_decode(slice(pair, eq + 1, len(pair)))
            }
        } else {
            if url_decode(pair) == key {
                return ""
            }
        }
    }
    return ""
}

# ?key=value in the address
fn query(req: Request, key: string) -> string {
    return __web_field(req.query, key)
}

# a field of a submitted form (<form method="post">)
fn form(req: Request, key: string) -> string {
    return __web_field(req.body, key)
}

# a request header, any capitalization: header(req, "User-Agent")
fn header(req: Request, name: string) -> string {
    want = lower(name)
    for line in split(req.headers, "\n") {
        c = find(line, ":")
        if c > 0 and lower(trim(slice(line, 0, c))) == want {
            return trim(slice(line, c + 1, len(line)))
        }
    }
    return ""
}

fn cookie(req: Request, name: string) -> string {
    for part in split(header(req, "Cookie"), ";") {
        p = trim(part)
        eq = find(p, "=")
        if eq > 0 and slice(p, 0, eq) == name {
            return url_decode(slice(p, eq + 1, len(p)))
        }
    }
    return ""
}

# ---------- text for the web ----------
fn url_decode(s: string) -> string {
    out = ""
    i = 0
    while i < len(s) {
        c = byte_at(s, i)
        if c == 43 {
            out = out + " "
            i += 1
            continue
        }
        if c == 37 and i + 2 < len(s) {
            hi = __web_hex(byte_at(s, i + 1))
            lo = __web_hex(byte_at(s, i + 2))
            if hi >= 0 and lo >= 0 {
                out = out + chr(hi * 16 + lo)
                i += 3
                continue
            }
        }
        out = out + char_at(s, i)
        i += 1
    }
    return out
}

fn __web_hex(c: int) -> int {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return -1
}

fn url_encode(s: string) -> string {
    digits = "0123456789ABCDEF"
    out = ""
    for i in 0..len(s) {
        c = byte_at(s, i)
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 46 or c == 95 or c == 126 {
            out = out + char_at(s, i)
        } else {
            out = out + "%" + char_at(digits, c / 16) + char_at(digits, c % 16)
        }
    }
    return out
}

# makes text safe to put inside HTML
fn escape_html(s: string) -> string {
    out = replace(s, "&", "&amp;")
    out = replace(out, "<", "&lt;")
    out = replace(out, ">", "&gt;")
    out = replace(out, "\"", "&quot;")
    return replace(out, "'", "&#39;")
}

# fills {{name}} in a template with values (made safe for HTML);
# {{{name}}} puts the value in as it is. pairs: ["name", "Ada", "age", "36"]
fn render(template: string, pairs: array[string]) -> string {
    out = template
    k = 0
    while k + 1 < len(pairs) {
        out = replace(out, "{{{" + pairs[k] + "}}}", pairs[k + 1])
        out = replace(out, "{{" + pairs[k] + "}}", escape_html(pairs[k + 1]))
        k += 2
    }
    return out
}

fn render_file(path: string, pairs: array[string]) -> string {
    return render(read_file(path), pairs)
}

# a whole HTML page with a clean, readable look
fn page(title: string, body: string) -> string {
    style = "body{font-family:system-ui,sans-serif;max-width:46rem;margin:2rem auto;padding:0 1rem;line-height:1.6;color:#222;background:#fff}a{color:#0b5fff}input,textarea,button{font:inherit;padding:.4rem .6rem;margin:.2rem 0}button{cursor:pointer}pre,code{background:#f4f4f4;padding:.1rem .3rem}@media(prefers-color-scheme:dark){body{background:#151515;color:#e8e8e8}a{color:#6ea8ff}pre,code{background:#262626}}"
    return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>" + escape_html(title) + "</title>\n<style>" + style + "</style>\n</head>\n<body>\n" + body + "\n</body>\n</html>\n"
}

# ---------- JSON ----------
# a JSON string, quoted and escaped
fn json_string(s: string) -> string {
    out = replace(s, "\\", "\\\\")
    out = replace(out, "\"", "\\\"")
    out = replace(out, "\n", "\\n")
    out = replace(out, "\r", "\\r")
    out = replace(out, "\t", "\\t")
    return "\"" + out + "\""
}

# {"key": value, ...} from pairs of key and JSON text:
# json_object(["name", json_string("Ada"), "age", "36"])
fn json_object(pairs: array[string]) -> string {
    parts: array[string] = []
    k = 0
    while k + 1 < len(pairs) {
        push(parts, json_string(pairs[k]) + ": " + pairs[k + 1])
        k += 2
    }
    return "{" + join(parts, ", ") + "}"
}

# [a, b, ...] from JSON texts
fn json_list(items: array[string]) -> string {
    return "[" + join(items, ", ") + "]"
}

# ---------- the server ----------
fn reason(code: int) -> string {
    codes = [200, 201, 204, 301, 302, 303, 304, 400, 401, 403, 404, 405, 413, 500, 503]
    names = ["OK", "Created", "No Content", "Moved Permanently", "Found", "See Other", "Not Modified", "Bad Request", "Unauthorized", "Forbidden", "Not Found", "Method Not Allowed", "Payload Too Large", "Internal Server Error", "Service Unavailable"]
    for i in 0..len(codes) {
        if codes[i] == code {
            return names[i]
        }
    }
    return "OK"
}

# stops serve() from printing a line for every request
fn quiet() {
    __web_quiet = true
}

# answers visitors on this port with your handle(req) function, forever
fn serve(port: int) {
    serve_count(port, -1)
}

# like serve, but stops after count requests (handy for tests)
fn serve_count(port: int, count: int) {
    fd = socket_listen(port)
    if fd < 0 {
        eprint("web: cannot use port " + str(port) + " (is another program using it?)")
        exit(1)
    }
    if not __web_quiet {
        print("Serving on http://localhost:" + str(port) + "  (stop with Ctrl+C)")
    }
    s = __web_server(port, count)
    p = __poller_new()
    if p < 0 {
        __web_serve_tasks(fd, s)
    } else {
        __web_serve_events(fd, p, s)
    }
    socket_close(fd)
}

# each server's own state (kept for the whole run): +0 requests answered,
# +8 the limit (-1: none), +16 its port, +24 a lock, +32 its poller,
# +40 its table of connections, +48 the table's lock, +56 the connections
# answered by tasks (4096 places, each 0 or the socket + 1)
fn __web_server(port: int, count: int) -> int {
    # on a multiple of 8 bytes: the locks in it need that on ARM
    s = (__alloc_bytes_in(2, 72) + 7) & -8
    __memzero(s, 64)
    __store64(s + 8, count)
    __store64(s + 16, port)
    __store64(s + 32, -1)
    held = (__alloc_bytes_in(2, 4096 * 8 + 8) + 7) & -8
    __memzero(held, 4096 * 8)
    __store64(s + 56, held)
    return s
}

# notes that a task answers c (its place, or -1 when all are taken)
fn __web_hold(s: int, c: int) -> int {
    held = __load64(s + 56)
    at = -1
    __spin_lock(s + 48)
    for i in 0..4096 {
        if at < 0 and __load64(held + i * 8) == 0 {
            __store64(held + i * 8, c + 1)
            at = i
        }
    }
    __spin_unlock(s + 48)
    return at
}

# the task is about to close its connection
fn __web_let_go(s: int, at: int) {
    if at >= 0 {
        __spin_lock(s + 48)
        __store64(__load64(s + 56) + at * 8, 0)
        __spin_unlock(s + 48)
    }
}

# the server is done: connections kept open for more requests stop waiting
fn __web_wake_all(s: int) {
    held = __load64(s + 56)
    __spin_lock(s + 48)
    for i in 0..4096 {
        v = __load64(held + i * 8)
        if v != 0 {
            __socket_shutdown(v - 1)
        }
    }
    __spin_unlock(s + 48)
    __ws_wake(s)
}

fn __web_more(s: int) -> bool {
    limit = __load64(s + 8)
    return limit < 0 or __load64(s) < limit
}

# one task per connection, which answers its requests one after another
# (where there is no poller: Windows)
fn __web_serve_tasks(fd: int, s: int) {
    live: array[task[void]] = []
    while __web_more(s) {
        c = socket_accept(fd)
        if c >= 0 and not __web_more(s) {
            socket_close(c)
        } else if c >= 0 {
            # each visitor gets its own task, so slow ones don't hold up the rest
            push(live, async __web_answer(c, s, __web_hold(s, c)))
            live = __web_reap(live)
        }
    }
    __web_wake_all(s)
    for t in live {
        await t
    }
}

# an event loop: a few worker threads (two per core) wait on one poller that
# watches every open connection. A worker takes a connection only when a
# request comes in, answers it, and gives it back. Idle connections (kept
# open between requests) cost no thread; ones idle for a minute are closed.
fn __web_serve_events(fd: int, p: int, s: int) {
    __store64(s + 32, p)
    # for each socket number: 0 not ours, 1 waiting, 2 being answered; then the time
    st = __os_alloc(65536 * 16)
    __store64(s + 40, st)
    __poller_watch(p, fd, true)
    workers = __cpu_count() * 2
    if workers < 8 {
        workers = 8
    }
    if workers > 64 {
        workers = 64
    }
    others: array[task[void]] = []
    for w in 1..workers {
        push(others, async __web_worker(fd, s, w))
    }
    __web_worker(fd, s, 0)
    for t in others {
        await t
    }
    # close what is still open
    for c in 0..65536 {
        if __load64(st + c * 16) != 0 {
            socket_close(c)
        }
    }
    socket_close(p)
    __os_release(st, 65536 * 16)
}

fn __web_worker(fd: int, s: int, me: int) {
    p = __load64(s + 32)
    st = __load64(s + 40)
    ready = __alloc_bytes(8 * 16)
    last_sweep = clock_ns()
    sockets: array[task[void]] = []
    while __web_more(s) {
        n = __poller_wait(p, ready, 16, 100)
        for i in 0..n {
            f = __load64(ready + i * 8)
            if f == fd {
                c = socket_accept(fd)
                # let the next visitor in (another worker may take it)
                __poller_watch(p, fd, true)
                if c >= 0 and c < 65536 {
                    __socket_nodelay(c)
                    # a request that starts must arrive within 10 seconds
                    __socket_timeout(c, 10000)
                    __store64(st + c * 16 + 8, clock_ns())
                    __store64(st + c * 16, 1)
                    __poller_watch(p, c, true)
                } else if c >= 0 {
                    socket_close(c)
                }
            } else if f >= 0 and f < 65536 {
                mine = false
                __spin_lock(s + 48)
                if __load64(st + f * 16) == 1 {
                    __store64(st + f * 16, 2)
                    mine = true
                }
                __spin_unlock(s + 48)
                if mine {
                    id = __web_conn(f, s)
                    if id >= 0 {
                        push(sockets, async __ws_run_plain(id, s))
                    }
                }
            }
        }
        # worker 0 closes connections idle for a minute
        now = clock_ns()
        if me == 0 and now - last_sweep > 1000000000 {
            last_sweep = now
            __spin_lock(s + 48)
            for c in 0..65536 {
                if __load64(st + c * 16) == 1 and now - __load64(st + c * 16 + 8) > 60000000000 {
                    __store64(st + c * 16, 0)
                    socket_close(c)
                }
            }
            __spin_unlock(s + 48)
        }
        if len(sockets) > 0 {
            sockets = __web_reap_done(sockets)
        }
    }
    # the server is done: end its WebSockets
    __ws_wake(s)
    for t in sockets {
        await t
    }
}

# the tasks still running (never waits)
fn __web_reap_done(live: array[task[void]]) -> array[task[void]] {
    keep: array[task[void]] = []
    for t in live {
        if done(t) {
            await t
        } else {
            push(keep, t)
        }
    }
    return keep
}

# answers the requests that came in on c, then gives it back to the event
# loop; or, when it became a WebSocket, its id (else -1)
fn __web_conn(c: int, s: int) -> int {
    st = __load64(s + 40)
    raw = ""
    while true {
        need = __web_need(raw)
        while need < 0 {
            piece = socket_read(c)
            if piece == "" or len(raw) > 16777216 {
                __store64(st + c * 16, 0)
                socket_close(c)
                return -1
            }
            raw = raw + piece
            need = __web_need(raw)
        }
        req = slice(raw, 0, need)
        raw = slice(raw, need, len(raw))
        keep = __web_keep(req)
        out = __web_reply(req, "http", keep)
        if out != "" {
            socket_write(c, out)
        }
        __web_count(s)
        if starts_with(out, "HTTP/1.1 101 ") {
            # the WebSocket's own task takes the connection from here
            id = __ws_take(__tls_new(c), false, s, __ws_path_of(req))
            __spin_lock(s + 48)
            __store64(st + c * 16, 0)
            __spin_unlock(s + 48)
            if id < 0 {
                socket_close(c)
            }
            return id
        }
        if not keep or out == "" {
            __store64(st + c * 16, 0)
            socket_close(c)
            return -1
        }
        if raw == "" {
            # nothing more for now: back to waiting
            __store64(st + c * 16 + 8, clock_ns())
            __store64(st + c * 16, 1)
            __poller_watch(__load64(s + 32), c, true)
            return -1
        }
    }
    return -1
}

fn __web_count(s: int) {
    __spin_lock(s + 24)
    __store64(s, __load64(s) + 1)
    last = __load64(s + 8) >= 0 and __load64(s) == __load64(s + 8)
    __spin_unlock(s + 24)
    if last {
        # the last request: wake the loop that may be waiting for a visitor
        w = socket_connect("127.0.0.1", __load64(s + 16))
        if w >= 0 {
            socket_close(w)
        }
    }
}

# the tasks still running (waits for the oldest when there are too many)
fn __web_reap(live: array[task[void]]) -> array[task[void]] {
    keep: array[task[void]] = []
    for t in live {
        if done(t) {
            await t
        } else {
            push(keep, t)
        }
    }
    if len(keep) >= 512 {
        await keep[0]
        rest: array[task[void]] = []
        for i in 1..len(keep) {
            push(rest, keep[i])
        }
        return rest
    }
    return keep
}

# the length of the first whole request in raw (head and body), or -1 if it
# has not all arrived yet
fn __web_need(raw: string) -> int {
    he = find(raw, "\r\n\r\n")
    if he < 0 {
        return -1
    }
    want = 0
    for line in split(slice(raw, 0, he), "\r\n") {
        c = find(line, ":")
        if c > 0 and lower(trim(slice(line, 0, c))) == "content-length" {
            want = to_int(trim(slice(line, c + 1, len(line))))
        }
    }
    if len(raw) - he - 4 < want {
        return -1
    }
    return he + 4 + want
}

# does the visitor want the connection kept open after this request?
# (HTTP/1.1 does unless it says close; HTTP/1.0 only if it asks)
fn __web_keep(req: string) -> bool {
    he = find(req, "\r\n\r\n")
    if he < 0 {
        return false
    }
    lines = split(slice(req, 0, he), "\r\n")
    keep = ends_with(lines[0], "HTTP/1.1")
    for i in 1..len(lines) {
        c = find(lines[i], ":")
        if c > 0 and lower(trim(slice(lines[i], 0, c))) == "connection" {
            v = lower(trim(slice(lines[i], c + 1, len(lines[i]))))
            if contains(v, "close") {
                keep = false
            }
            if contains(v, "keep-alive") {
                keep = true
            }
        }
    }
    return keep
}

# the answer (as bytes to send) for a whole raw request, from handle()
# handle() runs for one visitor at a time, so it can use globals freely;
# reading and sending (the slow parts) happen for many visitors at once
fn __web_reply(raw: string, scheme: string, keep: bool) -> string {
    __spin_lock(addr_of(__web_word))
    out = __web_reply_one(raw, scheme, keep)
    __spin_unlock(addr_of(__web_word))
    return out
}

fn __web_reply_one(raw: string, scheme: string, keep: bool) -> string {
    he = find(raw, "\r\n\r\n")
    if he < 0 {
        return ""
    }
    head = slice(raw, 0, he)
    body = slice(raw, he + 4, len(raw))
    lines = split(head, "\r\n")
    first = split(lines[0], " ")
    if len(first) < 2 {
        return ""
    }
    headers = ""
    for i in 1..len(lines) {
        headers = headers + lines[i] + "\n"
    }
    target = first[1]
    q = find(target, "?")
    path = target
    qs = ""
    if q >= 0 {
        path = slice(target, 0, q)
        qs = slice(target, q + 1, len(target))
    }
    req = Request(first[0], url_decode(path), qs, headers, body)
    __web_param_names = []
    __web_param_values = []
    resp = handle(req)
    if resp.status == 101 {
        # a WebSocket: the connection changes to messages after this
        if not __web_quiet {
            print(req.method + " " + req.path + " 101")
        }
        return "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" + resp.headers + "\r\n"
    }
    extra = ""
    if scheme == "https" {
        # browsers remember to use https for this site
        extra = "Strict-Transport-Security: max-age=31536000\r\n"
    }
    conn = "close"
    if keep {
        conn = "keep-alive"
    }
    out = "HTTP/1.1 " + str(resp.status) + " " + reason(resp.status) + "\r\nContent-Type: " + resp.content_type + "\r\nContent-Length: " + str(len(resp.body)) + "\r\nConnection: " + conn + "\r\n" + extra + resp.headers + "\r\n"
    if req.method != "HEAD" {
        out = out + resp.body
    }
    if not __web_quiet {
        print(req.method + " " + req.path + " " + str(resp.status))
    }
    return out
}

# answers the requests on one connection until the visitor is done (or
# idle for 30 seconds), then closes it
fn __web_answer(c: int, s: int, at: int) {
    __socket_nodelay(c)
    __socket_timeout(c, 30000)
    raw = ""
    while __web_more(s) {
        need = __web_need(raw)
        while need < 0 {
            piece = socket_read(c)
            if piece == "" or len(raw) > 16777216 {
                __web_let_go(s, at)
                socket_close(c)
                return
            }
            raw = raw + piece
            need = __web_need(raw)
        }
        req = slice(raw, 0, need)
        raw = slice(raw, need, len(raw))
        keep = __web_keep(req)
        out = __web_reply(req, "http", keep)
        if out != "" {
            socket_write(c, out)
        }
        __web_count(s)
        if starts_with(out, "HTTP/1.1 101 ") {
            t = __tls_new(c)
            id = __ws_take(t, false, s, __ws_path_of(req))
            __web_let_go(s, at)
            if id >= 0 {
                __ws_run(t, false, id, s)
            } else {
                socket_close(c)
            }
            return
        }
        if not keep or out == "" {
            break
        }
    }
    __web_let_go(s, at)
    socket_close(c)
}

# the same over TLS
fn __web_answer_tls(c: int, key: TlsKey, s: int, at: int) {
    __socket_nodelay(c)
    __socket_timeout(c, 30000)
    t = tls_accept(c, key)
    if not t.ok {
        if not __web_quiet and t.err != "the connection closed" {
            print("https handshake failed: " + t.err)
        }
        __web_let_go(s, at)
        socket_close(c)
        # a failed handshake counts as one visit (for serve_https_count)
        __web_count(s)
        return
    }
    raw = ""
    while __web_more(s) {
        need = __web_need(raw)
        while need < 0 {
            t = tls_recv(t)
            if t.data == "" or len(raw) > 16777216 {
                __web_let_go(s, at)
                tls_close(t)
                return
            }
            raw = raw + t.data
            need = __web_need(raw)
        }
        req = slice(raw, 0, need)
        raw = slice(raw, need, len(raw))
        keep = __web_keep(req)
        out = __web_reply(req, "https", keep)
        if out != "" {
            t = tls_send(t, out)
        }
        __web_count(s)
        if starts_with(out, "HTTP/1.1 101 ") {
            id = __ws_take(t, true, s, __ws_path_of(req))
            __web_let_go(s, at)
            if id >= 0 {
                __ws_run(t, true, id, s)
            } else {
                tls_close(t)
            }
            return
        }
        if not keep or out == "" {
            break
        }
    }
    __web_let_go(s, at)
    tls_close(t)
}

# answers visitors over https on this port, forever; cert_file holds the
# certificate (and any chain), key_file its private key (RSA, or ECDSA P-256 or P-384)
fn serve_https(port: int, cert_file: string, key_file: string) {
    serve_https_count(port, cert_file, key_file, -1)
}

fn serve_https_count(port: int, cert_file: string, key_file: string, count: int) {
    key = tls_load_key(cert_file, key_file)
    if not key.ok {
        eprint("web: cannot use " + cert_file + " and " + key_file + " (they should be PEM files: a certificate, and an RSA or ECDSA P-256/P-384 key; make_cert() makes a test pair)")
        exit(1)
    }
    fd = socket_listen(port)
    if fd < 0 {
        eprint("web: cannot use port " + str(port) + " (is another program using it?)")
        exit(1)
    }
    if not __web_quiet {
        print("Serving on https://localhost:" + str(port) + "  (stop with Ctrl+C)")
    }
    s = __web_server(port, count)
    live: array[task[void]] = []
    while __web_more(s) {
        c = socket_accept(fd)
        if c >= 0 {
            if not __web_more(s) {
                socket_close(c)
            } else {
                push(live, async __web_answer_tls(c, key, s, __web_hold(s, c)))
                live = __web_reap(live)
            }
        }
    }
    # no more visitors: stop taking them, and end the connections kept open
    socket_close(fd)
    __web_wake_all(s)
    for t in live {
        await t
    }
}

# makes a self-signed certificate and key for trying https on your computer
# (browsers will warn; http_get accepts it after trust_cert(cert_file))
fn make_cert(host: string, cert_file: string, key_file: string) {
    tls_make_cert(host, cert_file, key_file)
}

# trusts one more certificate for https (for example your own self-signed one)
fn trust_cert(cert_file: string) {
    tls_trust(cert_file)
    _web_pool_clear()
}

# ---------- asking other servers ----------
# http_get("https://example.com/") gives the page's text; http_status() then
# gives its status code (0 if it failed, with the reason in http_error()).
fn http_get(url: string) -> string {
    return http_request("GET", url, "")
}

fn http_post(url: string, form_data: string) -> string {
    return http_request("POST", url, form_data)
}

fn http_status() -> int {
    return __web_status
}

fn http_error() -> string {
    return __web_error
}

# for testing: the newest TLS version to offer (12 or 13) and AES only
fn https_client_options(max_version: int, aes_only: bool) {
    tls_client_options(max_version, aes_only)
    _web_pool_clear()
}

# for testing only: accept any https certificate
fn https_insecure() {
    __web_insecure = true
    _web_pool_clear()
}

# a kept connection to key ("https://host:port"), or one with ok false
fn _web_pool_take(key: string) -> Tls {
    __spin_lock(addr_of(__web_pool_word))
    let found = -1
    for i in 0..len(_web_pool_keys) {
        if _web_pool_keys[i] == key {
            found = i
        }
    }
    let t = __tls_new(-1)
    t.ok = false
    if found >= 0 {
        t = _web_pool_conns[found]
        let keys: array[string] = []
        let conns: array[Tls] = []
        for i in 0..len(_web_pool_keys) {
            if i != found {
                push(keys, _web_pool_keys[i])
                push(conns, _web_pool_conns[i])
            }
        }
        _web_pool_keys = keys
        _web_pool_conns = conns
    }
    __spin_unlock(addr_of(__web_pool_word))
    return t
}

# keeps a connection for later (at most 16; the oldest goes)
fn _web_pool_put(key: string, t: Tls) {
    __spin_lock(addr_of(__web_pool_word))
    if len(_web_pool_keys) >= 16 {
        tls_close(_web_pool_conns[0])
        let keys: array[string] = []
        let conns: array[Tls] = []
        for i in 1..len(_web_pool_keys) {
            push(keys, _web_pool_keys[i])
            push(conns, _web_pool_conns[i])
        }
        _web_pool_keys = keys
        _web_pool_conns = conns
    }
    push(_web_pool_keys, key)
    push(_web_pool_conns, t)
    __spin_unlock(addr_of(__web_pool_word))
}

fn _web_pool_clear() {
    __spin_lock(addr_of(__web_pool_word))
    for t in _web_pool_conns {
        tls_close(t)
    }
    let keys: array[string] = []
    let conns: array[Tls] = []
    _web_pool_keys = keys
    _web_pool_conns = conns
    __spin_unlock(addr_of(__web_pool_word))
}

fn __web_fail(why: string) -> string {
    __web_status = 0
    __web_error = why
    return ""
}

# the next piece from a connection (TLS or plain) into t.data; "" when closed
fn _web_recv(t: Tls, secure: bool) -> Tls {
    if secure {
        return tls_recv(t)
    }
    t.data = socket_read(t.fd)
    return t
}

# a new connection to host:port (TLS for https), or one with ok false
fn _web_open(host: string, port: int, secure: bool) -> Tls {
    let t = __tls_new(-1)
    t.ok = false
    let ip = host
    if host == "localhost" {
        ip = "127.0.0.1"
    }
    if len(split(ip, ".")) != 4 or find(ip, "-") >= 0 or lower(ip) != upper(ip) {
        ip = __resolve(host)
        if ip == "" {
            t.err = "cannot find the address of " + host
            return t
        }
    }
    let fd = socket_connect(ip, port)
    if fd < 0 {
        t.err = "cannot connect to " + host + ":" + str(port)
        return t
    }
    __socket_nodelay(fd)
    # a server that stops answering gives up after a minute
    __socket_timeout(fd, 60000)
    if secure {
        t = tls_connect(fd, host, __web_insecure)
        if not t.ok {
            socket_close(fd)
            t.err = "https: " + t.err
        }
        return t
    }
    t = __tls_new(fd)
    return t
}

# is the whole answer here? -1: not yet, else its length (head and body);
# -2: its end is when the server closes (no length given)
fn _web_answer_end(raw: string, method: string) -> int {
    let he = find(raw, "\r\n\r\n")
    if he < 0 {
        return -1
    }
    let lines = split(slice(raw, 0, he), "\r\n")
    let parts = split(lines[0], " ")
    let status = 0
    if len(parts) > 1 {
        status = to_int(parts[1])
    }
    if method == "HEAD" or status == 204 or status == 304 or (status >= 100 and status < 200) {
        return he + 4
    }
    let length = -1
    let chunked = false
    for line in lines {
        let c = find(line, ":")
        if c > 0 {
            let name = lower(trim(slice(line, 0, c)))
            if name == "content-length" {
                length = to_int(trim(slice(line, c + 1, len(line))))
            }
            if name == "transfer-encoding" and contains(lower(line), "chunked") {
                chunked = true
            }
        }
    }
    if chunked {
        let body = slice(raw, he + 4, len(raw))
        if starts_with(body, "0\r\n\r\n") {
            return he + 9
        }
        let e = find(body, "\r\n0\r\n\r\n")
        if e < 0 {
            return -1
        }
        return he + 4 + e + 7
    }
    if length >= 0 {
        if len(raw) - he - 4 < length {
            return -1
        }
        return he + 4 + length
    }
    return -2
}

# may the connection be used again after this answer?
fn _web_reusable(head: string) -> bool {
    let lines = split(head, "\r\n")
    let keep = contains(lines[0], "HTTP/1.1")
    for line in lines {
        let c = find(line, ":")
        if c > 0 and lower(trim(slice(line, 0, c))) == "connection" {
            let v = lower(line)
            if contains(v, "close") {
                keep = false
            }
            if contains(v, "keep-alive") {
                keep = true
            }
        }
    }
    return keep
}

# asks a server; connections are kept and used again for the next request to
# the same server (so https skips its handshake), unless the server says no
fn http_request(method: string, url: string, body: string) -> string {
    __web_status = 0
    __web_error = ""
    let secure = starts_with(url, "https://")
    if not secure and not starts_with(url, "http://") {
        return __web_fail("the address should start with http:// or https://")
    }
    let rest = slice(url, 7, len(url))
    let port = 80
    if secure {
        rest = slice(url, 8, len(url))
        port = 443
    }
    let slash = find(rest, "/")
    let hostport = rest
    let path = "/"
    if slash >= 0 {
        hostport = slice(rest, 0, slash)
        path = slice(rest, slash, len(rest))
    }
    let host = hostport
    let colon = find(hostport, ":")
    if colon >= 0 {
        host = slice(hostport, 0, colon)
        port = to_int(slice(hostport, colon + 1, len(hostport)))
    }
    let key = "http://"
    if secure {
        key = "https://"
    }
    key = key + lower(host) + ":" + str(port)
    let msg = method + " " + path + " HTTP/1.1\r\nHost: " + hostport + "\r\nConnection: keep-alive\r\nUser-Agent: slop\r\nAccept: */*\r\n"
    if body != "" or method == "POST" {
        msg = msg + "Content-Type: application/x-www-form-urlencoded\r\nContent-Length: " + str(len(body)) + "\r\n"
    }
    msg = msg + "\r\n" + body
    let raw = ""
    let t = __tls_new(-1)
    let end = -1
    # a kept connection first; if the server had closed it, a new one
    for attempt in 0..2 {
        let reused = false
        if attempt == 0 {
            t = _web_pool_take(key)
            reused = t.ok
        }
        if not reused {
            t = _web_open(host, port, secure)
            if not t.ok {
                return __web_fail(t.err)
            }
        }
        if secure {
            t = tls_send(t, msg)
        } else {
            socket_write(t.fd, msg)
        }
        raw = ""
        end = _web_answer_end(raw, method)
        while end < 0 and t.ok {
            t = _web_recv(t, secure)
            if t.data == "" {
                break
            }
            raw = raw + t.data
            end = _web_answer_end(raw, method)
        }
        if raw != "" or not reused {
            break
        }
        # a kept connection the server had closed: try once more, fresh
        tls_close(t)
    }
    let he = find(raw, "\r\n\r\n")
    if he < 0 {
        tls_close(t)
        return __web_fail("no answer from " + host)
    }
    let head = slice(raw, 0, he)
    if end >= 0 and len(raw) == end and t.ok and _web_reusable(head) {
        _web_pool_put(key, t)
    } else {
        tls_close(t)
    }
    let out = slice(raw, he + 4, len(raw))
    if end >= 0 {
        out = slice(raw, he + 4, end)
    }
    let lines = split(head, "\r\n")
    let parts = split(lines[0], " ")
    if len(parts) > 1 {
        __web_status = to_int(parts[1])
    }
    for line in lines {
        let c = find(line, ":")
        if c > 0 and lower(trim(slice(line, 0, c))) == "transfer-encoding" and contains(lower(line), "chunked") {
            out = __web_unchunk(out)
        }
    }
    return out
}

# "Transfer-Encoding: chunked" bodies: size lines in hex, then the pieces
fn __web_unchunk(s: string) -> string {
    out = ""
    i = 0
    while i < len(s) {
        e = find(slice(s, i, len(s)), "\r\n")
        if e < 0 {
            break
        }
        line = slice(s, i, i + e)
        semi = find(line, ";")
        if semi >= 0 {
            line = slice(line, 0, semi)
        }
        n = 0
        for k in 0..len(trim(line)) {
            n = n * 16 + __web_hex(byte_at(trim(line), k))
        }
        if n <= 0 {
            break
        }
        i = i + e + 2
        out = out + slice(s, i, i + n)
        i = i + n + 2
    }
    return out
}

# ---------- WebSockets ----------
# A connection that stays open: both sides send messages whenever they like.
#   server: in handle(), return websocket(req) for the address; then your
#           on_websocket(ws) runs for each visitor that connects:
#             fn on_websocket(ws: WebSocket) {
#                 ws = ws_receive(ws)
#                 while ws.ok {
#                     ws_send(ws, "you said " + ws.message)
#                     ws = ws_receive(ws)
#                 }
#             }
#   client: ws = ws_connect("ws://localhost:8080/chat")   (wss:// for TLS)
struct WebSocket {
    ok: bool,
    id: int,
    path: string,
    message: string,
    binary: bool,
    err: string,
    conn: Tls,
    secure: bool,
    buf: string,
    frag: string,
    fragging: bool,
    fragbin: bool
}

# runs for each WebSocket a visitor opens (write your own to use them)
fn on_websocket(ws: WebSocket) {
}

# the open connections, so any task can send on any of them. Each place
# (160 bytes): +0 socket + 1 (0: free), +8 a lock, +16 the TLS sequence
# number, +24 TLS version, +32 AES, +40 TLS, +48 the server it belongs to
# (0: a client), +56 its number (id / 4096), +64 key length, +72 iv length,
# +80 the path (for the server), +96 key (32 bytes), +128 iv (12 bytes)
__ws_slots = 0
__ws_word = 0
__ws_gen = 0
__ws_guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

fn __ws_place(id: int) -> int {
    if id < 0 or __ws_slots == 0 {
        return 0
    }
    return __ws_slots + id % 4096 * 160
}

# a place for a new connection: its id, or -1 when all 4096 are taken
fn __ws_take(t: Tls, secure: bool, owner: int, path: string) -> int {
    __spin_lock(addr_of(__ws_word))
    if __ws_slots == 0 {
        __ws_slots = __os_alloc(4096 * 160)
        __memzero(__ws_slots, 4096 * 160)
    }
    at = -1
    i = 0
    while at < 0 and i < 4096 {
        if __load64(__ws_slots + i * 160) == 0 {
            at = i
        }
        i += 1
    }
    gen = 0
    if at >= 0 {
        __ws_gen += 1
        gen = __ws_gen
        p = __ws_slots + at * 160
        __store64(p, t.fd + 1)
        __store64(p + 8, 0)
        __store64(p + 16, t.wseq)
        __store64(p + 24, t.ver)
        __store64(p + 32, 0)
        if t.aes {
            __store64(p + 32, 1)
        }
        __store64(p + 40, 0)
        if secure {
            __store64(p + 40, 1)
        }
        __store64(p + 48, owner)
        __store64(p + 56, gen)
        __store64(p + 64, len(t.wkey))
        __store64(p + 72, len(t.wiv))
        for k in 0..len(t.wkey) {
            __store8(p + 96 + k, t.wkey[k])
        }
        for k in 0..len(t.wiv) {
            __store8(p + 128 + k, t.wiv[k])
        }
        __store64(p + 80, 0)
        if owner != 0 {
            buf = __os_alloc(len(path) + 8)
            __store64(buf, len(path))
            __memcpy(buf + 8, __str_ptr(path), len(path))
            __store64(p + 80, buf)
        }
    }
    __spin_unlock(addr_of(__ws_word))
    if at < 0 {
        return -1
    }
    return gen * 4096 + at
}

# one frame: FIN, the kind, the length, and (from clients) a mask
fn __ws_frame(op: int, data: string, masked: bool) -> string {
    n = len(data)
    m = 0
    if masked {
        m = 128
    }
    head = chr(128 | op)
    if n < 126 {
        head = head + chr(m | n)
    } else if n < 65536 {
        head = head + chr(m | 126) + chr((n >> 8) & 255) + chr(n & 255)
    } else {
        head = head + chr(m | 127)
        for i in 0..8 {
            head = head + chr((n >> ((7 - i) * 8)) & 255)
        }
    }
    if not masked {
        return head + data
    }
    r = __random_text(4)
    key = byte_at(r, 0) | (byte_at(r, 1) << 8) | (byte_at(r, 2) << 16) | (byte_at(r, 3) << 24)
    return head + r + __ws_mask(data, key)
}

# data XOR the 4-byte mask (byte i uses mask byte i % 4)
fn __ws_mask(s: string, key: int) -> string {
    n = len(s)
    p = __alloc_bytes(n + 8)
    src = __str_ptr(s)
    i = 0
    while i < n {
        __store8(p + i, __load8(src + i) ^ ((key >> ((i & 3) * 8)) & 255))
        i += 1
    }
    return __str(p, n)
}

# sends one frame on connection id (from any task); false if it is closed
fn __ws_write(id: int, op: int, data: string) -> bool {
    p = __ws_place(id)
    if p == 0 {
        return false
    }
    __spin_lock(p + 8)
    if __load64(p) == 0 or __load64(p + 56) != id / 4096 {
        __spin_unlock(p + 8)
        return false
    }
    frame = __ws_frame(op, data, __load64(p + 48) == 0)
    fd = __load64(p) - 1
    if __load64(p + 40) != 0 {
        t = __tls_new(fd)
        t.ver = __load64(p + 24)
        t.aes = __load64(p + 32) != 0
        t.wseq = __load64(p + 16)
        key: array[int] = []
        for k in 0..__load64(p + 64) {
            push(key, __load8(p + 96 + k))
        }
        iv: array[int] = []
        for k in 0..__load64(p + 72) {
            push(iv, __load8(p + 128 + k))
        }
        t.wkey = key
        t.wiv = iv
        t.wenc = true
        t = __tls_write(t, 23, frame)
        __store64(p + 16, t.wseq)
    } else {
        socket_write(fd, frame)
    }
    __spin_unlock(p + 8)
    return true
}

# closes connection id's socket and frees its place
fn __ws_release(id: int) {
    p = __ws_place(id)
    if p == 0 {
        return
    }
    __spin_lock(p + 8)
    if __load64(p) == 0 or __load64(p + 56) != id / 4096 {
        __spin_unlock(p + 8)
        return
    }
    fd = __load64(p) - 1
    __store64(p, 0)
    if __load64(p + 80) != 0 {
        buf = __load64(p + 80)
        __os_release(buf, __load64(buf) + 8)
        __store64(p + 80, 0)
    }
    __spin_unlock(p + 8)
    socket_close(fd)
}

# the server s is done: its WebSockets stop waiting
fn __ws_wake(s: int) {
    if __ws_slots == 0 {
        return
    }
    for i in 0..4096 {
        p = __ws_slots + i * 160
        if __load64(p) != 0 and __load64(p + 48) == s {
            __spin_lock(p + 8)
            if __load64(p) != 0 and __load64(p + 48) == s {
                __socket_shutdown(__load64(p) - 1)
            }
            __spin_unlock(p + 8)
        }
    }
}

# answers an address with a WebSocket: return websocket(req) from handle(),
# and on_websocket(ws) then runs for the connection
fn websocket(req: Request) -> Response {
    key = header(req, "Sec-WebSocket-Key")
    if key == "" or not contains(lower(header(req, "Upgrade")), "websocket") {
        return bad_request("this address is for WebSockets")
    }
    accept = base64_encode(sha1(to_bytes(key + __ws_guid)))
    return Response(101, "", "Sec-WebSocket-Accept: " + accept + "\r\n", "")
}

# the path in a raw request ("GET /chat?x=1 HTTP/1.1" -> "/chat?x=1")
fn __ws_path_of(raw: string) -> string {
    first = split(slice(raw, 0, find(raw, "\r\n")), " ")
    if len(first) < 2 {
        return "/"
    }
    return first[1]
}

# runs on_websocket for a connection the server accepted
fn __ws_run(t: Tls, secure: bool, id: int, s: int) {
    p = __ws_place(id)
    path = "/"
    if p != 0 and __load64(p + 80) != 0 {
        buf = __load64(p + 80)
        path = __str(buf + 8, __load64(buf))
    }
    __socket_timeout(t.fd, 0)
    ws = WebSocket(true, id, path, "", false, "", t, secure, "", "", false, false)
    if __web_more(s) {
        on_websocket(ws)
    }
    __ws_release(id)
}

# the same, from the event loop (which hands over only numbers)
fn __ws_run_plain(id: int, s: int) {
    p = __ws_place(id)
    __ws_run(__tls_new(__load64(p) - 1), false, id, s)
}

# reads more from the connection into ws.buf
fn __ws_more(ws: WebSocket) -> WebSocket {
    piece = ""
    if ws.secure {
        ws.conn = tls_recv(ws.conn)
        piece = ws.conn.data
    } else {
        piece = socket_read(ws.conn.fd)
    }
    if piece == "" {
        ws.ok = false
        if ws.err == "" {
            ws.err = "the connection closed"
        }
        __ws_release(ws.id)
        return ws
    }
    ws.buf = ws.buf + piece
    return ws
}

# the length of the first whole frame in b, -1 if it has not all arrived,
# -2 if it is too big (over 16 MB)
fn __ws_need(b: string) -> int {
    if len(b) < 2 {
        return -1
    }
    n = byte_at(b, 1) & 127
    h = 2
    if n == 126 {
        if len(b) < 4 {
            return -1
        }
        n = (byte_at(b, 2) << 8) | byte_at(b, 3)
        h = 4
    } else if n == 127 {
        if len(b) < 10 {
            return -1
        }
        n = 0
        for i in 2..10 {
            n = (n << 8) | byte_at(b, i)
        }
        h = 10
    }
    if (byte_at(b, 1) & 128) != 0 {
        h += 4
    }
    if n < 0 or n > 16777216 {
        return -2
    }
    if len(b) < h + n {
        return -1
    }
    return h + n
}

# the data in one whole frame (unmasked)
fn __ws_payload(f: string) -> string {
    n = byte_at(f, 1) & 127
    h = 2
    if n == 126 {
        h = 4
    } else if n == 127 {
        h = 10
    }
    if (byte_at(f, 1) & 128) == 0 {
        return slice(f, h, len(f))
    }
    key = byte_at(f, h) | (byte_at(f, h + 1) << 8) | (byte_at(f, h + 2) << 16) | (byte_at(f, h + 3) << 24)
    return __ws_mask(slice(f, h + 4, len(f)), key)
}

# waits for the next message: ws.message (ws.binary if it was bytes);
# ws.ok is false once the connection has closed
fn ws_receive(ws: WebSocket) -> WebSocket {
    ws.message = ""
    ws.binary = false
    while ws.ok {
        need = __ws_need(ws.buf)
        if need == -2 or len(ws.frag) > 16777216 {
            __ws_write(ws.id, 8, "\x03\xf1")
            __ws_release(ws.id)
            ws.ok = false
            ws.err = "a message was too big"
            return ws
        }
        if need < 0 {
            ws = __ws_more(ws)
            continue
        }
        f = slice(ws.buf, 0, need)
        ws.buf = slice(ws.buf, need, len(ws.buf))
        op = byte_at(f, 0) & 15
        fin = (byte_at(f, 0) & 128) != 0
        data = __ws_payload(f)
        if op == 9 {
            # a ping: answer it
            __ws_write(ws.id, 10, data)
        } else if op == 10 {
            # a pong: nothing to do
        } else if op == 8 {
            # the other side is done: answer, then close
            code = "\x03\xe8"
            if len(data) >= 2 {
                code = slice(data, 0, 2)
            }
            __ws_write(ws.id, 8, code)
            __ws_release(ws.id)
            ws.ok = false
            return ws
        } else if op == 0 and ws.fragging {
            ws.frag = ws.frag + data
            if fin {
                ws.message = ws.frag
                ws.binary = ws.fragbin
                ws.frag = ""
                ws.fragging = false
                return ws
            }
        } else if op == 1 or op == 2 {
            if fin {
                ws.message = data
                ws.binary = op == 2
                return ws
            }
            ws.frag = data
            ws.fragging = true
            ws.fragbin = op == 2
        } else {
            __ws_write(ws.id, 8, "\x03\xea")
            __ws_release(ws.id)
            ws.ok = false
            ws.err = "the other side broke the WebSocket rules"
            return ws
        }
    }
    return ws
}

# sends a text message (false if the connection is closed)
fn ws_send(ws: WebSocket, text: string) -> bool {
    return __ws_write(ws.id, 1, text)
}

# sends bytes as a binary message
fn ws_send_binary(ws: WebSocket, data: string) -> bool {
    return __ws_write(ws.id, 2, data)
}

# sends a text message to the connection with this id (ws.id), from anywhere
fn ws_send_to(id: int, text: string) -> bool {
    return __ws_write(id, 1, text)
}

# sends a text message to every WebSocket visitor; how many got it
fn ws_broadcast(text: string) -> int {
    if __ws_slots == 0 {
        return 0
    }
    sent = 0
    for i in 0..4096 {
        p = __ws_slots + i * 160
        if __load64(p) != 0 and __load64(p + 48) != 0 {
            if __ws_write(__load64(p + 56) * 4096 + i, 1, text) {
                sent += 1
            }
        }
    }
    return sent
}

# how many WebSocket visitors are connected
fn ws_count() -> int {
    if __ws_slots == 0 {
        return 0
    }
    n = 0
    for i in 0..4096 {
        p = __ws_slots + i * 160
        if __load64(p) != 0 and __load64(p + 48) != 0 {
            n += 1
        }
    }
    return n
}

# closes the connection (telling the other side)
fn ws_close(ws: WebSocket) {
    __ws_write(ws.id, 8, "\x03\xe8")
    __ws_release(ws.id)
}

# opens a WebSocket to a server: ws://host:port/path, or wss:// (TLS);
# ws.ok is false (and ws.err says why) if it could not
fn ws_connect(url: string) -> WebSocket {
    e = __tls_new(-1)
    ws = WebSocket(false, -1, "", "", false, "", e, false, "", "", false, false)
    secure = starts_with(url, "wss://")
    rest = ""
    port = 80
    if secure {
        rest = slice(url, 6, len(url))
        port = 443
    } else if starts_with(url, "ws://") {
        rest = slice(url, 5, len(url))
    } else {
        ws.err = "the address should start with ws:// or wss://"
        return ws
    }
    slash = find(rest, "/")
    hostport = rest
    path = "/"
    if slash >= 0 {
        hostport = slice(rest, 0, slash)
        path = slice(rest, slash, len(rest))
    }
    host = hostport
    colon = find(hostport, ":")
    if colon >= 0 {
        host = slice(hostport, 0, colon)
        port = to_int(slice(hostport, colon + 1, len(hostport)))
    }
    t = _web_open(host, port, secure)
    if not t.ok {
        ws.err = t.err
        return ws
    }
    key = base64_encode(random_bytes(16))
    msg = "GET " + path + " HTTP/1.1\r\nHost: " + hostport + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\nUser-Agent: slop\r\n\r\n"
    if secure {
        t = tls_send(t, msg)
    } else {
        socket_write(t.fd, msg)
    }
    raw = ""
    while find(raw, "\r\n\r\n") < 0 {
        t = _web_recv(t, secure)
        if t.data == "" or len(raw) > 65536 {
            socket_close(t.fd)
            ws.err = "the server closed the connection"
            return ws
        }
        raw = raw + t.data
    }
    he = find(raw, "\r\n\r\n")
    lines = split(slice(raw, 0, he), "\r\n")
    if not starts_with(lines[0], "HTTP/1.1 101") {
        socket_close(t.fd)
        ws.err = "the server did not take the WebSocket (" + lines[0] + ")"
        return ws
    }
    want = base64_encode(sha1(to_bytes(key + __ws_guid)))
    got = ""
    for i in 1..len(lines) {
        c = find(lines[i], ":")
        if c > 0 and lower(trim(slice(lines[i], 0, c))) == "sec-websocket-accept" {
            got = trim(slice(lines[i], c + 1, len(lines[i])))
        }
    }
    if got != want {
        socket_close(t.fd)
        ws.err = "the server's WebSocket answer was wrong"
        return ws
    }
    # messages may come at any time: no time limit
    __socket_timeout(t.fd, 0)
    id = __ws_take(t, secure, 0, "")
    if id < 0 {
        socket_close(t.fd)
        ws.err = "too many WebSockets open"
        return ws
    }
    ws.ok = true
    ws.id = id
    ws.path = path
    ws.conn = t
    ws.secure = secure
    ws.buf = slice(raw, he + 4, len(raw))
    return ws
}
