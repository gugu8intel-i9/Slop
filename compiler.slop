# ============================================================================
# The Slop compiler, written in Slop.
#
# It turns a .slop file straight into a Linux x86-64 program. There is no C
# compiler, assembler or linker anywhere: this file writes the machine code and
# the executable file itself. The runtime (memory, printing, files, strings)
# is also Slop code: see prelude_source() at the bottom.
#
#   slop app.slop             build ./app
#   slop app.slop out         build ./out
#   slop run app.slop [args]  build and run
# ============================================================================

# ---------- tokens ----------
# kinds: 1 name, 2 keyword, 3 number, 4 string, 5 symbol, 6 end of file
use "tools/convert.slop"

let g_tk_kind: array[int] = []
let g_tk_text: array[string] = []
let g_tk_line: array[int] = []
let g_tk_num: array[int] = []
let g_pos: int = 0
let g_user_tok: int = 0
let g_src_dir: string = ""
# which source file each token came from: "" is the main file
let g_tk_file: array[int] = []
let g_files: array[string] = [""]
let g_cur_file: int = 0

# ---------- output ----------
let g_code: array[int] = []
let g_code_len: int = 0
let g_ro: array[int] = []
let g_ro_strs: array[string] = []
let g_ro_offs: array[int] = []
let g_lbl: array[int] = []
let g_fx_at: array[int] = []

# ---------- program symbols ----------
let g_st_name: array[string] = []
let g_st_fnames: array[string] = []
let g_st_ftypes: array[string] = []
let g_fn_name: array[string] = []
let g_fn_ret: array[string] = []
let g_fn_pnames: array[string] = []
let g_fn_ptypes: array[string] = []
let g_fn_tok: array[int] = []
let g_fn_label: array[int] = []
let g_fn_state: array[int] = []
let g_queue: array[int] = []
let g_gl_name: array[string] = []
let g_gl_type: array[string] = []
let g_gl_addr: array[int] = []
# the source file each global variable belongs to
let g_gl_file: array[int] = []
let g_gl_next: int = 0

# ---------- current function ----------
let g_lc_name: array[string] = []
let g_lc_type: array[string] = []
let g_lc_off: array[int] = []
let g_lc_n: int = 0
let g_frame: int = 0
let g_cur_ret: string = ""
let g_cur_framed: bool = false
let g_cur_raw: bool = false
let g_cur_epi: int = 0
let g_in_top: bool = false
let g_brk: array[int] = []
let g_cont: array[int] = []
let g_loop_n: int = 0
let g_want: string = ""
let g_lit_start: int = -1
let g_lit_end: int = -1
let g_cmp_end: int = -1
let g_cmp_at: int = -1
let g_cmp_cc: int = 0
let g_place_perm: bool = false
let g_simple_kind: int = 0
let g_simple_val: int = 0
let g_bounds_lbl: int = 0
# int/bool locals live in the callee-saved registers rbx, r12-r14 when free
# (r15 points at the thread's state).
# Such a local's "offset" is 100000 + register number.
let g_reg_owner: array[int] = [-1, -1, -1, -1]
let g_reg_used: array[int] = [0, 0, 0, 0]
let g_noreg: array[string] = []

# ---------- generated program memory map ----------
# The program is code + read-only data, followed by a zeroed data area that
# is always reached relative to the code (so programs load at any address):
#   +0 initial stack pointer   +8 call depth   +16 bump pointer of each of the
#   3 memory buckets   +40 their limits   +64 their reserved ends
#   +88 words for the OS layer   +128 scratch (64 bytes)
#   +192 return buffer (256 words)   +2304 imported functions (macOS)
#   +4096 global variables
fn a_sp0() -> int {
    return 0
}

fn a_depth() -> int {
    return 8
}

fn a_bump() -> int {
    return 16
}

fn a_scratch() -> int {
    return 128
}

fn a_retbuf() -> int {
    return 192
}

fn a_imports() -> int {
    return 2304
}

fn a_globals() -> int {
    return 4096
}

# ============================================================================
# errors
# ============================================================================
fn err(msg: string) {
    let line = 0
    if g_pos < len(g_tk_line) {
        line = g_tk_line[g_pos]
    }
    if g_pos < g_user_tok {
        print("error in runtime prelude, line " + int_to_string(line) + ": " + msg)
    } else {
        let file = ""
        if g_pos < len(g_tk_file) {
            file = g_files[g_tk_file[g_pos]]
        }
        if file != "" {
            print("error: " + file + " line " + int_to_string(line) + ": " + msg)
        } else {
            print("error: line " + int_to_string(line) + ": " + msg)
        }
    }
    exit(1)
}

# ============================================================================
# tokenizer
# ============================================================================
fn is_ident_start(c: int) -> bool {
    if c >= 97 and c <= 122 {
        return true
    }
    if c >= 65 and c <= 90 {
        return true
    }
    return c == 95
}

fn is_digit_b(c: int) -> bool {
    return c >= 48 and c <= 57
}

fn is_ident_char(c: int) -> bool {
    return is_ident_start(c) or is_digit_b(c)
}

fn is_keyword(w: string) -> bool {
    if w == "fn" or w == "let" or w == "if" or w == "else" or w == "while" {
        return true
    }
    if w == "for" or w == "in" or w == "return" or w == "struct" or w == "true" {
        return true
    }
    if w == "false" or w == "and" or w == "or" or w == "not" or w == "break" {
        return true
    }
    return w == "continue" or w == "match"
}

fn hex_val(c: int) -> int {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return -1
}

fn add_tok(kind: int, text: string, line: int, num: int) {
    push(g_tk_kind, kind)
    push(g_tk_text, text)
    push(g_tk_line, line)
    push(g_tk_num, num)
    push(g_tk_file, g_cur_file)
}

fn is_two_char_symbol(s: string) -> bool {
    if s == "->" or s == "==" or s == "!=" or s == "<=" or s == ">=" or s == ".." {
        return true
    }
    if s == "|>" or s == "+=" or s == "-=" or s == "*=" or s == "/=" or s == "=>" {
        return true
    }
    return s == "&&" or s == "||" or s == "<<" or s == ">>"
}

fn tokenize(src: string, with_eof: bool) {
    let n = len(src)
    let i = 0
    let line = 1
    while i < n {
        let c = byte_at(src, i)
        if c == 10 {
            line += 1
            i += 1
            continue
        }
        if c == 32 or c == 9 or c == 13 or c == 59 {
            i += 1
            continue
        }
        if c == 35 {
            while i < n and byte_at(src, i) != 10 {
                i += 1
            }
            continue
        }
        if is_ident_start(c) {
            let st = i
            while i < n and is_ident_char(byte_at(src, i)) {
                i += 1
            }
            let w = slice(src, st, i)
            if w == "use" and byte_at(src, i) == 32 and byte_at(src, i + 1) == 34 {
                # use "name" lines are read before compiling (see load_uses)
                while i < n and byte_at(src, i) != 10 {
                    i += 1
                }
                continue
            }
            if w == "true" or w == "false" or w == "and" or w == "or" or w == "not" {
                add_tok(2, w, line, 0)
            } else {
                if is_keyword(w) {
                    add_tok(2, w, line, 0)
                } else {
                    add_tok(1, w, line, 0)
                }
            }
            continue
        }
        if is_digit_b(c) {
            let st = i
            let v = 0
            if c == 48 and (byte_at(src, i + 1) == 120 or byte_at(src, i + 1) == 88) {
                i += 2
                while i < n and (hex_val(byte_at(src, i)) >= 0 or byte_at(src, i) == 95) {
                    if byte_at(src, i) != 95 {
                        v = v * 16 + hex_val(byte_at(src, i))
                    }
                    i += 1
                }
            } else {
                while i < n and (is_digit_b(byte_at(src, i)) or byte_at(src, i) == 95) {
                    if byte_at(src, i) != 95 {
                        v = v * 10 + byte_at(src, i) - 48
                    }
                    i += 1
                }
                # a float: 1.5, 2e10, 6.02e-23
                let is_float = false
                if i + 1 < n and byte_at(src, i) == 46 and is_digit_b(byte_at(src, i + 1)) {
                    is_float = true
                    i += 1
                    while i < n and (is_digit_b(byte_at(src, i)) or byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                if i < n and (byte_at(src, i) == 101 or byte_at(src, i) == 69) {
                    let j = i + 1
                    if j < n and (byte_at(src, j) == 43 or byte_at(src, j) == 45) {
                        j += 1
                    }
                    if j < n and is_digit_b(byte_at(src, j)) {
                        is_float = true
                        i = j
                        while i < n and is_digit_b(byte_at(src, i)) {
                            i += 1
                        }
                    }
                }
                if is_float {
                    let text = slice(src, st, i)
                    add_tok(7, text, line, _slop_parse_float_bits(replace(text, "_", "")))
                    continue
                }
            }
            add_tok(3, slice(src, st, i), line, v)
            continue
        }
        if c == 34 {
            let start_line = line
            i += 1
            let out = ""
            let st = i
            while i < n and byte_at(src, i) != 34 {
                let d = byte_at(src, i)
                if d == 10 {
                    line += 1
                }
                if d == 92 {
                    out = out + slice(src, st, i)
                    let e = byte_at(src, i + 1)
                    if e == 110 {
                        out = out + chr(10)
                    } else {
                        if e == 116 {
                            out = out + chr(9)
                        } else {
                            if e == 114 {
                                out = out + chr(13)
                            } else {
                                if e == 48 {
                                    out = out + chr(0)
                                } else {
                                    out = out + chr(e)
                                }
                            }
                        }
                    }
                    i += 2
                    st = i
                } else {
                    i += 1
                }
            }
            out = out + slice(src, st, i)
            i += 1
            add_tok(4, out, start_line, 0)
            continue
        }
        let two = slice(src, i, i + 2)
        if is_two_char_symbol(two) {
            add_tok(5, two, line, 0)
            i += 2
            continue
        }
        add_tok(5, slice(src, i, i + 1), line, 0)
        i += 1
    }
    if with_eof {
        add_tok(6, "", line, 0)
    }
}

# ============================================================================
# token cursor
# ============================================================================
fn tk() -> string {
    return g_tk_text[g_pos]
}

fn tk_at(i: int) -> string {
    if i >= len(g_tk_text) {
        return ""
    }
    return g_tk_text[i]
}

fn kind() -> int {
    return g_tk_kind[g_pos]
}

fn kind_at(i: int) -> int {
    if i >= len(g_tk_kind) {
        return 6
    }
    return g_tk_kind[i]
}

fn is_sym(s: string) -> bool {
    return g_tk_kind[g_pos] == 5 and g_tk_text[g_pos] == s
}

fn is_sym_at(i: int, s: string) -> bool {
    return kind_at(i) == 5 and tk_at(i) == s
}

fn is_kw(s: string) -> bool {
    return g_tk_kind[g_pos] == 2 and g_tk_text[g_pos] == s
}

fn expect(s: string) {
    if g_tk_kind[g_pos] == 4 or g_tk_text[g_pos] != s {
        let found = g_tk_text[g_pos]
        if g_tk_kind[g_pos] == 6 {
            found = "end of file"
        }
        err("expected '" + s + "' but found '" + found + "'")
    }
    g_pos += 1
}

fn expect_name() -> string {
    if g_tk_kind[g_pos] != 1 {
        err("expected a name but found '" + g_tk_text[g_pos] + "'")
    }
    let s = g_tk_text[g_pos]
    g_pos += 1
    return s
}

# skips a { ... } block starting at the current '{'
fn skip_block() {
    expect("{")
    let depth = 1
    while depth > 0 {
        if g_tk_kind[g_pos] == 6 {
            err("missing '}'")
        }
        if is_sym("{") {
            depth += 1
        }
        if is_sym("}") {
            depth -= 1
        }
        g_pos += 1
    }
}

# ============================================================================
# types
# ============================================================================
fn starts_with_s(s: string, pre: string) -> bool {
    return slice(s, 0, len(pre)) == pre
}

fn is_array_t(t: string) -> bool {
    return starts_with_s(t, "array[")
}

fn elem_t(t: string) -> string {
    return slice(t, 6, len(t) - 1)
}

fn struct_index(name: string) -> int {
    let i = 0
    while i < len(g_st_name) {
        if g_st_name[i] == name {
            return i
        }
        i += 1
    }
    return -1
}

fn words(t: string) -> int {
    if t == "int" or t == "bool" or t == "float" or starts_with_s(t, "thread[") {
        return 1
    }
    if t == "string" {
        return 2
    }
    if t == "void" {
        return 0
    }
    if is_array_t(t) {
        return 3
    }
    let si = struct_index(t)
    if si < 0 {
        err("unknown type '" + t + "'")
    }
    let total = 0
    for ft in split(g_st_ftypes[si], ",") {
        total += words(ft)
    }
    if total == 0 {
        total = 1
    }
    return total
}

fn has_heap(t: string) -> bool {
    if t == "string" or is_array_t(t) {
        return true
    }
    let si = struct_index(t)
    if si < 0 {
        return false
    }
    for ft in split(g_st_ftypes[si], ",") {
        if has_heap(ft) {
            return true
        }
    }
    return false
}

# Struct fields are laid out last-field-first, so pushing the fields in order
# builds the struct in memory. Returns -1 if the field does not exist.
fn field_off(st: string, f: string) -> int {
    let si = struct_index(st)
    let names = split(g_st_fnames[si], ",")
    let types = split(g_st_ftypes[si], ",")
    let i = 0
    let found = -1
    while i < len(names) {
        if names[i] == f {
            found = i
        }
        i += 1
    }
    if found < 0 {
        return -1
    }
    let off = 0
    let j = found + 1
    while j < len(names) {
        off += words(types[j]) * 8
        j += 1
    }
    return off
}

fn field_type(st: string, f: string) -> string {
    let si = struct_index(st)
    let names = split(g_st_fnames[si], ",")
    let types = split(g_st_ftypes[si], ",")
    let i = 0
    while i < len(names) {
        if names[i] == f {
            return types[i]
        }
        i += 1
    }
    return ""
}

fn parse_type() -> string {
    let name = expect_name()
    if name == "array" or name == "list" {
        expect("[")
        let inner = parse_type()
        expect("]")
        return "array[" + inner + "]"
    }
    if name == "thread" {
        expect("[")
        let inner = parse_type()
        expect("]")
        return "thread[" + inner + "]"
    }
    if name == "int" or name == "bool" or name == "string" or name == "void" or name == "float" {
        return name
    }
    if name == "str" {
        return "string"
    }
    if struct_index(name) >= 0 {
        return name
    }
    err("unknown type '" + name + "'")
    return ""
}

# ============================================================================
# machine code
# Code generation works on a small virtual register machine with x86-64 names:
#   0 rax, 1 rcx, 2 rdx, 3 rbx, 4 rsp, 5 rbp, 6 rsi, 7 rdi, 8-15 r8-r15
# rax holds the current value, rsp is the value stack, rbp the frame, and r15
# points at the current thread's state (call depth, memory buckets, buffers).
# Each e_* function below writes the instructions for x86-64 or ARM64.
# On ARM64 the value stack lives in x28 (so it need not stay 16-byte aligned).
# ============================================================================
let g_arch: int = 1
let g_fx_kind: array[int] = []
let g_fx_val: array[int] = []

fn arm() -> bool {
    return g_arch == 2
}

fn emit(b: int) {
    if g_code_len < len(g_code) {
        g_code[g_code_len] = b
    } else {
        push(g_code, b)
    }
    g_code_len += 1
}

fn emit2(a: int, b: int) {
    emit(a)
    emit(b)
}

fn emit3(a: int, b: int, c: int) {
    emit(a)
    emit(b)
    emit(c)
}

fn emit4(a: int, b: int, c: int, d: int) {
    emit(a)
    emit(b)
    emit(c)
    emit(d)
}

fn emit32(v: int) {
    if v < 0 {
        v += 4294967296
    }
    emit(v % 256)
    emit(v / 256 % 256)
    emit(v / 65536 % 256)
    emit(v / 16777216 % 256)
}

fn emit64(v: int) {
    if v >= 0 {
        for k in 0..8 {
            emit(v % 256)
            v = v / 256
        }
    } else {
        let u = -(v + 1)
        for k in 0..8 {
            emit(255 - u % 256)
            u = u / 256
        }
    }
}

fn patch32(at: int, v: int) {
    if v < 0 {
        v += 4294967296
    }
    g_code[at] = v % 256
    g_code[at + 1] = v / 256 % 256
    g_code[at + 2] = v / 65536 % 256
    g_code[at + 3] = v / 16777216 % 256
}

fn read32(at: int) -> int {
    return g_code[at] + g_code[at + 1] * 256 + g_code[at + 2] * 65536 + g_code[at + 3] * 16777216
}

fn fits32(v: int) -> bool {
    return v >= -2147483648 and v <= 2147483647
}

fn new_label() -> int {
    push(g_lbl, -1)
    return len(g_lbl) - 1
}

fn place(l: int) {
    g_lbl[l] = g_code_len
}

# records a spot to fill in once addresses are known (see resolve_fixups)
fn fixup(kind: int, val: int) {
    push(g_fx_at, g_code_len)
    push(g_fx_kind, kind)
    push(g_fx_val, val)
}

# ---------- ARM64 encoding helpers (raw register numbers, 31 = zero/sp) ----------
fn a32(w: int) {
    emit32(w)
}

# our register ids -> ARM64 registers
fn ar(r: int) -> int {
    let map = [0, 1, 2, 19, 28, 29, 6, 7, 8, 9, 10, 11, 20, 21, 22, 23]
    return map[r]
}

fn a_movz(d: int, imm: int, hw: int) {
    a32(3531603968 + hw * 2097152 + imm * 32 + d)
}

fn a_movk(d: int, imm: int, hw: int) {
    a32(4068474880 + hw * 2097152 + imm * 32 + d)
}

fn a_movn(d: int, imm: int, hw: int) {
    a32(2457862144 + hw * 2097152 + imm * 32 + d)
}

fn half(v: int, k: int) -> int {
    let i = 0
    while i < k {
        v = v / 65536
        i += 1
    }
    return v % 65536
}

fn a_mov_imm(d: int, v: int) {
    if v >= 0 {
        a_movz(d, v % 65536, 0)
        let u = v / 65536
        for k in 1..4 {
            if u % 65536 != 0 {
                a_movk(d, u % 65536, k)
            }
            u = u / 65536
        }
    } else {
        # halves of the bitwise complement
        let u = -(v + 1)
        a_movn(d, u % 65536, 0)
        u = u / 65536
        for k in 1..4 {
            if u % 65536 != 0 {
                a_movk(d, 65535 - u % 65536, k)
            }
            u = u / 65536
        }
    }
}

fn a_mov(d: int, s: int) {
    if d == 31 or s == 31 {
        a32(2432696320 + s * 32 + d)
    } else {
        a32(2852127712 + s * 65536 + d)
    }
}

# 3-register data processing: base opcode with m, n, d
fn a_rrr(base: int, d: int, n: int, m: int) {
    a32(base + m * 65536 + n * 32 + d)
}

fn a_add_imm(d: int, n: int, imm: int) {
    if imm < 0 {
        a_sub_imm(d, n, -imm)
        return
    }
    if imm < 4096 {
        a32(2432696320 + imm * 1024 + n * 32 + d)
    } else {
        a_mov_imm(17, imm)
        a_rrr(2332033024, d, n, 17)
    }
}

fn a_sub_imm(d: int, n: int, imm: int) {
    if imm < 4096 {
        a32(3506438144 + imm * 1024 + n * 32 + d)
    } else {
        a_mov_imm(17, imm)
        a_rrr(3405774848, d, n, 17)
    }
}

# load/store 64-bit at [n + disp]; x17 used for far displacements
fn a_ldst(load: bool, t: int, n: int, disp: int) {
    if disp >= 0 and disp < 32768 and disp % 8 == 0 {
        if load {
            a32(4181721088 + disp / 8 * 1024 + n * 32 + t)
        } else {
            a32(4177526784 + disp / 8 * 1024 + n * 32 + t)
        }
        return
    }
    if disp >= -256 and disp < 256 {
        let imm9 = disp
        if imm9 < 0 {
            imm9 += 512
        }
        if load {
            a32(4164943872 + imm9 * 4096 + n * 32 + t)
        } else {
            a32(4160749568 + imm9 * 4096 + n * 32 + t)
        }
        return
    }
    a_mov_imm(17, disp)
    a_rrr(2332033024, 17, n, 17)
    a_ldst(load, t, 17, 0)
}

fn a_push(t: int) {
    a32(4162817024 + 28 * 32 + t)
}

fn a_pop(t: int) {
    a32(4164977664 + 28 * 32 + t)
}

# adrp + add/ldr to a place in the file; kind is the fixup kind
fn a_adr_fixup(d: int, kind: int, val: int) {
    fixup(kind, val)
    a32(2415919104 + d)
    if kind == 14 {
        a32(4181721088 + d * 32 + d)
    } else {
        a32(2432696320 + d * 32 + d)
    }
}

# x86 condition code -> ARM64 condition
fn arm_cc(cc: int) -> int {
    if cc == 4 {
        return 0
    }
    if cc == 5 {
        return 1
    }
    if cc == 2 {
        return 3
    }
    if cc == 3 {
        return 2
    }
    if cc == 6 {
        return 9
    }
    if cc == 7 {
        return 8
    }
    if cc == 12 {
        return 11
    }
    if cc == 13 {
        return 10
    }
    if cc == 14 {
        return 13
    }
    return 12
}

# ---------- x86-64 encoding helpers ----------
# REX.W prefix with the R (bit 2) and B (bit 0) extensions for registers 8-15
fn rex(r: int, b: int) -> int {
    let v = 72
    if r >= 8 {
        v += 4
    }
    if b >= 8 {
        v += 1
    }
    return v
}

# [base + disp32] memory operand; base rsp/r12 need a SIB byte
fn e_modrm_mem(reg: int, base: int, disp: int) {
    if disp >= 100000 {
        err("internal: register variable used as memory")
    }
    emit(128 + reg % 8 * 8 + base % 8)
    if base % 8 == 4 {
        emit(36)
    }
    emit32(disp)
}

# [rip + data offset] (global variables) or [r15 + offset] (thread state)
fn is_thread_off(off: int) -> bool {
    return off < a_globals()
}

fn e_modrm_rip(reg: int, kind: int, val: int) {
    emit(5 + reg % 8 * 8)
    fixup(kind, val)
    emit32(0)
}

# ---------- control flow ----------
fn e_jmp(l: int) {
    if arm() {
        fixup(10, l)
        a32(335544320)
        return
    }
    emit(233)
    fixup(0, l)
    emit32(0)
}

# condition codes (x86 numbering): b 2, ae 3, e 4, ne 5, be 6, a 7, l 12, ge 13, le 14, g 15
fn e_jcc(cc: int, l: int) {
    if arm() {
        fixup(11, l)
        a32(1409286144 + arm_cc(cc))
        return
    }
    emit2(15, 128 + cc)
    fixup(0, l)
    emit32(0)
}

fn e_call(l: int) {
    if arm() {
        fixup(10, l)
        a32(2483027968)
        return
    }
    emit(232)
    fixup(0, l)
    emit32(0)
}

fn e_jz_rax(l: int) {
    if arm() {
        fixup(11, l)
        a32(3019898880)
        return
    }
    emit3(72, 133, 192)
    e_jcc(4, l)
}

fn e_jnz_rax(l: int) {
    if arm() {
        fixup(11, l)
        a32(3036676096)
        return
    }
    emit3(72, 133, 192)
    e_jcc(5, l)
}

fn invert_cc(cc: int) -> int {
    if cc % 2 == 0 {
        return cc + 1
    }
    return cc - 1
}

# rax = 0/1 from the flags of the last compare
fn e_setcc_rax(cc: int) {
    g_cmp_at = g_code_len
    g_cmp_cc = cc
    if arm() {
        a32(2594113504 + arm_cc(invert_cc(cc)) * 4096)
    } else {
        emit3(15, 144 + cc, 192)
        emit3(15, 182, 192)
    }
    g_cmp_end = g_code_len
}

# ---------- moves, loads, stores, stack ----------
fn e_push(r: int) {
    if arm() {
        a_push(ar(r))
        return
    }
    if r >= 8 {
        emit(65)
    }
    emit(80 + r % 8)
}

fn e_pop(r: int) {
    if arm() {
        a_pop(ar(r))
        return
    }
    if r >= 8 {
        emit(65)
    }
    emit(88 + r % 8)
}

fn e_mov_rr(dst: int, src: int) {
    if arm() {
        a_mov(ar(dst), ar(src))
        return
    }
    emit3(rex(src, dst), 137, 192 + src % 8 * 8 + dst % 8)
}

fn e_mov_imm(r: int, v: int) {
    if arm() {
        a_mov_imm(ar(r), v)
        return
    }
    if fits32(v) {
        emit3(rex(0, r), 199, 192 + r % 8)
        emit32(v)
    } else {
        emit2(rex(0, r), 184 + r % 8)
        emit64(v)
    }
}

fn e_push_imm(v: int) {
    if arm() {
        a_mov_imm(16, v)
        a_push(16)
        return
    }
    if fits32(v) {
        emit(104)
        emit32(v)
    } else {
        e_mov_imm(0, v)
        e_push(0)
    }
}

fn e_load(r: int, base: int, disp: int) {
    if arm() {
        a_ldst(true, ar(r), ar(base), disp)
        return
    }
    emit2(rex(r, base), 139)
    e_modrm_mem(r, base, disp)
}

fn e_store(base: int, disp: int, r: int) {
    if arm() {
        a_ldst(false, ar(r), ar(base), disp)
        return
    }
    emit2(rex(r, base), 137)
    e_modrm_mem(r, base, disp)
}

fn e_lea(r: int, base: int, disp: int) {
    if arm() {
        a_add_imm(ar(r), ar(base), disp)
        return
    }
    emit2(rex(r, base), 141)
    e_modrm_mem(r, base, disp)
}

fn e_push_mem(base: int, disp: int) {
    if arm() {
        a_ldst(true, 16, ar(base), disp)
        a_push(16)
        return
    }
    if base >= 8 {
        emit(65)
    }
    emit(255)
    e_modrm_mem(6, base, disp)
}

fn e_pop_mem(base: int, disp: int) {
    if arm() {
        a_pop(16)
        a_ldst(false, 16, ar(base), disp)
        return
    }
    if base >= 8 {
        emit(65)
    }
    emit(143)
    e_modrm_mem(0, base, disp)
}

# data area: thread state (offsets below 4096, via r15) or global variables
fn e_lea_data(r: int, off: int) {
    if is_thread_off(off) {
        e_lea(r, 15, off)
        return
    }
    if arm() {
        a_adr_fixup(ar(r), 13, off)
        return
    }
    emit2(rex(r, 0), 141)
    e_modrm_rip(r, 2, off)
}

fn e_load_abs(r: int, off: int) {
    if is_thread_off(off) {
        e_load(r, 15, off)
        return
    }
    if arm() {
        a_adr_fixup(17, 13, off)
        a_ldst(true, ar(r), 17, 0)
        return
    }
    emit2(rex(r, 0), 139)
    e_modrm_rip(r, 2, off)
}

fn e_store_abs(off: int, r: int) {
    if is_thread_off(off) {
        e_store(15, off, r)
        return
    }
    if arm() {
        a_adr_fixup(17, 13, off)
        a_ldst(false, ar(r), 17, 0)
        return
    }
    emit2(rex(r, 0), 137)
    e_modrm_rip(r, 2, off)
}

fn e_push_abs(off: int) {
    if is_thread_off(off) {
        e_push_mem(15, off)
        return
    }
    if arm() {
        a_adr_fixup(17, 13, off)
        a_ldst(true, 16, 17, 0)
        a_push(16)
        return
    }
    emit(255)
    e_modrm_rip(6, 2, off)
}

fn e_pop_abs(off: int) {
    if is_thread_off(off) {
        e_pop_mem(15, off)
        return
    }
    if arm() {
        a_adr_fixup(17, 13, off)
        a_pop(16)
        a_ldst(false, 16, 17, 0)
        return
    }
    emit(143)
    e_modrm_rip(0, 2, off)
}

fn e_add_rsp(n: int) {
    if n <= 0 {
        return
    }
    if arm() {
        a_add_imm(28, 28, n)
        return
    }
    emit3(72, 129, 196)
    emit32(n)
}

# string literal: pushes [ptr, len]
fn ro_offset(s: string) -> int {
    let i = 0
    while i < len(g_ro_strs) {
        if g_ro_strs[i] == s {
            return g_ro_offs[i]
        }
        i += 1
    }
    let off = len(g_ro)
    let n = len(s)
    for k in 0..n {
        push(g_ro, byte_at(s, k))
    }
    push(g_ro, 0)
    while len(g_ro) % 8 != 0 {
        push(g_ro, 0)
    }
    push(g_ro_strs, s)
    push(g_ro_offs, off)
    return off
}

fn e_string_literal(s: string) {
    g_lit_start = g_code_len
    e_push_imm(len(s))
    if arm() {
        a_adr_fixup(0, 12, ro_offset(s))
    } else {
        emit3(72, 141, 5)
        fixup(1, ro_offset(s))
        emit32(0)
    }
    e_push(0)
    g_lit_end = g_code_len
}

# ---------- arithmetic ----------
# d = d OP s. op: 0 add, 1 sub, 2 cmp, 3 and, 4 or, 5 xor, 6 imul
fn e_alu(op: int, d: int, s: int) {
    if arm() {
        let rd = ar(d)
        let rs = ar(s)
        if op == 2 {
            a32(3942645791 + rs * 65536 + rd * 32)
            return
        }
        if op == 6 {
            a_rrr(2600500224, rd, rd, rs)
            return
        }
        let bases = [2332033024, 3405774848, 0, 2315255808, 2852126720, 3388997632]
        a_rrr(bases[op], rd, rd, rs)
        return
    }
    let rr_ops = [1, 41, 57, 33, 9, 49]
    if op == 6 {
        emit4(rex(d, s), 15, 175, 192 + d % 8 * 8 + s % 8)
    } else {
        emit3(rex(s, d), rr_ops[op], 192 + s % 8 * 8 + d % 8)
    }
}

fn e_alu_imm(op: int, r: int, v: int) {
    if arm() {
        let rd = ar(r)
        if op == 0 and v >= 0 and v < 4096 {
            a_add_imm(rd, rd, v)
            return
        }
        if op == 1 and v >= 0 and v < 4096 {
            a_sub_imm(rd, rd, v)
            return
        }
        if op == 2 and v >= 0 and v < 4096 {
            a32(4043309087 + v * 1024 + rd * 32)
            return
        }
        a_mov_imm(16, v)
        if op == 2 {
            a32(3942645791 + 16 * 65536 + rd * 32)
            return
        }
        if op == 6 {
            a_rrr(2600500224, rd, rd, 16)
            return
        }
        let bases = [2332033024, 3405774848, 0, 2315255808, 2852126720, 3388997632]
        a_rrr(bases[op], rd, rd, 16)
        return
    }
    if op == 6 {
        emit3(rex(r, r), 105, 192 + r % 8 * 8 + r % 8)
        emit32(v)
        return
    }
    if r == 0 {
        let imm_ops = [5, 45, 61, 37, 13, 53]
        emit2(72, imm_ops[op])
    } else {
        emit3(rex(0, r), 129, 192 + op_ext(op) * 8 + r % 8)
    }
    emit32(v)
}

fn op_ext(op: int) -> int {
    let ext = [0, 5, 7, 4, 1, 6]
    return ext[op]
}

# rax = rax OP [base + disp]  (base must be rbp here)
fn e_alu_mem(op: int, base: int, disp: int) {
    if arm() {
        a_ldst(true, 16, ar(base), disp)
        e_alu_x16(op)
        return
    }
    let mem_ops = [3, 43, 59, 35, 11, 51]
    if op == 6 {
        emit3(72, 15, 175)
    } else {
        emit2(72, mem_ops[op])
    }
    e_modrm_mem(0, base, disp)
}

# rax = rax OP global variable
fn e_alu_global(op: int, off: int) {
    if arm() {
        a_adr_fixup(17, 13, off)
        a_ldst(true, 16, 17, 0)
        e_alu_x16(op)
        return
    }
    let mem_ops = [3, 43, 59, 35, 11, 51]
    if op == 6 {
        emit3(72, 15, 175)
    } else {
        emit2(72, mem_ops[op])
    }
    e_modrm_rip(0, 2, off)
}

fn e_alu_x16(op: int) {
    if op == 2 {
        a32(3942645791 + 16 * 65536)
        return
    }
    if op == 6 {
        a_rrr(2600500224, 0, 0, 16)
        return
    }
    let bases = [2332033024, 3405774848, 0, 2315255808, 2852126720, 3388997632]
    a_rrr(bases[op], 0, 0, 16)
}

# rax = rax / rcx, or rax % rcx
fn e_divmod_rcx(rem: bool) {
    if arm() {
        a_rrr(2596277248, 16, 0, 1)
        if rem {
            a32(2600501248 + 1 * 65536 + 0 * 1024 + 16 * 32 + 0)
        } else {
            a_mov(0, 16)
        }
        return
    }
    emit2(72, 153)
    emit3(72, 247, 249)
    if rem {
        e_mov_rr(0, 2)
    }
}

# rax = rax / 10 or rax % 10 (x86: multiply by a magic constant, much faster than idiv)
fn e_divmod10(rem: bool) {
    if arm() {
        a_mov_imm(1, 10)
        e_divmod_rcx(rem)
        return
    }
    e_mov_rr(1, 0)
    e_mov_imm(0, 7378697629483820647)
    emit3(72, 247, 233)
    emit4(72, 193, 250, 2)
    e_mov_rr(0, 1)
    emit4(72, 193, 248, 63)
    emit3(72, 41, 194)
    if rem {
        emit4(72, 107, 210, 10)
        e_mov_rr(0, 1)
        emit3(72, 41, 208)
    } else {
        e_mov_rr(0, 2)
    }
}

fn e_neg_rax() {
    if arm() {
        a32(3405775840)
        return
    }
    emit3(72, 247, 216)
}

# rax = rax xor 1 (logical not of a bool)
fn e_not_bool_rax() {
    if arm() {
        a32(3527409664)
        return
    }
    emit4(72, 131, 240, 1)
}

# rax = rax << rcx, or arithmetic >>
fn e_shift_rcx(left: bool) {
    if arm() {
        if left {
            a_rrr(2596282368, 0, 0, 1)
        } else {
            a_rrr(2596284416, 0, 0, 1)
        }
        return
    }
    if left {
        emit3(72, 211, 224)
    } else {
        emit3(72, 211, 248)
    }
}

# sign-extend the low 32 bits of rax
fn e_sext32_rax() {
    if arm() {
        a32(2470476800)
        return
    }
    emit3(72, 99, 192)
}

# ---------- arrays ----------
# rcx = array header address, rax = index -> rax = element address (bounds checked)
# ---------- floating point (64-bit floats travel as bits in integer registers) ----------
# r (rax or rcx) = int r converted to a float
fn e_f_from_int(r: int) {
    if arm() {
        a32(2657222656 + r * 32)
        a32(2657484800 + r)
        return
    }
    emit4(242, 72, 15, 42)
    emit(192 + r)
    emit4(102, 72, 15, 126)
    emit(192 + r)
}

# xmm0/d0 = rax, xmm1/d1 = rcx
fn e_f_load2() {
    if arm() {
        a32(2657550336)
        a32(2657550369)
        return
    }
    emit4(102, 72, 15, 110)
    emit(192)
    emit4(102, 72, 15, 110)
    emit(201)
}

fn e_f_result() {
    if arm() {
        a32(2657484800)
        return
    }
    emit4(102, 72, 15, 126)
    emit(192)
}

# rax = rax OP rcx; op: 0 add, 1 sub, 6 mul, 7 div
fn e_f_op(op: int) {
    e_f_load2()
    if arm() {
        let base = 509683712
        if op == 1 {
            base = 509687808
        }
        if op == 6 {
            base = 509675520
        }
        if op == 7 {
            base = 509679616
        }
        a32(base)
    } else {
        let code = 88
        if op == 1 {
            code = 92
        }
        if op == 6 {
            code = 89
        }
        if op == 7 {
            code = 94
        }
        emit4(242, 15, code, 193)
    }
    e_f_result()
}

# rax = (rax OP rcx) as 0/1; op is "<", "<=", ">", ">=", "==" or "!="
fn e_f_cmp(op: string) {
    e_f_load2()
    if arm() {
        a32(509681664)
        let cond = 0
        if op == "!=" {
            cond = 1
        }
        if op == "<" {
            cond = 4
        }
        if op == "<=" {
            cond = 9
        }
        if op == ">" {
            cond = 12
        }
        if op == ">=" {
            cond = 10
        }
        # cset x0, cond
        a32(2594113504 + (cond ^ 1) * 4096)
        return
    }
    if op == "<" or op == "<=" {
        # compare the other way round so NaN gives false
        emit4(102, 15, 46, 200)
        if op == "<" {
            emit3(15, 151, 192)
        } else {
            emit3(15, 147, 192)
        }
    } else {
        emit4(102, 15, 46, 193)
        if op == ">" {
            emit3(15, 151, 192)
        }
        if op == ">=" {
            emit3(15, 147, 192)
        }
        if op == "==" {
            emit3(15, 148, 192)
            emit3(15, 155, 193)
            emit2(32, 200)
        }
        if op == "!=" {
            emit3(15, 149, 192)
            emit3(15, 154, 193)
            emit2(8, 200)
        }
    }
    emit3(15, 182, 192)
}

# one-operand float operations on rax: 0 negate, 1 abs, 2 sqrt, 3 floor, 4 ceil, 5 trunc
fn e_f_unary(op: int) {
    if op == 0 {
        if arm() {
            a32(3527475200)
        } else {
            emit4(72, 15, 186, 248)
            emit(63)
        }
        return
    }
    if op == 1 {
        if arm() {
            a32(2453731328)
        } else {
            emit4(72, 15, 186, 240)
            emit(63)
        }
        return
    }
    e_f_load2()
    if arm() {
        let ops = [0, 0, 509722624, 509952000, 509919232, 509984768]
        a32(ops[op])
    } else {
        if op == 2 {
            emit4(242, 15, 81, 192)
        } else {
            emit4(102, 15, 58, 11)
            emit(192)
            emit(op + 6)
        }
    }
    e_f_result()
}

# rax = float rax converted to an int (rounds toward zero)
fn e_f_to_int() {
    e_f_load2()
    if arm() {
        a32(2658664448)
        return
    }
    emit4(242, 72, 15, 44)
    emit(192)
}

# ---------- threads ----------
# Each thread has its own 8 KB block (r15/x23 points at it): the usual thread
# state at +0, then the spawn arguments at +4096 and these words:
#   +7168 entry  +7176 OS thread id  +7184 OS handle  +7192 result
#   +7200 saved stack pointer  +7208 stack  +7216 stack size
#   +7224 start of each memory bucket  +7256 pthread attributes (macOS)

# r = address of label l
fn e_lea_label(r: int, l: int) {
    if arm() {
        fixup(15, l)
        a32(268435456 + ar(r))
        return
    }
    emit2(rex(r, 0), 141)
    emit(5 + r % 8 * 8)
    fixup(0, l)
    emit32(0)
}

# first code a new thread runs: point r15/x23 at the thread's block
fn e_thread_enter() {
    if g_target == 1 {
        if arm() {
            # mov x28, sp
            a32(2432697340)
        }
        return
    }
    if arm() {
        # save x19-x30 for the system library, then run on its stack
        a32(3506553855)
        for k in 0..6 {
            a32(2835370995 + k * 67586)
        }
        a_mov(23, 0)
        a32(2432697328)
        a_ldst(false, 16, 23, 7200)
        a_mov(28, 16)
        return
    }
    for r in thread_saved_regs() {
        e_push(r)
    }
    if g_target == 3 {
        e_mov_rr(15, 1)
    } else {
        e_mov_rr(15, 7)
    }
}

fn thread_saved_regs() -> array[int] {
    if g_target == 3 {
        return [3, 5, 7, 6, 12, 13, 14, 15]
    }
    return [3, 5, 12, 13, 14, 15]
}

fn e_thread_leave() {
    if g_target == 1 {
        call_named("__thread_exit")
        return
    }
    if arm() {
        a_ldst(true, 16, 23, 7200)
        a32(2432696863)
        for k in 0..6 {
            a32(2839565299 + k * 67586)
        }
        a32(2432812031)
        a32(3596551104)
        return
    }
    let regs = thread_saved_regs()
    let i = len(regs) - 1
    while i >= 0 {
        e_pop(regs[i])
        i -= 1
    }
    emit(195)
}

# Linux: __clone(flags, stack, tid address, block) starts a thread at the
# block's entry; returns the thread id (or an error below 0)
fn e_clone_thread() {
    e_pop(9)
    e_pop(2)
    e_pop(6)
    e_pop(7)
    if arm() {
        a_mov(0, 7)
        a_mov(1, 6)
        a_mov_imm(3, 0)
        a_mov(4, 2)
        a_mov(5, 9)
        a_mov_imm(8, 220)
        a32(3556769793)
        # the new thread: x0 is 0
        a32(3036676224)
        a_mov(23, 5)
        a_ldst(true, 16, 23, 7168)
        a32(3592356352)
        return
    }
    emit3(73, 137, 210)
    emit3(69, 49, 192)
    e_mov_imm(0, 56)
    emit2(15, 5)
    emit3(72, 133, 192)
    emit2(117, 10)
    emit3(77, 137, 207)
    emit3(65, 255, 167)
    emit32(7168)
}

# rax = old value at address rcx, which is set to rax (atomically)
fn e_xchg() {
    if arm() {
        a32(3361733680)
        a32(3356621856)
        a32(905969617)
        a_mov(0, 16)
        return
    }
    emit3(72, 135, 1)
}

fn e_index(t: string) {
    if arm() {
        a_ldst(true, 16, 1, 8)
        a32(3942645791 + 16 * 65536)
        fixup(11, g_bounds_lbl)
        a32(1409286144 + 2)
        a_ldst(true, 2, 1, 0)
        a32(2332036160)
    } else {
        emit3(72, 59, 129)
        emit32(8)
        e_jcc(3, g_bounds_lbl)
        e_load(2, 1, 0)
        emit4(72, 141, 4, 194)
    }
    if words(elem_t(t)) > 1 {
        e_load(0, 0, 0)
    }
}

# rax = 8-byte slot rcx[rax]
fn e_load_slot() {
    if arm() {
        a32(4167071744 + 0 * 65536 + 1 * 32 + 0)
        return
    }
    emit4(72, 139, 4, 193)
}

# d = [base + idx*8] / [base + idx*8] = s   (idx and base below r8)
fn e_load_idx(d: int, base: int, idx: int) {
    if arm() {
        a32(4167071744 + ar(idx) * 65536 + ar(base) * 32 + ar(d))
        return
    }
    emit4(rex(d, 0), 139, 4 + d % 8 * 8, 192 + idx * 8 + base)
}

fn e_store_idx(base: int, idx: int, s: int) {
    if arm() {
        a32(4162877440 + ar(idx) * 65536 + ar(base) * 32 + ar(s))
        return
    }
    emit4(rex(s, 0), 137, 4 + s % 8 * 8, 192 + idx * 8 + base)
}

# d = d + idx * 8
fn e_add_scaled(d: int, idx: int) {
    if arm() {
        a32(2332033024 + ar(idx) * 65536 + 3 * 1024 + ar(d) * 32 + ar(d))
        return
    }
    emit4(72, 141, 4 + d * 8, 192 + idx * 8 + d)
}

# [base + disp] += delta
fn e_add_mem(base: int, disp: int, delta: int) {
    if arm() {
        a_ldst(true, 16, ar(base), disp)
        a_add_imm(16, 16, delta)
        a_ldst(false, 16, ar(base), disp)
        return
    }
    if delta == 1 or delta == -1 {
        emit2(rex(0, base), 255)
        if delta == 1 {
            e_modrm_mem(0, base, disp)
        } else {
            e_modrm_mem(1, base, disp)
        }
        return
    }
    emit2(rex(0, base), 129)
    e_modrm_mem(0, base, disp)
    emit32(delta)
}

# [base + disp] = v
fn e_store_imm(base: int, disp: int, v: int) {
    if arm() {
        a_mov_imm(16, v)
        a_ldst(false, 16, ar(base), disp)
        return
    }
    emit2(rex(0, base), 199)
    e_modrm_mem(0, base, disp)
    emit32(v)
}

# ---------- locals (in memory at rbp+off, or in a register: off = 100000 + reg) ----------
fn is_reg_local(off: int) -> bool {
    return off >= 100000
}

fn loc_load(r: int, off: int) {
    if is_reg_local(off) {
        e_mov_rr(r, off - 100000)
    } else {
        e_load(r, 5, off)
    }
}

fn loc_store(off: int, r: int) {
    if is_reg_local(off) {
        e_mov_rr(off - 100000, r)
    } else {
        e_store(5, off, r)
    }
}

fn loc_inc(off: int) {
    if is_reg_local(off) {
        e_alu_imm(0, off - 100000, 1)
    } else {
        e_add_mem(5, off, 1)
    }
}

fn loc_set0(off: int) {
    if is_reg_local(off) {
        e_mov_imm(off - 100000, 0)
    } else {
        e_store_imm(5, off, 0)
    }
}

# compare rax with a local
fn e_cmp_rax_loc(off: int) {
    if is_reg_local(off) {
        e_alu(2, 0, off - 100000)
    } else {
        e_alu_mem(2, 5, off)
    }
}

# ---------- memory buckets ----------
# rcx <- index of the current memory bucket (call depth & 1)
fn e_cur_bucket_rcx() {
    e_load_abs(1, a_depth())
    e_alu_imm(3, 1, 1)
}

# rax <- index of the caller's bucket ((depth - 1) & 1)
fn e_parent_bucket_rax() {
    e_load_abs(0, a_depth())
    e_alu_imm(1, 0, 1)
    e_alu_imm(3, 0, 1)
}

# rax = size, rcx = bucket -> rax = address of the new block
fn e_alloc(aligned: bool) {
    e_lea_data(6, a_bump())
    e_load_idx(2, 6, 1)
    if aligned {
        e_alu_imm(0, 2, 7)
        e_alu_imm(3, 2, -8)
    }
    e_mov_rr(8, 2)
    e_alu(0, 8, 0)
    # past the bucket's limit: let the OS layer make room (or stop)
    e_lea(7, 6, 24)
    e_load_idx(0, 7, 1)
    e_alu(2, 8, 0)
    let l_ok = new_label()
    e_jcc(6, l_ok)
    e_push(1)
    e_push(2)
    e_push(6)
    e_push(8)
    e_push(1)
    e_push(8)
    call_named("__grow")
    e_add_rsp(16)
    e_pop(8)
    e_pop(6)
    e_pop(2)
    e_pop(1)
    place(l_ok)
    e_store_idx(6, 1, 8)
    e_mov_rr(0, 2)
}

# rax = bump pointer of bucket rax
fn e_bump_read() {
    e_lea_data(1, a_bump())
    e_load_slot()
}

# memory-frame prologue: depth += 1, remember the bucket's bump pointer at rbp-8
fn e_frame_prologue() {
    e_add_mem(15, a_depth(), 1)
    e_load_abs(0, a_depth())
    e_alu_imm(3, 0, 1)
    e_lea_data(1, a_bump())
    e_load_slot()
    e_store(5, -8, 0)
}

# memory-frame epilogue: wipe and give back everything allocated since the prologue
fn e_frame_epilogue() {
    e_push(0)
    e_cur_bucket_rcx()
    e_load(7, 5, -8)
    e_lea_data(6, a_bump())
    e_load_idx(2, 6, 1)
    e_store_idx(6, 1, 7)
    e_mov_rr(1, 2)
    e_alu(1, 1, 7)
    e_memzero()
    e_add_mem(15, a_depth(), -1)
    e_pop(0)
}

# ---------- bulk memory: rdi = destination, rsi = source, rcx = byte count ----------
fn e_memcpy() {
    if arm() {
        a32(4043317311)
        a32(1409286144 + 5 * 32 + 3)
        a32(4164977664 + 6 * 32 + 16)
        a32(4160783360 + 7 * 32 + 16)
        a32(3506446369)
        a32(335544320 + 67108864 - 5)
        a32(3019898880 + 5 * 32 + 1)
        a32(943723520 + 6 * 32 + 16)
        a32(939529216 + 7 * 32 + 16)
        a32(4043310113)
        a32(1409286144 + (524288 - 3) * 32 + 1)
        return
    }
    emit2(243, 164)
}

fn e_memzero() {
    if arm() {
        a32(4043317311)
        a32(1409286144 + 4 * 32 + 3)
        a32(4160783360 + 7 * 32 + 31)
        a32(3506446369)
        a32(335544320 + 67108864 - 4)
        a32(3019898880 + 4 * 32 + 1)
        a32(939529216 + 7 * 32 + 31)
        a32(4043310113)
        a32(1409286144 + (524288 - 2) * 32 + 1)
        return
    }
    emit2(49, 192)
    emit2(243, 170)
}

# rax = 1 if rcx bytes at rdi and rsi are equal
fn e_memeq() {
    if arm() {
        a_movz(0, 1, 0)
        a32(3019898880 + 9 * 32 + 1)
        a32(943723520 + 7 * 32 + 16)
        a32(943723520 + 6 * 32 + 17)
        a32(1795162143 + 17 * 65536 + 16 * 32)
        a32(1409286144 + 4 * 32 + 1)
        a32(4043310113)
        a32(1409286144 + (524288 - 5) * 32 + 1)
        a32(335544320 + 2)
        a_movz(0, 0, 0)
        return
    }
    emit2(49, 192)
    emit2(243, 166)
    emit3(15, 148, 192)
}

# rax = zero-extended 1/2/4/8 bytes at [rax]
fn e_load_sized(size: int) {
    if arm() {
        let ops = [0, 960495616, 2034237440, 0, 3107979264, 0, 0, 0, 4181721088]
        a32(ops[size])
        return
    }
    if size == 1 {
        emit3(15, 182, 0)
    }
    if size == 2 {
        emit3(15, 183, 0)
    }
    if size == 4 {
        emit2(139, 0)
    }
    if size == 8 {
        e_load(0, 0, 0)
    }
}

# [rcx] = low 1/2/4/8 bytes of rax
fn e_store_sized(size: int) {
    if arm() {
        let ops = [0, 956301344, 2030043168, 0, 3103784992, 0, 0, 0, 4177526816]
        a32(ops[size])
        return
    }
    if size == 1 {
        emit2(136, 1)
    }
    if size == 2 {
        emit3(102, 137, 1)
    }
    if size == 4 {
        emit2(137, 1)
    }
    if size == 8 {
        emit3(72, 137, 1)
    }
}

# op: 0 cycle counter, 1 full fence, 2 spin-wait hint, 3 prefetch [rax]
fn e_cpu(op: int) {
    if arm() {
        let ops = [3577471040, 3573758911, 3573751871, 4185915392]
        a32(ops[op])
        return
    }
    if op == 0 {
        emit2(15, 49)
        emit4(72, 193, 226, 32)
        emit3(72, 9, 208)
    }
    if op == 1 {
        emit3(15, 174, 240)
    }
    if op == 2 {
        emit2(243, 144)
    }
    if op == 3 {
        emit3(15, 24, 8)
    }
}

# Linux system call; the number and n-1 arguments are on the stack
fn e_syscall(n: int) {
    if arm() {
        let i = n - 2
        while i >= 0 {
            a_pop(i)
            i -= 1
        }
        a_pop(8)
        a32(3556769793)
        return
    }
    let regs = [7, 6, 2, 10, 8, 9]
    let i = n - 2
    while i >= 0 {
        e_pop(regs[i])
        i -= 1
    }
    e_pop(0)
    emit2(15, 5)
}

# ---------- functions ----------
# registers that may hold int locals (callee-saved): rbx r12 r13 r14
fn local_regs() -> array[int] {
    let r = [3, 12, 13, 14]
    return r
}

# function entry; returns where the frame size and the register saves go
fn e_func_enter() -> array[int] {
    let marks: array[int] = []
    if arm() {
        a_push(30)
        a_push(29)
        a_mov(29, 28)
        push(marks, g_code_len)
        a32(3506438144 + 28 * 32 + 28)
        a32(3510632448 + 28 * 32 + 28)
        push(marks, g_code_len)
        for k in 0..4 {
            a32(3573751839)
        }
        return marks
    }
    e_push(5)
    e_mov_rr(5, 4)
    emit3(72, 129, 236)
    push(marks, g_code_len)
    emit32(0)
    push(marks, g_code_len)
    for k in 0..7 {
        emit(144)
    }
    return marks
}

# skip the memory-frame prologue between from and to (the function never needed it)
fn e_patch_skip(from: int, to: int) {
    if arm() {
        patch32(from, 335544320 + (to - from) / 4)
        return
    }
    g_code[from] = 235
    g_code[from + 1] = to - from - 2
}

fn e_func_leave(marks: array[int], frame: int, used: array[int]) {
    let regs = local_regs()
    let k = 3
    while k >= 0 {
        if used[k] == 1 {
            e_pop(regs[k])
        }
        k -= 1
    }
    let saves: array[int] = []
    if arm() {
        a_mov(28, 29)
        a_pop(29)
        a_pop(30)
        a32(3596551104)
        patch32(marks[0], 3506438144 + frame % 4096 * 1024 + 28 * 32 + 28)
        patch32(marks[0] + 4, 3510632448 + frame / 4096 * 1024 + 28 * 32 + 28)
        let at = marks[1]
        for k2 in 0..4 {
            if used[k2] == 1 {
                patch32(at, 4162817024 + 28 * 32 + ar(regs[k2]))
                at += 4
            }
        }
        return
    }
    emit(201)
    emit(195)
    patch32(marks[0], frame)
    for k2 in 0..4 {
        if used[k2] == 1 {
            let r = regs[k2]
            if r >= 8 {
                push(saves, 65)
            }
            push(saves, 80 + r % 8)
        }
    }
    let fill = 7 - len(saves)
    if fill > 0 {
        for b in nop_bytes(fill) {
            push(saves, b)
        }
    }
    for i in 0..7 {
        g_code[marks[1] + i] = saves[i]
    }
}

# 1..7 byte no-op instructions
fn nop_bytes(n: int) -> array[int] {
    if n == 1 {
        let r = [144]
        return r
    }
    if n == 2 {
        let r = [102, 144]
        return r
    }
    if n == 3 {
        let r = [15, 31, 0]
        return r
    }
    if n == 4 {
        let r = [15, 31, 64, 0]
        return r
    }
    if n == 5 {
        let r = [15, 31, 68, 0, 0]
        return r
    }
    if n == 6 {
        let r = [102, 15, 31, 68, 0, 0]
        return r
    }
    let r = [15, 31, 128, 0, 0, 0, 0]
    return r
}

# program entry: point r15 at the main thread's state and remember the stack
fn e_entry(mac_args: bool) {
    if arm() {
        a32(2432697340)
        a_adr_fixup(23, 13, 0)
        a_ldst(false, 28, 23, 0)
        if mac_args {
            a_ldst(false, 0, 23, 88)
            a_ldst(false, 1, 23, 96)
            a_ldst(false, 2, 23, 104)
        }
        return
    }
    emit2(76, 141)
    e_modrm_rip(15, 2, 0)
    e_store(15, 0, 4)
    if mac_args {
        e_store(15, 88, 7)
        e_store(15, 96, 6)
        e_store(15, 104, 2)
    }
}

# ============================================================================
# values: 1-word values live in rax, bigger ones on the stack (word 0 on top)
# ============================================================================
fn to_stack(t: string) {
    if words(t) == 1 {
        e_push(0)
    }
}

fn from_stack(t: string) {
    if words(t) == 1 {
        e_pop(0)
    }
}

fn discard(t: string) {
    let w = words(t)
    if w > 1 {
        e_add_rsp(w * 8)
    }
}

# address in rax -> value
fn load_from_addr(t: string) {
    let w = words(t)
    if w == 1 {
        e_load(0, 0, 0)
    } else {
        let i = w - 1
        while i >= 0 {
            e_push_mem(0, i * 8)
            i -= 1
        }
    }
}

# value on the stack (always, even 1 word), address in rax -> memory
fn store_to_addr(t: string) {
    let w = words(t)
    for i in 0..w {
        e_pop_mem(0, i * 8)
    }
}

# ============================================================================
# locals and globals
# ============================================================================
fn add_local(name: string, t: string) -> int {
    if (t == "int" or t == "bool" or t == "float") and name != "" {
        let regs = local_regs()
        let promote = true
        for nr in g_noreg {
            if nr == name {
                promote = false
            }
        }
        let k = 0
        while promote and k < 4 {
            let owner = g_reg_owner[k]
            if owner < 0 or owner >= g_lc_n {
                g_reg_owner[k] = g_lc_n
                g_reg_used[k] = 1
                let reg = regs[k]
                return set_local(name, t, 100000 + reg)
            }
            k += 1
        }
    }
    let w = words(t)
    if w < 1 {
        w = 1
    }
    g_frame += w * 8
    return set_local(name, t, -g_frame)
}

fn set_local(name: string, t: string, off: int) -> int {
    if g_lc_n < len(g_lc_name) {
        g_lc_name[g_lc_n] = name
        g_lc_type[g_lc_n] = t
        g_lc_off[g_lc_n] = off
    } else {
        push(g_lc_name, name)
        push(g_lc_type, t)
        push(g_lc_off, off)
    }
    g_lc_n += 1
    return off
}






fn find_local(name: string) -> int {
    let i = g_lc_n - 1
    while i >= 0 {
        if g_lc_name[i] == name {
            return i
        }
        i -= 1
    }
    return -1
}

fn find_global(name: string) -> int {
    # runtime functions only see the runtime's own globals
    if g_cur_raw and not starts_with_s(name, "__") {
        return -1
    }
    let i = 0
    while i < len(g_gl_name) {
        if g_gl_name[i] == name {
            return i
        }
        i += 1
    }
    return -1
}

fn token_file(i: int) -> int {
    if i < len(g_tk_file) {
        return g_tk_file[i]
    }
    return 0
}

# Functions see the global variables of every file, but a plain `x = ...` in a
# function only changes a global of its own file; otherwise x is a new local.
# This keeps libraries and the program from changing each other's variables.
fn foreign_global(name: string, at: int) -> bool {
    if g_in_top or find_local(name) >= 0 {
        return false
    }
    let gi = find_global(name)
    return gi >= 0 and g_gl_file[gi] != token_file(at)
}

fn add_global(name: string, t: string) -> int {
    push(g_gl_name, name)
    push(g_gl_type, t)
    push(g_gl_addr, a_globals() + g_gl_next)
    push(g_gl_file, token_file(g_pos))
    let w = words(t)
    if w < 1 {
        w = 1
    }
    g_gl_next += w * 8
    return len(g_gl_name) - 1
}

fn find_fn(name: string) -> int {
    let i = 0
    while i < len(g_fn_name) {
        if g_fn_name[i] == name {
            return i
        }
        i += 1
    }
    return -1
}

fn request_fn(i: int) {
    if g_fn_state[i] == 0 {
        g_fn_state[i] = 1
        push(g_queue, i)
    }
}

fn call_named(name: string) {
    let f = find_fn(name)
    if f < 0 {
        err("internal: missing runtime function " + name)
    }
    request_fn(f)
    e_call(g_fn_label[f])
    # a memory frame is only needed to give back memory this call may use
    if starts_with_s(name, "__") and not (starts_with_s(name, "__out") or name == "__streq" or name == "__flush" or name == "__lock" or name == "__unlock") {
        g_cur_framed = true
    }
    if has_heap(g_fn_ret[f]) {
        g_cur_framed = true
    }
}

# pushes the result of a call that just returned
fn take_result(t: string) {
    let w = words(t)
    if w > 1 {
        let i = w - 1
        while i >= 0 {
            e_push_abs(a_retbuf() + i * 8)
            i -= 1
        }
    }
}

# ============================================================================
# deep copies of values (when a value leaves the memory bucket it was made in)
# ============================================================================
fn mangle(t: string) -> string {
    let out = ""
    let n = len(t)
    let st = 0
    for i in 0..n {
        let c = byte_at(t, i)
        if c == 91 or c == 93 {
            out = out + slice(t, st, i) + "_"
            st = i + 1
        }
    }
    return out + slice(t, st, n)
}

fn clone_source(t: string) -> string {
    let name = "__clone_" + mangle(t)
    let s = "fn " + name + "(a: int, b: int) {\n"
    if t == "string" {
        s = s + "n = __load64(a + 8)\nif n > 0 {\np = __alloc_bytes_in(b, n)\n__memcpy(p, __load64(a), n)\n__store64(a, p)\n}\n}\n"
        return s
    }
    if is_array_t(t) {
        let e = elem_t(t)
        let w = words(e)
        s = s + "n = __load64(a + 8)\nif n == 0 {\n__store64(a, 0)\n__store64(a + 16, 0)\nreturn\n}\n"
        s = s + "p = __alloc_in(b, n * 8)\n__memcpy(p, __load64(a), n * 8)\n__store64(a, p)\n__store64(a + 16, n)\n"
        if w > 1 {
            s = s + "for i in 0..n {\nnb = __alloc_in(b, " + int_to_string(w * 8) + ")\n__memcpy(nb, __load64(p + i * 8), " + int_to_string(w * 8) + ")\n"
            if has_heap(e) {
                s = s + "__clone_" + mangle(e) + "(nb, b)\n"
            }
            s = s + "__store64(p + i * 8, nb)\n}\n"
        }
        return s + "}\n"
    }
    let si = struct_index(t)
    for f in split(g_st_fnames[si], ",") {
        let ft = field_type(t, f)
        if has_heap(ft) {
            s = s + "__clone_" + mangle(ft) + "(a + " + int_to_string(field_off(t, f)) + ", b)\n"
        }
    }
    return s + "}\n"
}

fn ensure_clone_fn(t: string) {
    let name = "__clone_" + mangle(t)
    if find_fn(name) >= 0 {
        return
    }
    let saved = g_pos
    let start = len(g_tk_kind)
    tokenize(clone_source(t), false)
    g_pos = start
    collect_fn("")
    g_pos = saved
    # nested types get their own copy functions
    if is_array_t(t) {
        if has_heap(elem_t(t)) {
            ensure_clone_fn(elem_t(t))
        }
    }
    let si = struct_index(t)
    if si >= 0 {
        for ft in split(g_st_ftypes[si], ",") {
            if has_heap(ft) {
                ensure_clone_fn(ft)
            }
        }
    }
}

# value of type t on the stack -> deep copy into bucket: 0 parent, 2 permanent
fn e_clone(t: string, target: int) {
    if not has_heap(t) {
        return
    }
    ensure_clone_fn(t)
    e_mov_rr(0, 4)
    e_push(0)
    if target == 2 {
        e_push_imm(2)
    } else {
        e_parent_bucket_rax()
        e_push(0)
    }
    call_named("__clone_" + mangle(t))
    e_add_rsp(16)
}

# ============================================================================
# expressions
# ============================================================================
fn binop_prec(s: string) -> int {
    if s == "*" or s == "/" or s == "%" {
        return 10
    }
    if s == "+" or s == "-" {
        return 9
    }
    if s == "<<" or s == ">>" {
        return 8
    }
    if s == "<" or s == ">" or s == "<=" or s == ">=" {
        return 7
    }
    if s == "==" or s == "!=" {
        return 6
    }
    if s == "&" {
        return 5
    }
    if s == "^" {
        return 4
    }
    if s == "|" {
        return 3
    }
    return 0
}

# Is the next operand a plain number or int variable that can be used directly?
# Sets g_simple_kind: 1 number, 2 local (g_simple_val = rbp offset), 3 global (address)
fn simple_operand(level: int) -> bool {
    g_simple_kind = 0
    let k = kind()
    let nxt = g_pos + 1
    if kind_at(nxt) == 5 {
        let ns = tk_at(nxt)
        if ns == "(" or ns == "[" or ns == "." {
            return false
        }
        if binop_prec(ns) > level {
            return false
        }
    }
    if k == 3 {
        if fits32(g_tk_num[g_pos]) {
            g_simple_kind = 1
            g_simple_val = g_tk_num[g_pos]
            return true
        }
        return false
    }
    if k == 1 {
        let name = tk()
        let li = find_local(name)
        if li >= 0 {
            if g_lc_type[li] == "int" {
                g_simple_kind = 2
                g_simple_val = g_lc_off[li]
                if is_reg_local(g_simple_val) {
                    g_simple_kind = 4
                    g_simple_val -= 100000
                }
                return true
            }
            return false
        }
        let gi = find_global(name)
        if gi >= 0 {
            if g_gl_type[gi] == "int" {
                g_simple_kind = 3
                g_simple_val = g_gl_addr[gi]
                return true
            }
        }
    }
    return false
}

# rax = rax OP simple operand. op: 0 add, 1 sub, 2 cmp, 3 and, 4 or, 5 xor, 6 imul
fn e_op_simple(op: int) {
    if g_simple_kind == 4 {
        e_alu(op, 0, g_simple_val)
    } else {
        if g_simple_kind == 1 {
            e_alu_imm(op, 0, g_simple_val)
        } else {
            if g_simple_kind == 2 {
                e_alu_mem(op, 5, g_simple_val)
            } else {
                e_alu_global(op, g_simple_val)
            }
        }
    }
    g_pos += 1
}

# rcx <- simple operand
fn e_simple_to_rcx() {
    if g_simple_kind == 4 {
        e_mov_rr(1, g_simple_val)
        g_pos += 1
        return
    }
    if g_simple_kind == 1 {
        e_mov_imm(1, g_simple_val)
    } else {
        if g_simple_kind == 2 {
            e_load(1, 5, g_simple_val)
        } else {
            e_load_abs(1, g_simple_val)
        }
    }
    g_pos += 1
}

# rax = rax OP rcx
fn e_op_rcx(op: int) {
    e_alu(op, 0, 1)
}

fn gen_expr() -> string {
    let t = gen_or()
    while is_sym("|>") {
        g_pos += 1
        to_stack(t)
        let name = expect_name()
        if not is_sym("(") {
            err("expected '(' after " + name + " in a |> pipe")
        }
        t = gen_call(name, t)
    }
    return t
}

fn gen_or() -> string {
    let t = gen_and()
    if not is_kw("or") and not is_sym("||") {
        return t
    }
    let l_true = new_label()
    let l_end = new_label()
    while is_kw("or") or is_sym("||") {
        g_pos += 1
        e_jnz_rax(l_true)
        gen_and()
    }
    e_jnz_rax(l_true)
    e_mov_imm(0, 0)
    e_jmp(l_end)
    place(l_true)
    e_mov_imm(0, 1)
    place(l_end)
    return "bool"
}

fn gen_and() -> string {
    let t = gen_bitor()
    if not is_kw("and") and not is_sym("&&") {
        return t
    }
    let l_false = new_label()
    let l_end = new_label()
    while is_kw("and") or is_sym("&&") {
        g_pos += 1
        e_jz_rax(l_false)
        gen_bitor()
    }
    e_jz_rax(l_false)
    e_mov_imm(0, 1)
    e_jmp(l_end)
    place(l_false)
    e_mov_imm(0, 0)
    place(l_end)
    return "bool"
}

fn need_int(t: string, op: string) {
    if t != "int" and t != "bool" {
        if t == "float" {
            err("'" + op + "' needs whole numbers, not float (use int())")
        }
        err("'" + op + "' needs numbers, not " + t)
    }
}

fn need_num(t: string, op: string) {
    if t != "float" {
        need_int(t, op)
    }
}

# an int in rax becomes a float when a float is wanted
fn coerce(have: string, want: string) -> string {
    if want == "float" and (have == "int" or have == "bool") {
        e_f_from_int(0)
        return "float"
    }
    return have
}

# rax = rax OP right side, for whole numbers or floats; returns the result type.
# opcode: 0 add, 1 sub, 2 compare, 6 multiply. A float compare leaves 0/1 in rax.
fn gen_num_rhs(op: string, level: int, opcode: int, t: string) -> string {
    need_num(t, op)
    if t != "float" and simple_operand(level) {
        e_op_simple(opcode)
        return "int"
    }
    e_push(0)
    let rt = gen_level(level + 1)
    need_num(rt, op)
    e_mov_rr(1, 0)
    e_pop(0)
    if t == "float" or rt == "float" {
        if t != "float" {
            e_f_from_int(0)
        }
        if rt != "float" {
            e_f_from_int(1)
        }
        if opcode == 2 {
            e_f_cmp(op)
        } else {
            e_f_op(opcode)
        }
        return "float"
    }
    e_op_rcx(opcode)
    return "int"
}

# generic left-assoc integer level: ops listed with their op codes
fn gen_int_rhs(op: string, level: int, opcode: int) {
    if simple_operand(level) {
        e_op_simple(opcode)
    } else {
        e_push(0)
        let rt = gen_level(level + 1)
        need_int(rt, op)
        e_mov_rr(1, 0)
        e_pop(0)
        e_op_rcx(opcode)
    }
}

fn gen_bitor() -> string {
    let t = gen_level(4)
    while is_sym("|") {
        need_int(t, "|")
        g_pos += 1
        gen_int_rhs("|", 3, 4)
        t = "int"
    }
    return t
}

# levels: 4 xor, 5 and, 6 equality, 7 compare, 8 shift, 9 add, 10 multiply
fn gen_level(level: int) -> string {
    if level == 4 {
        let t = gen_level(5)
        while is_sym("^") {
            need_int(t, "^")
            g_pos += 1
            gen_int_rhs("^", 4, 5)
            t = "int"
        }
        return t
    }
    if level == 5 {
        let t = gen_level(6)
        while is_sym("&") {
            need_int(t, "&")
            g_pos += 1
            gen_int_rhs("&", 5, 3)
            t = "int"
        }
        return t
    }
    if level == 6 {
        return gen_equality()
    }
    if level == 7 {
        return gen_compare()
    }
    if level == 8 {
        return gen_shift()
    }
    if level == 9 {
        return gen_additive()
    }
    if level == 10 {
        return gen_multiplicative()
    }
    return gen_unary()
}

fn gen_equality() -> string {
    let t = gen_compare()
    while is_sym("==") or is_sym("!=") {
        let op = tk()
        g_pos += 1
        if t == "string" {
            let rt = gen_compare()
            if rt != "string" {
                err("cannot compare string with " + rt)
            }
            call_named("__streq")
            e_add_rsp(32)
            if op == "!=" {
                e_not_bool_rax()
            }
        } else {
            if t != "int" and t != "bool" and t != "float" {
                err("cannot compare values of type " + t + " with " + op)
            }
            if gen_num_rhs(op, 6, 2, t) == "int" {
                if op == "==" {
                    e_setcc_rax(4)
                } else {
                    e_setcc_rax(5)
                }
            }
        }
        t = "bool"
    }
    return t
}

fn compare_cc(op: string) -> int {
    if op == "<" {
        return 12
    }
    if op == ">=" {
        return 13
    }
    if op == "<=" {
        return 14
    }
    return 15
}

fn gen_compare() -> string {
    let t = gen_shift()
    while is_sym("<") or is_sym(">") or is_sym("<=") or is_sym(">=") {
        let op = tk()
        g_pos += 1
        if gen_num_rhs(op, 7, 2, t) == "int" {
            e_setcc_rax(compare_cc(op))
        }
        t = "bool"
    }
    return t
}

fn gen_shift() -> string {
    let t = gen_additive()
    while is_sym("<<") or is_sym(">>") {
        let op = tk()
        need_int(t, op)
        g_pos += 1
        if simple_operand(8) {
            e_simple_to_rcx()
        } else {
            e_push(0)
            need_int(gen_additive(), op)
            e_mov_rr(1, 0)
            e_pop(0)
        }
        e_shift_rcx(op == "<<")
        t = "int"
    }
    return t
}

fn gen_additive() -> string {
    let t = gen_multiplicative()
    while is_sym("+") or is_sym("-") {
        let op = tk()
        g_pos += 1
        if t == "string" {
            if op != "+" {
                err("strings can only be joined with +")
            }
            let rt = gen_multiplicative()
            if rt != "string" {
                err("cannot add " + rt + " to a string (use int_to_string)")
            }
            call_named("__concat")
            e_add_rsp(32)
            take_result("string")
        } else {
            let opcode = 0
            if op == "-" {
                opcode = 1
            }
            t = gen_num_rhs(op, 9, opcode, t)
        }
    }
    return t
}

fn gen_multiplicative() -> string {
    let t = gen_unary()
    while is_sym("*") or is_sym("/") or is_sym("%") {
        let op = tk()
        need_num(t, op)
        g_pos += 1
        if op == "*" {
            t = gen_num_rhs(op, 10, 6, t)
            continue
        }
        if t != "float" {
            if kind() == 3 and g_tk_num[g_pos] == 10 and binop_prec(tk_at(g_pos + 1)) <= 10 and not is_sym_at(g_pos + 1, "(") {
                # x / 10 by multiplying with a magic constant (much faster than idiv)
                g_pos += 1
                e_divmod10(op == "%")
                t = "int"
                continue
            }
            if simple_operand(10) {
                e_simple_to_rcx()
                e_divmod_rcx(op == "%")
                t = "int"
                continue
            }
        }
        e_push(0)
        let rt = gen_unary()
        need_num(rt, op)
        e_mov_rr(1, 0)
        e_pop(0)
        if t == "float" or rt == "float" {
            if op == "%" {
                err("'%' needs whole numbers, not float")
            }
            if t != "float" {
                e_f_from_int(0)
            }
            if rt != "float" {
                e_f_from_int(1)
            }
            e_f_op(7)
            t = "float"
        } else {
            e_divmod_rcx(op == "%")
            t = "int"
        }
    }
    return t
}

fn gen_unary() -> string {
    if is_sym("-") {
        g_pos += 1
        if kind() == 3 and not is_sym_at(g_pos + 1, "(") and not is_sym_at(g_pos + 1, "[") {
            e_mov_imm(0, -g_tk_num[g_pos])
            g_pos += 1
            return "int"
        }
        if kind() == 7 and not is_sym_at(g_pos + 1, "(") and not is_sym_at(g_pos + 1, "[") {
            e_mov_imm(0, g_tk_num[g_pos] ^ (1 << 63))
            g_pos += 1
            return "float"
        }
        let t = gen_unary()
        if t == "float" {
            e_f_unary(0)
            return "float"
        }
        need_int(t, "-")
        e_neg_rax()
        return "int"
    }
    if is_kw("not") or is_sym("!") {
        g_pos += 1
        let t = gen_unary()
        need_int(t, "not")
        e_not_bool_rax()
        return "bool"
    }
    return gen_postfix()
}


# variable address -> rax. Returns the type or "" when the name is not a variable.
fn e_var_addr(name: string) -> string {
    let li = find_local(name)
    if li >= 0 {
        e_lea(0, 5, g_lc_off[li])
        return g_lc_type[li]
    }
    let gi = find_global(name)
    if gi >= 0 {
        e_lea_data(0, g_gl_addr[gi])
        g_place_perm = true
        return g_gl_type[gi]
    }
    return ""
}

# load a whole variable as a value (fast path, no address math)
fn e_var_value(name: string) -> string {
    let li = find_local(name)
    if li >= 0 {
        let t = g_lc_type[li]
        let w = words(t)
        let off = g_lc_off[li]
        if w == 1 {
            loc_load(0, off)
        } else {
            let i = w - 1
            while i >= 0 {
                e_push_mem(5, off + i * 8)
                i -= 1
            }
        }
        return t
    }
    let gi = find_global(name)
    if gi >= 0 {
        let t = g_gl_type[gi]
        let w = words(t)
        let a = g_gl_addr[gi]
        if w == 1 {
            e_load_abs(0, a)
        } else {
            let i = w - 1
            while i >= 0 {
                e_push_abs(a + i * 8)
                i -= 1
            }
        }
        return t
    }
    return ""
}

# postfix chains: calls, a[i], s[i], x.field, x.method()
# while `addr` is true the place's address is in rax instead of its value
fn gen_postfix() -> string {
    let t = ""
    let addr = false
    if kind() == 1 and tk() == "spawn" and kind_at(g_pos + 1) == 1 and find_local("spawn") < 0 and find_global("spawn") < 0 {
        return gen_spawn()
    }
    if kind() == 1 {
        let name = tk()
        if is_sym_at(g_pos + 1, "(") {
            g_pos += 1
            t = gen_call(name, "")
        } else {
            let chained = is_sym_at(g_pos + 1, "[") or is_sym_at(g_pos + 1, ".")
            if chained {
                t = e_var_addr(name)
                addr = true
            } else {
                t = e_var_value(name)
            }
            if t == "" {
                err("unknown name '" + name + "'")
            }
            g_pos += 1
        }
    } else {
        t = gen_primary()
    }
    let going = true
    while going {
        if is_sym("[") {
            g_pos += 1
            if t == "string" {
                if addr {
                    load_from_addr(t)
                    addr = false
                }
                let it = gen_expr()
                need_int(it, "[]")
                expect("]")
                e_push(0)
                call_named("__char_at")
                e_add_rsp(24)
                take_result("string")
            } else {
                if not is_array_t(t) {
                    err("cannot index a value of type " + t)
                }
                if addr {
                    if simple_operand(0) and is_sym_at(g_pos + 1, "]") {
                        e_mov_rr(1, 0)
                        if g_simple_kind == 1 {
                            e_mov_imm(0, g_simple_val)
                        } else {
                            if g_simple_kind == 4 {
                                e_mov_rr(0, g_simple_val)
                            }
                            if g_simple_kind == 2 {
                                e_load(0, 5, g_simple_val)
                            }
                            if g_simple_kind == 3 {
                                e_load_abs(0, g_simple_val)
                            }
                        }
                        g_pos += 1
                    } else {
                        e_push(0)
                        need_int(gen_expr(), "[]")
                        e_pop(1)
                    }
                    expect("]")
                    e_index(t)
                } else {
                    need_int(gen_expr(), "[]")
                    expect("]")
                    e_mov_rr(1, 4)
                    e_index(t)
                    e_add_rsp(24)
                }
                g_place_perm = true
                addr = true
                t = elem_t(t)
            }
        } else {
            if is_sym(".") and kind_at(g_pos + 1) == 1 {
                let f = tk_at(g_pos + 1)
                if is_sym_at(g_pos + 2, "(") {
                    if struct_index(t) < 0 {
                        err("cannot call ." + f + "() on a value of type " + t)
                    }
                    if addr {
                        load_from_addr(t)
                        addr = false
                    }
                    to_stack(t)
                    g_pos += 2
                    t = gen_call(t + "_" + f, t)
                } else {
                    if struct_index(t) < 0 {
                        err("cannot read ." + f + " of a value of type " + t)
                    }
                    let off = field_off(t, f)
                    if off < 0 {
                        err(t + " has no field '" + f + "'")
                    }
                    let ft = field_type(t, f)
                    if addr {
                        if off > 0 {
                            e_alu_imm(0, 0, off)
                        }
                    } else {
                        let w = words(t)
                        let fw = words(ft)
                        if fw == 1 {
                            e_load(0, 4, off)
                            e_add_rsp(w * 8)
                        } else {
                            let i = fw - 1
                            while i >= 0 {
                                e_load(0, 4, off + i * 8)
                                e_store(4, (w - fw) * 8 + i * 8, 0)
                                i -= 1
                            }
                            e_add_rsp((w - fw) * 8)
                        }
                    }
                    t = ft
                    g_pos += 2
                }
            } else {
                going = false
            }
        }
    }
    if addr {
        load_from_addr(t)
    }
    return t
}

# address of an assignable place -> rax. Sets g_place_perm when the place
# lives in long-lived memory (a global, or inside an array).
fn gen_place() -> string {
    g_place_perm = false
    let name = expect_name()
    let t = e_var_addr(name)
    if t == "" {
        err("unknown name '" + name + "'")
    }
    let going = true
    while going {
        if is_sym("[") {
            if not is_array_t(t) {
                err("cannot assign into a value of type " + t)
            }
            g_pos += 1
            e_push(0)
            need_int(gen_expr(), "[]")
            e_pop(1)
            expect("]")
            e_index(t)
            g_place_perm = true
            t = elem_t(t)
        } else {
            if is_sym(".") {
                g_pos += 1
                let f = expect_name()
                if struct_index(t) < 0 {
                    err("cannot set ." + f + " on a value of type " + t)
                }
                let off = field_off(t, f)
                if off < 0 {
                    err(t + " has no field '" + f + "'")
                }
                if off > 0 {
                    e_alu_imm(0, 0, off)
                }
                t = field_type(t, f)
            } else {
                going = false
            }
        }
    }
    return t
}

# true when the place starting at token i is a global or goes through an array
fn place_is_perm(i: int) -> bool {
    let name = tk_at(i)
    if find_local(name) < 0 and find_global(name) >= 0 {
        return true
    }
    let j = i + 1
    while is_sym_at(j, "[") or is_sym_at(j, ".") {
        if is_sym_at(j, "[") {
            return true
        }
        j += 2
    }
    return false
}

# token index just after the [...] that starts at token j
fn skip_brackets(j: int) -> int {
    let depth = 0
    while true {
        if is_sym_at(j, "[") {
            depth += 1
        }
        if is_sym_at(j, "]") {
            depth -= 1
            if depth == 0 {
                return j + 1
            }
        }
        if kind_at(j) == 6 {
            err("missing ']'")
        }
        j += 1
    }
    return j
}

# token index just after a place expression starting at i
fn skip_place(i: int) -> int {
    let j = i + 1
    let going = true
    while going {
        if is_sym_at(j, ".") {
            j += 2
        } else {
            if is_sym_at(j, "[") {
                j = skip_brackets(j)
            } else {
                going = false
            }
        }
    }
    return j
}

fn gen_primary() -> string {
    let k = kind()
    if k == 3 {
        e_mov_imm(0, g_tk_num[g_pos])
        g_pos += 1
        return "int"
    }
    if k == 7 {
        e_mov_imm(0, g_tk_num[g_pos])
        g_pos += 1
        return "float"
    }
    if k == 4 {
        e_string_literal(tk())
        g_pos += 1
        return "string"
    }
    if is_kw("true") {
        e_mov_imm(0, 1)
        g_pos += 1
        return "bool"
    }
    if is_kw("false") {
        e_mov_imm(0, 0)
        g_pos += 1
        return "bool"
    }
    if is_sym("(") {
        g_pos += 1
        let t = gen_expr()
        expect(")")
        return t
    }
    if is_sym("[") {
        return gen_array_literal()
    }
    if k == 6 {
        err("unexpected end of file")
    }
    err("unexpected '" + tk() + "'")
    return ""
}

# zero a 3-word array header at rbp+off
fn e_zero_header(off: int) {
    for i in 0..3 {
        e_store_imm(5, off + i * 8, 0)
    }
}

# value of type et on the stack -> appended to the array whose header is at rbp+off
fn e_push_into_local(off: int, et: string) {
    e_lea(0, 5, off)
    e_push(0)
    e_cur_bucket_rcx()
    e_push(1)
    e_push_imm(words(et))
    call_named("__push_slot")
    e_add_rsp(24)
    store_to_addr(et)
}

fn gen_array_literal() -> string {
    expect("[")
    if is_sym("]") {
        g_pos += 1
        let t = "array[int]"
        if is_array_t(g_want) {
            t = g_want
        }
        e_push_imm(0)
        e_push_imm(0)
        e_push_imm(0)
        return t
    }
    # list comprehension?  [expr for x in items if cond]
    let j = g_pos
    let depth = 0
    let comp_at = -1
    while depth >= 0 and kind_at(j) != 6 {
        if kind_at(j) == 5 {
            let s = tk_at(j)
            if s == "[" or s == "(" or s == "{" {
                depth += 1
            }
            if s == "]" or s == ")" or s == "}" {
                depth -= 1
            }
        }
        if depth == 0 and kind_at(j) == 2 and tk_at(j) == "for" and comp_at < 0 {
            comp_at = j
        }
        j += 1
    }
    if comp_at >= 0 {
        return gen_comprehension(comp_at)
    }
    let hdr = add_local("", "array[int]")
    e_zero_header(hdr)
    let et = ""
    let going = true
    while going {
        let saved_want = g_want
        if is_array_t(g_want) {
            g_want = elem_t(g_want)
        }
        let t = gen_expr()
        g_want = saved_want
        if et == "" {
            et = t
        } else {
            if t != et {
                err("array items must all have the same type (" + et + " vs " + t + ")")
            }
        }
        to_stack(t)
        e_push_into_local(hdr, t)
        if is_sym(",") {
            g_pos += 1
            if is_sym("]") {
                going = false
            }
        } else {
            going = false
        }
    }
    expect("]")
    for i in 0..3 {
        e_push_mem(5, hdr + 16 - i * 8)
    }
    return "array[" + et + "]"
}

fn gen_comprehension(comp_at: int) -> string {
    let expr_at = g_pos
    let saved_n = g_lc_n
    g_pos = comp_at + 1
    let var = expect_name()
    expect("in")
    let l_top = new_label()
    let l_next = new_label()
    let l_end = new_label()
    let res = add_local("", "array[int]")
    e_zero_header(res)
    let var_off = 0
    let it_t = gen_expr()
    let is_range = false
    let src = 0
    let idx = add_local("#i", "int")
    let lim = add_local("", "int")
    if is_sym("..") {
        need_int(it_t, "..")
        is_range = true
        g_pos += 1
        loc_store(idx, 0)
        need_int(gen_expr(), "..")
        e_store(5, lim, 0)
        var_off = add_local(var, "int")
    } else {
        if not is_array_t(it_t) {
            err("can only loop over arrays and ranges, not " + it_t)
        }
        src = add_local("", it_t)
        e_lea(0, 5, src)
        store_to_addr(it_t)
        loc_set0(idx)
        var_off = add_local(var, elem_t(it_t))
    }
    let cond_at = -1
    if is_kw("if") {
        g_pos += 1
        cond_at = g_pos
    }
    place(l_top)
    loc_load(0, idx)
    if is_range {
        e_alu_mem(2, 5, lim)
    } else {
        e_alu_mem(2, 5, src + 8)
    }
    e_jcc(13, l_end)
    if is_range {
        loc_store(var_off, 0)
    } else {
        e_load(1, 5, src)
        e_load_elem_to_local(elem_t(it_t), var_off)
    }
    let end_at = 0
    if cond_at >= 0 {
        g_pos = cond_at
        gen_cond(l_next)
    }
    end_at = g_pos
    g_pos = expr_at
    let et = gen_expr()
    if not is_kw("for") {
        err("expected 'for' in list comprehension")
    }
    to_stack(et)
    e_push_into_local(res, et)
    place(l_next)
    loc_inc(idx)
    e_jmp(l_top)
    place(l_end)
    g_pos = end_at
    expect("]")
    g_lc_n = saved_n
    for i in 0..3 {
        e_push_mem(5, res + 16 - i * 8)
    }
    return "array[" + et + "]"
}

# rcx = array data pointer, rax = element number -> element copied to the local at rbp+dst
fn e_load_elem_to_local(et: string, dst: int) {
    e_load_slot()
    let w = words(et)
    if w == 1 {
        loc_store(dst, 0)
    } else {
        for i in 0..w {
            e_load(1, 0, i * 8)
            e_store(5, dst + i * 8, 1)
        }
    }
}

# ============================================================================
# calls and built-in functions
# ============================================================================
fn builtin_alias(name: string) -> string {
    if name == "read_file" or name == "write_file" or name == "int_to_string" or name == "to_int" {
        return "__" + name
    }
    if name == "char_at" or name == "byte_at" or name == "slice" or name == "split" or name == "join" {
        return "__" + name
    }
    if name == "chr" or name == "find" or name == "contains" or name == "starts_with" or name == "ends_with" {
        return "__" + name
    }
    if name == "trim" or name == "exit" or name == "make_executable" or name == "bytes_to_string" or name == "remove_file" {
        return "__" + name
    }
    if name == "exec" or name == "clock_ns" or name == "eprint" or name == "input" or name == "upper" or name == "lower" {
        return "__" + name
    }
    if name == "socket_listen" or name == "socket_accept" or name == "socket_read" or name == "socket_write" or name == "socket_close" or name == "socket_connect" {
        return "__" + name
    }
    if name == "str" {
        return "__int_to_string"
    }
    if name == "string_equal" {
        return "__streq"
    }
    if name == "slop_pack" or name == "slop_unpack" or name == "run" or name == "run_status" or name == "os_name" or name == "arch_name" {
        return "__" + name
    }
    if name == "replace" or name == "repeat" or name == "lock" or name == "unlock" or name == "cpu_count" {
        return "__" + name
    }
    if name == "env" or name == "make_dir" or name == "program_path" or name == "input_ended" or name == "file_exists" {
        return "__" + name
    }
    if name == "round" or name == "pow" or name == "exp" or name == "log" or name == "sin" or name == "cos" or name == "tan" or name == "atan" {
        return "__f" + name
    }
    return ""
}

fn no_types() -> array[string] {
    let none: array[string] = []
    return none
}

# evaluates call arguments (pushing each one); pos is at '('
fn gen_args(expected: array[string]) -> array[string] {
    expect("(")
    let types: array[string] = []
    let i = 0
    while not is_sym(")") {
        let saved_want = g_want
        if i < len(expected) {
            g_want = expected[i]
        }
        let t = gen_expr()
        g_want = saved_want
        if i < len(expected) {
            t = coerce(t, expected[i])
        }
        to_stack(t)
        push(types, t)
        i += 1
        if is_sym(",") {
            g_pos += 1
        } else {
            if not is_sym(")") {
                err("expected ',' or ')' in call")
            }
        }
    }
    g_pos += 1
    return types
}

# Every value is worked out first and kept in a hidden local; only then is
# the output locked and the line written, so a print that waits (on the
# network, say) never keeps other threads from printing.
fn gen_print(pre: string) {
    let types: array[string] = []
    let offs: array[int] = []
    if pre != "" {
        if words(pre) == 1 {
            e_pop(0)
        }
        let off = add_local("", pre)
        store_local(off, pre)
        push(types, pre)
        push(offs, off)
    }
    expect("(")
    while not is_sym(")") {
        let t = gen_expr()
        if words(t) < 1 {
            err("cannot print a value of type " + t)
        }
        let off = add_local("", t)
        store_local(off, t)
        push(types, t)
        push(offs, off)
        if is_sym(",") {
            g_pos += 1
        }
    }
    g_pos += 1
    call_named("__out_lock")
    for i in 0..len(types) {
        if i > 0 {
            e_push_imm(32)
            call_named("__out_byte")
            e_add_rsp(8)
        }
        let t = types[i]
        let w = words(t)
        if w == 1 {
            loc_load(0, offs[i])
            e_push(0)
        } else {
            let k = w - 1
            while k >= 0 {
                e_push_mem(5, offs[i] + k * 8)
                k -= 1
            }
        }
        print_value(t)
    }
    e_push_imm(10)
    call_named("__out_byte")
    e_add_rsp(8)
    call_named("__out_unlock")
}

# value of type t on the stack -> written to the output
fn print_value(t: string) {
    if t == "string" {
        call_named("__out_str")
        e_add_rsp(16)
        return
    }
    if t == "int" {
        call_named("__out_int")
        e_add_rsp(8)
        return
    }
    if t == "bool" {
        call_named("__out_bool")
        e_add_rsp(8)
        return
    }
    if t == "float" {
        call_named("_slop_out_float")
        e_add_rsp(8)
        return
    }
    if t == "array[float]" {
        call_named("__out_floats")
        e_add_rsp(24)
        return
    }
    if t == "array[int]" {
        call_named("__out_ints")
        e_add_rsp(24)
        return
    }
    if t == "array[string]" {
        call_named("__out_strs")
        e_add_rsp(24)
        return
    }
    err("cannot print a value of type " + t)
}

fn gen_push_builtin() -> string {
    expect("(")
    let place_at = g_pos
    if kind() != 1 {
        err("push needs a variable as its first argument")
    }
    let perm = place_is_perm(place_at)
    g_pos = skip_place(place_at)
    expect(",")
    # find the array's type without emitting code: dry run on a copy of the cursor
    let arr_t = place_type(place_at)
    if not is_array_t(arr_t) {
        err("push needs an array, not " + arr_t)
    }
    let et = elem_t(arr_t)
    let saved_want = g_want
    g_want = et
    let vt = gen_expr()
    g_want = saved_want
    if vt != et {
        err("cannot push " + vt + " onto " + arr_t)
    }
    expect(")")
    let end_at = g_pos
    to_stack(et)
    if perm {
        e_clone(et, 2)
    }
    g_pos = place_at
    gen_place()
    g_pos = end_at
    if words(et) == 1 and not perm {
        # room left: write straight into the next slot
        let l_slow = new_label()
        let l_store = new_label()
        e_mov_rr(1, 0)
        e_load(2, 1, 8)
        e_load(0, 1, 16)
        e_alu(2, 2, 0)
        e_jcc(3, l_slow)
        e_load(0, 1, 0)
        e_add_scaled(0, 2)
        e_add_mem(1, 8, 1)
        e_jmp(l_store)
        place(l_slow)
        e_push(1)
        e_cur_bucket_rcx()
        e_push(1)
        e_push_imm(1)
        call_named("__push_slot")
        e_add_rsp(24)
        place(l_store)
        store_to_addr(et)
        return "void"
    }
    e_push(0)
    if perm {
        e_push_imm(2)
    } else {
        e_cur_bucket_rcx()
        e_push(1)
    }
    e_push_imm(words(et))
    call_named("__push_slot")
    e_add_rsp(24)
    store_to_addr(et)
    return "void"
}

# type of the place starting at token i (no code)
fn place_type(i: int) -> string {
    let name = tk_at(i)
    let t = ""
    let li = find_local(name)
    if li >= 0 {
        t = g_lc_type[li]
    } else {
        let gi = find_global(name)
        if gi < 0 {
            err("unknown name '" + name + "'")
        }
        t = g_gl_type[gi]
    }
    let j = i + 1
    let going = true
    while going {
        if is_sym_at(j, ".") {
            if struct_index(t) < 0 {
                err("no fields on " + t)
            }
            t = field_type(t, tk_at(j + 1))
            if t == "" {
                err("unknown field '" + tk_at(j + 1) + "'")
            }
            j += 2
        } else {
            if is_sym_at(j, "[") {
                if not is_array_t(t) {
                    err("cannot index " + t)
                }
                t = elem_t(t)
                j = skip_brackets(j)
            } else {
                going = false
            }
        }
    }
    return t
}

fn gen_pop_builtin() -> string {
    expect("(")
    let place_at = g_pos
    let arr_t = place_type(place_at)
    if not is_array_t(arr_t) {
        err("pop needs an array, not " + arr_t)
    }
    gen_place()
    expect(")")
    e_push(0)
    call_named("__pop_slot")
    e_add_rsp(8)
    let et = elem_t(arr_t)
    if words(et) > 1 {
        e_load(0, 0, 0)
    }
    load_from_addr(et)
    return et
}

# low-level and memory intrinsics; all arguments are already on the stack
fn gen_intrinsic(name: string, n: int) -> string {
    let sizes = ["8", "16", "32", "64"]
    for sz in sizes {
        if name == "__load" + sz or name == "unsafe_load" + sz or (sz == "32" and name == "mmio_read32") {
            e_pop(0)
            e_load_sized(to_int(sz) / 8)
            if name == "mmio_read32" {
                e_cpu(1)
            }
            return "int"
        }
        if name == "__store" + sz or name == "unsafe_store" + sz or (sz == "32" and name == "mmio_write32") {
            e_pop(0)
            e_pop(1)
            e_store_sized(to_int(sz) / 8)
            if name == "mmio_write32" {
                e_cpu(1)
            }
            return "void"
        }
    }
    if name == "__alloc" or name == "__alloc_bytes" or name == "__alloc_in" or name == "__alloc_bytes_in" {
        e_pop(0)
        if name == "__alloc_in" or name == "__alloc_bytes_in" {
            e_pop(1)
        } else {
            e_cur_bucket_rcx()
        }
        e_alloc(name == "__alloc" or name == "__alloc_in")
        g_cur_framed = true
        return "int"
    }
    if name == "__bump" {
        e_pop(0)
        e_bump_read()
        return "int"
    }
    if name == "__data" {
        e_lea_data(0, 0)
        return "int"
    }
    if name == "__arch" {
        e_mov_imm(0, g_arch)
        return "int"
    }
    if name == "__clone" {
        e_clone_thread()
        return "int"
    }
    if name == "__xchg" {
        e_pop(0)
        e_pop(1)
        e_xchg()
        return "int"
    }
    if name == "__cur_bucket" {
        e_cur_bucket_rcx()
        e_mov_rr(0, 1)
        return "int"
    }
    if name == "__memcpy" or name == "ram_copy" {
        e_pop(1)
        e_pop(6)
        e_pop(7)
        e_memcpy()
        return "void"
    }
    if name == "__memzero" or name == "ram_zero" {
        e_pop(1)
        e_pop(7)
        e_memzero()
        return "void"
    }
    if name == "__memeq" {
        e_pop(1)
        e_pop(6)
        e_pop(7)
        e_memeq()
        return "bool"
    }
    if name == "__syscall" {
        e_syscall(n)
        return "int"
    }
    if name == "__str" {
        e_pop(0)
        e_pop(1)
        e_push(0)
        e_push(1)
        return "string"
    }
    if name == "__str_ptr" {
        e_pop(0)
        e_add_rsp(8)
        return "int"
    }
    if name == "__sp0" {
        e_load_abs(0, a_sp0())
        return "int"
    }
    if name == "__scratch" {
        e_lea_data(0, a_scratch())
        return "int"
    }
    if name == "cpu_cycles" {
        e_cpu(0)
        return "int"
    }
    if name == "cpu_fence" or name == "device_fence" or name == "gpu_fence" {
        e_cpu(1)
        return "void"
    }
    if name == "cpu_relax" {
        e_cpu(2)
        return "void"
    }
    if name == "cpu_prefetch" {
        e_pop(0)
        e_cpu(3)
        return "void"
    }
    if name == "component_base" {
        e_pop(0)
        return "int"
    }
    return ""
}

fn intrinsic_arity(name: string) -> int {
    if name == "__sp0" or name == "__scratch" or name == "__cur_bucket" or name == "cpu_cycles" or name == "cpu_fence" or name == "__data" or name == "__arch" {
        return 0
    }
    if name == "device_fence" or name == "gpu_fence" or name == "cpu_relax" {
        return 0
    }
    if name == "__load8" or name == "__load16" or name == "__load32" or name == "__load64" or name == "__alloc" or name == "__alloc_bytes" or name == "__bump" {
        return 1
    }
    if name == "unsafe_load8" or name == "unsafe_load16" or name == "unsafe_load32" or name == "unsafe_load64" {
        return 1
    }
    if name == "mmio_read32" or name == "cpu_prefetch" or name == "component_base" {
        return 1
    }
    if name == "__store8" or name == "__store16" or name == "__store32" or name == "__store64" or name == "__alloc_in" or name == "__alloc_bytes_in" or name == "__str" {
        return 2
    }
    if name == "__xchg" {
        return 2
    }
    if name == "__clone" {
        return 4
    }
    if name == "unsafe_store8" or name == "unsafe_store16" or name == "unsafe_store32" or name == "unsafe_store64" {
        return 2
    }
    if name == "mmio_write32" or name == "ram_zero" or name == "__memzero" {
        return 2
    }
    if name == "__memcpy" or name == "__memeq" or name == "ram_copy" {
        return 3
    }
    if name == "__syscall" {
        return 99
    }
    if name == "__str_ptr" {
        return 50
    }
    return -1
}

fn is_num_builtin(name: string) -> bool {
    if name == "float" or name == "to_float" or name == "int" or name == "str" or name == "int_to_string" {
        return true
    }
    if name == "float_bits" or name == "float_from_bits" {
        return true
    }
    return name == "sqrt" or name == "floor" or name == "ceil" or name == "abs"
}

# float(x), int(x), str(x), sqrt, floor, ceil and abs work on any number
fn gen_num_builtin(name: string, pre: string) -> string {
    let t = pre
    expect("(")
    if pre == "" {
        t = gen_expr()
    } else {
        from_stack(pre)
    }
    expect(")")
    if name == "float_bits" {
        if t != "float" {
            err("float_bits needs a float, not " + t)
        }
        return "int"
    }
    if name == "float_from_bits" {
        need_int(t, name)
        return "float"
    }
    if name == "str" or name == "int_to_string" {
        if t == "string" {
            return t
        }
        need_num(t, name)
        e_push(0)
        if t == "float" {
            call_named("_slop_float_to_string")
        } else {
            call_named("__int_to_string")
        }
        e_add_rsp(8)
        take_result("string")
        return "string"
    }
    if t == "string" and name != "int" and name != "float" and name != "to_float" {
        err(name + " needs a number, not string")
    }
    if name == "int" {
        if t == "string" {
            call_named("__to_int")
            e_add_rsp(16)
        } else {
            need_num(t, name)
            if t == "float" {
                e_f_to_int()
            }
        }
        return "int"
    }
    if t == "string" {
        call_named("_slop_parse_float_bits")
        e_add_rsp(16)
        return "float"
    }
    need_num(t, name)
    if name == "abs" and t != "float" {
        e_push(0)
        call_named("__iabs")
        e_add_rsp(8)
        return "int"
    }
    coerce(t, "float")
    if name == "abs" {
        e_f_unary(1)
    }
    if name == "sqrt" {
        e_f_unary(2)
    }
    if name == "floor" {
        e_f_unary(3)
    }
    if name == "ceil" {
        e_f_unary(4)
    }
    return "float"
}

# spawn f(args): runs f on a new thread; the value is the thread
fn gen_spawn() -> string {
    g_pos += 1
    let name = expect_name()
    let f = find_fn(name)
    if f < 0 or not is_sym("(") {
        err("spawn needs a call to one of your functions, like spawn work(1)")
    }
    let ptypes: array[string] = []
    if g_fn_ptypes[f] != "" {
        ptypes = split(g_fn_ptypes[f], ",")
    }
    let types = gen_args(ptypes)
    if len(types) != len(ptypes) {
        err(name + " takes " + int_to_string(len(ptypes)) + " arguments (" + join(ptypes, ", ") + "), got " + int_to_string(len(types)))
    }
    let argbytes = 0
    for i in 0..len(types) {
        if types[i] != ptypes[i] {
            err(name + ": argument " + int_to_string(i + 1) + " should be " + ptypes[i] + ", got " + types[i])
        }
        argbytes += words(types[i]) * 8
    }
    if argbytes > 3072 {
        err("spawn: too many arguments for " + name)
    }
    let rt = g_fn_ret[f]
    if rt != "void" and rt != "int" and rt != "bool" and rt != "float" {
        err("spawn: " + name + " must return int, float, bool or nothing")
    }
    # the code the new thread runs (skipped here)
    let l_thread = new_label()
    let l_over = new_label()
    e_jmp(l_over)
    place(l_thread)
    e_thread_enter()
    call_named("__thread_init")
    let i = argbytes / 8 - 1
    while i >= 0 {
        e_push_mem(15, 4096 + i * 8)
        i -= 1
    }
    call_named(name)
    e_add_rsp(argbytes)
    if rt == "void" {
        e_mov_imm(0, 0)
    }
    e_store(15, 7192, 0)
    e_thread_leave()
    place(l_over)
    # __thread_spawn(entry, arguments, size)
    e_mov_rr(1, 4)
    e_lea_label(0, l_thread)
    e_push(0)
    e_push(1)
    e_push_imm(argbytes)
    call_named("__thread_spawn")
    e_add_rsp(24 + argbytes)
    return "thread[" + rt + "]"
}

# join(thread) waits for it and gives its result; join(list, sep) joins text
fn gen_join(pre: string) -> string {
    let t = pre
    expect("(")
    if pre == "" {
        t = gen_expr()
    } else {
        from_stack(pre)
    }
    if starts_with_s(t, "thread[") {
        expect(")")
        e_push(0)
        call_named("__thread_join")
        e_add_rsp(8)
        return slice(t, 7, len(t) - 1)
    }
    if t != "array[string]" {
        err("join needs a thread, or a list of strings and a separator")
    }
    to_stack(t)
    if is_sym(",") {
        g_pos += 1
    }
    let st = gen_expr()
    if st != "string" {
        err("join: the separator should be a string, not " + st)
    }
    expect(")")
    call_named("__join")
    e_add_rsp(40)
    take_result("string")
    return "string"
}

# pos is at '('. pre is the type of an argument already pushed (pipes and methods), or ""
fn gen_call(name: string, pre: string) -> string {
    if pre == "" {
        if name == "push" {
            return gen_push_builtin()
        }
        if name == "pop" {
            return gen_pop_builtin()
        }
        if name == "addr_of" {
            expect("(")
            gen_place()
            expect(")")
            return "int"
        }
    }
    if name == "print" {
        gen_print(pre)
        return "void"
    }
    if is_num_builtin(name) and find_fn(name) < 0 {
        return gen_num_builtin(name, pre)
    }
    if name == "join" and find_fn(name) < 0 {
        return gen_join(pre)
    }
    if (name == "__ccall" or name == "__ccall32") and pre == "" {
        expect("(")
        if kind() != 4 {
            err(name + " needs a function name in quotes")
        }
        let fname = tk()
        g_pos += 1
        let n = 0
        while is_sym(",") {
            g_pos += 1
            need_int(gen_expr(), name)
            e_push(0)
            n += 1
        }
        expect(")")
        e_ccall(fname, n)
        if name == "__ccall32" {
            # the result is a 32-bit int: sign-extend it
            e_sext32_rax()
        }
        return "int"
    }
    if name == "embed" and pre == "" {
        # embed("file") is the file's contents as a string, read when compiling
        expect("(")
        if kind() != 4 {
            err("embed needs a file name in quotes")
        }
        let path = g_src_dir + tk()
        let content = read_file(path)
        if len(content) == 0 {
            err("embed: cannot read " + path)
        }
        g_pos += 1
        expect(")")
        e_string_literal(content)
        return "string"
    }
    let ar = intrinsic_arity(name)
    if ar >= 0 {
        let types = gen_args(no_types())
        let n = len(types)
        if pre != "" {
            n += 1
        }
        if ar == 50 {
            if n != 1 or (pre == "" and types[0] != "string") {
                err(name + " takes one string")
            }
        } else {
            if ar == 99 {
                if n < 1 or n > 7 {
                    err("__syscall takes 1 to 7 numbers")
                }
            } else {
                if n != ar {
                    err(name + " takes " + int_to_string(ar) + " arguments")
                }
            }
            for at in types {
                need_int(at, name)
            }
        }
        return gen_intrinsic(name, n)
    }
    if name == "len" or name == "length" {
        let types = gen_args(no_types())
        let t = pre
        if pre == "" {
            if len(types) != 1 {
                err("len takes one argument")
            }
            t = types[0]
        }
        if t == "string" {
            e_load(0, 4, 8)
            e_add_rsp(16)
        } else {
            if not is_array_t(t) {
                err("len needs a string or an array, not " + t)
            }
            e_load(0, 4, 8)
            e_add_rsp(24)
        }
        return "int"
    }
    let target = name
    let alias = builtin_alias(name)
    if alias != "" and find_fn(name) < 0 {
        target = alias
    }
    # struct constructor
    let si = struct_index(target)
    if si >= 0 {
        let ftypes = split(g_st_ftypes[si], ",")
        let types = gen_args(ftypes)
        if pre != "" {
            err("cannot pipe into a struct constructor")
        }
        if len(types) != len(ftypes) {
            err(target + " needs " + int_to_string(len(ftypes)) + " values (" + join(ftypes, ", ") + ")")
        }
        for i in 0..len(types) {
            if types[i] != ftypes[i] {
                err(target + ": field " + int_to_string(i + 1) + " should be " + ftypes[i] + ", got " + types[i])
            }
        }
        from_stack(target)
        return target
    }
    let f = find_fn(target)
    if f < 0 {
        err("unknown function '" + name + "'")
    }
    let ptypes: array[string] = []
    if g_fn_ptypes[f] != "" {
        ptypes = split(g_fn_ptypes[f], ",")
    }
    let rest: array[string] = []
    let skip = 0
    if pre != "" {
        skip = 1
    }
    let k = skip
    while k < len(ptypes) {
        push(rest, ptypes[k])
        k += 1
    }
    if pre != "" and len(ptypes) > 0 and ptypes[0] == "float" and (pre == "int" or pre == "bool") {
        e_pop(0)
        e_f_from_int(0)
        e_push(0)
        pre = "float"
    }
    let types = gen_args(rest)
    let all: array[string] = []
    if pre != "" {
        push(all, pre)
    }
    for at in types {
        push(all, at)
    }
    if len(all) != len(ptypes) {
        err(name + " takes " + int_to_string(len(ptypes)) + " arguments (" + join(ptypes, ", ") + "), got " + int_to_string(len(all)))
    }
    let argbytes = 0
    for i in 0..len(all) {
        if all[i] != ptypes[i] {
            err(name + ": argument " + int_to_string(i + 1) + " should be " + ptypes[i] + ", got " + all[i])
        }
        argbytes += words(all[i]) * 8
    }
    call_named(target)
    e_add_rsp(argbytes)
    let rt = g_fn_ret[f]
    take_result(rt)
    return rt
}

# ============================================================================
# statements
# ============================================================================
# jumps to l_false when the condition is false
fn gen_cond(l_false: int) {
    g_cmp_end = -1
    let t = gen_expr()
    if t != "bool" and t != "int" {
        err("a condition must be true/false, not " + t)
    }
    if g_cmp_end == g_code_len {
        g_code_len = g_cmp_at
        e_jcc(invert_cc(g_cmp_cc), l_false)
    } else {
        e_jz_rax(l_false)
    }
}

fn gen_block() {
    expect("{")
    let saved = g_lc_n
    while not is_sym("}") {
        if kind() == 6 {
            err("missing '}'")
        }
        gen_stmt()
    }
    g_pos += 1
    g_lc_n = saved
}

# value of type t on the stack/rax -> stored into a new or existing variable
fn store_var(name: string, t: string, declare: bool) {
    let li = -1
    if not declare {
        li = find_local(name)
    }
    if li >= 0 {
        t = coerce(t, g_lc_type[li])
        if g_lc_type[li] != t {
            err("'" + name + "' holds " + g_lc_type[li] + ", cannot assign " + t)
        }
        store_local(g_lc_off[li], t)
        return
    }
    let gi = find_global(name)
    if gi >= 0 and (not declare or g_in_top) {
        t = coerce(t, g_gl_type[gi])
        if g_gl_type[gi] != t {
            err("'" + name + "' holds " + g_gl_type[gi] + ", cannot assign " + t)
        }
        store_global(gi, t)
        return
    }
    if g_in_top {
        store_global(add_global(name, t), t)
        return
    }
    store_local(add_local(name, t), t)
}

fn store_local(off: int, t: string) {
    let w = words(t)
    if w == 1 {
        loc_store(off, 0)
    } else {
        for i in 0..w {
            e_pop_mem(5, off + i * 8)
        }
    }
}

fn store_global(gi: int, t: string) {
    let a = g_gl_addr[gi]
    let w = words(t)
    if has_heap(t) {
        e_clone(t, 2)
    }
    if w == 1 {
        e_store_abs(a, 0)
    } else {
        for i in 0..w {
            e_pop_abs(a + i * 8)
        }
    }
}

fn gen_let() {
    let name = expect_name()
    let t = ""
    if is_sym(":") {
        g_pos += 1
        t = parse_type()
    }
    expect("=")
    let saved_want = g_want
    g_want = t
    let vt = coerce(gen_expr(), t)
    g_want = saved_want
    if t != "" and vt != t {
        err("'" + name + "' is declared as " + t + " but given " + vt)
    }
    if vt == "void" {
        err("'" + name + "' cannot hold the result of a function that returns nothing")
    }
    store_var(name, vt, true)
}

fn is_assign_op(s: string) -> bool {
    return s == "=" or s == "+=" or s == "-=" or s == "*=" or s == "/="
}

fn gen_assign() {
    let lhs_at = g_pos
    let after = skip_place(lhs_at)
    let op = tk_at(after)
    let simple = after == lhs_at + 1
    let name = tk_at(lhs_at)
    let known = find_local(name) >= 0 or find_global(name) >= 0
    if op == "=" and simple and foreign_global(name, lhs_at) {
        known = false
    }
    if not known {
        if op == "=" and simple {
            g_pos = lhs_at + 2
            let vt = gen_expr()
            if vt == "void" {
                err("'" + name + "' cannot hold the result of a function that returns nothing")
            }
            store_var(name, vt, true)
            return
        }
        err("unknown name '" + name + "'")
    }
    let lt = place_type(lhs_at)
    let vt = ""
    if simple and lt == "int" and (op == "+=" or op == "-=") {
        g_pos = after + 1
        let opc = 0
        if op == "-=" {
            opc = 1
        }
        let li = find_local(name)
        let use_simple = simple_operand(0) and binop_prec(tk_at(g_pos + 1)) == 0 and not is_sym_at(g_pos + 1, "|>")
        if not use_simple {
            need_int(gen_expr(), op)
            e_mov_rr(1, 0)
        }
        if li >= 0 {
            loc_load(0, g_lc_off[li])
        } else {
            e_load_abs(0, g_gl_addr[find_global(name)])
        }
        if use_simple {
            e_op_simple(opc)
        } else {
            e_op_rcx(opc)
        }
        if li >= 0 {
            loc_store(g_lc_off[li], 0)
        } else {
            e_store_abs(g_gl_addr[find_global(name)], 0)
        }
        return
    }
    if op == "=" {
        g_pos = after + 1
        let saved_want = g_want
        g_want = lt
        vt = coerce(gen_expr(), lt)
        g_want = saved_want
    } else {
        g_pos = lhs_at
        vt = gen_postfix()
        g_pos = after + 1
        if vt == "string" and op == "+=" {
            let rt = gen_expr()
            if rt != "string" {
                err("cannot add " + rt + " to a string")
            }
            call_named("__concat")
            e_add_rsp(32)
            take_result("string")
        } else {
            need_num(vt, op)
            e_push(0)
            let rt = gen_expr()
            need_num(rt, op)
            e_mov_rr(1, 0)
            e_pop(0)
            if vt == "float" {
                if rt != "float" {
                    e_f_from_int(1)
                }
                let fops = [0, 1, 6, 7]
                let names = ["+=", "-=", "*=", "/="]
                for k in 0..4 {
                    if op == names[k] {
                        e_f_op(fops[k])
                    }
                }
            } else {
                if rt == "float" {
                    err("cannot store a float in " + name + " (int); use int()")
                }
            }
            if vt != "float" and op == "+=" {
                e_op_rcx(0)
            }
            if vt != "float" and op == "-=" {
                e_op_rcx(1)
            }
            if vt != "float" and op == "*=" {
                e_op_rcx(6)
            }
            if vt != "float" and op == "/=" {
                e_divmod_rcx(false)
            }
        }
    }
    if vt != lt {
        err("cannot assign " + vt + " to " + name + " (" + lt + ")")
    }
    let end_at = g_pos
    if simple {
        store_var(name, lt, false)
        return
    }
    to_stack(lt)
    if place_is_perm(lhs_at) {
        e_clone(lt, 2)
    }
    g_pos = lhs_at
    gen_place()
    g_pos = end_at
    store_to_addr(lt)
}

fn gen_if() {
    let l_else = new_label()
    gen_cond(l_else)
    gen_block()
    if is_kw("else") {
        g_pos += 1
        let l_end = new_label()
        e_jmp(l_end)
        place(l_else)
        if is_kw("if") {
            g_pos += 1
            gen_if()
        } else {
            gen_block()
        }
        place(l_end)
    } else {
        place(l_else)
    }
}

fn push_loop(l_break: int, l_cont: int) {
    if g_loop_n < len(g_brk) {
        g_brk[g_loop_n] = l_break
        g_cont[g_loop_n] = l_cont
    } else {
        push(g_brk, l_break)
        push(g_cont, l_cont)
    }
    g_loop_n += 1
}

fn gen_while() {
    let l_top = new_label()
    let l_end = new_label()
    place(l_top)
    gen_cond(l_end)
    push_loop(l_end, l_top)
    gen_block()
    g_loop_n -= 1
    e_jmp(l_top)
    place(l_end)
}

fn gen_for() {
    let saved_n = g_lc_n
    let var = expect_name()
    expect("in")
    let l_top = new_label()
    let l_next = new_label()
    let l_end = new_label()
    let it_t = gen_expr()
    let idx = add_local("#i", "int")
    let lim = add_local("", "int")
    let var_off = 0
    let src = 0
    let mode = 0
    if is_sym("..") {
        need_int(it_t, "..")
        g_pos += 1
        loc_store(idx, 0)
        need_int(gen_expr(), "..")
        e_store(5, lim, 0)
        var_off = add_local(var, "int")
    } else {
        if it_t == "string" {
            mode = 2
        } else {
            if not is_array_t(it_t) {
                err("can only loop over ranges, arrays and strings, not " + it_t)
            }
            mode = 1
        }
        src = add_local("", it_t)
        e_lea(0, 5, src)
        store_to_addr(it_t)
        loc_set0(idx)
        if mode == 1 {
            var_off = add_local(var, elem_t(it_t))
        } else {
            var_off = add_local(var, "string")
        }
    }
    place(l_top)
    loc_load(0, idx)
    if mode == 0 {
        e_alu_mem(2, 5, lim)
    } else {
        e_alu_mem(2, 5, src + 8)
    }
    e_jcc(13, l_end)
    if mode == 0 {
        loc_store(var_off, 0)
    }
    if mode == 1 {
        e_load(1, 5, src)
        e_load_elem_to_local(elem_t(it_t), var_off)
    }
    if mode == 2 {
        e_load(1, 5, src)
        e_alu(0, 0, 1)
        e_store(5, var_off, 0)
        e_store_imm(5, var_off + 8, 1)
    }
    push_loop(l_end, l_next)
    gen_block()
    g_loop_n -= 1
    place(l_next)
    loc_inc(idx)
    e_jmp(l_top)
    place(l_end)
    g_lc_n = saved_n
}

fn gen_match() {
    let t = gen_expr()
    if t != "int" and t != "string" and t != "bool" {
        err("match works on numbers, strings and bools, not " + t)
    }
    let tmp = add_local("", t)
    to_stack(t)
    e_lea(0, 5, tmp)
    store_to_addr(t)
    let l_end = new_label()
    expect("{")
    while not is_sym("}") {
        if is_kw("else") or (kind() == 1 and tk() == "_") {
            g_pos += 1
            expect("=>")
            gen_block()
        } else {
            let l_next = new_label()
            let l_body = new_label()
            let more = true
            while more {
                if t == "string" {
                    e_push_mem(5, tmp + 8)
                    e_push_mem(5, tmp)
                    let pt = gen_level(4)
                    if pt != "string" {
                        err("match pattern should be a string")
                    }
                    call_named("__streq")
                    e_add_rsp(32)
                    e_jnz_rax(l_body)
                } else {
                    let pt = gen_level(4)
                    need_int(pt, "match")
                    e_alu_mem(2, 5, tmp)
                    e_jcc(4, l_body)
                }
                if is_sym("|") {
                    g_pos += 1
                } else {
                    more = false
                }
            }
            e_jmp(l_next)
            place(l_body)
            expect("=>")
            gen_block()
            e_jmp(l_end)
            place(l_next)
        }
        if is_sym(",") {
            g_pos += 1
        }
    }
    g_pos += 1
    place(l_end)
}

fn gen_return() {
    let ends = is_sym("}") or kind() == 6
    if ends or g_cur_ret == "void" {
        if not ends {
            let t = gen_expr()
            if t != "void" {
                err("this function returns nothing, but return has a value")
            }
        }
        e_jmp(g_cur_epi)
        return
    }
    g_lit_end = -1
    let start = g_code_len
    let t = coerce(gen_expr(), g_cur_ret)
    if t != g_cur_ret {
        err("should return " + g_cur_ret + ", not " + t)
    }
    let w = words(t)
    if w > 1 {
        let literal = g_lit_end == g_code_len and g_lit_start == start
        if has_heap(t) and not g_cur_raw and not literal {
            e_clone(t, 0)
        }
        for i in 0..w {
            e_pop_abs(a_retbuf() + i * 8)
        }
    }
    e_jmp(g_cur_epi)
}

fn gen_stmt() {
    let k = kind()
    if k == 2 {
        let w = tk()
        if w == "let" {
            g_pos += 1
            gen_let()
            return
        }
        if w == "if" {
            g_pos += 1
            gen_if()
            return
        }
        if w == "while" {
            g_pos += 1
            gen_while()
            return
        }
        if w == "for" {
            g_pos += 1
            gen_for()
            return
        }
        if w == "match" {
            g_pos += 1
            gen_match()
            return
        }
        if w == "return" {
            g_pos += 1
            gen_return()
            return
        }
        if w == "break" or w == "continue" {
            g_pos += 1
            if g_loop_n == 0 {
                err(w + " outside of a loop")
            }
            if w == "break" {
                e_jmp(g_brk[g_loop_n - 1])
            } else {
                e_jmp(g_cont[g_loop_n - 1])
            }
            return
        }
        if w == "fn" or w == "struct" {
            err("'" + w + "' must be at the top level")
        }
    }
    if k == 1 and is_sym_at(g_pos + 1, ":") {
        gen_let()
        return
    }
    if k == 1 {
        let after = skip_place(g_pos)
        if kind_at(after) == 5 and is_assign_op(tk_at(after)) {
            gen_assign()
            return
        }
    }
    let t = gen_expr()
    discard(t)
}

# ============================================================================
# functions
# ============================================================================
# reads `fn name(params) -> type { ... }` at the cursor and records it
fn collect_fn(this_struct: string) {
    expect("fn")
    let name = expect_name()
    if this_struct != "" {
        name = this_struct + "_" + name
    }
    if find_fn(name) >= 0 {
        err("function '" + name + "' is defined twice")
    }
    let open_at = g_pos
    expect("(")
    let pnames: array[string] = []
    let ptypes: array[string] = []
    if this_struct != "" {
        push(pnames, "this")
        push(ptypes, this_struct)
    }
    while not is_sym(")") {
        push(pnames, expect_name())
        expect(":")
        push(ptypes, parse_type())
        if is_sym(",") {
            g_pos += 1
        }
    }
    g_pos += 1
    let rt = "void"
    if is_sym("->") {
        g_pos += 1
        rt = parse_type()
    }
    push(g_fn_name, name)
    push(g_fn_ret, rt)
    push(g_fn_pnames, join(pnames, ","))
    push(g_fn_ptypes, join(ptypes, ","))
    push(g_fn_tok, open_at)
    push(g_fn_label, new_label())
    push(g_fn_state, 0)
    skip_block()
}

fn collect_struct_names(from: int) {
    g_pos = from
    while kind() != 6 {
        if is_kw("struct") {
            g_pos += 1
            let name = expect_name()
            if struct_index(name) >= 0 {
                err("struct '" + name + "' is defined twice")
            }
            push(g_st_name, name)
            push(g_st_fnames, "")
            push(g_st_ftypes, "")
            skip_block()
        } else {
            g_pos += 1
        }
    }
}

fn collect_all(from: int) {
    g_pos = from
    while kind() != 6 {
        if is_kw("fn") {
            collect_fn("")
        } else {
            if is_kw("struct") {
                g_pos += 1
                let name = expect_name()
                let si = struct_index(name)
                expect("{")
                let fnames: array[string] = []
                let ftypes: array[string] = []
                while not is_sym("}") {
                    if is_kw("fn") {
                        collect_fn(name)
                    } else {
                        push(fnames, expect_name())
                        expect(":")
                        push(ftypes, parse_type())
                        if is_sym(",") {
                            g_pos += 1
                        }
                    }
                }
                g_pos += 1
                g_st_fnames[si] = join(fnames, ",")
                g_st_ftypes[si] = join(ftypes, ",")
            } else {
                g_pos += 1
            }
        }
    }
}



fn begin_function(label: int, no_frame: bool) -> array[int] {
    place(label)
    # frame size and saved registers are filled in once the body is compiled
    let marks = e_func_enter()
    let pro_at = g_code_len
    if not no_frame {
        e_frame_prologue()
    }
    push(marks, pro_at)
    push(marks, g_code_len)
    for k in 0..4 {
        g_reg_owner[k] = -1
        g_reg_used[k] = 0
    }
    g_lc_n = 0
    g_frame = 8
    g_loop_n = 0
    g_cur_framed = false
    g_cur_raw = no_frame
    g_cur_epi = new_label()
    return marks
}

fn end_function(marks: array[int]) {
    place(g_cur_epi)
    if not g_cur_raw {
        if g_cur_framed {
            e_frame_epilogue()
        } else {
            e_patch_skip(marks[2], marks[3])
        }
    }
    let size = g_frame
    if size % 16 != 0 {
        size += 16 - size % 16
    }
    e_func_leave(marks, size, g_reg_used)
}

fn compile_fn(f: int) {
    g_fn_state[f] = 2
    g_pos = g_fn_tok[f]
    let name = g_fn_name[f]
    let marks = begin_function(g_fn_label[f], starts_with_s(name, "__"))
    g_in_top = false
    g_cur_ret = g_fn_ret[f]
    # parameters sit above the return address, last one first
    let pnames: array[string] = []
    let ptypes: array[string] = []
    if g_fn_pnames[f] != "" {
        pnames = split(g_fn_pnames[f], ",")
        ptypes = split(g_fn_ptypes[f], ",")
    }
    let off = 16
    let i = len(pnames) - 1
    let offs: array[int] = []
    for k in 0..len(pnames) {
        push(offs, 0)
    }
    while i >= 0 {
        offs[i] = off
        off += words(ptypes[i]) * 8
        i -= 1
    }
    for k in 0..len(pnames) {
        if k < len(g_lc_name) {
            g_lc_name[k] = pnames[k]
            g_lc_type[k] = ptypes[k]
            g_lc_off[k] = offs[k]
        } else {
            push(g_lc_name, pnames[k])
            push(g_lc_type, ptypes[k])
            push(g_lc_off, offs[k])
        }
    }
    g_lc_n = len(pnames)
    # skip the parameter list and return type
    let depth = 0
    let scanning = true
    while scanning {
        if is_sym("(") {
            depth += 1
        }
        if is_sym(")") {
            depth -= 1
            if depth == 0 {
                scanning = false
            }
        }
        g_pos += 1
    }
    while not is_sym("{") {
        g_pos += 1
    }
    gen_block()
    end_function(marks)
}

# code outside of functions runs first, in order; its variables are globals
fn compile_top(label: int) {
    let marks = begin_function(label, false)
    g_in_top = true
    g_cur_ret = "void"
    g_pos = 0
    while kind() != 6 {
        if is_kw("fn") {
            g_pos += 1
            expect_name()
            while not is_sym("{") {
                g_pos += 1
            }
            skip_block()
        } else {
            if is_kw("struct") {
                g_pos += 2
                skip_block()
            } else {
                gen_stmt()
            }
        }
    }
    end_function(marks)
    g_in_top = false
}

# ============================================================================
# program entry and the executable file
# ============================================================================
# targets (all x86-64): 1 Linux (ELF), 2 macOS (Mach-O), 3 Windows (PE)
let g_target: int = 1
let g_imp_name: array[string] = []
let g_out: array[int] = []

fn target_name(t: int) -> string {
    if t == 2 {
        return "macos"
    }
    if t == 3 {
        return "windows"
    }
    return "linux"
}

fn runtime_source() -> string {
    let os = embed("runtime/linux.slop")
    if g_target == 2 {
        os = embed("runtime/macos.slop")
    }
    if g_target == 3 {
        os = embed("runtime/windows.slop")
    }
    return embed("runtime/core.slop") + embed("runtime/numbers.slop") + embed("runtime/math.slop") + os
}

fn import_index(name: string) -> int {
    for i in 0..len(g_imp_name) {
        if g_imp_name[i] == name {
            return i
        }
    }
    push(g_imp_name, name)
    return len(g_imp_name) - 1
}

# __ccall("name", args...): call a function of the operating system's own
# libraries (macOS libSystem, Windows kernel32/ws2_32). Arguments are on the stack.
fn e_ccall(name: string, n: int) {
    if g_target == 1 {
        err("__ccall is not available on Linux")
    }
    let idx = import_index(name)
    if arm() {
        if n > 16 {
            err("__ccall takes at most 16 arguments")
        }
        # arguments go in x0-x7, the rest on the stack; Apple passes the
        # variable arguments of open() on the stack
        for i in 0..n {
            if i < 8 {
                a_ldst(true, i, 28, (n - 1 - i) * 8)
            }
        }
        # the system library gets a 16-byte aligned hardware stack below ours
        a_mov(16, 28)
        a32(3544514064)
        a32(3548179984)
        a_sub_imm(16, 16, 64)
        a32(2432696832 + 31)
        for i in 8..n {
            a_ldst(true, 17, 28, (n - 1 - i) * 8)
            a_ldst(false, 17, 31, (i - 8) * 8)
        }
        if name == "open" and n == 3 {
            # str x2, [sp]
            a32(4177527778)
        }
        a_adr_fixup(16, 14, idx)
        a32(3594453504)
        e_add_rsp(n * 8)
        return
    }
    # keep our stack pointer in rbp and give the callee a 16-byte aligned stack
    e_push(5)
    e_mov_rr(5, 4)
    emit4(72, 131, 228, 240)
    if g_target == 3 {
        let extra = 0
        if n > 4 {
            extra = n - 4
        }
        let space = 32 + extra * 8
        if space % 16 != 0 {
            space += 8
        }
        e_alu_imm(1, 4, space)
        for i in 4..n {
            e_load(0, 5, 8 + (n - 1 - i) * 8)
            e_store(4, 32 + (i - 4) * 8, 0)
        }
        let regs = [1, 2, 8, 9]
        for i in 0..n {
            if i < 4 {
                e_load(regs[i], 5, 8 + (n - 1 - i) * 8)
            }
        }
    } else {
        if n > 6 {
            err("__ccall takes at most 6 arguments on macOS")
        }
        let regs = [7, 6, 2, 1, 8, 9]
        for i in 0..n {
            e_load(regs[i], 5, 8 + (n - 1 - i) * 8)
        }
        e_mov_imm(0, 0)
    }
    emit2(255, 21)
    fixup(3, idx)
    emit32(0)
    e_mov_rr(4, 5)
    e_pop(5)
    e_add_rsp(n * 8)
}

# ---------- use "package" / use "file.slop" ----------
# Used files are read first (each once), so their functions, structs and
# top-level code come before the file that uses them.

# the names in the `use "..."` lines of a source file
fn use_lines(src: string) -> array[string] {
    let names: array[string] = []
    for raw in split(src, "\n") {
        let line = trim(raw)
        if starts_with_s(line, "use \"") and ends_with(line, "\"") and len(line) > 6 {
            push(names, slice(line, 5, len(line) - 1))
        }
    }
    return names
}

# the standard library: modules built into slop itself
fn std_modules() -> array[string] {
    return ["csv", "files", "lists", "math", "random", "strings", "testing", "time", "web"]
}

fn std_source(name: string) -> string {
    if name == "csv" {
        return embed("std/csv.slop")
    }
    if name == "files" {
        return embed("std/files.slop")
    }
    if name == "lists" {
        return embed("std/lists.slop")
    }
    if name == "math" {
        return embed("std/math.slop")
    }
    if name == "random" {
        return embed("std/random.slop")
    }
    if name == "strings" {
        return embed("std/strings.slop")
    }
    if name == "testing" {
        return embed("std/testing.slop")
    }
    if name == "time" {
        return embed("std/time.slop")
    }
    if name == "web" {
        return embed("std/web.slop")
    }
    return ""
}

# where a use line points: a file next to the one using it, an installed
# package, or a standard library module ("std/NAME.slop")
fn resolve_use(name: string, dir: string) -> string {
    if ends_with(name, ".slop") {
        return dir + name
    }
    if starts_with_s(name, "std/") {
        let m = slice(name, 4, len(name))
        if std_source(m) != "" {
            return "std/" + m + ".slop"
        }
    }
    let roots = [g_src_dir + "slop_packages/", "slop_packages/"]
    for root in roots {
        let base = root + name + "/"
        if file_exists(base + name + ".slop") {
            return base + name + ".slop"
        }
        if file_exists(base + "lib.slop") {
            return base + "lib.slop"
        }
    }
    if std_source(name) != "" {
        return "std/" + name + ".slop"
    }
    print("error: package '" + name + "' is not installed. Add it with: slop add " + name)
    exit(1)
    return ""
}

fn load_uses(src: string, dir: string) {
    for name in use_lines(src) {
        let path = resolve_use(name, dir)
        let seen = false
        for f in g_files {
            if f == path {
                seen = true
            }
        }
        if not seen {
            push(g_files, path)
            let idx = len(g_files) - 1
            let text = ""
            if starts_with_s(path, "std/") and not file_exists(path) {
                text = std_source(slice(path, 4, len(path) - 5))
            } else {
                text = read_file(path)
            }
            if len(text) == 0 {
                print("error: cannot read " + path + " (used as \"" + name + "\")")
                exit(1)
            }
            load_uses(text, dir_of(path))
            g_cur_file = idx
            tokenize(text, false)
        }
    }
}

fn compile_program(main_src: string) {
    # the runtime counts as its own file
    push(g_files, "")
    g_cur_file = 1
    tokenize(runtime_source(), false)
    g_user_tok = len(g_tk_kind)
    load_uses(main_src, g_src_dir)
    g_cur_file = 0
    tokenize(main_src, true)
    collect_struct_names(0)
    collect_all(0)
    let ti = 0
    while ti + 2 < len(g_tk_text) {
        if g_tk_text[ti] == "addr_of" and g_tk_text[ti + 1] == "(" {
            push(g_noreg, g_tk_text[ti + 2])
        }
        ti += 1
    }
    g_bounds_lbl = new_label()

    # entry point (macOS calls it like main(argc, argv, envp))
    e_entry(g_target == 2)
    call_named("__rt_init")
    let top_label = new_label()
    e_call(top_label)
    let mi = find_fn("main")
    if mi >= 0 {
        request_fn(mi)
        if g_fn_ptypes[mi] == "array[string]" {
            call_named("__args")
            take_result("array[string]")
            e_call(g_fn_label[mi])
            e_add_rsp(24)
        } else {
            if g_fn_ptypes[mi] != "" {
                err("main takes no parameters or (args: array[string])")
            }
            e_call(g_fn_label[mi])
        }
    }
    e_push_imm(0)
    call_named("__exit")

    compile_top(top_label)
    let qi = 0
    while qi < len(g_queue) {
        compile_fn(g_queue[qi])
        qi += 1
    }

    # shared out-of-bounds exit: index in rax, array header in rcx
    place(g_bounds_lbl)
    e_push(0)
    e_push_mem(1, 8)
    let bf = find_fn("__bounds_fail")
    request_fn(bf)
    e_call(g_fn_label[bf])
    while qi < len(g_queue) {
        compile_fn(g_queue[qi])
        qi += 1
    }
}

# ---------- writing the file ----------
fn o8(v: int) {
    push(g_out, v)
}

fn o16(v: int) {
    o8(v % 256)
    o8(v / 256 % 256)
}

fn o32(v: int) {
    if v < 0 {
        v += 4294967296
    }
    o16(v % 65536)
    o16(v / 65536 % 65536)
}

fn o64(v: int) {
    o32(v % 4294967296)
    o32(v / 4294967296)
}

fn o_text(s: string, size: int) {
    for k in 0..size {
        if k < len(s) {
            o8(byte_at(s, k))
        } else {
            o8(0)
        }
    }
}

fn o_pad_to(n: int) {
    while len(g_out) < n {
        o8(0)
    }
}

fn align_up(v: int, a: int) -> int {
    if v % a == 0 {
        return v
    }
    return v + a - v % a
}

# fills in every jump, call and data reference once addresses are known
fn resolve_fixups(code_addr: int, ro_addr: int, data_addr: int, imp_addr: array[int]) {
    for i in 0..len(g_fx_at) {
        let at = g_fx_at[i]
        let kind = g_fx_kind[i]
        let val = g_fx_val[i]
        let target = 0
        if kind == 0 or kind == 10 or kind == 11 or kind == 15 {
            target = g_lbl[val]
            if target < 0 {
                print("internal error: unplaced label")
                exit(1)
            }
        }
        if kind == 1 or kind == 12 {
            target = ro_addr + val
        }
        if kind == 2 or kind == 13 {
            target = data_addr + val
        }
        if kind == 3 or kind == 14 {
            target = imp_addr[val]
        }
        if kind < 10 {
            if kind == 0 {
                patch32(at, target - (at + 4))
            } else {
                patch32(at, target - (code_addr + at + 4))
            }
        }
        if kind == 10 {
            patch32(at, read32(at) + ((target - at) / 4 & 67108863))
        }
        if kind == 11 {
            patch32(at, read32(at) + ((target - at) / 4 & 524287) * 32)
        }
        if kind == 15 {
            let d = target - at
            patch32(at, read32(at) + (d & 3) * 536870912 + (d / 4 & 524287) * 32)
        }
        if kind >= 12 and kind <= 14 {
            # adrp: distance in 4 KB pages; then the low 12 bits in add/ldr
            let pages = target / 4096 - (code_addr + at) / 4096
            if pages < 0 {
                pages += 2097152
            }
            patch32(at, read32(at) + (pages & 3) * 536870912 + (pages / 4 & 524287) * 32)
            let low = target & 4095
            if kind == 14 {
                low = low / 8
            }
            patch32(at + 4, read32(at + 4) + low * 1024)
        }
    }
}

# code, then the string literals starting at file offset ro_at
fn o_code_and_ro(ro_at: int) {
    for k in 0..g_code_len {
        o8(g_code[k])
    }
    o_pad_to(ro_at)
    for b in g_ro {
        o8(b)
    }
}

fn bss_size() -> int {
    return align_up(a_globals() + g_gl_next, 4096)
}

# Linux: ELF with one code segment and one zeroed data segment
fn build_elf() {
    let base = 4194304
    let hdr = 232
    let page = 4096
    let machine = 62
    if arm() {
        # ARM64 Linux may use 4, 16 or 64 KB pages
        page = 65536
        machine = 183
    }
    let ro_off = align_up(hdr + g_code_len, 8)
    let file_size = ro_off + len(g_ro)
    let data_addr = align_up(base + file_size, page)
    let none: array[int] = []
    resolve_fixups(base + hdr, base + ro_off, data_addr, none)
    o_text(chr(127) + "ELF", 4)
    o8(2)
    o8(1)
    o8(1)
    o_pad_to(16)
    o16(2)
    o16(machine)
    o32(1)
    o64(base + hdr)
    o64(64)
    o64(0)
    o32(0)
    o16(64)
    o16(56)
    o16(3)
    o16(64)
    o16(0)
    o16(0)
    o_phdr(1, 5, base, file_size, file_size, page)
    o_phdr(1, 6, data_addr, 0, bss_size(), page)
    o_phdr(1685382481, 6, 0, 0, 0, 16)
    o_code_and_ro(ro_off)
}

fn o_phdr(ptype: int, flags: int, vaddr: int, filesz: int, memsz: int, align: int) {
    o32(ptype)
    o32(flags)
    o64(0)
    o64(vaddr)
    o64(vaddr)
    o64(filesz)
    o64(memsz)
    o64(align)
}

fn o_segment(name: string, vmaddr: int, vmsize: int, fileoff: int, filesize: int, prot: int, nsects: int) {
    o32(25)
    o32(72 + nsects * 80)
    o_text(name, 16)
    o64(vmaddr)
    o64(vmsize)
    o64(fileoff)
    o64(filesize)
    o32(prot)
    o32(prot)
    o32(nsects)
    o32(0)
}

fn o_uleb(v: int) {
    while v >= 128 {
        o8(v % 128 + 128)
        v = v / 128
    }
    o8(v)
}

# macOS: Mach-O that dyld loads, linked against libSystem
fn build_macho() {
    let text_vm = 4294967296
    let cmds_size = 760
    let ncmds = 12
    let page = 4096
    if arm() {
        # Apple Silicon: 16 KB pages and a code signature
        cmds_size += 16
        ncmds += 1
        page = 16384
    }
    let code_off = align_up(32 + cmds_size, 16)
    let ro_off = align_up(code_off + g_code_len, 8)
    let text_file = align_up(ro_off + len(g_ro), page)
    let data_vm = text_vm + text_file
    let bss = align_up(bss_size(), page)
    let imp: array[int] = []
    for k in 0..len(g_imp_name) {
        push(imp, data_vm + a_imports() + k * 8)
    }
    if len(g_imp_name) > 224 {
        err("too many imported functions")
    }
    resolve_fixups(text_vm + code_off, text_vm + ro_off, data_vm, imp)
    # bind opcodes: point each import slot at its libSystem function
    let saved = g_out
    let empty: array[int] = []
    g_out = empty
    o8(17)
    for k in 0..len(g_imp_name) {
        o8(64)
        o_text("_" + g_imp_name[k], len(g_imp_name[k]) + 2)
        o8(81)
        o8(114)
        o_uleb(a_imports() + k * 8)
        o8(144)
    }
    o8(0)
    while len(g_out) % 8 != 0 {
        o8(0)
    }
    let bind = g_out
    g_out = saved
    let le_off = text_file
    let bind_size = len(bind)
    let str_off = le_off + bind_size
    let le_size = bind_size + 8
    let sig_off = align_up(str_off + 8, 16)
    if arm() {
        le_size = sig_off + sig_size(sig_off) - le_off
    }
    # header
    o32(4277009103)
    if arm() {
        o32(16777228)
        o32(0)
    } else {
        o32(16777223)
        o32(3)
    }
    o32(2)
    o32(ncmds)
    o32(cmds_size)
    o32(2097284)
    o32(0)
    o_segment("__PAGEZERO", 0, text_vm, 0, 0, 0, 0)
    o_segment("__TEXT", text_vm, text_file, 0, text_file, 5, 1)
    o_text("__text", 16)
    o_text("__TEXT", 16)
    o64(text_vm + code_off)
    o64(ro_off + len(g_ro) - code_off)
    o32(code_off)
    o32(4)
    o32(0)
    o32(0)
    o32(2147484672)
    o32(0)
    o32(0)
    o32(0)
    o_segment("__DATA", data_vm, bss, text_file, 0, 3, 1)
    o_text("__bss", 16)
    o_text("__DATA", 16)
    o64(data_vm)
    o64(bss)
    o32(0)
    o32(3)
    o32(0)
    o32(0)
    o32(1)
    o32(0)
    o32(0)
    o32(0)
    o_segment("__LINKEDIT", data_vm + bss, align_up(le_size, page), le_off, le_size, 1, 0)
    # LC_DYLD_INFO_ONLY
    o32(2147483682)
    o32(48)
    o32(0)
    o32(0)
    o32(le_off)
    o32(bind_size)
    for k in 0..6 {
        o32(0)
    }
    # LC_SYMTAB
    o32(2)
    o32(24)
    o32(str_off)
    o32(0)
    o32(str_off)
    o32(8)
    # LC_DYSYMTAB
    o32(11)
    o32(80)
    for k in 0..18 {
        o32(0)
    }
    # LC_LOAD_DYLINKER
    o32(14)
    o32(32)
    o32(12)
    o_text("/usr/lib/dyld", 20)
    # LC_UUID
    o32(27)
    o32(24)
    o_text("slop-language-v1", 16)
    # LC_BUILD_VERSION: macOS 11.0
    o32(50)
    o32(24)
    o32(1)
    o32(720896)
    o32(720896)
    o32(0)
    # LC_MAIN
    o32(2147483688)
    o32(24)
    o64(code_off)
    o64(0)
    # LC_LOAD_DYLIB
    o32(12)
    o32(56)
    o32(24)
    o32(2)
    o32(65536)
    o32(65536)
    o_text("/usr/lib/libSystem.B.dylib", 32)
    if arm() {
        # LC_CODE_SIGNATURE
        o32(29)
        o32(16)
        o32(sig_off)
        o32(sig_size(sig_off))
    }
    o_pad_to(code_off)
    o_code_and_ro(ro_off)
    o_pad_to(text_file)
    for b in bind {
        o8(b)
    }
    o8(32)
    if arm() {
        o_pad_to(sig_off)
        o_code_signature(sig_off, text_file)
    }
    o_pad_to(text_file + le_size)
}

# ---------- SHA-256 (for the code signature Apple requires on ARM64) ----------
fn rotr(x: int, n: int) -> int {
    return ((x >> n) | (x << (32 - n))) & 4294967295
}

# SHA-256 of n bytes of data starting at start -> 32 bytes
fn sha256(data: array[int], start: int, n: int) -> array[int] {
    let k = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
    let h = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
    # padded message: data, 0x80, zeros, 64-bit big-endian bit length
    let total = n + 9
    if total % 64 != 0 {
        total += 64 - total % 64
    }
    let w: array[int] = []
    for i in 0..64 {
        push(w, 0)
    }
    let blk = 0
    while blk < total {
        for i in 0..16 {
            let v = 0
            for j in 0..4 {
                let at = blk + i * 4 + j
                let b = 0
                if at < n {
                    b = data[start + at]
                } else {
                    if at == n {
                        b = 128
                    } else {
                        if at >= total - 8 {
                            b = (n * 8 >> ((total - 1 - at) * 8)) & 255
                        }
                    }
                }
                v = v * 256 + b
            }
            w[i] = v
        }
        for i in 16..64 {
            let s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
            let s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 4294967295
        }
        let a = h[0]
        let b2 = h[1]
        let c = h[2]
        let d = h[3]
        let e = h[4]
        let f = h[5]
        let g = h[6]
        let hh = h[7]
        for i in 0..64 {
            let t1 = (hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ ((e ^ 4294967295) & g)) + k[i] + w[i]) & 4294967295
            let t2 = ((rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b2) ^ (a & c) ^ (b2 & c))) & 4294967295
            hh = g
            g = f
            f = e
            e = (d + t1) & 4294967295
            d = c
            c = b2
            b2 = a
            a = (t1 + t2) & 4294967295
        }
        h[0] = (h[0] + a) & 4294967295
        h[1] = (h[1] + b2) & 4294967295
        h[2] = (h[2] + c) & 4294967295
        h[3] = (h[3] + d) & 4294967295
        h[4] = (h[4] + e) & 4294967295
        h[5] = (h[5] + f) & 4294967295
        h[6] = (h[6] + g) & 4294967295
        h[7] = (h[7] + hh) & 4294967295
        blk += 64
    }
    let out: array[int] = []
    for v in h {
        for j in 0..4 {
            push(out, (v >> ((3 - j) * 8)) & 255)
        }
    }
    return out
}

fn o32be(v: int) {
    o8((v >> 24) & 255)
    o8((v >> 16) & 255)
    o8((v >> 8) & 255)
    o8(v & 255)
}

fn o64be(v: int) {
    o32be((v >> 32) & 4294967295)
    o32be(v & 4294967295)
}

# ad-hoc code signature over the first code_limit bytes of the file
fn sig_size(code_limit: int) -> int {
    let slots = (code_limit + 4095) / 4096
    return 20 + 88 + 5 + slots * 32
}

fn o_code_signature(code_limit: int, text_size: int) {
    let slots = (code_limit + 4095) / 4096
    let cd_len = 88 + 5 + slots * 32
    # SuperBlob with one CodeDirectory
    o32be(4208856256)
    o32be(20 + cd_len)
    o32be(1)
    o32be(0)
    o32be(20)
    # CodeDirectory (version 0x20400), ad-hoc and linker-signed
    o32be(4208856066)
    o32be(cd_len)
    o32be(132096)
    o32be(131074)
    o32be(88 + 5)
    o32be(88)
    o32be(0)
    o32be(slots)
    o32be(code_limit)
    o8(32)
    o8(2)
    o8(0)
    o8(12)
    o32be(0)
    o32be(0)
    o32be(0)
    o32be(0)
    o64be(0)
    o64be(0)
    o64be(text_size)
    o64be(1)
    o_text("slop", 5)
    for i in 0..slots {
        let n = 4096
        if i * 4096 + n > code_limit {
            n = code_limit - i * 4096
        }
        for b in sha256(g_out, i * 4096, n) {
            o8(b)
        }
    }
}

fn is_winsock(name: string) -> bool {
    let names = ["WSAStartup", "socket", "setsockopt", "bind", "listen", "accept", "recv", "send", "closesocket", "connect"]
    for n in names {
        if n == name {
            return true
        }
    }
    return false
}

fn o_section(name: string, vsize: int, va: int, raw_size: int, raw_ptr: int, flags: int) {
    o_text(name, 8)
    o32(vsize)
    o32(va)
    o32(raw_size)
    o32(raw_ptr)
    o32(0)
    o32(0)
    o16(0)
    o16(0)
    o32(flags)
}

# Windows: PE with kernel32 / ws2_32 imports
fn build_pe() {
    let image_base = 5368709120
    let text_va = 4096
    let ro_off = align_up(g_code_len, 8)
    let text_size = ro_off + len(g_ro)
    let text_raw = align_up(text_size, 512)
    let idata_va = align_up(text_va + text_size, 4096)
    # imports grouped by DLL
    let dll_names = ["KERNEL32.dll", "WS2_32.dll"]
    let dll_funcs: array[array[int]] = []
    push(dll_funcs, no_ints())
    push(dll_funcs, no_ints())
    for k in 0..len(g_imp_name) {
        if is_winsock(g_imp_name[k]) {
            push(dll_funcs[1], k)
        } else {
            push(dll_funcs[0], k)
        }
    }
    let dlls: array[int] = []
    for d in 0..2 {
        if len(dll_funcs[d]) > 0 {
            push(dlls, d)
        }
    }
    let desc_size = (len(dlls) + 1) * 20
    let ilt_off: array[int] = []
    let at = desc_size
    for d in dlls {
        push(ilt_off, at)
        at += (len(dll_funcs[d]) + 1) * 8
    }
    let iat_start = at
    let iat_off: array[int] = []
    for d in dlls {
        push(iat_off, at)
        at += (len(dll_funcs[d]) + 1) * 8
    }
    let iat_size = at - iat_start
    let hint_off: array[int] = []
    for k in 0..len(g_imp_name) {
        push(hint_off, 0)
    }
    for k in 0..len(g_imp_name) {
        hint_off[k] = at
        at += align_up(2 + len(g_imp_name[k]) + 1, 2)
    }
    let name_off: array[int] = []
    for d in dlls {
        push(name_off, at)
        at += align_up(len(dll_names[d]) + 1, 2)
    }
    let idata_size = at
    let idata_raw = align_up(idata_size, 512)
    # ARM64 Windows only loads relocatable programs: our code is all relative,
    # so the relocation table holds one empty block
    let nsect = 3
    let reloc_va = align_up(idata_va + idata_size, 4096)
    let reloc_off = 512 + text_raw + idata_raw
    let data_va = reloc_va
    if arm() {
        nsect = 4
        data_va = reloc_va + 4096
    }
    let bss = bss_size()
    let image_size = align_up(data_va + bss, 4096)
    let imp: array[int] = []
    for k in 0..len(g_imp_name) {
        push(imp, 0)
    }
    for i in 0..len(dlls) {
        let funcs = dll_funcs[dlls[i]]
        for j in 0..len(funcs) {
            imp[funcs[j]] = idata_va + iat_off[i] + j * 8
        }
    }
    resolve_fixups(text_va, text_va + ro_off, data_va, imp)
    # DOS header, then the PE header at 64
    o_text("MZ", 60)
    o32(64)
    o_text("PE", 4)
    if arm() {
        o16(43620)
    } else {
        o16(34404)
    }
    o16(nsect)
    o32(0)
    o32(0)
    o32(0)
    o16(240)
    if arm() {
        o16(34)
    } else {
        o16(35)
    }
    # optional header (PE32+)
    o16(523)
    o8(14)
    o8(0)
    o32(text_raw)
    o32(idata_raw)
    o32(bss)
    o32(text_va)
    o32(text_va)
    o64(image_base)
    o32(4096)
    o32(512)
    o16(6)
    o16(0)
    o16(0)
    o16(0)
    o16(6)
    o16(0)
    o32(0)
    o32(image_size)
    o32(512)
    o32(0)
    o16(3)
    if arm() {
        o16(33120)
    } else {
        o16(33024)
    }
    o64(8388608)
    o64(8388608)
    o64(1048576)
    o64(4096)
    o32(0)
    o32(16)
    for d in 0..16 {
        if d == 1 {
            o32(idata_va)
            o32(desc_size)
        } else {
            if d == 12 {
                o32(idata_va + iat_start)
                o32(iat_size)
            } else {
                if d == 5 and arm() {
                    o32(reloc_va)
                    o32(12)
                } else {
                    o32(0)
                    o32(0)
                }
            }
        }
    }
    o_section(".text", text_size, text_va, text_raw, 512, 1610612768)
    o_section(".idata", idata_size, idata_va, idata_raw, 512 + text_raw, 3221225536)
    if arm() {
        o_section(".reloc", 12, reloc_va, 512, reloc_off, 1107296320)
    }
    o_section(".data", bss, data_va, 0, 0, 3221225600)
    o_pad_to(512)
    o_code_and_ro(512 + ro_off)
    o_pad_to(512 + text_raw)
    let idata_at = len(g_out)
    # import descriptors
    for i in 0..len(dlls) {
        o32(idata_va + ilt_off[i])
        o32(0)
        o32(0)
        o32(idata_va + name_off[i])
        o32(idata_va + iat_off[i])
    }
    for k in 0..5 {
        o32(0)
    }
    # lookup tables, then address tables (filled in by Windows at load)
    for pass in 0..2 {
        for i in 0..len(dlls) {
            for k in dll_funcs[dlls[i]] {
                o64(idata_va + hint_off[k])
            }
            o64(0)
        }
    }
    for k in 0..len(g_imp_name) {
        o16(0)
        o_text(g_imp_name[k], align_up(len(g_imp_name[k]) + 1, 2))
    }
    for i in 0..len(dlls) {
        let nm = dll_names[dlls[i]]
        o_text(nm, align_up(len(nm) + 1, 2))
    }
    o_pad_to(idata_at + idata_raw)
    if arm() {
        # one block for page 0x1000 with two padding entries
        o32(4096)
        o32(12)
        o32(0)
        o_pad_to(reloc_off + 512)
    }
}

fn no_ints() -> array[int] {
    let none: array[int] = []
    return none
}

fn write_executable(path: string) {
    if g_target == 2 {
        build_macho()
    } else {
        if g_target == 3 {
            build_pe()
        } else {
            build_elf()
        }
    }
    # a new file, so even a running program (like this compiler) can be replaced
    remove_file(path)
    write_file(path, bytes_to_string(g_out))
    make_executable(path)
}

fn output_name(src: string) -> string {
    let n = len(src)
    let base = src + ".out"
    if n > 5 and slice(src, n - 5, n) == ".slop" {
        base = slice(src, 0, n - 5)
    }
    if g_target == 3 {
        return base + ".exe"
    }
    return base
}

fn dir_of(path: string) -> string {
    let i = len(path) - 1
    while i >= 0 {
        if byte_at(path, i) == 47 or byte_at(path, i) == 92 {
            return slice(path, 0, i + 1)
        }
        i -= 1
    }
    return ""
}

fn build(src_path: string, out_path: string) {
    g_src_dir = dir_of(src_path)
    let source = read_file(src_path)
    if len(source) == 0 {
        print("error: cannot read " + src_path + " (missing or empty)")
        exit(1)
    }
    compile_program(source)
    write_executable(out_path)
}

# target name -> system (g_target: 1 Linux, 2 macOS, 3 Windows) and CPU (g_arch: 1 x86-64, 2 ARM64)
fn set_target(name: string) -> bool {
    let names = ["linux", "macos", "windows", "linux-arm64", "macos-arm64", "windows-arm64"]
    for i in 0..len(names) {
        if names[i] == name {
            g_target = i % 3 + 1
            g_arch = 1
            if i >= 3 {
                g_arch = 2
            }
            return true
        }
    }
    return false
}

# ============================================================================
# packages: slop add / remove / sync / update / list / search
# A package is a folder in slop_packages/ with NAME.slop (or lib.slop) in it.
# slop.pkg lists the packages a program uses, one "name source" per line.
# Sources: a name from the package list, github:user/repo[@branch-or-tag],
# or a link (or path) to one .slop file. Downloads use curl and tar, which
# come with Linux, macOS and Windows 10 and later.
# ============================================================================
struct Package {
    name: string,
    source: string,
    about: string
}

let g_index_url = "https://raw.githubusercontent.com/gugu8intel-i9/Slop/main/packages/index.txt"
let g_index: array[Package] = []
let g_index_loaded = false

fn is_windows() -> bool {
    return os_name() == "windows"
}

fn find_program(name: string) -> string {
    let sep = ":"
    let slash = "/"
    let exe = name
    if is_windows() {
        sep = ";"
        slash = "\\"
        exe = name + ".exe"
        let sys = env("SystemRoot") + "\\System32\\" + exe
        if file_exists(sys) {
            return sys
        }
    }
    for dir in split(env("PATH"), sep) {
        if dir != "" and file_exists(dir + slash + exe) {
            return dir + slash + exe
        }
    }
    return ""
}

fn need_program(name: string) -> string {
    let p = find_program(name)
    if p == "" {
        print("error: packages are downloaded with '" + name + "', which was not found. Install it and try again.")
        exit(1)
    }
    return p
}

fn is_link(src: string) -> bool {
    return starts_with_s(src, "https://") or starts_with_s(src, "http://")
}

# downloads a link (or copies a file) to dest
fn fetch(src: string, dest: string) -> bool {
    if is_link(src) {
        let curl = need_program("curl")
        run(curl, [curl, "-fsSL", "-o", dest, src])
        return run_status() == 0 and file_exists(dest)
    }
    let text = read_file(src)
    if len(text) == 0 {
        return false
    }
    write_file(dest, text)
    return true
}

fn fetch_text(src: string) -> string {
    if is_link(src) {
        let curl = need_program("curl")
        let text = run(curl, [curl, "-fsSL", src])
        if run_status() != 0 {
            return ""
        }
        return text
    }
    return read_file(src)
}

fn remove_dir(dir: string) {
    if is_windows() {
        let cmd = env("ComSpec")
        run(cmd, [cmd, "/c", "rmdir", "/s", "/q", replace(dir, "/", "\\")])
    } else {
        let rm = need_program("rm")
        run(rm, [rm, "-rf", dir])
    }
}

# "name | source | about" lines; # starts a comment
fn parse_packages(text: string, sep: string) -> array[Package] {
    let out: array[Package] = []
    for raw in split(text, "\n") {
        let line = trim(raw)
        if line != "" and not starts_with_s(line, "#") {
            let parts = split(line, sep)
            let about = ""
            if len(parts) > 2 {
                about = trim(parts[2])
            }
            if len(parts) > 1 {
                push(out, Package(trim(parts[0]), trim(parts[1]), about))
            }
        }
    }
    return out
}

# the list of known packages (SLOP_INDEX can point at another list)
fn package_index() -> array[Package] {
    if g_index_loaded {
        return g_index
    }
    let where = env("SLOP_INDEX")
    if where == "" {
        where = g_index_url
    }
    let text = fetch_text(where)
    if len(text) == 0 {
        print("error: could not get the package list from " + where)
        exit(1)
    }
    g_index = parse_packages(text, "|")
    if not is_link(where) {
        # file sources in a local list are relative to it
        for i in 0..len(g_index) {
            let src = g_index[i].source
            if not is_link(src) and not starts_with_s(src, "github:") {
                g_index[i].source = dir_of(where) + src
            }
        }
    }
    g_index_loaded = true
    return g_index
}

fn read_pkg_file() -> array[Package] {
    return parse_packages(read_file("slop.pkg"), " ")
}

fn write_pkg_file(list: array[Package]) {
    let text = "# packages this program uses; slop add and slop remove keep it up to date\n"
    for p in list {
        text = text + p.name + " " + p.source + "\n"
    }
    write_file("slop.pkg", text)
}

fn base_name(path: string) -> string {
    let d = dir_of(path)
    let b = slice(path, len(d), len(path))
    if ends_with(b, ".slop") {
        b = slice(b, 0, len(b) - 5)
    }
    return b
}

# package name and source for what was typed after slop add
fn package_for(spec: string) -> Package {
    if starts_with_s(spec, "github:") {
        let repo = slice(spec, 7, len(spec))
        let at = find(repo, "@")
        if at >= 0 {
            repo = slice(repo, 0, at)
        }
        return Package(base_name(repo), spec, "")
    }
    if is_link(spec) or ends_with(spec, ".slop") {
        return Package(base_name(spec), spec, "")
    }
    for p in package_index() {
        if p.name == spec {
            return p
        }
    }
    print("error: there is no package called '" + spec + "'. See them all with: slop search")
    exit(1)
    return Package("", "", "")
}

fn package_entry(name: string) -> string {
    let dir = "slop_packages/" + name + "/"
    if file_exists(dir + name + ".slop") {
        return dir + name + ".slop"
    }
    if file_exists(dir + "lib.slop") {
        return dir + "lib.slop"
    }
    return ""
}

# downloads one package into slop_packages/, then the packages it uses
fn install_package(p: Package) {
    make_dir("slop_packages")
    let dir = "slop_packages/" + p.name
    remove_dir(dir)
    make_dir(dir)
    if starts_with_s(p.source, "github:") {
        let repo = slice(p.source, 7, len(p.source))
        let ref = "HEAD"
        let at = find(repo, "@")
        if at >= 0 {
            ref = slice(repo, at + 1, len(repo))
            repo = slice(repo, 0, at)
        }
        let tmp = "slop_packages/" + p.name + ".tar.gz"
        if not fetch("https://codeload.github.com/" + repo + "/tar.gz/" + ref, tmp) {
            print("error: could not download " + p.source)
            exit(1)
        }
        let tar = need_program("tar")
        let log = run(tar, [tar, "-xzf", tmp, "-C", dir, "--strip-components=1"])
        let ok = run_status() == 0
        remove_file(tmp)
        if not ok {
            print("error: could not unpack " + p.source + ":\n" + log)
            exit(1)
        }
    } else {
        if not fetch(p.source, dir + "/" + p.name + ".slop") {
            print("error: could not download " + p.source)
            exit(1)
        }
    }
    let entry = package_entry(p.name)
    if entry == "" {
        print("error: " + p.source + " has no " + p.name + ".slop or lib.slop, so it is not a Slop package")
        remove_dir(dir)
        exit(1)
    }
    print("  got " + p.name)
    for dep in use_lines(read_file(entry)) {
        if not ends_with(dep, ".slop") and package_entry(dep) == "" {
            install_package(package_for(dep))
        }
    }
}

# slop std: the standard library modules; slop std NAME: what one has
fn std_list(names: array[string]) {
    if len(names) == 0 {
        print("Standard library (use \"NAME\" at the top of a program):")
        for m in std_modules() {
            let about = strip_hash(split(std_source(m), "\n")[0])
            if starts_with_s(about, m + ": ") {
                about = slice(about, len(m) + 2, len(about))
            }
            print("  " + pad_name(m) + about)
        }
        print("")
        print("See what one has: slop std NAME")
        return
    }
    let src = std_source(names[0])
    if src == "" {
        usage_error("there is no standard module called '" + names[0] + "'")
    }
    for line in split(src, "\n") {
        if starts_with_s(line, "#") {
            print(strip_hash(line))
        }
        if starts_with_s(line, "fn ") {
            print("  " + slice(line, 3, len(line) - 2))
        }
    }
}

fn pad_name(s: string) -> string {
    let out = s
    while len(out) < 10 {
        out = out + " "
    }
    return out
}

fn strip_hash(line: string) -> string {
    if starts_with_s(line, "# ") {
        return slice(line, 2, len(line))
    }
    return line
}

fn pkg_add(specs: array[string]) {
    if len(specs) == 0 {
        usage_error("which package? like: slop add stats")
    }
    let list = read_pkg_file()
    for spec in specs {
        let p = package_for(spec)
        install_package(p)
        let kept: array[Package] = []
        for q in list {
            if q.name != p.name {
                push(kept, q)
            }
        }
        push(kept, Package(p.name, p.source, ""))
        list = kept
        print("added " + p.name + ". Use it with: use \"" + p.name + "\"")
    }
    write_pkg_file(list)
}

fn pkg_remove(names: array[string]) {
    if len(names) == 0 {
        usage_error("which package? like: slop remove stats")
    }
    let list = read_pkg_file()
    for name in names {
        let kept: array[Package] = []
        let found = false
        for q in list {
            if q.name == name {
                found = true
            } else {
                push(kept, q)
            }
        }
        if not found and package_entry(name) == "" {
            usage_error("'" + name + "' is not installed")
        }
        remove_dir("slop_packages/" + name)
        list = kept
        print("removed " + name)
    }
    write_pkg_file(list)
}

# sync: get what slop.pkg lists but is missing; update: get it all again
fn pkg_sync(all: bool, only: array[string]) {
    let list = read_pkg_file()
    if len(list) == 0 {
        print("no packages yet (slop.pkg is empty). Add one with: slop add NAME")
        return
    }
    let n = 0
    for p in list {
        let wanted = len(only) == 0
        for o in only {
            if o == p.name {
                wanted = true
            }
        }
        if wanted and (all or package_entry(p.name) == "") {
            install_package(p)
            n += 1
        }
    }
    print(int_to_string(len(list)) + " packages ready (" + int_to_string(n) + " downloaded)")
}

fn pkg_list() {
    let list = read_pkg_file()
    if len(list) == 0 {
        print("no packages yet. Find some with: slop search")
        return
    }
    for p in list {
        let note = ""
        if package_entry(p.name) == "" {
            note = "   (missing: run slop sync)"
        }
        print(p.name + "   " + p.source + note)
    }
}

fn pkg_search(words: array[string]) {
    let word = ""
    if len(words) > 0 {
        word = lower(words[0])
    }
    let shown = 0
    for p in package_index() {
        if word == "" or contains(lower(p.name), word) or contains(lower(p.about), word) {
            print(p.name + " - " + p.about)
            shown += 1
        }
    }
    if shown == 0 {
        print("no packages match '" + word + "'")
    }
}

let g_version = "1.1"

fn help() {
    print("Slop " + g_version + " - a small, fast programming language")
    print("")
    print("  slop run app.slop [args]   build and run a program")
    print("  slop build app.slop        build ./app (app.exe on Windows)")
    print("  slop check app.slop        look for mistakes without building")
    print("  slop new hello             start a new program in hello.slop")
    print("  slop new site --web        start a website in site.slop")
    print("  slop repl                  type Slop code and see results right away")
    print("  slop install               copy slop to a folder for programs on this computer")
    print("  slop convert hello.rs      turn Rust, C, C++, Java, C#, JavaScript, TypeScript,")
    print("                             Go, Kotlin, Swift or Python code into Slop")
    print("")
    print("Packages (put 'use \"name\"' at the top of your program to use one):")
    print("  slop add NAME              get a package: a name from 'slop search',")
    print("                             github:user/repo, or a link to a .slop file")
    print("  slop remove NAME           remove a package")
    print("  slop list                  show this program's packages (from slop.pkg)")
    print("  slop sync                  get every package slop.pkg lists that is missing")
    print("  slop update [NAME]         get the newest version of packages")
    print("  slop search [WORD]         find packages")
    print("  slop std [NAME]            the standard library: math, lists, strings, random,")
    print("                             time, files, csv, testing, web (no download needed)")
    print("  slop version               show the version and system")
    print("  slop help                  show this help")
    print("")
    print("Options:")
    print("  -o NAME           name of the program to write")
    print("  --target SYSTEM   build for another system: linux, linux-arm64, macos,")
    print("                    macos-arm64, windows, windows-arm64")
}

fn usage_error(msg: string) {
    print("error: " + msg)
    print("Try: slop help")
    exit(2)
}

fn host_target() -> string {
    let t = os_name()
    if __arch() == 2 {
        t = t + "-arm64"
    }
    return t
}

fn local_exe(path: string) -> string {
    if starts_with_s(path, "/") or byte_at(path, 1) == 58 or starts_with_s(path, ".") {
        return path
    }
    return "./" + path
}

fn new_program(name: string) {
    let file = name
    if not ends_with(file, ".slop") {
        file = file + ".slop"
    }
    if len(read_file(file)) > 0 {
        usage_error(file + " already exists")
    }
    write_file(file, "# " + file + "\nname = \"World\"\nprint(\"Hello \" + name + \"!\")\n")
    print("created " + file)
    print("run it with: slop run " + file)
}

# slop new NAME --web: a small website to start from
fn new_website(name: string) {
    let file = name
    if not ends_with(file, ".slop") {
        file = file + ".slop"
    }
    if len(read_file(file)) > 0 {
        usage_error(file + " already exists")
    }
    let code = "# " + file + ": a website. Run it with: slop run " + file + "\n# then open http://localhost:8080\nuse \"web\"\n\nvisits = 0\n\nfn handle(req: Request) -> Response {\n    if route(req, \"GET\", \"/\") {\n        visits += 1\n        body = render(\"<h1>Hello from Slop!</h1><p>This page was opened {{n}} times.</p><form method=\\\"post\\\" action=\\\"/hello\\\"><input name=\\\"who\\\" placeholder=\\\"Your name\\\"> <button>Say hi</button></form>\", [\"n\", str(visits)])\n        return html(page(\"Home\", body))\n    }\n    if route(req, \"POST\", \"/hello\") {\n        return html(page(\"Hi\", render(\"<h1>Hi {{who}}!</h1><p><a href=\\\"/\\\">Back</a></p>\", [\"who\", form(req, \"who\")])))\n    }\n    if route(req, \"GET\", \"/api/time\") {\n        return json(json_object([\"ms\", str(clock_ns() / 1000000)]))\n    }\n    return not_found()\n}\n\nserve(8080)\n"
    write_file(file, code)
    print("created " + file)
    print("run it with: slop run " + file + "   then open http://localhost:8080")
}

fn install() {
    let me = program_path()
    let dir = ""
    let dest = ""
    if os_name() == "windows" {
        let base = env("LOCALAPPDATA")
        make_dir(base + "\\Programs")
        dir = base + "\\Programs\\Slop"
        dest = dir + "\\slop.exe"
    } else {
        let home = env("HOME")
        make_dir(home + "/.local")
        dir = home + "/.local/bin"
        dest = dir + "/slop"
    }
    make_dir(dir)
    if me == dest {
        print("slop is already installed at " + dest)
        return
    }
    let program = read_file(me)
    write_file(dest, program)
    make_executable(dest)
    if read_file(dest) != program {
        print("error: could not write " + dest)
        exit(1)
    }
    print("installed " + dest)
    let path = env("PATH")
    if not contains(path, dir) {
        print("")
        print("Add that folder to your PATH so 'slop' works everywhere:")
        if os_name() == "windows" {
            print("  [Environment]::SetEnvironmentVariable(\"Path\", $env:Path + \";" + dir + "\", \"User\")")
            print("(paste into PowerShell, then open a new window)")
        } else {
            print("  echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.profile")
            print("(on macOS use ~/.zprofile; then open a new terminal)")
        }
    }
}

# slop convert FILE: writes FILE's code as Slop next to it, then checks it
fn convert_command(files: array[string], from_lang: string, out: string) {
    if len(files) == 0 {
        usage_error("which file? like: slop convert hello.rs")
    }
    let file = files[0]
    let lang = from_lang
    if lang == "" {
        lang = cv_language(file)
    }
    let langs = ["rust", "c", "cpp", "java", "csharp", "js", "go", "python", "kotlin", "swift"]
    let known = false
    for l in langs {
        if l == lang {
            known = true
        }
    }
    if not known {
        usage_error("cannot tell what language " + file + " is in. Add --from with one of: " + join(langs, ", "))
    }
    let src = read_file(file)
    if len(src) == 0 {
        usage_error("cannot read " + file + " (missing or empty)")
    }
    let dest = out
    if dest == "" {
        let dot = len(file) - 1
        while dot > 0 and byte_at(file, dot) != 46 and byte_at(file, dot) != 47 {
            dot -= 1
        }
        dest = file + ".slop"
        if dot > 0 and byte_at(file, dot) == 46 {
            dest = slice(file, 0, dot) + ".slop"
        }
    }
    let text = convert_source(src, lang)
    write_file(dest, "# converted from " + slice(file, len(dir_of(file)), len(file)) + " by slop convert\n" + text)
    print("wrote " + dest)
    if cv_todos > 0 {
        print(int_to_string(cv_todos) + " lines need a hand: look for '# TODO' in " + dest)
    }
    let me = program_path()
    let log = run(me, [me, "check", dest])
    if run_status() == 0 {
        print("it builds. Run it with: slop run " + dest)
    } else {
        print("it does not build yet: " + clean_error(log))
    }
}

fn brace_depth(s: string) -> int {
    let d = 0
    for i in 0..len(s) {
        let c = byte_at(s, i)
        if c == 123 {
            d += 1
        }
        if c == 125 {
            d -= 1
        }
    }
    return d
}

fn prompt(p: string) {
    __out_str(p)
    __flush()
}

fn starts_with_word(s: string, words: array[string]) -> bool {
    for w in words {
        if s == w or starts_with_s(s, w + " ") or starts_with_s(s, w + "(") {
            return true
        }
    }
    return false
}

# "error: line 3: unknown name 'x'" -> "error: unknown name 'x'"
fn clean_error(log: string) -> string {
    let out = trim(log)
    if starts_with_s(out, "error: line ") {
        let rest = slice(out, 12, len(out))
        let k = find(rest, ": ")
        if k > 0 {
            out = "error: " + slice(rest, k + 2, len(rest))
        }
    }
    return out
}

# Each line is added to a program that is built and run again; only the new
# output is shown. A line that is just a value prints it.
fn repl() {
    let me = program_path()
    let file = ".slop-repl.slop"
    let exe = ".slop-repl"
    if os_name() == "windows" {
        exe = exe + ".exe"
    }
    print("Slop " + g_version + ". Type code and press Enter; 'exit' to quit.")
    let code = ""
    let shown = 0
    let keywords = ["fn", "let", "if", "while", "for", "struct", "match", "return", "print", "break", "continue"]
    while true {
        prompt(">>> ")
        let line = trim(input())
        if input_ended() and line == "" {
            print("")
            break
        }
        if line == "exit" or line == "quit" {
            break
        }
        if line == "" {
            continue
        }
        let chunk = line
        let depth = brace_depth(line)
        while depth > 0 and not input_ended() {
            prompt("... ")
            let more = input()
            chunk = chunk + "\n" + more
            depth += brace_depth(more)
        }
        let tries: array[string] = []
        if not contains(chunk, "\n") and not starts_with_word(chunk, keywords) {
            push(tries, "print(" + chunk + ")")
        }
        push(tries, chunk)
        let done = false
        let problem = ""
        for t in tries {
            if done {
                break
            }
            write_file(file, code + t + "\n")
            let log = run(me, [me, "build", file, "-o", exe])
            if run_status() != 0 {
                if problem == "" or t == chunk {
                    problem = clean_error(log)
                }
                continue
            }
            done = true
            let out = run(local_exe(exe), [exe])
            if len(out) > shown {
                __out_str(slice(out, shown, len(out)))
            }
            if run_status() == 0 {
                code = code + t + "\n"
                shown = len(out)
            }
        }
        if not done {
            print(problem)
        }
    }
    remove_file(file)
    remove_file(exe)
}

fn main(args: array[string]) {
    let target = host_target()
    let out = ""
    let from_lang = ""
    let words: array[string] = []
    let program_args: array[string] = []
    let k = 1
    while k < len(args) {
        let a = args[k]
        if len(words) >= 2 and words[0] == "run" {
            # everything after the program's file goes to the program
            push(program_args, a)
        } else {
            if (a == "--target" or a == "-o" or a == "--from") and k + 1 < len(args) {
                if a == "--target" {
                    target = args[k + 1]
                } else {
                    if a == "--from" {
                        from_lang = args[k + 1]
                    } else {
                        out = args[k + 1]
                    }
                }
                k += 1
            } else {
                push(words, a)
            }
        }
        k += 1
    }
    if not set_target(target) {
        usage_error("unknown target '" + target + "' (use linux, linux-arm64, macos, macos-arm64, windows or windows-arm64)")
    }
    if len(words) == 0 {
        help()
        exit(2)
    }
    let cmd = words[0]
    if cmd == "help" or cmd == "-h" or cmd == "--help" {
        help()
        return
    }
    if cmd == "version" or cmd == "--version" or cmd == "-v" {
        print("Slop " + g_version + " (" + os_name() + " " + arch_name() + ")")
        return
    }
    if cmd == "repl" {
        repl()
        return
    }
    if cmd == "install" {
        install()
        return
    }
    let rest: array[string] = []
    for i in 1..len(words) {
        push(rest, words[i])
    }
    if cmd == "add" {
        pkg_add(rest)
        return
    }
    if cmd == "remove" {
        pkg_remove(rest)
        return
    }
    if cmd == "sync" {
        pkg_sync(false, rest)
        return
    }
    if cmd == "update" {
        pkg_sync(true, rest)
        return
    }
    if cmd == "list" {
        pkg_list()
        return
    }
    if cmd == "search" {
        pkg_search(rest)
        return
    }
    if cmd == "convert" {
        convert_command(rest, from_lang, out)
        return
    }
    if cmd == "std" {
        std_list(rest)
        return
    }
    if cmd == "new" {
        if len(words) < 2 {
            usage_error("give the new program a name, like: slop new hello")
        }
        let web = false
        for w in words {
            if w == "--web" {
                web = true
            }
        }
        if web {
            new_website(words[1])
        } else {
            new_program(words[1])
        }
        return
    }
    let file = ""
    if cmd == "run" or cmd == "build" or cmd == "check" {
        if len(words) < 2 {
            usage_error("which file? like: slop " + cmd + " app.slop")
        }
        file = words[1]
        if len(words) > 2 and out == "" {
            out = words[2]
        }
    } else {
        if not ends_with(cmd, ".slop") {
            usage_error("unknown command '" + cmd + "'")
        }
        # slop app.slop [out] is the same as slop build
        file = cmd
        cmd = "build"
        if len(words) > 1 and out == "" {
            out = words[1]
        }
    }
    if out == "" {
        out = output_name(file)
    }
    if cmd == "check" {
        g_src_dir = dir_of(file)
        let source = read_file(file)
        if len(source) == 0 {
            usage_error("cannot read " + file + " (missing or empty)")
        }
        compile_program(source)
        print("ok: no mistakes found in " + file)
        return
    }
    build(file, out)
    if cmd == "run" {
        let exe = local_exe(out)
        let run_args: array[string] = [exe]
        for a in program_args {
            push(run_args, a)
        }
        exec(exe, run_args)
    }
}
