# Slop runtime: math on floats. Only the functions a program uses are built in.

fn __iabs(n: int) -> int {
    if n < 0 {
        return -n
    }
    return n
}

fn __out_floats(a: array[float]) {
    __out_byte(91)
    for i in 0..len(a) {
        if i > 0 {
            __out_str(", ")
        }
        _slop_out_float(float_bits(a[i]))
    }
    __out_byte(93)
}

fn __fnan() -> float {
    return float_from_bits(9221120237041090560)
}

fn __finf() -> float {
    return float_from_bits(9218868437227405312)
}

# halves round away from zero: round(2.5) is 3.0, round(-2.5) is -3.0
fn __fround(x: float) -> float {
    a = abs(x)
    r = floor(a)
    if a - r >= 0.5 {
        r = r + 1.0
    }
    if x < 0.0 {
        return -r
    }
    return r
}

# x * 2^k
fn __fscale(x: float, k: int) -> float {
    while k > 1000 {
        x = x * float_from_bits(2023 << 52)
        k -= 1000
    }
    while k < -1000 {
        x = x * float_from_bits(23 << 52)
        k += 1000
    }
    return x * float_from_bits((k + 1023) << 52)
}

fn __fexp(x: float) -> float {
    if x != x {
        return x
    }
    if x > 709.782712893384 {
        return __finf()
    }
    if x < -745.2 {
        return 0.0
    }
    k = int(floor(x * 1.4426950408889634 + 0.5))
    hi = x - float(k) * 0.6931471803691238
    lo = float(k) * 1.9082149292705877e-10
    r = hi - lo
    # exp(r) = (1 + hi) - lo + r^2/2! + r^3/3! + ..., with the rounding error of 1 + hi kept
    p = 1.0
    i = 20
    while i > 2 {
        p = 1.0 + p * r / float(i)
        i -= 1
    }
    rest = r * r * 0.5 * p
    one = 1.0 + hi
    err = (1.0 - one) + hi
    sum = one + ((err - lo) + rest)
    return __fscale(sum, k)
}

# natural logarithm
fn __flog(x: float) -> float {
    if x != x or x < 0.0 {
        return __fnan()
    }
    if x == 0.0 {
        return -__finf()
    }
    if x == __finf() {
        return x
    }
    bits = float_bits(x)
    ex = (bits >> 52) & 2047
    if ex == 0 {
        # tiny numbers: scale up by 2^54 first
        bits = float_bits(x * 18014398509481984.0)
        ex = ((bits >> 52) & 2047) - 54
    }
    m = float_from_bits((bits & 4503599627370495) | (1023 << 52))
    ex -= 1023
    if m > 1.4142135623730951 {
        m = m * 0.5
        ex += 1
    }
    # log(1 + f) = f - s * (f - 2R) with s = f / (2 + f), R = s^2/3 + s^4/5 + ...
    f = m - 1.0
    s = f / (2.0 + f)
    s2 = s * s
    q = 0.0
    i = 15
    while i > 0 {
        q = s2 * (1.0 / float(2 * i + 1) + q)
        i -= 1
    }
    a = float(ex) * 0.6931471803691238
    corr = s * (f - 2.0 * q) - float(ex) * 1.9082149292705877e-10
    # a + f with its rounding error kept
    sum = a + f
    bb = sum - a
    err = (a - (sum - bb)) + (f - bb)
    return sum + (err - corr)
}

fn __fsin_r(r: float) -> float {
    r2 = r * r
    term = r
    sum = r
    for i in 1..11 {
        term = -term * r2 / float((2 * i) * (2 * i + 1))
        sum = sum + term
    }
    return sum
}

fn __fcos_r(r: float) -> float {
    r2 = r * r
    term = 1.0
    sum = 1.0
    for i in 1..11 {
        term = -term * r2 / float((2 * i - 1) * (2 * i))
        sum = sum + term
    }
    return sum
}

# sine and cosine: x = k * pi/2 + r with r in [-pi/4, pi/4]
fn __ftrig(x: float, cos: bool) -> float {
    if x != x or abs(x) == __finf() {
        return __fnan()
    }
    kf = __fround(x * 0.6366197723675814)
    r = (x - kf * 1.5707963267341256) - kf * 6.077100506506192e-11
    q = int(kf) & 3
    if cos {
        q = (q + 1) & 3
    }
    if q == 0 {
        return __fsin_r(r)
    }
    if q == 1 {
        return __fcos_r(r)
    }
    if q == 2 {
        return -__fsin_r(r)
    }
    return -__fcos_r(r)
}

fn __fsin(x: float) -> float {
    return __ftrig(x, false)
}

fn __fcos(x: float) -> float {
    return __ftrig(x, true)
}

fn __ftan(x: float) -> float {
    return __ftrig(x, false) / __ftrig(x, true)
}

fn __fatan(x: float) -> float {
    if x != x {
        return x
    }
    neg = x < 0.0
    a = abs(x)
    base = 0.0
    if a > 1.0 {
        # atan(a) = pi/2 - atan(1/a)
        t = __fatan(1.0 / a)
        base = 1.5707963267948966 - t
        if neg {
            return -base
        }
        return base
    }
    if a > 0.41421356237309503 {
        base = 0.7853981633974483
        a = (a - 1.0) / (a + 1.0)
    }
    a2 = a * a
    term = a
    sum = a
    for i in 1..30 {
        term = -term * a2
        sum = sum + term / float(2 * i + 1)
    }
    r = base + sum
    if neg {
        return -r
    }
    return r
}

fn __fpow(a: float, b: float) -> float {
    if b == 0.0 {
        return 1.0
    }
    if b == floor(b) and abs(b) < 1000000000.0 {
        n = int(b)
        neg = n < 0
        if neg {
            n = -n
        }
        r = 1.0
        base = a
        while n > 0 {
            if (n & 1) == 1 {
                r = r * base
            }
            base = base * base
            n = n / 2
        }
        if neg {
            return 1.0 / r
        }
        return r
    }
    if a != a or b != b or a < 0.0 {
        return __fnan()
    }
    if b == 0.5 {
        return sqrt(a)
    }
    if a == 0.0 {
        if b > 0.0 {
            return 0.0
        }
        return __finf()
    }
    return __fexp(b * __flog(a))
}
