# Slop runtime for macOS: calls the system library (libSystem), which is how
# every macOS program talks to the kernel.

fn __os_name() -> string {
    return "macos"
}

fn __rt_init() {
    __init_buckets(17179869184, 17179869184)
}

# address space that gets memory when touched; 0 if there is none
fn __os_reserve(size: int) -> int {
    # PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON|MAP_NORESERVE
    p = __ccall("mmap", 0, size, 3, 4162, -1, 0)
    if p == -1 {
        return 0
    }
    return p
}

fn __os_alloc(size: int) -> int {
    return __os_reserve(size)
}

fn __os_release(p: int, size: int) {
    __ccall("munmap", p, size)
}

fn __os_commit_on_grow() -> bool {
    return false
}

# ---------- threads ----------
fn __os_thread_start(block: int, entry: int) -> bool {
    attr = block + 7256
    __ccall("pthread_attr_init", attr)
    __ccall("pthread_attr_setstacksize", attr, 67108864)
    return __ccall32("pthread_create", block + 7184, attr, entry, block) == 0
}

fn __os_thread_join(block: int) {
    __ccall("pthread_join", __load64(block + 7184), 0)
}

# sleeps while the 32-bit word at p still holds v (may wake early)
fn __os_wait(p: int, v: int) {
    # UL_COMPARE_AND_WAIT, no time limit
    __ccall32("__ulock_wait", 1, p, v, 0)
}

# wakes everyone waiting on the word at p
fn __os_wake(p: int) {
    # UL_COMPARE_AND_WAIT | ULF_WAKE_ALL
    __ccall32("__ulock_wake", 257, p, 0)
}

fn __os_thread_release(block: int) {
}

fn __cpu_count() -> int {
    # sysconf(_SC_NPROCESSORS_ONLN)
    n = __ccall("sysconf", 58)
    if n < 1 {
        return 1
    }
    return n
}

fn __grow(b: int, need: int) {
    __eprint("Slop: out of memory")
    __os_exit(1)
}

fn __os_write(fd: int, p: int, n: int) -> int {
    return __ccall("write", fd, p, n)
}

fn __os_read(fd: int, p: int, n: int) -> int {
    return __ccall("read", fd, p, n)
}

fn __os_open_read(path: int) -> int {
    return __ccall32("open", path, 0, 0)
}

fn __os_open_write(path: int) -> int {
    # O_WRONLY|O_CREAT|O_TRUNC
    return __ccall32("open", path, 1537, 420)
}

fn __os_close(fd: int) {
    __ccall32("close", fd)
}

fn __os_size(fd: int) -> int {
    size = __ccall("lseek", fd, 0, 2)
    __ccall("lseek", fd, 0, 0)
    if size <= 0 {
        return -1
    }
    return size
}

fn __os_exit(code: int) {
    __ccall("_exit", code)
}

fn __os_remove(path: int) {
    __ccall32("unlink", path)
}

fn __make_executable(path: string) {
    __ccall32("chmod", __cstr(path), 493)
}

fn __make_dir(path: string) -> bool {
    return __ccall32("mkdir", __cstr(path), 493) == 0
}

# full path of this program
fn __program_path() -> string {
    buf = __alloc_bytes(4096)
    size = __scratch()
    __store64(size, 4096)
    if __ccall32("_NSGetExecutablePath", buf, size) != 0 {
        return ""
    }
    return __str(buf, __strlen(buf))
}

# value of an environment variable, or "" when it is not set
fn __env(name: string) -> string {
    p = __ccall("getenv", __cstr(name))
    if p == 0 {
        return ""
    }
    return __str(p, __strlen(p))
}

fn __args() -> array[string] {
    argc = __load64(__data() + 88)
    argv = __load64(__data() + 96)
    out: array[string] = []
    for i in 0..argc {
        a = __load64(argv + i * 8)
        push(out, __str(a, __strlen(a)))
    }
    return out
}

fn __argv_block(args: array[string]) -> int {
    n = len(args)
    argv = __alloc((n + 1) * 8)
    for i in 0..n {
        __store64(argv + i * 8, __cstr(args[i]))
    }
    __store64(argv + n * 8, 0)
    return argv
}

fn __exec(path: string, args: array[string]) {
    argv = __argv_block(args)
    __flush()
    __ccall32("execve", __cstr(path), argv, __load64(__data() + 104))
    __eprint("cannot run " + path)
    __os_exit(127)
}

fn __run(path: string, args: array[string]) -> string {
    __flush()
    fds = __scratch()
    if __ccall32("pipe", fds) != 0 {
        return ""
    }
    rd = __load64(fds) & 4294967295
    wr = (__load64(fds) >> 32) & 4294967295
    argv = __argv_block(args)
    cpath = __cstr(path)
    pid = __ccall32("fork")
    if pid == 0 {
        __ccall32("dup2", wr, 1)
        __ccall32("dup2", wr, 2)
        __ccall32("close", rd)
        __ccall32("execve", cpath, argv, __load64(__data() + 104))
        __ccall("_exit", 127)
    }
    __ccall32("close", wr)
    p = __alloc_bytes(0)
    total = 0
    while true {
        __alloc_bytes(4096)
        r = __ccall("read", rd, p + total, 4096)
        if r <= 0 {
            break
        }
        total += r
    }
    __ccall32("close", rd)
    st = __scratch() + 32
    __store64(st, 0)
    __ccall32("waitpid", pid, st, 0)
    __last_status = (__load64(st) >> 8) & 255
    return __str(p, total)
}

fn __clock_ns() -> int {
    t = __scratch()
    # CLOCK_MONOTONIC
    __ccall("clock_gettime", 6, t)
    return __load64(t) * 1000000000 + __load64(t + 8)
}

# seconds since 1970 (the calendar clock)
fn __time_unix() -> int {
    t = __scratch()
    # CLOCK_REALTIME
    __ccall("clock_gettime", 0, t)
    return __load64(t)
}

# n bytes from the system's secure random source
fn __random_text(n: int) -> string {
    p = __alloc_bytes(n)
    got = 0
    while got < n {
        k = n - got
        if k > 256 {
            k = 256
        }
        if __ccall32("getentropy", p + got, k) != 0 {
            __eprint("Slop: no secure random numbers available")
            __os_exit(1)
        }
        got += k
    }
    return __str(p, n)
}

fn __sleep_ms(ms: int) {
    t = __scratch()
    __store64(t, ms / 1000)
    __store64(t + 8, ms % 1000 * 1000000)
    __ccall("nanosleep", t, 0)
}

fn __af6() -> int {
    return 30
}

fn __sa_init(a: int, v6: bool) {
    __memzero(a, 28)
    if v6 {
        __store8(a, 28)
        __store8(a + 1, 30)
    } else {
        __store8(a, 16)
        __store8(a + 1, 2)
    }
}

fn __sa_is6(a: int) -> bool {
    return __load8(a + 1) == 30
}

# a socket (kind 1: TCP, 2: UDP) on port for every address: IPv6 and IPv4
# together where the system has IPv6, else IPv4
fn __bound_socket(kind: int, port: int) -> int {
    for v6 in [true, false] {
        fam = 2
        if v6 {
            fam = 30
        }
        fd = __ccall32("socket", fam, kind, 0)
        if fd >= 0 {
            one = __alloc_bytes(8)
            __store64(one, 1)
            # SOL_SOCKET, SO_REUSEADDR
            __ccall32("setsockopt", fd, 65535, 4, one, 4)
            n = 16
            if v6 {
                # IPPROTO_IPV6, IPV6_V6ONLY off: IPv4 visitors too
                zero = __alloc_bytes(8)
                __store64(zero, 0)
                __ccall32("setsockopt", fd, 41, 27, zero, 4)
                n = 28
            }
            if kind == 2 {
                # room for big messages (up to 64 KB; macOS allows only 9 KB
                # unless the send buffer is bigger) and for bursts of them
                big = __alloc_bytes(8)
                __store64(big, 1048576)
                __ccall32("setsockopt", fd, 65535, 4097, big, 4)
                __ccall32("setsockopt", fd, 65535, 4098, big, 4)
            }
            a = __alloc_bytes(32)
            __sa_init(a, v6)
            __store8(a + 2, port / 256)
            __store8(a + 3, port % 256)
            if __ccall32("bind", fd, a, n) == 0 {
                return fd
            }
            __ccall32("close", fd)
        }
    }
    return -1
}

fn __socket_listen(port: int) -> int {
    fd = __bound_socket(1, port)
    if fd < 0 {
        return -1
    }
    if __ccall32("listen", fd, 4096) != 0 {
        __ccall32("close", fd)
        return -1
    }
    return fd
}

fn __udp_open(port: int) -> int {
    return __bound_socket(2, port)
}

fn __socket_is6(fd: int) -> bool {
    a = __alloc_bytes(32)
    __memzero(a, 32)
    l = __alloc_bytes(8)
    __store64(l, 32)
    __ccall32("getsockname", fd, a, l)
    return __sa_is6(a)
}

fn __sendto(fd: int, data: string, a: int, n: int) -> bool {
    return __ccall("sendto", fd, __str_ptr(data), len(data), 0, a, n) >= 0
}

fn __recvfrom(fd: int, buf: int, n: int, a: int) -> int {
    l = __alloc_bytes(8)
    __store64(l, 32)
    return __ccall("recvfrom", fd, buf, n, 0, a, l)
}

fn __socket_accept(fd: int) -> int {
    __flush()
    c = __ccall32("accept", fd, 0, 0)
    __no_sigpipe(c)
    return c
}

# SO_NOSIGPIPE: a visitor who left early must not stop the program
fn __no_sigpipe(fd: int) {
    if fd >= 0 {
        one = __scratch()
        __store64(one, 1)
        __ccall32("setsockopt", fd, 65535, 4130, one, 4)
    }
}

# connects to ip:port ("127.0.0.1" or an IPv6 address like "::1"); -1 if it can't
fn __socket_connect(ip: string, port: int) -> int {
    a = __alloc_bytes(32)
    n = __sockaddr(a, ip, port, false)
    if n == 0 {
        return -1
    }
    fam = 2
    if n == 28 {
        fam = 30
    }
    fd = __ccall32("socket", fam, 1, 0)
    if fd < 0 {
        return -1
    }
    if __ccall32("connect", fd, a, n) != 0 {
        __ccall32("close", fd)
        return -1
    }
    __no_sigpipe(fd)
    return fd
}

fn __windows_roots() -> array[string] {
    out: array[string] = []
    return out
}

fn __resolve(host: string) -> string {
    return __getaddrinfo(host)
}

fn __socket_read(fd: int) -> string {
    p = __alloc_bytes(8192)
    r = __ccall("read", fd, p, 8192)
    if r <= 0 {
        return ""
    }
    return __str(p, r)
}

fn __socket_write(fd: int, s: string) {
    __write_all(fd, __str_ptr(s), len(s))
}

fn __socket_close(fd: int) {
    __ccall32("close", fd)
}

# ---------- gpu for: Apple GPUs through Metal ----------
# Only on Apple Silicon (on Intel Macs gpu for runs on the CPU cores).
__gpu_state = 0
__gpu_dev = 0
__gpu_queue = 0
__gpu_pipes = 0
__gpu_cmd = 0
__gpu_enc = 0
__gpu_slot = 0
__gpu_bufs = 0
__gpu_nbufs = 0
__gpu_backs = 0
__gpu_err = 0
__gpu_count = 0
__gpu_pool = 0
__gpu_tmp = 0

__gpu_sels = 0

# the Objective-C selector for a method name (looked up once per name)
fn __objc(s: string) -> int {
    if __gpu_sels == 0 {
        # kept for the whole run (bucket 2 is never given back)
        __gpu_sels = __alloc_bytes_in(2, 16 * 64)
        __memzero(__gpu_sels, 16 * 64)
    }
    k = __str_ptr(s)
    for i in 0..64 {
        e = __gpu_sels + i * 16
        if __load64(e) == k {
            return __load64(e + 8)
        }
        if __load64(e) == 0 {
            sel = __ccall("sel_registerName", __cstr(s))
            __store64(e, k)
            __store64(e + 8, sel)
            return sel
        }
    }
    return __ccall("sel_registerName", __cstr(s))
}

fn __gpu_init() -> bool {
    if __gpu_state != 0 {
        return __gpu_state == 1
    }
    __gpu_state = -1
    if __arch() != 2 {
        return false
    }
    __gpu_dev = __ccall("MTLCreateSystemDefaultDevice")
    if __gpu_dev == 0 {
        return false
    }
    __gpu_queue = __ccall("objc_msgSend", __gpu_dev, __objc("newCommandQueue"))
    if __gpu_queue == 0 {
        return false
    }
    # kept for the whole run (bucket 2 is never given back)
    __gpu_pipes = __alloc_bytes_in(2, 8 * 4096)
    __memzero(__gpu_pipes, 8 * 4096)
    __gpu_bufs = __alloc_bytes_in(2, 8 * 32)
    __gpu_tmp = __alloc_bytes_in(2, 64)
    __gpu_state = 1
    return true
}

fn __gpu_nsstring(s: string) -> int {
    return __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("NSString")), __objc("stringWithUTF8String:"), __cstr(s))
}

# the compiled kernel for this gpu for (made once); 0 if Metal refused it
fn __gpu_pipe(src: string, id: int) -> int {
    if id < 4096 {
        p = __load64(__gpu_pipes + id * 8)
        if p == -1 {
            return 0
        }
        if p != 0 {
            return p
        }
    }
    e = __gpu_tmp
    __store64(e, 0)
    # exact math (no fast shortcuts), so results match the CPU as closely as 32-bit floats can
    opts = __ccall("objc_msgSend", __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MTLCompileOptions")), __objc("alloc")), __objc("init"))
    if opts != 0 {
        __ccall("objc_msgSend", opts, __objc("setFastMathEnabled:"), 0)
    }
    lib = __ccall("objc_msgSend", __gpu_dev, __objc("newLibraryWithSource:options:error:"), __gpu_nsstring(src), opts, e)
    if lib == 0 and opts != 0 {
        # some GPUs (like virtual ones) only take the default settings
        __store64(e, 0)
        lib = __ccall("objc_msgSend", __gpu_dev, __objc("newLibraryWithSource:options:error:"), __gpu_nsstring(src), 0, e)
    }
    p = 0
    if lib != 0 {
        f = __ccall("objc_msgSend", lib, __objc("newFunctionWithName:"), __gpu_nsstring("slop_gpu_" + __int_to_string(id)))
        if f != 0 {
            __store64(e, 0)
            p = __ccall("objc_msgSend", __gpu_dev, __objc("newComputePipelineStateWithFunction:error:"), f, e)
        }
    }
    if p == 0 {
        msg = "unknown error"
        if __load64(e) != 0 {
            # description includes the compiler's own messages
            d = __ccall("objc_msgSend", __load64(e), __objc("description"))
            c = __ccall("objc_msgSend", d, __objc("UTF8String"))
            msg = __str(c, __strlen(c))
        }
        __eprint("Slop: the GPU could not take this gpu for, so it runs on the CPU: " + msg)
        if id < 4096 {
            __store64(__gpu_pipes + id * 8, -1)
        }
        return 0
    }
    if id < 4096 {
        __store64(__gpu_pipes + id * 8, p)
    }
    return p
}

fn __gpu_begin(src: string, spv: string, id: int, a: int, b: int) -> bool {
    if not __gpu_init() {
        return false
    }
    n = b - a
    if n > 1073741824 or a < -2147483648 or b > 2147483647 {
        return false
    }
    __gpu_pool = __ccall("objc_autoreleasePoolPush")
    pipe = __gpu_pipe(src, id)
    if pipe == 0 {
        __ccall("objc_autoreleasePoolPop", __gpu_pool)
        return false
    }
    __gpu_count = n
    __gpu_cmd = __ccall("objc_msgSend", __gpu_queue, __objc("commandBuffer"))
    __gpu_enc = __ccall("objc_msgSend", __gpu_cmd, __objc("computeCommandEncoder"))
    __ccall("objc_msgSend", __gpu_enc, __objc("setComputePipelineState:"), pipe)
    __gpu_nbufs = 0
    __gpu_backs = 0
    __gpu_slot = 0
    # slot 0: set to 1 when the loop goes outside a list
    __gpu_err = __gpu_new_buffer(4)
    __store32(__ccall("objc_msgSend", __gpu_err, __objc("contents")), 0)
    __gpu_bind(__gpu_err)
    __gpu_bytes(a, 4)
    __gpu_bytes(n, 4)
    __store64(__gpu_tmp + 32, pipe)
    return true
}

fn __gpu_new_buffer(bytes: int) -> int {
    if bytes < 16 {
        bytes = 16
    }
    # MTLResourceStorageModeShared: the CPU and GPU see the same memory
    buf = __ccall("objc_msgSend", __gpu_dev, __objc("newBufferWithLength:options:"), bytes, 0)
    if buf == 0 {
        __eprint("Slop: the GPU is out of memory")
        __os_exit(1)
    }
    if __gpu_nbufs < 32 {
        __store64(__gpu_bufs + __gpu_nbufs * 8, buf)
        __gpu_nbufs += 1
    }
    return buf
}

fn __gpu_bind(buf: int) {
    __ccall("objc_msgSend", __gpu_enc, __objc("setBuffer:offset:atIndex:"), buf, 0, __gpu_slot)
    __gpu_slot += 1
}

fn __gpu_buffer(bytes: int, n: int) -> int {
    buf = __gpu_new_buffer(bytes)
    __gpu_bind(buf)
    __gpu_bytes(n, 4)
    return __ccall("objc_msgSend", buf, __objc("contents"))
}

fn __gpu_bytes(v: int, size: int) {
    __store64(__gpu_tmp, v)
    __ccall("objc_msgSend", __gpu_enc, __objc("setBytes:length:atIndex:"), __gpu_tmp, size, __gpu_slot)
    __gpu_slot += 1
}

fn __gpu_run() {
    pipe = __load64(__gpu_tmp + 32)
    if __gpu_count > 0 {
        w = __ccall("objc_msgSend", pipe, __objc("maxTotalThreadsPerThreadgroup"))
        if w < 1 {
            w = 1
        }
        if w > 256 {
            w = 256
        }
        # MTLSize structs (width, height, depth), passed by address
        g = __gpu_tmp + 8
        __store64(g, __gpu_count)
        __store64(g + 8, 1)
        __store64(g + 16, 1)
        t = __gpu_tmp + 40
        __store64(t, w)
        __store64(t + 8, 1)
        __store64(t + 16, 1)
        __ccall("objc_msgSend", __gpu_enc, __objc("dispatchThreads:threadsPerThreadgroup:"), g, t)
    }
    __ccall("objc_msgSend", __gpu_enc, __objc("endEncoding"))
    __ccall("objc_msgSend", __gpu_cmd, __objc("commit"))
    __ccall("objc_msgSend", __gpu_cmd, __objc("waitUntilCompleted"))
    if __ccall("objc_msgSend", __gpu_cmd, __objc("status")) == 5 {
        __eprint("Slop: the GPU failed to run a gpu for")
        __os_exit(1)
    }
    if __load32(__ccall("objc_msgSend", __gpu_err, __objc("contents"))) != 0 {
        __eprint("Slop Secure Guard: Array index out of bounds in a gpu for! Terminating process to prevent memory exploit.")
        __os_exit(139)
    }
    # list buffers come after the error buffer, in order
    __gpu_backs = 1
}

fn __gpu_back() -> int {
    buf = __load64(__gpu_bufs + __gpu_backs * 8)
    __gpu_backs += 1
    return __ccall("objc_msgSend", buf, __objc("contents"))
}

fn __gpu_end() {
    for i in 0..__gpu_nbufs {
        __ccall("objc_msgSend", __load64(__gpu_bufs + i * 8), __objc("release"))
    }
    __gpu_nbufs = 0
    __ccall("objc_autoreleasePoolPop", __gpu_pool)
}

# the GPU's name, or "" when gpu for runs on the CPU
fn __gpu_name() -> string {
    if not __gpu_init() {
        return ""
    }
    pool = __ccall("objc_autoreleasePoolPush")
    c = __ccall("objc_msgSend", __ccall("objc_msgSend", __gpu_dev, __objc("name")), __objc("UTF8String"))
    n = __strlen(c)
    p = __alloc_bytes(n + 1)
    __memcpy(p, c, n)
    __ccall("objc_autoreleasePoolPop", pool)
    s = __str(p, n)
    return s
}

# ---------- the npu module: the Apple Neural Engine through Core ML ----------
# Core ML runs networks it loads from model files, so each shape gets a small
# one, written in Core ML's format (protocol buffers). SLOP_NPU_DEVICE=CPU
# uses Core ML on the CPU instead (for testing on Macs without the NPU).
__ane_state = 0
__ane_units = 0
__ane_cache = 0
__ane_cached = 0

fn __pb_varint(v: int) -> string {
    s = ""
    while v >= 128 {
        s = s + __chr(v % 128 + 128)
        v = v / 128
    }
    return s + __chr(v)
}

fn __pb_bytes(field: int, payload: string) -> string {
    return __pb_varint(field * 8 + 2) + __pb_varint(len(payload)) + payload
}

fn __pb_int(field: int, v: int) -> string {
    return __pb_varint(field * 8) + __pb_varint(v)
}

# a float32 multi-array input or output called name, with these sizes
fn __ane_feature(name: string, dims: array[int]) -> string {
    packed = ""
    for d in dims {
        packed = packed + __pb_varint(d)
    }
    array_type = __pb_bytes(1, packed) + __pb_int(2, 65568)
    return __pb_bytes(1, name) + __pb_bytes(3, __pb_bytes(5, array_type))
}

fn __ane_layer(name: string, inputs: array[string], output: string, field: int, params: string) -> string {
    s = __pb_bytes(1, name)
    for i in inputs {
        s = s + __pb_bytes(2, i)
    }
    return s + __pb_bytes(3, output) + __pb_bytes(field, params)
}

fn __ane_model(m: int, k: int, n: int, has_bias: bool, act: int) -> string {
    desc = __pb_bytes(1, __ane_feature("x", [m, k])) + __pb_bytes(1, __ane_feature("w", [k, n]))
    if has_bias {
        desc = desc + __pb_bytes(1, __ane_feature("b", [n]))
    }
    desc = desc + __pb_bytes(10, __ane_feature("out", [m, n]))
    last = "out"
    if has_bias or act > 0 {
        last = "mm"
    }
    # batchedMatmul
    layers = __pb_bytes(1, __ane_layer("mm", ["x", "w"], last, 1045, ""))
    if has_bias {
        to = "out"
        if act > 0 {
            to = "sum"
        }
        # addBroadcastable
        layers = layers + __pb_bytes(1, __ane_layer("add", [last, "b"], to, 880, ""))
        last = to
    }
    if act > 0 {
        # activation: ReLU 10, sigmoid 40, tanh 30
        kind = 10
        if act == 2 {
            kind = 40
        }
        if act == 3 {
            kind = 30
        }
        layers = layers + __pb_bytes(1, __ane_layer("act", [last], "out", 130, __pb_bytes(kind, "")))
    }
    # exact array shapes; specification version 4 (macOS 10.15)
    network = layers + __pb_int(5, 1)
    return __pb_int(1, 4) + __pb_bytes(2, desc) + __pb_bytes(500, network)
}

fn __ns_number(v: int) -> int {
    return __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("NSNumber")), __objc("numberWithLongLong:"), v)
}

fn __ns_array(items: array[int]) -> int {
    p = __alloc_bytes(8 * len(items) + 8)
    for i in 0..len(items) {
        __store64(p + i * 8, items[i])
    }
    return __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("NSArray")), __objc("arrayWithObjects:count:"), p, len(items))
}

fn __ane_init() -> bool {
    if __ane_state != 0 {
        return __ane_state == 1
    }
    __ane_state = -1
    if __ccall("dlopen", __cstr("/System/Library/Frameworks/CoreML.framework/CoreML"), 2) == 0 {
        return false
    }
    want = __env("SLOP_NPU_DEVICE")
    if want == "CPU" {
        # MLComputeUnitsCPUOnly
        __ane_units = 0
    } else {
        if not __ane_present() {
            return false
        }
        # MLComputeUnitsCPUAndNeuralEngine
        __ane_units = 3
    }
    # kept for the whole run (bucket 2 is never given back)
    __ane_cache = __alloc_bytes_in(2, 40 * 256)
    __ane_state = 1
    return true
}

# does this Mac have a Neural Engine? (macOS 14 and later can tell)
fn __ane_present() -> bool {
    devices = __ccall("objc_getClass", __cstr("MLComputeDevice"))
    ane = __ccall("objc_getClass", __cstr("MLNeuralEngineComputeDevice"))
    if devices == 0 or ane == 0 {
        return false
    }
    pool = __ccall("objc_autoreleasePoolPush")
    list = __ccall("objc_msgSend", devices, __objc("allComputeDevices"))
    found = false
    if list != 0 {
        count = __ccall("objc_msgSend", list, __objc("count"))
        for i in 0..count {
            d = __ccall("objc_msgSend", list, __objc("objectAtIndex:"), i)
            if __ccall("objc_msgSend", d, __objc("isKindOfClass:"), ane) % 256 != 0 {
                found = true
            }
        }
    }
    __ccall("objc_autoreleasePoolPop", pool)
    return found
}

fn __ane_error(e: int) -> string {
    if __load64(e) == 0 {
        return "unknown error"
    }
    d = __ccall("objc_msgSend", __load64(e), __objc("description"))
    c = __ccall("objc_msgSend", d, __objc("UTF8String"))
    return __str(c, __strlen(c))
}

# the loaded model for this shape (made once); -1 if Core ML refused it
fn __ane_model_for(m: int, k: int, n: int, has_bias: bool, act: int) -> int {
    kind = act * 2
    if has_bias {
        kind += 1
    }
    for i in 0..__ane_cached {
        c = __ane_cache + i * 40
        if __load64(c) == m and __load64(c + 8) == k and __load64(c + 16) == n and __load64(c + 24) == kind {
            return __load64(c + 32)
        }
    }
    pool = __ccall("objc_autoreleasePoolPush")
    e = __alloc_bytes(8)
    __store64(e, 0)
    path = "/tmp/slop-npu-" + __int_to_string(__ccall32("getpid")) + "-" + __int_to_string(__ane_cached) + ".mlmodel"
    __write_file(path, __ane_model(m, k, n, has_bias, act))
    url = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("NSURL")), __objc("fileURLWithPath:"), __gpu_nsstring(path))
    compiled = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MLModel")), __objc("compileModelAtURL:error:"), url, e)
    __remove_file(path)
    model = -1
    if compiled != 0 {
        cfg = __ccall("objc_msgSend", __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MLModelConfiguration")), __objc("alloc")), __objc("init"))
        __ccall("objc_msgSend", cfg, __objc("setComputeUnits:"), __ane_units)
        model = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MLModel")), __objc("modelWithContentsOfURL:configuration:error:"), compiled, cfg, e)
        if model != 0 {
            __ccall("objc_msgSend", model, __objc("retain"))
        } else {
            model = -1
        }
    }
    if model == -1 {
        __eprint("Slop: the NPU could not take this network, so it runs on the GPU or CPU: " + __ane_error(e))
    }
    __ccall("objc_autoreleasePoolPop", pool)
    if __ane_cached < 256 {
        c = __ane_cache + __ane_cached * 40
        __store64(c, m)
        __store64(c + 8, k)
        __store64(c + 16, n)
        __store64(c + 24, kind)
        __store64(c + 32, model)
        __ane_cached += 1
    }
    return model
}

# a float32 MLMultiArray over memory at p (rows of the last size)
fn __ane_array(p: int, dims: array[int]) -> int {
    shape: array[int] = []
    strides: array[int] = []
    for i in 0..len(dims) {
        push(shape, __ns_number(dims[i]))
        s = 1
        for j in i + 1..len(dims) {
            s = s * dims[j]
        }
        push(strides, __ns_number(s))
    }
    a = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MLMultiArray")), __objc("alloc"))
    e = __alloc_bytes(8)
    __store64(e, 0)
    return __ccall("objc_msgSend", a, __objc("initWithDataPointer:shape:dataType:strides:deallocator:error:"), p, __ns_array(shape), 65568, __ns_array(strides), 0, e)
}

fn __ane_floats(xs: array[float]) -> int {
    p = __alloc_bytes(len(xs) * 4 + 16)
    for i in 0..len(xs) {
        __store32(p + i * 4, __f64_to_f32(float_bits(xs[i])))
    }
    return p
}

# a 16-bit float's bits -> float
fn __half_to_float(h: int) -> float {
    sign = 1.0
    if h >= 32768 {
        sign = -1.0
        h -= 32768
    }
    ex = h / 1024
    fr = h % 1024
    if ex == 0 {
        return sign * float(fr) / 16777216.0
    }
    if ex == 31 {
        return sign * 1.0 / 0.0
    }
    v = float(1024 + fr)
    ex -= 25
    while ex > 0 {
        v = v * 2.0
        ex -= 1
    }
    while ex < 0 {
        v = v / 2.0
        ex += 1
    }
    return sign * v
}

fn __ane_input(name: string, p: int, dims: array[int], keys: int, objs: int, i: int) {
    fv = __ccall("objc_getClass", __cstr("MLFeatureValue"))
    __store64(keys + i * 8, __gpu_nsstring(name))
    __store64(objs + i * 8, __ccall("objc_msgSend", fv, __objc("featureValueWithMultiArray:"), __ane_array(p, dims)))
}

fn __npu_dense(x: array[float], w: array[float], bias: array[float], m: int, k: int, n: int, act: int, out: array[float]) -> bool {
    if not __ane_init() {
        return false
    }
    has_bias = len(bias) > 0
    model = __ane_model_for(m, k, n, has_bias, act)
    if model == -1 {
        return false
    }
    pool = __ccall("objc_autoreleasePoolPush")
    keys = __alloc_bytes(32)
    objs = __alloc_bytes(32)
    count = 2
    __ane_input("x", __ane_floats(x), [m, k], keys, objs, 0)
    __ane_input("w", __ane_floats(w), [k, n], keys, objs, 1)
    if has_bias {
        __ane_input("b", __ane_floats(bias), [n], keys, objs, 2)
        count = 3
    }
    dict = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("NSDictionary")), __objc("dictionaryWithObjects:forKeys:count:"), objs, keys, count)
    e = __alloc_bytes(8)
    __store64(e, 0)
    provider = __ccall("objc_msgSend", __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MLDictionaryFeatureProvider")), __objc("alloc")), __objc("initWithDictionary:error:"), dict, e)
    result = 0
    if provider != 0 {
        result = __ccall("objc_msgSend", model, __objc("predictionFromFeatures:error:"), provider, e)
    }
    ok = false
    if result != 0 {
        arr = __ccall("objc_msgSend", __ccall("objc_msgSend", result, __objc("featureValueForName:"), __gpu_nsstring("out")), __objc("multiArrayValue"))
        if arr != 0 {
            kind = __ccall("objc_msgSend", arr, __objc("dataType"))
            p = __ccall("objc_msgSend", arr, __objc("dataPointer"))
            st = __ccall("objc_msgSend", arr, __objc("strides"))
            s0 = __ccall("objc_msgSend", __ccall("objc_msgSend", st, __objc("objectAtIndex:"), 0), __objc("longLongValue"))
            s1 = __ccall("objc_msgSend", __ccall("objc_msgSend", st, __objc("objectAtIndex:"), 1), __objc("longLongValue"))
            ok = true
            for i in 0..m {
                for j in 0..n {
                    at = i * s0 + j * s1
                    v = 0.0
                    if kind == 65568 {
                        v = float_from_bits(__f32_to_f64(__load32(p + at * 4)))
                    } else if kind == 65600 {
                        v = float_from_bits(__load64(p + at * 8))
                    } else if kind == 65552 {
                        v = __half_to_float(__load16(p + at * 2))
                    } else {
                        ok = false
                    }
                    out[i * n + j] = v
                }
            }
        }
    } else {
        __eprint("Slop: the NPU could not run this network: " + __ane_error(e))
    }
    __ccall("objc_autoreleasePoolPop", pool)
    return ok
}

# the NPU's name, or "" when there is none
fn __npu_name() -> string {
    if not __ane_init() {
        return ""
    }
    if __ane_units == 0 {
        return "Core ML CPU"
    }
    return "Apple Neural Engine"
}

# ---------- system libraries (for BLAS) ----------
fn __dl_load(file: string) -> int {
    return __ccall("dlopen", __cstr(file), 2)
}

fn __dl_sym(lib: int, name: string) -> int {
    return __ccall("dlsym", lib, __cstr(name))
}

fn __gpu_thread_ok() -> bool {
    return true
}

# ---------- matrix multiply on the GPU (the matrix module's gpu_matmul) ----------
# Apple's own tuned one (Metal Performance Shaders) when the GPU supports it,
# else the same tiled kernel as on other systems, in Metal's language.
__mps_state = 0

fn __mps_ok() -> bool {
    if __mps_state != 0 {
        return __mps_state == 1
    }
    __mps_state = -1
    lib = __dl_load("/System/Library/Frameworks/MetalPerformanceShaders.framework/MetalPerformanceShaders")
    if lib == 0 {
        return false
    }
    f = __dl_sym(lib, "MPSSupportsMTLDevice")
    if f == 0 or __ccall_ptr(f, __gpu_dev) % 256 == 0 {
        return false
    }
    __mps_state = 1
    return true
}

fn __mtl_mm_source() -> string {
    return "#include <metal_stdlib>\nusing namespace metal;\nkernel void slop_gpu_4095(device const float* a [[buffer(0)]], device const float* b [[buffer(1)]], device float* c [[buffer(2)]], constant uint* p [[buffer(3)]], uint2 tid [[thread_position_in_threadgroup]], uint2 gid [[threadgroup_position_in_grid]]) {\nthreadgroup float As[16][64];\nthreadgroup float Bs[16][64];\nuint M = p[0], N = p[1], K = p[2];\nuint tx = tid.x, ty = tid.y, lid = ty * 16 + tx;\nuint row0 = gid.y * 64, col0 = gid.x * 64;\nfloat acc[4][4];\nfor (uint i = 0; i < 4; i++) for (uint j = 0; j < 4; j++) acc[i][j] = 0.0f;\nfor (uint k0 = 0; k0 < K; k0 += 16) {\nfor (uint s = 0; s < 4; s++) {\nuint e = lid + s * 256;\nuint r = e / 16, kk = e % 16, gr = row0 + r, gk = k0 + kk;\nAs[kk][r] = (gr < M && gk < K) ? a[gr * K + gk] : 0.0f;\nuint kb = e / 64, cc = e % 64, gk2 = k0 + kb, gc = col0 + cc;\nBs[kb][cc] = (gk2 < K && gc < N) ? b[gk2 * N + gc] : 0.0f;\n}\nthreadgroup_barrier(mem_flags::mem_threadgroup);\nfor (uint kk = 0; kk < 16; kk++) {\nfloat av[4], bv[4];\nfor (uint i = 0; i < 4; i++) { av[i] = As[kk][ty * 4 + i]; bv[i] = Bs[kk][tx * 4 + i]; }\nfor (uint i = 0; i < 4; i++) for (uint j = 0; j < 4; j++) acc[i][j] += av[i] * bv[j];\n}\nthreadgroup_barrier(mem_flags::mem_threadgroup);\n}\nfor (uint i = 0; i < 4; i++) {\nuint r = row0 + ty * 4 + i;\nif (r < M) for (uint j = 0; j < 4; j++) { uint cl = col0 + tx * 4 + j; if (cl < N) c[r * N + cl] = acc[i][j]; }\n}\n}\n"
}

fn __mtl_buffer(p: int, bytes: int) -> int {
    if p == 0 {
        return __ccall("objc_msgSend", __gpu_dev, __objc("newBufferWithLength:options:"), bytes, 0)
    }
    return __ccall("objc_msgSend", __gpu_dev, __objc("newBufferWithBytes:length:options:"), p, bytes, 0)
}

fn __mps_matrix(buf: int, rows: int, cols: int) -> int {
    # MPSDataTypeFloat32
    desc = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MPSMatrixDescriptor")), __objc("matrixDescriptorWithRows:columns:rowBytes:dataType:"), rows, cols, cols * 4, 268435488)
    m = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MPSMatrix")), __objc("alloc"))
    return __ccall("objc_msgSend", m, __objc("initWithBuffer:descriptor:"), buf, desc)
}

# the last GPU matmul's way: "Metal Performance Shaders", "Slop's Metal kernel"
__mtl_mm_way = 0

# c = a * b on the GPU, floats as 32 bits at a, b, c; false: not possible here
fn __gpu_matmul(a: int, b: int, c: int, m: int, k: int, n: int) -> bool {
    if not __gpu_init() {
        return false
    }
    pool = __ccall("objc_autoreleasePoolPush")
    ba = __mtl_buffer(a, m * k * 4)
    bb = __mtl_buffer(b, k * n * 4)
    bc = __mtl_buffer(0, m * n * 4)
    cmd = __ccall("objc_msgSend", __gpu_queue, __objc("commandBuffer"))
    ok = ba != 0 and bb != 0 and bc != 0 and cmd != 0
    used = false
    if ok and __env("SLOP_MPS") != "none" and __mps_ok() {
        ma = __mps_matrix(ba, m, k)
        mb = __mps_matrix(bb, k, n)
        mc = __mps_matrix(bc, m, n)
        mm = __ccall("objc_msgSend", __ccall("objc_getClass", __cstr("MPSMatrixMultiplication")), __objc("alloc"))
        mm = __ccall("objc_msgSend", mm, __objc("initWithDevice:resultRows:resultColumns:interiorColumns:"), __gpu_dev, m, n, k)
        if ma != 0 and mb != 0 and mc != 0 and mm != 0 {
            __ccall("objc_msgSend", mm, __objc("encodeToCommandBuffer:leftMatrix:rightMatrix:resultMatrix:"), cmd, ma, mb, mc)
            used = true
            __mtl_mm_way = 1
        }
        for x in [ma, mb, mc, mm] {
            if x != 0 {
                __ccall("objc_msgSend", x, __objc("release"))
            }
        }
    }
    if ok and not used {
        pipe = __gpu_pipe(__mtl_mm_source(), 4095)
        if pipe != 0 {
            enc = __ccall("objc_msgSend", cmd, __objc("computeCommandEncoder"))
            __ccall("objc_msgSend", enc, __objc("setComputePipelineState:"), pipe)
            __ccall("objc_msgSend", enc, __objc("setBuffer:offset:atIndex:"), ba, 0, 0)
            __ccall("objc_msgSend", enc, __objc("setBuffer:offset:atIndex:"), bb, 0, 1)
            __ccall("objc_msgSend", enc, __objc("setBuffer:offset:atIndex:"), bc, 0, 2)
            p = __alloc_bytes(16)
            __store32(p, m)
            __store32(p + 4, n)
            __store32(p + 8, k)
            __ccall("objc_msgSend", enc, __objc("setBytes:length:atIndex:"), p, 16, 3)
            # MTLSize structs, passed by address: groups, then threads per group
            g = __alloc_bytes(48)
            __store64(g, (n + 63) / 64)
            __store64(g + 8, (m + 63) / 64)
            __store64(g + 16, 1)
            __store64(g + 24, 16)
            __store64(g + 32, 16)
            __store64(g + 40, 1)
            __ccall("objc_msgSend", enc, __objc("dispatchThreadgroups:threadsPerThreadgroup:"), g, g + 24)
            __ccall("objc_msgSend", enc, __objc("endEncoding"))
            used = true
            __mtl_mm_way = 2
        }
    }
    if used {
        __ccall("objc_msgSend", cmd, __objc("commit"))
        __ccall("objc_msgSend", cmd, __objc("waitUntilCompleted"))
        # MTLCommandBufferStatusError
        if __ccall("objc_msgSend", cmd, __objc("status")) == 5 {
            used = false
        } else {
            __memcpy(c, __ccall("objc_msgSend", bc, __objc("contents")), m * n * 4)
        }
    }
    for x in [ba, bb, bc] {
        if x != 0 {
            __ccall("objc_msgSend", x, __objc("release"))
        }
    }
    __ccall("objc_autoreleasePoolPop", pool)
    return used
}

# ---------- many connections at once (kqueue) ----------
fn __poller_new() -> int {
    return __ccall32("kqueue")
}

# watch fd for reading; once: only until it fires (then watch it again)
fn __poller_watch(p: int, fd: int, once: bool) -> bool {
    kev = __alloc_bytes(32)
    __memzero(kev, 32)
    __store64(kev, fd)
    # EVFILT_READ; EV_ADD | EV_ENABLE (| EV_ONESHOT)
    __store16(kev + 8, 65535)
    flags = 5
    if once {
        flags = 21
    }
    __store16(kev + 10, flags)
    return __ccall32("kevent", p, kev, 1, 0, 0, 0) >= 0
}

fn __poller_wait(p: int, out: int, max: int, ms: int) -> int {
    evs = __alloc_bytes(32 * max)
    ts = __alloc_bytes(16)
    __store64(ts, ms / 1000)
    __store64(ts + 8, ms % 1000 * 1000000)
    n = __ccall32("kevent", p, 0, 0, evs, max, ts)
    if n < 0 {
        return 0
    }
    for i in 0..n {
        __store64(out + i * 8, __load64(evs + i * 32))
    }
    return n
}

fn __socket_timeout(fd: int, ms: int) {
    tv = __alloc_bytes(16)
    __memzero(tv, 16)
    __store64(tv, ms / 1000)
    __store32(tv + 8, ms % 1000 * 1000)
    # SOL_SOCKET, SO_RCVTIMEO
    __ccall32("setsockopt", fd, 65535, 4102, tv, 16)
}

fn __socket_nodelay(fd: int) {
    one = __alloc_bytes(8)
    __store64(one, 1)
    __ccall32("setsockopt", fd, 6, 1, one, 4)
}

# stops reading from fd: a read waiting on it returns at once
fn __socket_shutdown(fd: int) {
    __ccall32("shutdown", fd, 0)
}

# is there something to read on fd (or has it closed)? waits up to ms
fn __socket_ready(fd: int, ms: int) -> bool {
    p = __alloc_bytes(16)
    __memzero(p, 16)
    __store32(p, fd)
    __store8(p + 4, 1)
    return __ccall32("poll", p, 1, ms) != 0
}
