# Slop runtime: the part shared by every operating system. It is compiled
# into every program. The OS-specific part (linux.slop, macos.slop,
# windows.slop) provides the __os_* functions used here.
#
# Functions whose names start with __ have no memory frame of their own:
# whatever they allocate lands in their caller's memory.

__out_ptr = __alloc_in(2, 65536)
__out_len = 0
__threads_on = false
__out_word = 0
__out_owner = 0
__out_depth = 0
__user_word = 0
__in_ptr = 0
__in_len = 0
__in_pos = 0
__in_eof = false

fn __write_all(fd: int, p: int, n: int) {
    while n > 0 {
        w = __os_write(fd, p, n)
        if w <= 0 {
            return
        }
        p += w
        n -= w
    }
}

fn __flush() {
    __out_lock()
    if __out_len > 0 {
        __write_all(1, __out_ptr, __out_len)
        __out_len = 0
    }
    __out_unlock()
}

fn __out_bytes(p: int, n: int) {
    if __out_len + n > 65536 {
        __flush()
        if n > 65536 {
            __write_all(1, p, n)
            return
        }
    }
    __memcpy(__out_ptr + __out_len, p, n)
    __out_len += n
}

fn __out_byte(b: int) {
    if __out_len >= 65536 {
        __flush()
    }
    __store8(__out_ptr + __out_len, b)
    __out_len += 1
}

fn __out_str(s: string) {
    __out_bytes(__str_ptr(s), len(s))
}

fn __digits(n: int, buf: int) -> int {
    i = 24
    if n == 0 {
        __store8(buf + 23, 48)
        return 23
    }
    neg = n < 0
    if not neg {
        n = -n
    }
    while n != 0 {
        i -= 1
        __store8(buf + i, 48 - n % 10)
        n = n / 10
    }
    if neg {
        i -= 1
        __store8(buf + i, 45)
    }
    return i
}

fn __out_int(n: int) {
    buf = __scratch()
    i = __digits(n, buf)
    __out_bytes(buf + i, 24 - i)
}

fn __out_bool(b: bool) {
    if b {
        __out_str("true")
    } else {
        __out_str("false")
    }
}

fn __out_ints(a: array[int]) {
    __out_byte(91)
    for i in 0..len(a) {
        if i > 0 {
            __out_str(", ")
        }
        __out_int(a[i])
    }
    __out_byte(93)
}

fn __out_strs(a: array[string]) {
    __out_byte(91)
    for i in 0..len(a) {
        if i > 0 {
            __out_str(", ")
        }
        __out_byte(34)
        __out_str(a[i])
        __out_byte(34)
    }
    __out_byte(93)
}

fn __int_to_string(n: int) -> string {
    p = __alloc_bytes(24)
    i = __digits(n, p)
    return __str(p + i, 24 - i)
}

fn __concat(a: string, b: string) -> string {
    la = len(a)
    lb = len(b)
    if lb == 0 {
        return a
    }
    if la == 0 {
        return b
    }
    pa = __str_ptr(a)
    # a ends exactly where free memory starts: just grow it in place
    if pa + la == __bump(__cur_bucket()) {
        __memcpy(__alloc_bytes(lb), __str_ptr(b), lb)
        return __str(pa, la + lb)
    }
    p = __alloc_bytes(la + lb)
    __memcpy(p, pa, la)
    __memcpy(p + la, __str_ptr(b), lb)
    return __str(p, la + lb)
}

fn __streq(a: string, b: string) -> bool {
    if len(a) != len(b) {
        return false
    }
    return __memeq(__str_ptr(a), __str_ptr(b), len(a))
}

fn __char_at(s: string, i: int) -> string {
    if i < 0 or i >= len(s) {
        return ""
    }
    return __str(__str_ptr(s) + i, 1)
}

fn __byte_at(s: string, i: int) -> int {
    if i < 0 or i >= len(s) {
        return -1
    }
    return __load8(__str_ptr(s) + i)
}

fn __slice(s: string, a: int, b: int) -> string {
    n = len(s)
    if a < 0 {
        a = 0
    }
    if b > n {
        b = n
    }
    if b <= a {
        return ""
    }
    return __str(__str_ptr(s) + a, b - a)
}

fn __find(s: string, sub: string) -> int {
    n = len(s)
    m = len(sub)
    p = __str_ptr(s)
    q = __str_ptr(sub)
    i = 0
    while i + m <= n {
        if __memeq(p + i, q, m) {
            return i
        }
        i += 1
    }
    return -1
}

fn __contains(s: string, sub: string) -> bool {
    return __find(s, sub) >= 0
}

fn __starts_with(s: string, pre: string) -> bool {
    if len(pre) > len(s) {
        return false
    }
    return __memeq(__str_ptr(s), __str_ptr(pre), len(pre))
}

fn __ends_with(s: string, post: string) -> bool {
    if len(post) > len(s) {
        return false
    }
    return __memeq(__str_ptr(s) + len(s) - len(post), __str_ptr(post), len(post))
}

fn __is_space(c: int) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13
}

fn __trim(s: string) -> string {
    p = __str_ptr(s)
    a = 0
    b = len(s)
    while a < b and __is_space(__load8(p + a)) {
        a += 1
    }
    while b > a and __is_space(__load8(p + b - 1)) {
        b -= 1
    }
    return __str(p + a, b - a)
}

fn __map_case(s: string, lo: int, hi: int, delta: int) -> string {
    n = len(s)
    p = __alloc_bytes(n)
    q = __str_ptr(s)
    for i in 0..n {
        c = __load8(q + i)
        if c >= lo and c <= hi {
            c += delta
        }
        __store8(p + i, c)
    }
    return __str(p, n)
}

fn __upper(s: string) -> string {
    return __map_case(s, 97, 122, -32)
}

fn __lower(s: string) -> string {
    return __map_case(s, 65, 90, 32)
}

fn __split(s: string, sep: string) -> array[string] {
    out: array[string] = []
    n = len(s)
    m = len(sep)
    p = __str_ptr(s)
    if m == 0 {
        for i in 0..n {
            push(out, __str(p + i, 1))
        }
        return out
    }
    q = __str_ptr(sep)
    start = 0
    i = 0
    while i + m <= n {
        if __memeq(p + i, q, m) {
            push(out, __str(p + start, i - start))
            i += m
            start = i
        } else {
            i += 1
        }
    }
    push(out, __str(p + start, n - start))
    return out
}

fn __join(parts: array[string], sep: string) -> string {
    k = len(parts)
    if k == 0 {
        return ""
    }
    total = len(sep) * (k - 1)
    for s in parts {
        total += len(s)
    }
    p = __alloc_bytes(total)
    at = 0
    for i in 0..k {
        if i > 0 {
            __memcpy(p + at, __str_ptr(sep), len(sep))
            at += len(sep)
        }
        s = parts[i]
        __memcpy(p + at, __str_ptr(s), len(s))
        at += len(s)
    }
    return __str(p, total)
}

fn __replace(s: string, old: string, new: string) -> string {
    if len(old) == 0 {
        return s
    }
    return __join(__split(s, old), new)
}

fn __repeat(s: string, n: int) -> string {
    if n <= 0 or len(s) == 0 {
        return ""
    }
    p = __alloc_bytes(len(s) * n)
    for i in 0..n {
        __memcpy(p + i * len(s), __str_ptr(s), len(s))
    }
    return __str(p, len(s) * n)
}

fn __to_int(s: string) -> int {
    p = __str_ptr(s)
    n = len(s)
    i = 0
    while i < n and __is_space(__load8(p + i)) {
        i += 1
    }
    neg = false
    if i < n and __load8(p + i) == 45 {
        neg = true
        i += 1
    }
    v = 0
    while i < n and __load8(p + i) >= 48 and __load8(p + i) <= 57 {
        v = v * 10 + __load8(p + i) - 48
        i += 1
    }
    if neg {
        return -v
    }
    return v
}

fn __chr(n: int) -> string {
    p = __alloc_bytes(1)
    __store8(p, n)
    return __str(p, 1)
}

fn __cstr(s: string) -> int {
    n = len(s)
    p = __alloc_bytes(n + 1)
    __memcpy(p, __str_ptr(s), n)
    __store8(p + n, 0)
    return p
}

fn __strlen(p: int) -> int {
    n = 0
    while __load8(p + n) != 0 {
        n += 1
    }
    return n
}

fn __eprint(s: string) {
    __out_lock()
    __flush()
    __write_all(2, __str_ptr(s), len(s))
    __store8(__scratch(), 10)
    __write_all(2, __scratch(), 1)
    __out_unlock()
}

fn __arch_name() -> string {
    if __arch() == 2 {
        return "arm64"
    }
    return "x86-64"
}

fn __exit(code: int) {
    __flush()
    __os_exit(code)
}

fn __bounds_fail(i: int, n: int) {
    __eprint("Slop Secure Guard: Array index out of bounds! Length: " + __int_to_string(n) + ", Requested Index: " + __int_to_string(i) + ". Terminating process to prevent memory exploit.")
    __os_exit(139)
}

fn __read_file(path: string) -> string {
    if __contains(path, "..") {
        __eprint("Slop Secure Guard: Blocked directory traversal attack attempt on path: " + path)
        return ""
    }
    fd = __os_open_read(__cstr(path))
    if fd < 0 {
        return ""
    }
    size = __os_size(fd)
    if size > 0 {
        p = __alloc_bytes(size)
        got = 0
        while got < size {
            r = __os_read(fd, p + got, size - got)
            if r <= 0 {
                break
            }
            got += r
        }
        __os_close(fd)
        return __str(p, got)
    }
    # size unknown (like /proc files): read in chunks that sit next to each other
    p = __alloc_bytes(0)
    total = 0
    while true {
        __alloc_bytes(4096)
        r = __os_read(fd, p + total, 4096)
        if r <= 0 {
            break
        }
        total += r
    }
    __os_close(fd)
    return __str(p, total)
}

fn __write_file(path: string, data: string) {
    if __contains(path, "..") {
        __eprint("Slop Secure Guard: Blocked directory traversal write attempt on path: " + path)
        return
    }
    fd = __os_open_write(__cstr(path))
    if fd < 0 {
        return
    }
    __write_all(fd, __str_ptr(data), len(data))
    __os_close(fd)
}

fn __remove_file(path: string) {
    if __contains(path, "..") {
        __eprint("Slop Secure Guard: Blocked directory traversal attempt on path: " + path)
        return
    }
    __os_remove(__cstr(path))
}



# fills a 16-byte IPv4 socket address (family set by the caller); false if ip is not like 1.2.3.4
fn __ipv4_fill(a: int, ip: string, port: int) -> bool {
    if ip == "localhost" {
        ip = "127.0.0.1"
    }
    parts = __split(ip, ".")
    if len(parts) != 4 {
        return false
    }
    __store8(a + 2, port / 256)
    __store8(a + 3, port % 256)
    for i in 0..4 {
        __store8(a + 4 + i, __to_int(parts[i]))
    }
    return true
}

fn __file_exists(path: string) -> bool {
    fd = __os_open_read(__cstr(path))
    if fd < 0 {
        return false
    }
    __os_close(fd)
    return true
}

# true once input() has reached the end of what was typed or piped in
fn __input_ended() -> bool {
    return __in_eof
}

fn __input() -> string {
    __flush()
    if __in_ptr == 0 {
        __in_ptr = __alloc_in(2, 65536)
    }
    out = ""
    while true {
        if __in_pos >= __in_len {
            r = __os_read(0, __in_ptr, 65536)
            if r <= 0 {
                __in_eof = true
                return out
            }
            __in_len = r
            __in_pos = 0
        }
        st = __in_pos
        while __in_pos < __in_len and __load8(__in_ptr + __in_pos) != 10 {
            __in_pos += 1
        }
        piece = __alloc_bytes(__in_pos - st)
        __memcpy(piece, __in_ptr + st, __in_pos - st)
        out = out + __str(piece, __in_pos - st)
        if __in_pos < __in_len {
            __in_pos += 1
            return out
        }
    }
    return out
}




fn __bytes_to_string(a: array[int]) -> string {
    n = len(a)
    p = __alloc_bytes(n)
    for i in 0..n {
        __store8(p + i, a[i])
    }
    return __str(p, n)
}

fn __push_slot(h: int, b: int, w: int) -> int {
    data = __load64(h)
    n = __load64(h + 8)
    cap = __load64(h + 16)
    if n >= cap {
        if cap > 0 and data + cap * 8 == __bump(b) {
            __alloc_in(b, cap * 8)
            cap = cap * 2
        } else {
            nc = cap * 2
            if nc < 8 {
                nc = 8
            }
            nd = __alloc_in(b, nc * 8)
            if n > 0 {
                __memcpy(nd, data, n * 8)
            }
            data = nd
            cap = nc
            __store64(h, nd)
        }
        __store64(h + 16, cap)
    }
    slot = data + n * 8
    __store64(h + 8, n + 1)
    if w == 1 {
        return slot
    }
    box = __alloc_in(b, w * 8)
    __store64(slot, box)
    return box
}

fn __pop_slot(h: int) -> int {
    n = __load64(h + 8)
    if n <= 0 {
        __bounds_fail(-1, 0)
    }
    __store64(h + 8, n - 1)
    return __load64(h) + (n - 1) * 8
}

fn __index_of(list: array[string], s: string) -> int {
    for i in 0..len(list) {
        if list[i] == s {
            return i
        }
    }
    return -1
}

fn __put16(p: int, v: int) {
    __store8(p, v & 255)
    __store8(p + 1, (v >> 8) & 255)
}

fn __get16(p: int) -> int {
    return __load8(p) | (__load8(p + 1) << 8)
}

# Slop-Pack: repeated strings become one-byte dictionary codes
fn __slop_pack(items: array[string]) -> string {
    dict: array[string] = []
    for s in items {
        if len(dict) < 255 and __index_of(dict, s) < 0 {
            push(dict, s)
        }
    }
    size = 5
    for d in dict {
        size += 2 + len(d)
    }
    for s in items {
        if __index_of(dict, s) >= 0 {
            size += 1
        } else {
            size += 3 + len(s)
        }
    }
    p = __alloc_bytes(size)
    __store8(p, len(dict))
    at = 1
    for d in dict {
        __put16(p + at, len(d))
        __memcpy(p + at + 2, __str_ptr(d), len(d))
        at += 2 + len(d)
    }
    n = len(items)
    __put16(p + at, n & 65535)
    __put16(p + at + 2, (n >> 16) & 65535)
    at += 4
    for s in items {
        id = __index_of(dict, s)
        if id >= 0 {
            __store8(p + at, id)
            at += 1
        } else {
            __store8(p + at, 255)
            __put16(p + at + 1, len(s))
            __memcpy(p + at + 3, __str_ptr(s), len(s))
            at += 3 + len(s)
        }
    }
    return __str(p, size)
}

fn __slop_unpack(packed: string) -> array[string] {
    out: array[string] = []
    if len(packed) < 5 {
        return out
    }
    p = __str_ptr(packed)
    dict: array[string] = []
    k = __load8(p)
    at = 1
    for i in 0..k {
        n = __get16(p + at)
        push(dict, __str(p + at + 2, n))
        at += 2 + n
    }
    count = __get16(p + at) | (__get16(p + at + 2) << 16)
    at += 4
    for i in 0..count {
        id = __load8(p + at)
        if id < 255 {
            push(out, dict[id])
            at += 1
        } else {
            n = __get16(p + at + 1)
            push(out, __str(p + at + 3, n))
            at += 3 + n
        }
    }
    return out
}

__last_status = 0

fn __run_status() -> int {
    return __last_status
}

# ---------- memory buckets ----------
# reserve address space for the 3 memory buckets of the current thread
fn __init_buckets(size: int, perm_size: int) {
    for b in 0..3 {
        want = size
        if b == 2 {
            want = perm_size
        }
        p = 0
        while p == 0 and want >= 16777216 {
            p = __os_reserve(want)
            if p == 0 {
                want = want / 4
            }
        }
        __store64(__data() + 16 + b * 8, p)
        if __os_commit_on_grow() {
            __store64(__data() + 40 + b * 8, p)
        } else {
            __store64(__data() + 40 + b * 8, p + want)
        }
        __store64(__data() + 64 + b * 8, p + want)
    }
}

# ---------- threads and locks ----------
fn __spin_lock(p: int) {
    while __xchg(p, 1) != 0 {
        while __load64(p) != 0 {
            cpu_relax()
        }
    }
}

fn __spin_unlock(p: int) {
    __xchg(p, 0)
}

fn __lock() {
    __spin_lock(addr_of(__user_word))
}

fn __unlock() {
    __spin_unlock(addr_of(__user_word))
}

# print holds this lock so lines from different threads don't mix
fn __out_lock() {
    if __threads_on {
        me = __data()
        if __out_owner == me {
            __out_depth += 1
            return
        }
        __spin_lock(addr_of(__out_word))
        __out_owner = me
    }
}

fn __out_unlock() {
    if __threads_on {
        if __out_depth > 0 {
            __out_depth -= 1
            return
        }
        __out_owner = 0
        __spin_unlock(addr_of(__out_word))
    }
}

# starts a thread at entry; its arguments are copied from args
fn __thread_spawn(entry: int, args: int, argbytes: int) -> int {
    __threads_on = true
    block = __task_reuse()
    if block == 0 {
        block = __os_alloc(8192)
    }
    if block == 0 {
        __eprint("Slop: cannot start a thread (out of memory)")
        __os_exit(1)
    }
    __memcpy(block, __data(), 128)
    __store64(block + 8, 0)
    __store64(block + 7248, 0)
    __memcpy(block + 4096, args, argbytes)
    __store64(block + 7168, entry)
    if not __os_thread_start(block, entry) {
        __eprint("Slop: cannot start a thread")
        __os_exit(1)
    }
    return block
}

# runs first on a new thread: its own memory buckets
fn __thread_init() {
    d = __data()
    if __load64(d + 7376) != 0 {
        # a reused block: its memory is still there, empty again
        for b in 0..3 {
            __store64(d + 16 + b * 8, __load64(d + 7224 + b * 8))
            __store64(d + 40 + b * 8, __load64(d + 7328 + b * 8))
            __store64(d + 64 + b * 8, __load64(d + 7352 + b * 8))
        }
        return
    }
    __init_buckets(4294967296, 1073741824)
    for b in 0..3 {
        __store64(d + 7224 + b * 8, __load64(d + 16 + b * 8))
    }
}

# waits for a thread, gives back its memory and returns its result. What it
# stored in global variables (its bucket 2) is kept.
fn __thread_join(block: int) -> int {
    __os_thread_join(block)
    r = __load64(block + 7192)
    __task_free(block)
    return r
}

# async tasks are threads whose result is copied out before their memory goes
fn __task_wait(block: int) {
    __os_thread_join(block)
}

# finished threads' blocks (with their memory and stack) are kept for reuse,
# since getting them from the system is the slow part of starting a thread
__task_cache = 0
__task_cached = 0
__task_word = 0

fn __task_reuse() -> int {
    if __task_cached == 0 {
        return 0
    }
    block = 0
    __spin_lock(addr_of(__task_word))
    if __task_cached > 0 {
        __task_cached -= 1
        block = __load64(__task_cache + __task_cached * 8)
    }
    __spin_unlock(addr_of(__task_word))
    return block
}

fn __task_keep(block: int) -> bool {
    kept = false
    __spin_lock(addr_of(__task_word))
    if __task_cache == 0 {
        __task_cache = __os_alloc(8192)
    }
    if __task_cache != 0 and __task_cached < 256 {
        for b in 0..3 {
            __store64(block + 7328 + b * 8, __load64(block + 40 + b * 8))
            __store64(block + 7352 + b * 8, __load64(block + 64 + b * 8))
        }
        __store64(block + 7376, 1)
        __store64(__task_cache + __task_cached * 8, block)
        __task_cached += 1
        kept = true
    }
    __spin_unlock(addr_of(__task_word))
    return kept
}

fn __task_free(block: int) {
    if __load64(block + 32) == __load64(block + 7240) and __task_keep(block) {
        return
    }
    __os_thread_release(block)
    for b in 0..2 {
        start = __load64(block + 7224 + b * 8)
        __os_release(start, __load64(block + 64 + b * 8) - start)
    }
    # its memory for global variables is kept, unless it never used it
    start = __load64(block + 7240)
    if __load64(block + 32) == start {
        __os_release(start, __load64(block + 80) - start)
    }
    __os_release(block, 8192)
}

fn __task_done(block: int) -> bool {
    return __load64(block + 7248) != 0
}

# a name -> its IPv4 address through the system library's getaddrinfo (macOS, Windows)
fn __getaddrinfo(host: string) -> string {
    hints = __alloc(48)
    __memzero(hints, 48)
    __store32(hints + 4, 2)
    __store32(hints + 8, 1)
    res = __scratch() + 40
    __store64(res, 0)
    if __ccall32("getaddrinfo", __cstr(host), 0, hints, res) != 0 {
        return ""
    }
    ai = __load64(res)
    if ai == 0 {
        return ""
    }
    a = __load64(ai + 32)
    ip = __int_to_string(__load8(a + 4)) + "." + __int_to_string(__load8(a + 5)) + "." + __int_to_string(__load8(a + 6)) + "." + __int_to_string(__load8(a + 7))
    __ccall("freeaddrinfo", ai)
    return ip
}

# ---------- parallel for ----------
__par_cores = 0

# how many pieces to cut the range a..b into: one per core (at most 256)
fn __par_pieces(a: int, b: int) -> int {
    n = b - a
    if n <= 0 {
        return 0
    }
    if __par_cores == 0 {
        __par_cores = __cpu_count()
        if __par_cores < 1 {
            __par_cores = 1
        }
        if __par_cores > 256 {
            __par_cores = 256
        }
    }
    if n < __par_cores {
        return n
    }
    return __par_cores
}

# where piece c of t starts in a..b
fn __par_cut(a: int, b: int, t: int, c: int) -> int {
    return a + (b - a) / t * c + __min_int((b - a) % t, c)
}

fn __min_int(x: int, y: int) -> int {
    if x < y {
        return x
    }
    return y
}

# ---------- gpu for ----------
# The compiler turns gpu for into: __gpu_begin, one call per list or number the
# loop uses, __gpu_run, __gpu_back_* for each list, __gpu_end. GPUs work with
# 32-bit numbers: floats are converted on the way in and out, and whole
# numbers are cut to 32 bits (the GPU's own size).
fn __gpu_floats(x: array[float]) {
    n = len(x)
    p = __gpu_buffer(n * 4, n)
    for i in 0..n {
        __store32(p + i * 4, __f64_to_f32(float_bits(x[i])))
    }
}

fn __gpu_ints(x: array[int]) {
    n = len(x)
    p = __gpu_buffer(n * 4, n)
    for i in 0..n {
        __store32(p + i * 4, x[i])
    }
}

fn __gpu_back_floats(x: array[float]) {
    p = __gpu_back()
    for i in 0..len(x) {
        x[i] = float_from_bits(__f32_to_f64(__load32(p + i * 4)))
    }
}

fn __gpu_back_ints(x: array[int]) {
    p = __gpu_back()
    for i in 0..len(x) {
        v = __load32(p + i * 4)
        if v >= 2147483648 {
            v -= 4294967296
        }
        x[i] = v
    }
}

fn __gpu_int(v: int) {
    __gpu_bytes(v, 4)
}

fn __gpu_bool(v: bool) {
    if v {
        __gpu_bytes(1, 4)
    } else {
        __gpu_bytes(0, 4)
    }
}

fn __gpu_float(v: float) {
    __gpu_bytes(__f64_to_f32(float_bits(v)), 4)
}
