# c = a * b on the GPU, floats as 32 bits at a, b, c; false: not possible here
fn __vk_matmul(a: int, b: int, c: int, m: int, k: int, n: int) -> bool {
    if not __vk_init() {
        return false
    }
    spv = __vk_mm_spv()
    __store64(__vk_tmp + 2048, __str_ptr(spv))
    __store64(__vk_tmp + 2056, len(spv))
    __vk_cur = 4095
    if not __vk_pipeline(4) {
        return false
    }
    kern = __vk_kernels + 4095 * 32
    all = __vk_struct(40 * 4)
    sizes = [m * k * 4, k * n * 4, m * n * 4, 16]
    for i in 0..4 {
        if not __vk_make(sizes[i], all + i * 40) {
            __vk_free_all(all, 4)
            return false
        }
    }
    __memcpy(__load64(all + 32), a, m * k * 4)
    __memcpy(__load64(all + 72), b, k * n * 4)
    p = __load64(all + 152)
    __store32(p, m)
    __store32(p + 4, n)
    __store32(p + 8, k)
    r = __vk_dispatch(kern, all, 4, (n + 63) / 64, (m + 63) / 64)
    if r == 1 {
        __memcpy(c, __load64(all + 112), m * n * 4)
    }
    __vk_free_all(all, 4)
    return r == 1
}

fn __vk_back() -> int {
    p = __load64(__vk_bufs + __vk_backs * 40)
    __vk_backs += 1
    return p
}

fn __vk_end() {
    for i in 0..__vk_nbufs {
        e = __vk_bufs + i * 40
        __os_release(__load64(e), __load64(e + 8))
    }
    __vk_nbufs = 0
}

# ---------- which GPU library runs a gpu for: Vulkan, else OpenCL ----------
__gpu_api = 0

fn __gpu_begin(src: string, spv: string, id: int, a: int, b: int) -> bool {
    if not __gpu_thread_ok() {
        return false
    }
    which = __env("SLOP_GPU")
    if which != "opencl" and __vk_begin(spv, id, a, b) {
        __gpu_api = 1
        return true
    }
    if which != "vulkan" and __cl_begin(src, id, a, b) {
        __gpu_api = 2
        return true
    }
    return false
}

fn __gpu_buffer(bytes: int, n: int) -> int {
    if __gpu_api == 1 {
        return __vk_buffer(bytes, n)
    }
    return __cl_buffer(bytes, n)
}

fn __gpu_bytes(v: int, size: int) {
    if __gpu_api == 1 {
        __vk_bytes(v, size)
    } else {
        __cl_bytes(v, size)
    }
}

fn __gpu_run() {
    if __gpu_api == 1 {
        if not __vk_run() {
            __eprint("Slop: Vulkan could not start this gpu for")
            __os_exit(1)
        }
    } else {
        __cl_run()
    }
}

fn __gpu_back() -> int {
    if __gpu_api == 1 {
        return __vk_back()
    }
    return __cl_back()
}

fn __gpu_end() {
    if __gpu_api == 1 {
        __vk_end()
    } else {
        __cl_end()
    }
}

# the GPU's name, or "" when gpu for runs on the CPU
fn __gpu_name() -> string {
    if not __gpu_thread_ok() {
        return ""
    }
    which = __env("SLOP_GPU")
    if which != "opencl" and __vk_init() {
        return __str(__vk_name, __strlen(__vk_name))
    }
    if which != "vulkan" {
        return __cl_name()
    }
    return ""
}

# gpu_matmul: Vulkan, else OpenCL; false: no GPU (then the CPU does it)
fn __gpu_matmul(a: int, b: int, c: int, m: int, k: int, n: int) -> bool {
    if not __gpu_thread_ok() {
        return false
    }
    which = __env("SLOP_GPU")
    if which != "opencl" and __vk_matmul(a, b, c, m, k, n) {
        return true
    }
    if which != "vulkan" and __cl_matmul(a, b, c, m, k, n) {
        return true
    }
    return false
}
