# Slop runtime for Linux: talks to the kernel through system calls.
# x86-64 and ARM64 number their system calls differently; __arch() is 1 or 2.

fn __arm() -> bool {
    return __arch() == 2
}

fn __os_name() -> string {
    return "linux"
}

fn __rt_init() {
    __init_buckets(17179869184, 17179869184)
}

# address space that gets memory when touched; 0 if there is none
fn __os_reserve(size: int) -> int {
    p = 0
    if __arm() {
        p = __syscall(222, 0, size, 3, 16418, -1, 0)
    } else {
        p = __syscall(9, 0, size, 3, 16418, -1, 0)
    }
    if p < 0 {
        return 0
    }
    return p
}

fn __os_alloc(size: int) -> int {
    return __os_reserve(size)
}

fn __os_release(p: int, size: int) {
    if __arm() {
        __syscall(215, p, size)
    } else {
        __syscall(11, p, size)
    }
}

fn __os_commit_on_grow() -> bool {
    return false
}

fn __grow(b: int, need: int) {
    __eprint("Slop: out of memory")
    __os_exit(1)
}

fn __os_write(fd: int, p: int, n: int) -> int {
    if __arm() {
        return __syscall(64, fd, p, n)
    }
    return __syscall(1, fd, p, n)
}

fn __os_read(fd: int, p: int, n: int) -> int {
    if __arm() {
        return __syscall(63, fd, p, n)
    }
    return __syscall(0, fd, p, n)
}

fn __open(path: int, flags: int, mode: int) -> int {
    if __arm() {
        # openat(AT_FDCWD, ...)
        return __syscall(56, -100, path, flags, mode)
    }
    return __syscall(2, path, flags, mode)
}

fn __os_open_read(path: int) -> int {
    return __open(path, 0, 0)
}

fn __os_open_write(path: int) -> int {
    return __open(path, 577, 420)
}

fn __os_close(fd: int) {
    if __arm() {
        __syscall(57, fd)
    } else {
        __syscall(3, fd)
    }
}

fn __lseek(fd: int, off: int, whence: int) -> int {
    if __arm() {
        return __syscall(62, fd, off, whence)
    }
    return __syscall(8, fd, off, whence)
}

# file size, or -1 when unknown (like files in /proc)
fn __os_size(fd: int) -> int {
    size = __lseek(fd, 0, 2)
    __lseek(fd, 0, 0)
    if size <= 0 {
        return -1
    }
    return size
}

# ends the whole program (every thread)
fn __os_exit(code: int) {
    if __arm() {
        __syscall(94, code)
    }
    __syscall(231, code)
}

# ---------- threads ----------
# CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|PARENT_SETTID|CHILD_CLEARTID: the
# kernel clears the id word when the thread ends, which join waits for
fn __os_thread_start(block: int, entry: int) -> bool {
    size = 67108864
    stack = __os_reserve(size)
    if stack == 0 {
        return false
    }
    __store64(block + 7208, stack)
    __store64(block + 7216, size)
    return __clone(3477248, stack + size, block + 7176, block) > 0
}

fn __os_thread_join(block: int) {
    p = block + 7176
    while true {
        id = __load32(p)
        if id == 0 {
            break
        }
        # futex wait until the word changes
        if __arm() {
            __syscall(98, p, 0, id, 0)
        } else {
            __syscall(202, p, 0, id, 0)
        }
    }
    __os_release(__load64(block + 7208), __load64(block + 7216))
}

# ends only the current thread
fn __thread_exit() {
    if __arm() {
        __syscall(93, 0)
    }
    __syscall(60, 0)
}

fn __cpu_count() -> int {
    buf = __scratch()
    n = 0
    if __arm() {
        n = __syscall(123, 0, 64, buf)
    } else {
        n = __syscall(204, 0, 64, buf)
    }
    if n <= 0 {
        return 1
    }
    count = 0
    for i in 0..n {
        b = __load8(buf + i)
        while b > 0 {
            count += b & 1
            b = b >> 1
        }
    }
    return count
}

fn __os_remove(path: int) {
    if __arm() {
        __syscall(35, -100, path, 0)
    } else {
        __syscall(87, path)
    }
}

fn __make_executable(path: string) {
    if __arm() {
        __syscall(53, -100, __cstr(path), 493, 0)
    } else {
        __syscall(90, __cstr(path), 493)
    }
}

fn __make_dir(path: string) -> bool {
    if __arm() {
        return __syscall(34, -100, __cstr(path), 493) == 0
    }
    return __syscall(83, __cstr(path), 493) == 0
}

# full path of this program
fn __program_path() -> string {
    buf = __alloc_bytes(4096)
    n = 0
    if __arm() {
        n = __syscall(78, -100, __cstr("/proc/self/exe"), buf, 4096)
    } else {
        n = __syscall(89, __cstr("/proc/self/exe"), buf, 4096)
    }
    if n <= 0 {
        return ""
    }
    return __str(buf, n)
}

# value of an environment variable, or "" when it is not set
fn __env(name: string) -> string {
    p = __envp()
    while __load64(p) != 0 {
        s = __load64(p)
        n = __strlen(s)
        entry = __str(s, n)
        if __starts_with(entry, name + "=") {
            return __slice(entry, len(name) + 1, n)
        }
        p += 8
    }
    return ""
}

fn __execve(path: int, argv: int, envp: int) {
    if __arm() {
        __syscall(221, path, argv, envp)
    } else {
        __syscall(59, path, argv, envp)
    }
}

fn __args() -> array[string] {
    sp = __sp0()
    argc = __load64(sp)
    out: array[string] = []
    for i in 0..argc {
        a = __load64(sp + 8 + i * 8)
        push(out, __str(a, __strlen(a)))
    }
    return out
}

fn __argv_block(args: array[string]) -> int {
    n = len(args)
    argv = __alloc((n + 1) * 8)
    for i in 0..n {
        __store64(argv + i * 8, __cstr(args[i]))
    }
    __store64(argv + n * 8, 0)
    return argv
}

fn __envp() -> int {
    sp = __sp0()
    return sp + 16 + __load64(sp) * 8
}

fn __exec(path: string, args: array[string]) {
    argv = __argv_block(args)
    __flush()
    __execve(__cstr(path), argv, __envp())
    __eprint("cannot run " + path)
    __os_exit(127)
}

# runs a program and returns everything it printed (stdout and stderr)
fn __run(path: string, args: array[string]) -> string {
    __flush()
    fds = __scratch()
    ok = 0
    if __arm() {
        ok = __syscall(59, fds, 0)
    } else {
        ok = __syscall(22, fds)
    }
    if ok < 0 {
        return ""
    }
    rd = __load64(fds) & 4294967295
    wr = (__load64(fds) >> 32) & 4294967295
    argv = __argv_block(args)
    cpath = __cstr(path)
    pid = 0
    if __arm() {
        # clone(SIGCHLD) is fork
        pid = __syscall(220, 17, 0, 0, 0, 0)
    } else {
        pid = __syscall(57)
    }
    if pid == 0 {
        if __arm() {
            __syscall(24, wr, 1, 0)
            __syscall(24, wr, 2, 0)
        } else {
            __syscall(33, wr, 1)
            __syscall(33, wr, 2)
        }
        __os_close(rd)
        __execve(cpath, argv, __envp())
        __os_exit(127)
    }
    __os_close(wr)
    p = __alloc_bytes(0)
    total = 0
    while true {
        __alloc_bytes(4096)
        r = __os_read(rd, p + total, 4096)
        if r <= 0 {
            break
        }
        total += r
    }
    __os_close(rd)
    st = __scratch() + 32
    __store64(st, 0)
    if __arm() {
        __syscall(260, pid, st, 0, 0)
    } else {
        __syscall(61, pid, st, 0, 0)
    }
    __last_status = (__load64(st) >> 8) & 255
    return __str(p, total)
}

fn __clock_ns() -> int {
    t = __scratch()
    if __arm() {
        __syscall(113, 1, t)
    } else {
        __syscall(228, 1, t)
    }
    return __load64(t) * 1000000000 + __load64(t + 8)
}

# seconds since 1970 (the calendar clock)
fn __time_unix() -> int {
    t = __scratch()
    if __arm() {
        __syscall(113, 0, t)
    } else {
        __syscall(228, 0, t)
    }
    return __load64(t)
}

# n bytes from the kernel's secure random source
fn __random_text(n: int) -> string {
    p = __alloc_bytes(n)
    got = 0
    while got < n {
        r = 0
        if __arm() {
            r = __syscall(278, p + got, n - got, 0)
        } else {
            r = __syscall(318, p + got, n - got, 0)
        }
        if r <= 0 {
            __eprint("Slop: no secure random numbers available")
            __os_exit(1)
        }
        got += r
    }
    return __str(p, n)
}

fn __sleep_ms(ms: int) {
    t = __scratch()
    __store64(t, ms / 1000)
    __store64(t + 8, ms % 1000 * 1000000)
    if __arm() {
        __syscall(101, t, 0)
    } else {
        __syscall(35, t, 0)
    }
}

# x86-64 and ARM64 numbers for socket, setsockopt, bind, listen, accept
fn __sock_nr(i: int) -> int {
    if __arm() {
        nums = [198, 208, 200, 201, 202, 203, 206]
        return nums[i]
    }
    nums = [41, 54, 49, 50, 43, 42, 44]
    return nums[i]
}

fn __socket_listen(port: int) -> int {
    fd = __syscall(__sock_nr(0), 2, 1, 0)
    if fd < 0 {
        return -1
    }
    one = __scratch()
    __store64(one, 1)
    __syscall(__sock_nr(1), fd, 1, 2, one, 4)
    a = __scratch() + 16
    __memzero(a, 16)
    __store8(a, 2)
    __store8(a + 2, port / 256)
    __store8(a + 3, port % 256)
    if __syscall(__sock_nr(2), fd, a, 16) < 0 or __syscall(__sock_nr(3), fd, 128) < 0 {
        __os_close(fd)
        return -1
    }
    return fd
}

fn __socket_accept(fd: int) -> int {
    __flush()
    return __syscall(__sock_nr(4), fd, 0, 0)
}

fn __socket_read(fd: int) -> string {
    p = __alloc_bytes(8192)
    r = __os_read(fd, p, 8192)
    if r <= 0 {
        return ""
    }
    return __str(p, r)
}

# MSG_NOSIGNAL: a visitor who left early must not stop the program
fn __socket_write(fd: int, s: string) {
    p = __str_ptr(s)
    n = len(s)
    while n > 0 {
        w = __syscall(__sock_nr(6), fd, p, n, 16384, 0, 0)
        if w <= 0 {
            return
        }
        p += w
        n -= w
    }
}

# connects to ip:port (like "127.0.0.1"); -1 if it can't
fn __socket_connect(ip: string, port: int) -> int {
    fd = __syscall(__sock_nr(0), 2, 1, 0)
    if fd < 0 {
        return -1
    }
    a = __scratch() + 16
    __memzero(a, 16)
    __store8(a, 2)
    if not __ipv4_fill(a, ip, port) or __syscall(__sock_nr(5), fd, a, 16) < 0 {
        __os_close(fd)
        return -1
    }
    return fd
}

fn __windows_roots() -> array[string] {
    out: array[string] = []
    return out
}

# a host name -> its IPv4 address: /etc/hosts first, then a DNS question
# to the name server in /etc/resolv.conf
fn __resolve(host: string) -> string {
    for line in __split(__read_file("/etc/hosts"), "\n") {
        t = __trim(line)
        if len(t) > 0 and __byte_at(t, 0) != 35 {
            words = __split(__replace(t, "\t", " "), " ")
            if len(words) > 1 and len(__split(words[0], ".")) == 4 {
                for w in words {
                    if w == host {
                        return words[0]
                    }
                }
            }
        }
    }
    server = ""
    for line in __split(__read_file("/etc/resolv.conf"), "\n") {
        t = __trim(line)
        if server == "" and __starts_with(t, "nameserver ") {
            cand = __trim(__slice(t, 11, len(t)))
            if len(__split(cand, ".")) == 4 {
                server = cand
            }
        }
    }
    if server == "" {
        server = "8.8.8.8"
    }
    # the question: id, flags (recursion), 1 question, the name, type A, class IN
    q = __alloc_bytes(512)
    n = 12
    __memzero(q, 12)
    __store8(q, 23)
    __store8(q + 1, 41)
    __store8(q + 2, 1)
    __store8(q + 5, 1)
    for label in __split(host, ".") {
        __store8(q + n, len(label))
        __memcpy(q + n + 1, __str_ptr(label), len(label))
        n += 1 + len(label)
    }
    __store8(q + n, 0)
    __store8(q + n + 1, 0)
    __store8(q + n + 2, 1)
    __store8(q + n + 3, 0)
    __store8(q + n + 4, 1)
    n += 5
    fd = __syscall(__sock_nr(0), 2, 2, 0)
    if fd < 0 {
        return ""
    }
    # wait at most 3 seconds for the answer
    tv = __scratch()
    __store64(tv, 3)
    __store64(tv + 8, 0)
    __syscall(__sock_nr(1), fd, 1, 20, tv, 16)
    a = __scratch() + 16
    __memzero(a, 16)
    __store8(a, 2)
    __ipv4_fill(a, server, 53)
    ans = __alloc_bytes(1500)
    got = 0
    for attempt in 0..2 {
        if got <= 0 {
            __syscall(__sock_nr(6), fd, q, n, 0, a, 16)
            if __arm() {
                got = __syscall(207, fd, ans, 1500, 0, 0, 0)
            } else {
                got = __syscall(45, fd, ans, 1500, 0, 0, 0)
            }
        }
    }
    __os_close(fd)
    if got < 12 {
        return ""
    }
    count = __load8(ans + 6) * 256 + __load8(ans + 7)
    # skip the question
    p = 12
    while p < got and __load8(ans + p) != 0 {
        p += 1 + __load8(ans + p)
    }
    p += 5
    for i in 0..count {
        if p + 12 > got {
            return ""
        }
        # the name: a pointer (2 bytes) or labels
        if __load8(ans + p) >= 192 {
            p += 2
        } else {
            while p < got and __load8(ans + p) != 0 {
                p += 1 + __load8(ans + p)
            }
            p += 1
        }
        typ = __load8(ans + p) * 256 + __load8(ans + p + 1)
        rlen = __load8(ans + p + 8) * 256 + __load8(ans + p + 9)
        p += 10
        if typ == 1 and rlen == 4 {
            return __int_to_string(__load8(ans + p)) + "." + __int_to_string(__load8(ans + p + 1)) + "." + __int_to_string(__load8(ans + p + 2)) + "." + __int_to_string(__load8(ans + p + 3))
        }
        p += rlen
    }
    return ""
}

fn __socket_close(fd: int) {
    __os_close(fd)
}
