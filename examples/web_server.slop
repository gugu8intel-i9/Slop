# A small website with a page, a form, a JSON API and files from a folder.
#   slop run examples/web_server.slop     then open http://localhost:8080
use "web"

notes: array[string] = []

fn notes_page() -> string {
    items = ""
    for n in notes {
        items = items + "<li>" + escape_html(n) + "</li>"
    }
    if items == "" {
        items = "<li><em>No notes yet.</em></li>"
    }
    return page("Notes", render("<h1>Notes</h1><ul>{{{items}}}</ul><form method=\"post\" action=\"/add\"><input name=\"note\" placeholder=\"Write a note\" required> <button>Add</button></form><p><a href=\"/api/notes\">as JSON</a></p>", ["items", items]))
}

fn handle(req: Request) -> Response {
    if route(req, "GET", "/") {
        return html(notes_page())
    }
    if route(req, "POST", "/add") {
        note = trim(form(req, "note"))
        if note != "" {
            push(notes, note)
        }
        return redirect("/")
    }
    if route(req, "GET", "/api/notes") {
        items: array[string] = []
        for n in notes {
            push(items, json_string(n))
        }
        return json(json_object(["count", str(len(notes)), "notes", json_list(items)]))
    }
    if route(req, "GET", "/hello/:name") {
        return text("Hello, " + param("name") + "!")
    }
    if route(req, "GET", "/examples/*") {
        return send_dir(req, "/examples/", "examples")
    }
    return not_found()
}

serve(8080)
