# Fetches a web page and says how it went:
#   slop run examples/fetch.slop https://example.com/
use "web"

fn main(args: array[string]) {
    url = "https://example.com/"
    if len(args) > 1 {
        url = args[1]
    }
    start = clock_ns()
    body = http_get(url)
    ms = (clock_ns() - start) / 1000000
    if http_status() == 0 {
        print("could not fetch " + url + ": " + http_error())
        exit(1)
    }
    print(url + " -> " + str(http_status()) + ", " + str(len(body)) + " bytes in " + str(ms) + " ms")
}
